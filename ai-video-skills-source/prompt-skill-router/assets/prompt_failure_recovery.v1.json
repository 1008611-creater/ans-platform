    {"id": "text_strategy_mismatch", "name_zh": "文字策略错误或乱码", "earliest_gate": "text_policy", "required_recovery": "决定可读短语、模糊纹理、留白或后期叠字；不要要求模型生成长文案。", "qa_checks": ["可读性", "语言", "无乱码", "后期职责"]},
