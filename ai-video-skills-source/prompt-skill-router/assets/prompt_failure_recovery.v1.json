    {"id": "prop_mismatch", "name_zh": "关键道具错误", "earliest_gate": "hand_prop_handoff", "required_recovery": "创建或确认独立关键道具职责，禁止仅靠一段 Prompt 假定模型会还原。", "qa_checks": ["道具身份", "材质", "位置", "连续性"]},
