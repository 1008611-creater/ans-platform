    {"id": "generic_ai_look", "name_zh": "泛化 AI 感", "earliest_gate": "asset_identity", "required_recovery": "补足可见身份、材质、光线、镜头和状态事实；不要叠加长负面词。", "qa_checks": ["材质", "皮肤/衣料", "光线动机", "镜头距离"]},
    {"id": "wrong_reference_submission", "name_zh": "错参考图进入视频任务", "earliest_gate": "prompt_routing_contract", "required_recovery": "拒绝该输出，回到已确认路径/SHA/中文职责和 locked prompt，不得续写或交付错误输出。", "qa_checks": ["路径", "SHA", "参考职责", "prompt readback"]}
