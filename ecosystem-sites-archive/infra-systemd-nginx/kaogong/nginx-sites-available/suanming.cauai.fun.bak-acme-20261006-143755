server {
 server_name suanming.cauai.fun;
 root /var/www/suanming;
 index index.html;
 location / { try_files $uri $uri/ /index.html; }
 # 入口与算法产物必须每次校验：部署新版本后浏览器不能继续吃 1 小时的旧缓存。
 location ~* \.html$ { add_header Cache-Control "no-cache, must-revalidate"; try_files $uri =404; }
 location ~* \.(js|css|svg|json)$ { add_header Cache-Control "no-cache, must-revalidate"; try_files $uri =404; }
 location ~* \.(png|jpg|jpeg|gif|webp|ico|woff2?)$ { expires 7d; add_header Cache-Control "public"; try_files $uri =404; }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/suanming.cauai.fun/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/suanming.cauai.fun/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}server {
    if ($host = suanming.cauai.fun) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


 listen 80;
 listen [::]:80;
 server_name suanming.cauai.fun;
    return 404; # managed by Certbot


}