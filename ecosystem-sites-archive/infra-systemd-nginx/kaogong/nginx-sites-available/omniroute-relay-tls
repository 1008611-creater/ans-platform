# OmniRoute server-side relay (PC-independent).
# Upstream is now the server-local OmniRoute gateway (http://127.0.0.1:20128),
# NOT the old reverse-SSH tunnel to the local PC.
server {
    listen 127.0.0.1:20130 ssl;
    listen 172.19.0.1:20130 ssl;
    server_name origin-canary.cauai.fun;

    # 2026-10-06 加：ACME http-01 校验目录（webroot 方式）。
    # 必须在 location / 之前命中，否则校验请求会被 proxy_pass 或 301 吃掉 → 续期失败。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
        try_files $uri =404;
    }


    ssl_certificate     /etc/letsencrypt/live/origin-canary.cauai.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/origin-canary.cauai.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:20128;
        proxy_http_version 1.1;
        proxy_set_header Host origin-canary.cauai.fun;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
