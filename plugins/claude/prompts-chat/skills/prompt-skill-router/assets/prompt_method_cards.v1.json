    {
      "id": "text_policy",
      "lesson_ref": "Visual reference responsibilities are explicit",
      "name_zh": "画面文字与后期策略",
      "applies_to": ["document", "screen", "subtitle", "commerce"],
      "required_facts": ["text_visibility", "language_policy", "postproduction_owner"],
      "compiler_instruction": "逐项决定文字是可读短语、模糊纹理、留白、翻译后重做还是后期字幕。不要让模型生成长合同、聊天记录、价格表或密集 UI。",
      "lint_tags": ["text_policy", "generated_text_risk"],
      "qa_checks": ["无中文/汉字残留", "无乱码", "字幕职责正确", "可读文字与授权语言一致"]
    },
    {
      "id": "product_evidence",
      "lesson_ref": "Asset-first, not adjective-first",
      "name_zh": "商品证据与真实使用",
      "applies_to": ["product_demo", "commerce"],
      "required_facts": ["product_identity", "usage_action", "claim_boundary", "proof_point"],
      "compiler_instruction": "商品身份、材质、使用动作、可见卖点和主张边界必须来自确认资料。用真实手部接触和物理反馈展示，不编造价格、功效或购买信息。",
      "lint_tags": ["product_anchor", "claim_boundary"],
      "qa_checks": ["商品未变形替换", "动作真实", "卖点可见", "无未经授权主张"]
    },
    {
      "id": "story_insert",
      "lesson_ref": "第六十节：用空镜讲故事",
      "name_zh": "空镜与信息性插入",
      "applies_to": ["insert", "transition"],
