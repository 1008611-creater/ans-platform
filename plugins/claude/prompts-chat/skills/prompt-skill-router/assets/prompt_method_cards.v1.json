      "applies_to": ["emotion", "dialogue", "reaction"],
      "required_facts": ["emotion_baseline", "emotion_change", "gaze_or_face_action"],
      "compiler_instruction": "先写当前情绪基线，再写触发后的眼神、呼吸、嘴角、下颌、手指或肩部微变化。不能用抽象情绪词替代可见反应。",
      "lint_tags": ["emotion_anchor", "micro_reaction"],
      "qa_checks": ["表情与剧情事实一致", "没有反向情绪", "微反应清晰但不过度"]
    },
    {
      "id": "dialogue_voice_timing",
      "lesson_ref": "Voice is structured performance",
      "name_zh": "台词、声音与停顿",
      "applies_to": ["dialogue", "voice"],
      "required_facts": ["speaker", "dialogue_visibility", "voice_duty", "timing"],
      "compiler_instruction": "可见台词、画外音和后期字幕必须分开。需要原生声音时说明年龄感、音色、语速、情绪、重音和停顿；不支持时保留后期声音职责。",
      "lint_tags": ["speaker_binding", "audio_boundary"],
      "qa_checks": ["说话人正确", "非可见台词未变成画面人物", "字幕未提前烤入首帧"]
    },
    {
      "id": "continuity_handoff",
      "lesson_ref": "Long-video continuity is designed before generation",
      "name_zh": "首尾帧与连续镜头承接",
      "applies_to": ["continuity", "video"],
      "required_facts": ["continuity_in", "continuity_out", "immutable_anchor", "next_shot_link"],
      "compiler_instruction": "锁定进入镜头的外观、空间和动作起点；把动作完成点或可用尾帧交给下一镜头。静态尾帧只锚定外观，不代表速度或镜头运动连续。",
      "lint_tags": ["continuity_in", "continuity_out"],
      "qa_checks": ["身份/服装/道具连续", "空间连续", "尾帧未被误当动作证明"]
