      "id": "asset_identity",
      "lesson_ref": "Character design uses identity plus state",
      "name_zh": "身份与状态分离",
      "applies_to": ["character", "first_frame", "video"],
      "required_facts": ["identity", "age_or_state", "wardrobe_or_material"],
      "compiler_instruction": "把稳定身份与当前剧情状态分开写：脸部结构、年龄感、发型和身份归属保持稳定；服装、磨损、姿态和情绪体现当前状态。",
      "lint_tags": ["identity_anchor", "wardrobe_state"],
