      "applies_to": ["video", "emotion", "product_demo"],
      "required_facts": ["primary_action", "action_path", "secondary_response", "micro_reaction"],
      "compiler_instruction": "短镜头只保留一个主动作，并写出身体路径、衣发或道具的次级反应、微表情和环境/声音变化的顺序。",
      "lint_tags": ["primary_action", "temporal_order"],
      "qa_checks": ["动作符合要求", "没有无关多动作", "次级物理反应自然", "动作有开始和结束"]
    },
    {
      "id": "emotion_microreaction",
      "lesson_ref": "Motion is layered visible change",
