      "applies_to": ["scene", "dialogue", "continuity"],
      "required_facts": ["location", "landmarks", "subject_positions", "camera_side"],
      "compiler_instruction": "先锁定房间稳定地标、人物相对位置和镜头所在侧，再写构图。屏幕、镜子和文件只能出现在摄影机实际可见的方向。",
      "lint_tags": ["space_anchor", "screen_physics"],
      "qa_checks": ["地理关系稳定", "屏幕方向物理正确", "人物左右位置未反转"]
