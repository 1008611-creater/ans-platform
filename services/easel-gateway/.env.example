# Keep the real file outside Git and mode 0600. No ANS/provider secrets belong in worker containers.
EASEL_PUBLIC_ORIGIN=https://easel.cauai.fun
EASEL_OIDC_ISSUER=https://ans.cauai.fun
EASEL_OIDC_CLIENT_ID=ans-easel
EASEL_OIDC_CLIENT_SECRET=
# Separate, stable 32-byte random keys encoded as base64url (43 characters).
EASEL_COOKIE_KEY=
EASEL_TENANT_KEY=
EASEL_NAMESPACE=ans-easel
EASEL_WORKER_IMAGE=ans-easel-worker:bb3c8ff
EASEL_EGRESS_IMAGE=ans-easel-egress:1
EASEL_MAX_ACTIVE=4
EASEL_MAX_USERS=30
EASEL_IDLE_SECONDS=10800
EASEL_GATEWAY_PORT=7871

# Root-owned immutable frontend built with --target frontend; never point this at a user volume.
EASEL_FRONTEND_DIR=/opt/ans-easel/frontend/bb3c8ff
