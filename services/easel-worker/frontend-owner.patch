diff --git a/web/frontend/src/lib/ans-owner.ts b/web/frontend/src/lib/ans-owner.ts
new file mode 100644
--- /dev/null
+++ b/web/frontend/src/lib/ans-owner.ts
@@ -0,0 +1,11 @@
+// Bind browser media requests to the account that originally opened this page.
+const owner = new URLSearchParams(window.location.search).get('ans_owner');
+export function privateMediaUrl(value: string): string {
+  if (!owner) return value;
+  const url = new URL(value, window.location.origin);
+  if (url.origin !== window.location.origin || !url.pathname.startsWith('/api/media/')) return value;
+  return '/ans/media/' + encodeURIComponent(owner) + '/' + url.pathname.slice('/api/media/'.length) + url.search + url.hash;
+}
+export function mediaPrefix(value: string): string | null {
+  return value.match(/^\/ans\/media\/[^/]+\//)?.[0] ?? (value.startsWith('/api/media/') ? '/api/media/' : null);
+}
