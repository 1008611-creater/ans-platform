;box-shadow:4px 4px 0 #111;padding:10px\">\n          <div style=\"height:56px;background:#ee4266;border:2px solid #111;position:relative;overflow:hidden\"><i style=\"position:absolute;top:8px;left:10px;font-size:14px;font-weight:800;color:#fff;font-style:normal\">+</i><i style=\"position:absolute;bottom:10px;right:12px;width:14px;height:14px;background:#ffd23f;border:2px solid #111;transform:rotate(45deg)\"></i></div>\n          <div style=\"font-size:12px;font-weight:800;color:#111;margin-top:8px\">Geometric Badge Set</div>\n          <div style=\"font-size:12px;color:#ee4266;font-weight:800;margin-top:2px\">¥39</div>\n        </div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"style-memphis-anat\">\n      <span class=\"ap\" data-ap=\"geo\"><span class=\"style-memphis-sw\"><span style=\"display:inline-flex;align-items:center;gap:6px\"><i style=\"width:14px;height:14px;border-radius:50%;background:#ffd23f;border:2px solid #111;background-image:radial-gradient(#111 1.2px,transparent 1.4px);background-size:6px 6px\"></i><i style=\"width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-bottom:14px solid #3d5af1\"></i><i style=\"width:20px;height:9px;background:url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='20' height='9'><path d='M2 5 Q 5 1, 8 5 T 14 5 T 20 5' fill='none' stroke='%23ee4266' stroke-width='3'/></svg>&quot;) center/contain no-repeat\"></i></span></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"clash\"><span class=\"style-memphis-sw\"><span style=\"display:inline-flex;gap:3px\"><i style=\"width:13px;height:13px;background:#ffd23f;border:2px solid #111\"></i><i style=\"width:13px;height:13px;background:#3d5af1;border:2px solid #111\"></i><i style=\"width:13px;height:13px;background:#ee4266;border:2px solid #111\"></i><i style=\"width:13px;height:13px;background:#22c1a3;border:2px solid #111\"></i></span></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"stroke\"><span class=\"style-memphis-sw\"><span style=\"width:20px;height:20px;border-radius:50%;background:#ee4266;border:3px solid #111\"></span></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"scatter\"><span class=\"style-memphis-sw\" style=\"position:relative\"><i style=\"position:absolute;top:5px;left:7px;width:8px;height:8px;border-radius:50%;background:#ffd23f;border:2px solid #111\"></i><i style=\"position:absolute;bottom:6px;right:8px;font-size:13px;font-weight:800;color:#111;font-style:normal\">+</i><i style=\"position:absolute;bottom:8px;left:14px;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:10px solid #3d5af1\"></i></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"white\"><span class=\"style-memphis-sw\" style=\"background:#fff8ef\"></span></span>\n    </span>","demo_en":"<span class=\"style-memphis-anat\">\n      <span class=\"ap\" data-ap=\"geo\"><span class=\"style-memphis-sw\"><span style=\"display:inline-flex;align-items:center;gap:6px\"><i style=\"width:14px;height:14px;border-radius:50%;background:#ffd23f;border:2px solid #111;background-image:radial-gradient(#111 1.2px,transparent 1.4px);background-size:6px 6px\"></i><i style=\"width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-bottom:14px solid #3d5af1\"></i><i style=\"width:20px;height:9px;background:url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='20' height='9'><path d='M2 5 Q 5 1, 8 5 T 14 5 T 20 5' fill='none' stroke='%23ee4266' stroke-width='3'/></svg>&quot;) center/contain no-repeat\"></i></span></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"clash\"><span class=\"style-memphis-sw\"><span style=\"display:inline-flex;gap:3px\"><i style=\"width:13px;height:13px;background:#ffd23f;border:2px solid #111\"></i><i style=\"width:13px;height:13px;background:#3d5af1;border:2px solid #111\"></i><i style=\"width:13px;height:13px;background:#ee4266;border:2px solid #111\"></i><i style=\"width:13px;height:13px;background:#22c1a3;border:2px solid #111\"></i></span></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"stroke\"><span class=\"style-memphis-sw\"><span style=\"width:20px;height:20px;border-radius:50%;background:#ee4266;border:3px solid #111\"></span></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"scatter\"><span class=\"style-memphis-sw\" style=\"position:relative\"><i style=\"position:absolute;top:5px;left:7px;width:8px;height:8px;border-radius:50%;background:#ffd23f;border:2px solid #111\"></i><i style=\"position:absolute;bottom:6px;right:8px;font-size:13px;font-weight:800;color:#111;font-style:normal\">+</i><i style=\"position:absolute;bottom:8px;left:14px;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:10px solid #3d5af1\"></i></span></span><span class=\"style-memphis-anat-plus\">+</span>\n      <span class=\"ap\" data-ap=\"white\"><span class=\"style-memphis-sw\" style=\"background:#fff8ef\"></span></span>\n    </span>","parts":[{"key":"geo","cn":"几何图案","en":"Geometry","desc":"选择少量形状反复变化，建立统一的装饰语言","desc_en":"Repeat a small set of geometric shapes to create a coherent decorative vocabulary."},{"key":"clash","cn":"撞色","en":"Color Clash","desc":"用有主次的对比色制造活力，并检查文字和状态的可辨认度","desc_en":"Use primary and secondary contrasting colors for energy, while preserving readable text and status cues."},{"key":"stroke","cn":"描边","en":"Outline","desc":"深色描边可帮助小元素从背景中分离，颜色和粗细按主题调整","desc_en":"Dark outlines help small shapes separate from the background; tune their color and weight to the visual system."},{"key":"scatter","cn":"散布构图","en":"Scatter","desc":"将小元素安排在边缘与留白处，保留正文和操作所需的空间","desc_en":"Place small motifs along edges and in margins, leaving room for content and actions."},{"key":"white","cn":"留白","en":"Breathing Room","desc":"用空白分开内容和装饰，让高对比元素有明确的阅读位置","desc_en":"Use whitespace to separate content from decoration so high-contrast elements do not disrupt reading."}]},"use":[{"t":"运营和促销活动，需要活跃节奏与识别度","m":"style-memphis-use-campaign"},{"t":"儿童与教育产品，并经过真实用户验证","m":"style-memphis-use-kids"},{"t":"创意机构和招聘页，把页面作为作品展示","m":"style-memphis-use-hiring"},{"t":"空状态和插图区域，用小面积图形增加节奏","m":"style-memphis-use-empty"}],"dont":[{"t":"高频后台系统整页持续使用撞色装饰","m":"style-memphis-dont-full","bad":true},{"t":"波点和图形覆盖正文与操作区域","m":"style-memphis-dont-text","bad":true},{"t":"柔和配色仍机械搭配强黑边，语言不一致","m":"style-memphis-dont-pastel","bad":true},{"t":"年报和合同的关键信息被装饰抢走","m":"style-memphis-dont-serious","bad":true}],"principles":[{"t":"选择少量几何图案反复使用，形成统一装饰语言","m":"style-memphis-geo"},{"t":"活跃配色仍要区分主色、强调色和状态色","m":"style-memphis-clash"},{"t":"用描边或色块对比让装饰从背景中分离","m":"style-memphis-stroke"},{"t":"把装饰放在留白和独立图层，避免挡住操作","m":"style-memphis-scatter"},{"t":"保留足够空白，让不对称构图仍然可以阅读","m":"style-memphis-white"}],"history":[{"year":"1981","title":"Memphis Group 在米兰成立","desc":"Ettore Sottsass 与设计师伙伴在米兰组建 Memphis Group；名称取自鲍勃·迪伦歌曲《Stuck Inside of Mobile with the Memphis Blues Again》。","year_en":"1981","title_en":"The Memphis Group forms in Milan","desc_en":"Ettore Sottsass and a group of young designers took their name from a Bob Dylan song playing during an early meeting."},{"year":"1981—1987","title":"以强烈形式语言形成辨识度","desc":"塑料贴面、明亮配色和几何图案成为小组的常见表达，并与当时主流现代主义设计形成对照。","year_en":"1981–1987","title_en":"The group challenges accepted good taste","desc_en":"Plastic laminate, contrasting color, and geometric pattern confronted the restrained rules of modernist design."},{"year":"1987","title":"小组解散，视觉语言继续传播","desc":"Memphis Group 在 1987 年解散；其色彩与几何语言随后出现在音乐电视、零售空间与流行文化视觉中。","year_en":"1987","title_en":"The group ends, but the style spreads","desc_en":"After the group dissolved, its visual language continued through 1980s television, retail, music, and youth culture."},{"year":"2010s","title":"数字视觉中的再应用","desc":"活动页面、插画和品牌传播中再次出现孟菲斯式几何与配色，并与当代界面结构结合。","year_en":"2010s","title_en":"The internet rediscovers Memphis","desc_en":"As flat-design sameness grew tiring, Memphis shapes returned in campaign pages and illustration systems."},{"year":"今天","title":"用于表达活力与节奏","desc":"活动、儿童产品和创意品牌等页面可借助波点、波浪线和不对称构图强化气氛，同时保持信息清楚。","year_en":"Today","title_en":"The style remains common in campaigns","desc_en":"Dots, squiggles, and geometric shapes still appear in promotions, children's products, and creative brand sites."}],"prompt":"做一个陶艺工作坊预约页。用活泼的几何装饰和有主次的色彩表达活动气氛，同时让日期、时段、名额、价格和预约按钮容易找到。预约信息只用我提供的资料，缺少的先标“待补充”，不要自行生成。","prompt_en":"Memphis creative-workshop booking page, waves, dots, triangles, high-saturation yellow, blue, pink and green, heavy black outlines, warm off-white space, clear date, remaining seats, price and booking action","scenes":["创意工作坊预约","大促活动页","儿童教育 App 首页","创意招聘页","品牌周边商城页"],"en":{"prompt":"Memphis creative-workshop booking page, waves, dots, triangles, high-saturation yellow, blue, pink and green, heavy black outlines, warm off-white space, clear date, remaining seats, price and booking action","use":[{"t":"Campaign and promotion page","m":"style-memphis-use-campaign"},{"t":"Children's or education product after user testing","m":"style-memphis-use-kids"},{"t":"Creative studio and recruitment page","m":"style-memphis-use-hiring"},{"t":"Illustration or empty-state area","m":"style-memphis-use-empty"}],"dont":[{"t":"Cover dense work interfaces in constant pattern","m":"style-memphis-dont-full","bad":true},{"t":"Place dots and shapes over reading or click targets","m":"style-memphis-dont-text","bad":true},{"t":"Mix a soft palette with heavy outlines without a reason","m":"style-memphis-dont-pastel","bad":true},{"t":"Let decoration overpower reports, contracts, or key facts","m":"style-memphis-dont-serious","bad":true}],"principles":[{"t":"Build