3%,#ffdd00 66%,#90e8ff 66%)\"></i>高饱和撞色</span></span>\n      <span class=\"ap\" data-ap=\"type\"><span class=\"style-brutalism-chip\"><b style=\"font-size:14px;font-weight:900;color:#000\">Aa</b>900 粗黑标题</span></span>\n      <span class=\"ap\" data-ap=\"press\"><span class=\"style-brutalism-chip\"><i style=\"background:#ff90e8;border:2.5px solid #000;box-shadow:2px 2px 0 #000\"></i>按压位移</span></span>\n    </span>","demo_en":"<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"border\"><span class=\"style-brutalism-chip\"><i style=\"background:#fff;border:3px solid #000;border-radius:3px\"></i>Solid black stroke 2-3px</span></span>\n      <span class=\"ap\" data-ap=\"shadow\"><span class=\"style-brutalism-chip\"><i style=\"background:#fff;border:2.5px solid #000;box-shadow:4px 4px 0 #000\"></i>hard shadow</span></span>\n      <span class=\"ap\" data-ap=\"color\"><span class=\"style-brutalism-chip\"><i style=\"background:linear-gradient(90deg,#ff90e8 33%,#ffdd00 33%,#ffdd00 66%,#90e8ff 66%)\"></i>Highly saturated contrasting colors</span></span>\n      <span class=\"ap\" data-ap=\"type\"><span class=\"style-brutalism-chip\"><b style=\"font-size:14px;font-weight:900;color:#000\">Aa</b>900 bold black title</span></span>\n      <span class=\"ap\" data-ap=\"press\"><span class=\"style-brutalism-chip\"><i style=\"background:#ff90e8;border:2.5px solid #000;box-shadow:2px 2px 0 #000\"></i>Press displacement</span></span>\n    </span>","parts":[{"key":"border","cn":"粗描边","en":"Border","desc":"用统一尺度建立剪纸般轮廓，颜色和粗细按主题与组件尺寸调整","desc_en":"Create paper-cut outlines with uniform scale, and adjust color and thickness according to theme and component size"},{"key":"shadow","cn":"硬阴影","en":"Hard Shadow","desc":"无模糊纯色位移形成拼贴感，偏移量按空间和控件大小设定","desc_en":"Non-blurred solid color displacement creates a collage feel, and the offset is set according to space and control size."},{"key":"color","cn":"高对比配色","en":"Colors","desc":"示例用荧光粉、明黄和亮蓝；实际色板要有主次并通过对比测试","desc_en":"Examples use fluorescent powder, bright yellow and bright blue; the actual color palette must have primary and secondary colors and pass comparison tests"},{"key":"type","cn":"海报式大字","en":"Type","desc":"大号粗体建立视觉态度，中英文需要分别处理字重、字距和换行","desc_en":"Large bold fonts establish visual attitude. Chinese and English need to deal with font weight, font spacing and line breaks separately."},{"key":"press","cn":"按压位移","en":"Press","desc":"悬停、焦点和按下状态都要提供反馈，不能只照顾鼠标","desc_en":"Feedback must be provided on hover, focus and pressed states, not just the mouse."}]},"use":[{"t":"独立产品官网，需要鲜明而直接的品牌态度","m":"style-brutalism-use-indie"},{"t":"数字商品页面，用高对比突出内容和价格","m":"style-brutalism-use-gumroad"},{"t":"活动和黑客松页面，需要较强参与感","m":"style-brutalism-use-event"},{"t":"局部表达反精致方向，建立视觉辨识度","m":"style-brutalism-use-attitude"}],"dont":[{"t":"金融和医疗核心流程只追求视觉冲击","m":"style-brutalism-dont-finance","bad":true},{"t":"企业工具把每个区域都做成高强度海报","m":"style-brutalism-dont-saas","bad":true},{"t":"正式办事页面让装饰压过信息和操作","m":"style-brutalism-dont-gov","bad":true},{"t":"全站持续使用撞色，造成长期视觉疲劳","m":"style-brutalism-dont-tire","bad":true}],"principles":[{"t":"<b>粗描边建立直接轮廓</b>：按钮、卡片和输入框可以共用同一尺度，粗细按尺寸与主题调整","m":"style-brutalism-border"},{"t":"<b>无模糊硬阴影</b>：用纯色位移制造拼贴感，偏移量不应盖住相邻内容","m":"style-brutalism-shadow"},{"t":"<b>高对比配色有主次</b>：荧光色是常见示例，也可以用低饱和色；文字对比和状态含义仍要清楚","m":"style-brutalism-color"},{"t":"<b>大号粗体承担海报感</b>：字重和紧排需要根据字体能力、中英文和换行测试","m":"style-brutalism-type"},{"t":"<b>交互状态覆盖鼠标、键盘和触屏</b>：悬停可移动阴影，按下与焦点也要有明确反馈","m":"style-brutalism-press"}],"prompt":"做一个创作者经营后台，突出本周收入、订单和发布新商品。可以用直接、有冲击力的边界和色彩表达个性，但数字、状态和主要操作必须便于快速扫描。只读取项目现有数据，尚未接入的指标显示“待接入”，不要编造收入或订单。","prompt_en":"Neo-brutalist creator dashboard, clear income and order hierarchy, 2–3px black borders, hard offset shadows with no blur, yellow base with limited pink and blue status accents, extreme 800/400 type-weight contrast","references":[{"title":"粗野主义与反设计","source":"NN/g","url":"https://www.nngroup.com/articles/brutalism-antidesign/","title_en":"Brutalism and Antidesign"}],"scenes":["创作者经营工作台","独立产品发布工具","黑客松活动管理","创作者个人商店"],"en":{"prompt":"Neo-brutalist creator dashboard, clear income and order hierarchy, 2–3px black borders, hard offset shadows with no blur, yellow base with limited pink and blue status accents, extreme 800/400 type-weight contrast","use":[{"t":"Creative studio or portfolio","m":"style-brutalism-use-indie"},{"t":"Youth, culture, and event campaigns","m":"style-brutalism-use-gumroad"},{"t":"A product with a direct, playful voice","m":"style-brutalism-use-event"},{"t":"Small sites that benefit from strong identity","m":"style-brutalism-use-attitude"}],"dont":[{"t":"Use constant visual shouting in a dense work tool","m":"style-brutalism-dont-finance","bad":true},{"t":"Sacrifice reading and focus states for attitude","m":"style-brutalism-dont-saas","bad":true},{"t":"Mix many unrelated colors, borders, and shadows","m":"style-brutalism-dont-gov","bad":true},{"t":"Imitate roughness without a consistent layout","m":"style-brutalism-dont-tire","bad":true}],"principles":[{"t":"Make the structure and interaction obvious","m":"style-brutalism-border"},{"t":"Use strong type and borders with a clear hierarchy","m":"style-brutalism-shadow"},{"t":"Choose a limited high-contrast palette","m":"style-brutalism-color"},{"t":"Let hard shadows describe layers consistently","m":"style-brutalism-type"},{"t":"Keep intentional irregularity separate from accidental disorder","m":"style-brutalism-press"}],"scenes":["Creative agency","Event page","Portfolio","Culture brand"],"sceneUI":["<div style=\"max-width:620px;margin:0 auto;padding:12px;background-color:#ffc62d;background-image:radial-gradient(#5f521d 1px,transparent 1.2px);background-size:14px 14px;color:#050505;font-family:ui-monospace,Menlo,monospace\">\n      <div style=\"background:#fff8ee;border:3px solid #050505;box-shadow:6px 6px 0 #050505\">\n        <div style=\"height:38px;display:flex;align-items:center;gap:8px;padding:0 11px;border-bottom:3px solid #050505\">\n        