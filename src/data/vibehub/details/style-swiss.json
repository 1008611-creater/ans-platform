pan class=\"style-swiss-chip\"><b style=\"font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:700;color:#000;letter-spacing:-.5px\">Aa</b>无衬线大字</span></span>\n      <span class=\"ap\" data-ap=\"red\"><span class=\"style-swiss-chip\"><i style=\"background:#e30613\"></i>强调色示例</span></span>\n      <span class=\"ap\" data-ap=\"scale\"><span class=\"style-swiss-chip\"><b style=\"font-size:15px;color:#000\">大</b><span style=\"font-size:12px;color:#999\">/小</span></span></span>\n      <span class=\"ap\" data-ap=\"space\"><span class=\"style-swiss-chip\"><i style=\"background:#fff;border:1px dashed #d9d9d9\"></i>大量留白</span></span>\n    </span>","demo_en":"<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"grid\"><span class=\"style-swiss-chip\"><i style=\"background:repeating-linear-gradient(90deg,#e3e3e3 0 1px,#fff 1px 5px);border-color:#e3e3e3\"></i>strict grid</span></span>\n      <span class=\"ap\" data-ap=\"type\"><span class=\"style-swiss-chip\"><b style=\"font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:700;color:#000;letter-spacing:-.5px\">Aa</b>Sans-serif display type</span></span>\n      <span class=\"ap\" data-ap=\"red\"><span class=\"style-swiss-chip\"><i style=\"background:#e30613\"></i>Accent color examples</span></span>\n      <span class=\"ap\" data-ap=\"scale\"><span class=\"style-swiss-chip\"><b style=\"font-size:15px;color:#000\">Large</b><span style=\"font-size:12px;color:#999\">/Small</span></span></span>\n      <span class=\"ap\" data-ap=\"space\"><span class=\"style-swiss-chip\"><i style=\"background:#fff;border:1px dashed #d9d9d9\"></i>Generous whitespace</span></span>\n    </span>","parts":[{"key":"grid","cn":"明确网格","en":"Grid","desc":"以栏线组织对齐与间距，为页面建立稳定结构","desc_en":"Use a grid to organize alignment and spacing into a clear page structure."},{"key":"type","cn":"无衬线大字","en":"Type","desc":"用清楚的字号和字重建立层级；对齐方式按内容、语言和版面关系决定","desc_en":"Build hierarchy with deliberate type size and weight; align content according to language and layout relationships."},{"key":"red","cn":"强调色","en":"Accent","desc":"强调色可标记关键信息或操作；颜色与数量由品牌和内容层级决定","desc_en":"Use accent color for key information or actions, with its scope set by the brand and content hierarchy."},{"key":"scale","cn":"字号层级","en":"Scale","desc":"用足够的字号与字重差异区分阅读层级，同时保证注释可读","desc_en":"Create distinct reading levels with clear size and weight contrast while keeping supporting text legible."},{"key":"space","cn":"大量留白","en":"Whitespace","desc":"空白不是没设计，是把注意力留给内容","desc_en":"Whitespace is an active part of the composition: it gives content room to breathe."}]},"use":[{"t":"作品集和设计机构官网，用排版本身展示能力","m":"style-swiss-use-portfolio"},{"t":"海报式活动页，需要直接而清楚的信息层级","m":"style-swiss-use-poster"},{"t":"年报和展览页面，需要编号与图文对齐","m":"style-swiss-use-report"},{"t":"素材较少时，依靠文字和网格建立画面","m":"style-swiss-use-text"}],"dont":[{"t":"电商促销只剩冷静网格，缺少商品重点","m":"style-swiss-dont-promo","bad":true},{"t":"需要亲和力时仍只使用冷硬黑白表达","m":"style-swiss-dont-cute","bad":true},{"t":"社交产品把秩序做成明显的距离感","m":"style-swiss-dont-social","bad":true},{"t":"内容没有先编辑，希望仅靠网格解决混乱","m":"style-swiss-dont-messy","bad":true}],"principles":[{"t":"<b>网格是骨架</b>：让标题、正文、图片和注释共享清楚的对齐关系，必要时可以跨栏","m":"style-swiss-grid"},{"t":"<b>无衬线标题强化信息</b>：左对齐最常见，但对齐方式应服务版面和阅读方向","m":"style-swiss-type"},{"t":"<b>强调色承担明确职责</b>：经典红色只是示例，可以换成品牌色并保持使用范围克制","m":"style-swiss-red"},{"t":"<b>字号对比建立层级</b>：标题可以很大，但注释不能小到不可读","m":"style-swiss-scale"},{"t":"<b>装饰服从信息</b>：阴影、渐变或圆角并非禁止，只是不应掩盖内容结构","m":"style-swiss-plain"}],"prompt":"为一个当代艺术展做信息页。先用网格安排展名、日期、地点、导览说明和购票入口，再决定标题对齐和强调色。展览信息只使用现有资料，缺少的先标“待补充”，不要自行生成日期、地点或票务信息。","prompt_en":"Swiss International Style, strict grid, huge left-aligned sans-serif headline, black and white with one red accent, extreme type-scale contrast, no decorative shadows, generous structured whitespace","scenes":["文化展览日程与购票","设计机构官网","瑞士风年报封面","作品集索引页"],"en":{"prompt":"Swiss International Style, strict grid, huge left-aligned sans-serif headline, black and white w