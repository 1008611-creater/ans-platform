px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1;font-family:monospace\">app.vibeui.dev</span>\n        <span style=\"font-size:12px;color:var(--text-2)\">Online editor</span>\n        <span class=\"demo-tag green\">Online</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1;font-family:monospace\">blog.vibeui.dev</span>\n        <span style=\"font-size:12px;color:var(--text-2)\">Update log and tutorial</span>\n        <span class=\"demo-tag gray\">Under planning</span>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"dom-anat\"><span class=\"ap\" data-ap=\"sub\"><span class=\"dom-seg sub\">app</span></span><span class=\"dom-dot\">.</span><span class=\"ap\" data-ap=\"root\"><span class=\"dom-seg root\">vibeui</span></span><span class=\"dom-dot\">.</span><span class=\"ap\" data-ap=\"tld\"><span class=\"dom-seg tld\">dev</span></span></span>","demo_en":"<span class=\"dom-anat\"><span class=\"ap\" data-ap=\"sub\"><span class=\"dom-seg sub\">app</span></span><span class=\"dom-dot\">.</span><span class=\"ap\" data-ap=\"root\"><span class=\"dom-seg root\">vibeui</span></span><span class=\"dom-dot\">.</span><span class=\"ap\" data-ap=\"tld\"><span class=\"dom-seg tld\">dev</span></span></span>","parts":[{"key":"sub","cn":"子域名","en":"Subdomain","desc":"在已注册域名下配置的前缀，例如 app、blog、docs，用于区分不同服务","desc_en":"The prefix configured under the registered domain name, such as app, blog, docs, is used to distinguish different services"},{"key":"root","cn":"可注册域名","en":"Registrable Domain","desc":"注册规则决定可注册的名称层级；例如 vibeui.dev 常可注册，具体层级随后缀而变","desc_en":"Registry rules determine which level can be registered. For example, vibeui.dev may be registrable at that level, depending on the suffix."},{"key":"tld","cn":"顶级后缀","en":"Top-level Domain","desc":".com、.dev、.cn 等域名末尾部分；注册政策、价格和受众熟悉度会随后缀变化","desc_en":"The final part of domain names such as .com, .dev, .cn, etc.; registration policies, prices and audience familiarity will change after the suffix."}]},"variants":[{"cn":".com","en":"Commercial","demo":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.com</span></span>","demo_en":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.com</span></span>","when":"受众熟悉度高，但仍要结合名称可用性和品牌选择","when_en":"Audience familiarity is high, but still combined with name availability and brand choice"},{"cn":".dev / .app","en":"Dev & App","demo":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.dev</span></span>","demo_en":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.dev</span></span>","when":"常用于技术与应用产品；浏览器按 HSTS 使用 HTTPS，部署前需配置证书","when_en":"Commonly used in technology and application products; use HTTPS. Configure a valid certificate before deployment, and enable HSTS only after HTTPS is working correctly."},{"cn":".cn","en":"China","demo":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.cn</span></span>","demo_en":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.cn</span></span>","when":"面向中文用户时可评估；注册与上线要求需按注册商和托管地区核对","when_en":"It can be evaluated when targeting Chinese users; registration and online requirements need to be checked according to the registrar and hosting region."},{"cn":".ai / .io","en":"AI & IO","demo":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.ai</span></span>","demo_en":"<span style=\"font-family:monospace;font-size:13px;font-weight:600\">vibeui<span style=\"color:var(--brand)\">.ai</span></span>","when":"常见于 AI 与工具产品；购买前比较首年价、续费价和转入转出规则","when_en":"Commonly found in AI and tool products; compare first-year price, renewal price and transfer-in and transfer-out rules before purchasing"}],"use":[{"t":"先在注册商<b>查询可注册状态</b>，并检查商标与名称混淆风险后再购买","m":"dom-search"},{"t":"优先选择<b>简短、好读、好拼</b>的名称，减少口头传达和手动输入错误","m":"dom-good"},{"t":"用<b>子域名</b>分业务：app. 放应用、blog. 放博客，不用再买新域名","m":"dom-sub"},{"t":"先<b>部署网页</b>，再按托管平台说明配置 {c:dns}，让域名连接到对应服务","m":"dom-point"}],"dont":[{"t":"以为<b>买了域名就会出现网站</b>：还需部署网页并用 DNS 连接托管服务；否则可能看到 DNS 错误或注册商停放页，而不是自己的页面","m":"dom-name-only","bad":true},{"t":"名称包含过多<b>缩写、数字和连字符</b>，会增加记忆、输入与口头传达错误","m":"dom-ugly","bad":true},{"t":"<b>忘记续费</b>：过期后的宽限、赎回和删除流程由注册局与注册商决定，可能产生额外费用或被他人注册","m":"dom-expire","bad":true},{"t":"只看<b>首年低价</b>选择后缀，却忽略续费价格、受众熟悉度、平台限制与后缀声誉","m":"dom-tld","bad":true}],"lessonPractice":{"title":"已经买下 example.com，但打开后仍看不到刚做好的网站。下一步应该确认什么？","options":[{"id":"host-only","label":"只在托管平台添加 example.com，不检查域名当前 DNS","feedback":"托管平台知道域名还不够；DNS 仍可能指向注册商停放页，访问者不会到达新网站。","correct":false},{"id":"deploy-and-connect","label":"确认网站已部署，再按托管说明配置 DNS 指向","feedback":"域名只是名称；还需要可访问的网站服务，并通过 DNS 把名称连接到该服务。","correct":true},{"id":"redirect-temporary","label":"把域名转发到临时地址，让浏览器跳走后再显示网站","feedback":"转发可能打开网站，却不会让正式域名直接承载页面；地址会变化，也绕过了正常绑定。","correct":false}],"en":{"title":"You bought example.com, but opening it still does not show the website you built. What should be confirmed next?","options":[{"id":"host-only","label":"Add example.com at the hosting platform but do not inspect its current DNS","feedback":"The host may know the domain while DNS still points visitors to the registrar's parking page.","correct":false},{"id":"deploy-and-connect","label":"Confirm the site is deployed, then point DNS according to the host's instructions","feedback":"A domain is only a name. A reachable host must serve the site, and DNS must connect the name to that service.","correct":true},{"id":"redirect-temporary","label":"Forward the domain to a temporary address and let the browser navigate away","feedback":"A redirect may open the site but changes the visible address and does not properly bind the custom domain.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请检查 example.com 为什么还没打开正式网站：先确认站点已部署，再核对托管平台的域名绑定和要求的 DNS 记录。不要改动无关记录或只做网址转发。完成后验证 example.com 和 HTTPS 都正常。","en":{"title":"You can say this to an AI Agent","text":"Find why example.com does not open the production site: confirm deployment, then check the host's domain binding and required DNS records. Do not change unrelated records or rely on URL forwarding. Verify example.com and HTTPS afterward."}},"references":[{"title":"什么是域名？","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Howto/Web_mechanics/What_is_a_domain_name","title_en":"What is a Domain Name?"}],"scenes":["注册商搜索下单","域名管理与续费","托管平台绑定域名","子域名规划"],"en":{"use":[{"t":"Publish a memorable website address","m":"dom-search"},{"t":"Create subdomains for different services","m":"dom-good"},{"t":"Use a branded email domain","m":"dom-sub"},{"t":"Point visitors to a deployed website","m":"dom-point"}],"dont":[{"t":"Assume buying a domain also creates the website","m":"dom-name-only","bad":true},{"t":"Forget renewal and account security","m":"dom-ugly","bad":true},{"t":"Change DNS records without knowing which service uses them","m":"dom-expire","bad":true},{"t":"Put secret information in a domain or subdomain name","m":"dom-tld","bad":true}],"scenes":["Company website","Product app","Documentation subdomain","Custom email"],"sceneUI":["<div class=\"domain-demo\">\n      <div class=\"domain-demo-query\">\n        <input class=\"demo-input\" value=\"vibeui\">\n        <button class=\"btn btn-primary\">Search domain name</button>\n      </div>\n      <div class=\"domain-demo-results\">\n        <div class=\"domain-demo-result\">\n          <b class=\"domain-demo-name\">vibeui.dev</b>\n          <span class=\"demo-tag green\">Registerable</span>\n          <span class=\"domain-demo-note\">Example quo