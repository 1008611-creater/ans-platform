{"__formatVersion":2,"__revision":"0d13b9e43308e51b","__entryId":"single-page-layout","entry":{"sceneUI":["<div style=\"border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n      <div style=\"text-align:center;padding:13px 16px 11px;background:linear-gradient(180deg,var(--brand-light),#fff)\">\n        <div style=\"font-size:13px;font-weight:700\">把会议录音整理成可编辑文稿</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin:4px 0 8px\">上传录音，得到逐字稿、结论和待办</div>\n        <button class=\"btn btn-primary\" style=\"padding:4px 12px;font-size:12px\">免费体验</button>\n      </div>\n      <div style=\"display:flex;gap:8px;padding:9px 14px\">\n        <div style=\"flex:1;text-align:center\"><div style=\"font-size:14px\">🎙️</div><div style=\"font-size:12px;font-weight:500\">实时转写</div><div style=\"font-size:12px;color:var(--text-3)\">准确率 98%</div></div>\n        <div style=\"flex:1;text-align:center\"><div style=\"font-size:14px\">🤖</div><div style=\"font-size:12px;font-weight:500\">智能摘要</div><div style=\"font-size:12px;color:var(--text-3)\">自动划重点</div></div>\n        <div style=\"flex:1;text-align:center\"><div style=\"font-size:14px\">📤</div><div style=\"font-size:12px;font-weight:500\">一键分享</div><div style=\"font-size:12px;color:var(--text-3)\">链接直接看</div></div>\n      </div>\n      <div style=\"background:var(--brand);color:var(--on-brand);display:flex;align-items:center;justify-content:center;gap:10px;padding:9px 14px\">\n        <span style=\"font-size:12px;font-weight:600\">已有 20 万团队在用</span>\n        <button class=\"btn\" style=\"background:var(--bg);color:var(--brand);padding:3px 12px;font-size:12px\">立即开始</button>\n      </div>\n    </div>","<div style=\"border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n      <div style=\"padding:11px 16px;background:var(--bg-soft)\">\n        <span class=\"demo-tag blue\" style=\"font-size:12px;pa