t-size:13px;font-weight:700\">Do difficult things with interesting people</div>\n        <div style=\"display:flex;gap:6px;justify-content:center;margin-top:7px\">\n          <span class=\"demo-tag gray\" style=\"font-size:12px;padding:1px 8px\">Remote friendly</span>\n          <span class=\"demo-tag gray\" style=\"font-size:12px;padding:1px 8px\">Option incentives</span>\n          <span class=\"demo-tag gray\" style=\"font-size:12px;padding:1px 8px\">Mac standard</span>\n        </div>\n      </div>\n      <div style=\"padding:0 16px 10px\">\n        <div style=\"display:flex;align-items:center;gap:8px;padding:7px 0;border-top:1px solid var(--border-light)\">\n          <div style=\"flex:1\"><div style=\"font-size:12px;font-weight:600\">Senior front-end engineer</div><div style=\"font-size:12px;color:var(--text-3)\">Beijing · Full-time · 30-50K</div></div>\n          <button class=\"btn btn-outline\" style=\"padding:3px 10px;font-size:12px\">Delivery</button>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;padding:7px 0;border-top:1px solid var(--border-light)\">\n          <div style=\"flex:1\"><div style=\"font-size:12px;font-weight:600\">AI Product Manager</div><div style=\"font-size:12px;color:var(--text-3)\">Shanghai · Full-time · 25-45K</div></div>\n          <button class=\"btn btn-outline\" style=\"padding:3px 10px;font-size:12px\">Delivery</button>\n        </div>\n      </div>\n    </div>","<div style=\"border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n      <div style=\"text-align:center;padding:13px 16px 9px\">\n        <img src=\"/assets/avatar-fox.png\" style=\"width:38px;height:38px;border-radius:50%;border:2px solid #fff;box-shadow:var(--shadow-card)\">\n        <div style=\"font-size:13px;font-weight:700;margin-top:5px\">Ali</div>\n        <div style=\"font-size:12px;color:var(--text-2)\">Independent developers · Use AI to make small and beautiful tools</div>\n      </div>\n      <div style=\"padding:0 16px 12px;display:flex;flex-direction:column;gap:6px;max-width:280px;margin:0 auto\">\n        <div style=\"display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid var(--border);border-radius:8px;padding:6px;font-size:12px;font-weight:500;color:var(--text)\">📝 My blog <span style=\"color:var(--text-3);font-weight:400\">· Weekly updates</span></div>\n        <div style=\"display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid var(--border);border-radius:8px;padding:6px;font-size:12px;font-weight:500;color:var(--text)\">🚀 Products in progress <span style=\"color:var(--text-3);font-weight:400\">· Miaojian App</span></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"single-wire single-anat\"><span class=\"ap\" data-ap=\"hero\"><span class=\"single-wire-screen hook\">核心价值</span></span><span class=\"ap\" data-ap=\"features\"><span class=\"single-wire-screen\">主要优势</span></span><span class=\"ap\" data-ap=\"proof\"><span class=\"single-wire-screen\">可信证据</span></span><span class=\"ap\" data-ap=\"cta\"><span class=\"single-wire-screen cta\">行动号召</span></span></span>","demo_en":"<span class=\"single-wire single-anat\"><span class=\"ap\" data-ap=\"hero\"><span class=\"single-wire-screen hook\">Core Value</span></span><span class=\"ap\" data-ap=\"features\"><span class=\"single-wire-screen\">Main Advantages</span></span><span class=\"ap\" data-ap=\"proof\"><span class=\"single-wire-screen\">Credible Evidence</span></span><span class=\"ap\" data-ap=\"cta\"><span class=\"single-wire-screen cta\">Call to Action</span></span></span>","parts":[{"key":"hero","cn":"核心价值","en":"Hero","desc":"说明产品面向谁、解决什么问题，并提供明确下一步","desc_en":"Explain who the product is for, what problem it solves, and provide clear next steps"},{"key":"features","cn":"主要优势","en":"Features","desc":"按用户任务组织关键能力，避免同级信息过多","desc_en":"Organize key capabilities by user tasks to avoid too much information at the same level"},{"key":"proof","cn":"可信证据","en":"Proof","desc":"使用已授权、可核验的案例、数据或评价支撑主张","desc_en":"Use authorized, verifiable cases, data or reviews to support claims"},{"key":"cta","cn":"行动号召","en":"CTA","desc":"在合适的阅读节点提供清楚的下一步入口","desc_en":"Provide clear next steps at appropriate reading points"}]},"variants":[{"cn":"锚点导航","en":"Anchors","demo":"<span style=\"display:flex;gap:5px;align-items:stretch\"><span class=\"single-wire\" style=\"width:74px\"><span class=\"single-wire-screen hook\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen cta\" style=\"height:14px\"></span></span><span style=\"display:flex;flex-direction:column;gap:3px;justify-content:center\"><i style=\"width:18px;height:4px;border-radius:2px;background:var(--brand)\"></i><i style=\"width:18px;height:4px;border-radius:2px;background:var(--bg-hover)\"></i><i style=\"width:18px;height:4px;border-radius:2px;background:var(--bg-hover)\"></i></span></span>","demo_en":"<span style=\"display:flex;gap:5px;align-items:stretch\"><span class=\"single-wire\" style=\"width:74px\"><span class=\"single-wire-screen hook\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen cta\" style=\"height:14px\"></span></span><span style=\"display:flex;flex-direction:column;gap:3px;justify-content:center\"><i style=\"width:18px;height:4px;border-radius:2px;background:var(--brand)\"></i><i style=\"width:18px;height:4px;border-radius:2px;background:var(--bg-hover)\"></i><i style=\"width:18px;height:4px;border-radius:2px;background:var(--bg-hover)\"></i></span></span>","when":"段落多，需要随时跳转","when_en":"There are many paragraphs and you need to jump at any time"},{"cn":"纯滚动","en":"Pure Scroll","demo":"<span class=\"single-wire\" style=\"width:74px\"><span class=\"single-wire-screen hook\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen cta\" style=\"height:14px\"></span></span>","demo_en":"<span class=\"single-wire\" style=\"width:74px\"><span class=\"single-wire-screen hook\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen cta\" style=\"height:14px\"></span></span>","when":"三四屏讲完的小落地页","when_en":"A small landing page finished in three or four screens"},{"cn":"带回到顶部","en":"BackTop","demo":"<span style=\"position:relative;display:inline-block\"><span class=\"single-wire\" style=\"width:74px\"><span class=\"single-wire-screen hook\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen cta\" style=\"height:14px\"></span></span><span style=\"position:absolute;right:-8px;bottom:6px;width:18px;height:18px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:12px;display:flex;align-items:center;justify-content:center\">↑</span></span>","demo_en":"<span style=\"position:relative;display:inline-block\"><span class=\"single-wire\" style=\"width:74px\"><span class=\"single-wire-screen hook\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen\" style=\"height:14px\"></span><span class=\"single-wire-screen cta\" style=\"height:14px\"></span></span><span style=\"position:absolute;right:-8px;bottom:6px;width:18px;height:18px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:12px;display:flex;align-items:center;justify-content:center\">↑</span></span>","when":"页面较长，需要提供返回顶部的快捷入口","when_en":"The page is long and a quick entry to return to the top needs to be provided."}],"use":[{"t":"<b>锚点导航</b>：钉在页边的分节目录，交给 {c:anchor}","m":"anchor-landing"},{"t":"<b>按信息关系划分章节</b>：每节承担清楚任务；章节高度由内容决定，不强求正好占满一屏","m":"single-screen"},{"t":"按照价值、主要优势、证据和行动组织完整阅读顺序","m":"single-story"},{"t":"<b>滚动跟随高亮</b>：读到哪一节，目录亮到哪","m":"anchor-active"}],"dont":[{"t":"长页面<b>缺少锚点和返回顶部</b>：提供 {c:back-top} 等导航路径","m":"single-endless","bad":true},{"t":"同一章节混入多个无关任务，<b>阅读主线会变得不清楚</b>；按信息关系拆分或重排","m":"single-crowd","bad":true},{"t":"多模块后台系统通常使用 {c:sidebar-layout}，而非单页布局","m":"table-admin"},{"t":"主要行动只在结尾出现一次，<b>阅读过程中没有可用入口</b>","m":"single-cta-once","bad":true}],"lessonPractice":{"title":"产品落地页围绕一个试用目标，内容按“问题、价值、产品证据、客户证明、行动”依次排列。怎样组织更合适？","options":[{"id":"guided-single-page","label":"使用单页滚动布局，按阅读顺序分节，并提供锚点和阶段性行动入口","feedback":"所有内容服务同一决策，连续页面能按顺序读完，页内导航也能避免在长页面中找不到位置。","correct":true},{"id":"dashboard-long-page","label":"把账号、账单和项目管理也接在落地页后面，统一靠滚动完成","feedback":"这些是独立的工具任务，不属于同一阅读主线，合并会让导航和状态管理混乱。","correct":false},{"id":"route-every-section","label":"把每个短章节都拆成独立网址，用户必须逐页点击才能读完","feedback":"内容本来组成一个连续决策，过度拆页会打断上下文和阅读节奏。","correct":false}],"en":{"title":"A product landing page serves one trial goal through a sequence of problem, value, product evidence, customer proof, and action. How should it be organized?","options":[{"id":"guided-single-page","label":"Use a single scrolling page with ordered sections, anchors, and contextual action entries","feedback":"All content supports one decision, so a continuous page keeps one reading order while in-page navigation keeps people oriented on a long page.","correct":true},{"id":"dashboard-long-page","label":"Append account, billing, and project management below the landing page and handle everything by scrolling","feedback":"Those are separate tool tasks rather than one reading path, so merging them confuses navigation and state.","correct":false},{"id":"route-every-section","label":"Give every short section a separate URL and require page-by-page navigation to read everything","feedback":"The content forms one continuous decision, and excessive page breaks interrupt context and reading rhythm.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把落地页组织成单页滚动结构，依次呈现问题、价值、产品证据、客户证明和 CTA。章节使用稳定锚点，长页提供返回路径，主要行动在合适阶段重复但保持同一目标。","en":{"title":"You can say this to an AI Agent","text":"Organize the landing page as one scrolling sequence: problem, value, product evidence, customer proof, and CTA. Give sections stable anchors and long-page return paths, and repeat the same primary action only at useful decision stages."}},"references":[{"title":"滚动与滚动条","source":"NN/g","url":"https://www.nngroup.com/articles/scrolling-and-scrollbars/","title_en":"Scrolling and Scrollbars"},{"title":"首屏宣言：为什么页面首屏仍然重要","source":"NN/g","url":"https://www.nngroup.com/articles/page-fold-manifesto/","title_en":"The Fold Manifesto: Why the Page Fold Still Matters"}],"scenes":["产品落地页","活动页","招聘页","个人主页"],"en":{"use":[{"t":"Product landing page","m":"anchor-landing"},{"t":"Campaign page","m":"single-screen"},{"t":"Portfolio story","m":"single-story"},{"t":"A focused site with one main conversion goal","m":"anchor-active"}],"dont":[{"t":"Force a large multi-purpose product into one endless page","m":"single-endless","bad":true},{"t":"Hide content behind complex scroll animation","m":"single-crowd","bad":true},{"t":"Repeat the same action after every short paragraph","m":"table-admin"},{"t":"Use sections with no clear narrative order","m":"single-cta-once","bad":true}],"scenes":["Product launch","Personal portfolio","Event page","Campaign landing page"],"sceneUI":["<div style=\"border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n      <div style=\"text-align:center;padding:13px 16px 11px;background:linear-gradient(180deg,var(--brand-light),#fff)\">\n        <div style=\"font-size:13px;font-weight:700\">Turn meeting recordings into editable notes</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin:4px 0 8px\">Upload a recording to draft a transcript, summary, and action items</div>\n        <button class=\"btn btn-primary\" style=\"padding:4px 12px;font-size:12px\">Try the demo</button>\n      </div>\n  