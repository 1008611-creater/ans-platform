{"__formatVersion":2,"__revision":"bce9d49c39ba6df5","__entryId":"modal","entry":{"sceneUI":["<div class=\"modal-scene\">\n      <div style=\"padding:14px 16px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:52%\"></i><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:42%\"></i></div>\n      <div class=\"dm-mask\"></div>\n      <div class=\"modal-card\">\n        <div class=\"modal-card-title\">确认删除这个项目？</div>\n        <div class=\"modal-card-body\">「官网改版 v2」及其 12 个文件将被永久删除，无法恢复。</div>\n        <div class=\"modal-card-actions\"><button class=\"btn btn-outline\">取消</button><button class=\"btn btn-danger\">确认删除</button></div>\n      </div>\n    </div>","<div class=\"modal-scene\">\n      <div style=\"padding:14px 16px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:56%\"></i><i class=\"mk-line\" style=\"width:76%\"></i><i class=\"mk-line\" style=\"width:48%\"></i></div>\n      <div class=\"dm-mask\"></div>\n      <div class=\"modal-card\">\n        <div class=\"modal-card-title\">重命名项目</div>\n        <input class=\"demo-input\" value=\"官网改版 v2\">\n        <div class=\"modal-card-actions\"><button class=\"btn btn-outline\">取消</button><button class=\"btn btn-primary\">保存</button></div>\n      </div>\n    </div>","<div class=\"modal-scene\">\n      <div style=\"padding:14px 16px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:50%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:40%\"></i></div>\n      <div class=\"dm-mask\"></div>\n      <div class=\"modal-card\" style=\"padding:12px 14px;gap:8px\">\n        <div class=\"modal-card-title\" style=\"font-size:13px\">封面预览</div>\n        <img src=\"/assets/cover-mountain.png\" style=\"width:100%;height:58px;object-fit:cover;border-radius:6px\" alt=\"\">\n        <div class=\"modal-card-actions\"><button class=\"btn btn-outline\">关闭</button><button class=\"btn btn-pr