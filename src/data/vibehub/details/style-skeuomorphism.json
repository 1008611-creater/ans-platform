{"__formatVersion":2,"__revision":"707fd27553ddecf3","__entryId":"style-skeuomorphism","entry":{"sceneUI":["<div class=\"style-skeuomorphism-scene\">\n      <div class=\"style-skeuomorphism-scene-head\"><span>MELLOWTAPE</span><b>SESSION / VOCAL 04</b><i>● RECORDING</i></div>\n      <div class=\"style-skeuomorphism-scene-board\">\n        <div class=\"style-skeuomorphism-scene-track\"><b>VOICE</b><span class=\"style-skeuomorphism-scene-wave\"></span><em>-8 dB</em></div>\n        <div class=\"style-skeuomorphism-scene-track\"><b>GUITAR</b><span class=\"style-skeuomorphism-scene-wave alt\"></span><em>-14 dB</em></div>\n        <div class=\"style-skeuomorphism-scene-fader\"><i></i><i></i><i></i></div>\n      </div>\n      <div class=\"style-skeuomorphism-scene-footer\"><span>00:02:18 / 03:40</span><b>● <i>RECORD</i></b><span>48 kHz · STEREO</span></div>\n    </div>","<div style=\"max-width:600px;margin:0 auto;display:flex;justify-content:center;padding:16px;border-radius:12px\" class=\"style-skeuomorphism-linen\">\n      <div style=\"width:264px;border-radius:20px;border:3px solid #26262a;background:#1c1c1e;padding:14px;box-shadow:0 10px 28px rgba(0,0,0,.4)\">\n        <div style=\"background:linear-gradient(#d7dce4,#b9c0cb);border-radius:8px;box-shadow:inset 0 2px 6px rgba(0,0,0,.35), 0 1px 0 rgba(255,255,255,.15);text-align:right;padding:8px 14px;font-size:26px;font-weight:300;color:#2b2f36;margin-bottom:12px\">1,024</div>\n        <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:8px\">\n          <span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">C</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">±</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">%</span><span class=\"style-skeuomorphism-key orange\" style=\"width:auto;height:30px\">÷</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">7</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">8</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">9</span><span class=\"style-skeuomorphism-key orange\" style=\"width:auto;height:30px\">×</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">4</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">5</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">6</span><span class=\"style-skeuomorphism-key orange\" style=\"width:auto;height:30px\">−</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">1</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">2</span><span class=\"style-skeuomorphism-key\" style=\"width:auto;height:30px\">3</span><span class=\"style-skeuomorphism-key orange\" style=\"width:auto;height:30px\">+</span>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:600px;margin:0 auto;padding:16px;border-radius:12px\" class=\"style-skeuomorphism-linen\">\n      <div style=\"max-width:380px;margin:0 auto;border-radius:6px;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.35)\">\n        <div style=\"background:linear-gradient(#7f8590,#5b626d);color:#fff;text-shadow:0 -1px 1px rgba(0,0,0,.5);font-size:14px;font-weight:700;text-align:center;padding:8px;box-shadow:inset 0 1px 0 rgba(255,255,255,.25)\">设置</div>\n        <div style=\"background:#e8e8ec;padding:12px\">\n          <div style=\"background:#fff;border:1px solid #b8bcc4;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.12)\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border-bottom:1px solid #d8dbe0\"><span style=\"font-size:13px;color:#1d2129\">无线局域网</span><span style=\"font-size:12px;color:#2a7de1;text-shadow:0 1px 0 #fff\">Home-WiFi &gt;</span></div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border-bottom:1px solid #d8dbe0\"><span style=\"font-size:13px;color:#1d2129\">通知</span><span class=\"style-skeuomorphism-switch sm\"><i class=\"style-skeuomorphism-switch-fill\"></i><b class=\"style-skeuomorphism-switch-knob\"></b></span></div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;padding:9px 12px\"><span style=\"font-size:13px;color:#1d2129\">定位服务</span><span class=\"style-skeuomorphism-switch sm\"><i class=\"style-skeuomorphism-switch-fill\"></i><b class=\"style-skeuomorphism-switch-knob\"></b></span></div>\n          </div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:600px;margin:0 auto;padding:16px;border-radius:12px\" class=\"style-skeuomorphism-linen\">\n      <div style=\"max-width:420px;margin:0 auto;border-radius:6px;overflow:hidden;box-shadow:0 6px 16px rgba(0,0,0,.4)\">\n        <div class=\"style-skeuomorphism-bar\">报刊亭</div>\n        <div style=\"background:repeating-linear-gradient(90deg,#7a5230 0 8px,#6a4527 8px 16px);padding:18px 20px 0\">\n          <div style=\"display:flex;gap:14px;align-items:flex-end;justify-content:center\">\n            <img src=\"/assets/slide-forest.png\" style=\"width:100px;height:142px;object-fit:cover;border-radius:2px;box-shadow:0 4px 8px rgba(0,0,0,.5)\" alt=\"\">\n            <img src=\"/assets/photo-cat.png\" style=\"width:100px;height:142px;object-fit:cover;border-radius:2px;box-shadow:0 4px 8px rgba(0,0,0,.5)\" alt=\"\">\n            <img src=\"/assets/slide-city.png\" style=\"width:100px;height:142px;object-fit:cover;border-radius:2px;box-shadow:0 4px 8px rgba(0,0,0,.5)\" alt=\"\">\n          </div>\n          <div style=\"height:14px;margin-top:-2px;background:linear-gradient(#8a5f3a,#5e3d20);box-shadow:0 6px 10px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.2);border-radius:2px\"></div>\n        </div>\n      </div>\n    </div>"],"sceneUI_en":["<div class=\"style-skeuomorphism-scene\">\n      <div class=\"style-skeuomorphism-scene-head\"><span>MELLOWTAPE</span><b>SESSION / VOC