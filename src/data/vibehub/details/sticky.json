tom:1px solid var(--border-light)\">\n        <img src=\"/assets/photo-cat.png\" style=\"width:38px;height:38px;border-radius:6px;object-fit:cover\" alt=\"\">\n        <div style=\"flex:1;min-width:0\"><b class=\"trunc-ellipsis\" style=\"font-size:12px;color:var(--text)\">Cat photography album \"Light on the Windowsill\" ×1</b><div style=\"font-size:12px;color:var(--text-3)\">¥ 128.00</div></div>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 12px\">\n        <img src=\"/assets/slide-city.png\" style=\"width:38px;height:38px;border-radius:6px;object-fit:cover\" alt=\"\">\n        <div style=\"flex:1;min-width:0\"><b class=\"trunc-ellipsis\" style=\"font-size:12px;color:var(--text)\">City Walking Map · Guangzhou ×2</b><div style=\"font-size:12px;color:var(--text-3)\">¥ 58.00</div></div>\n      </div>\n      <div style=\"position:absolute;left:0;right:0;bottom:0;z-index:2;display:flex;align-items:center;gap:10px;background:var(--bg);border-top:1px solid var(--border);box-shadow:0 -2px 8px rgba(0,0,0,.06);padding:8px 12px\">\n        <span style=\"flex:1;font-size:12px;color:var(--text-2)\">Total <b style=\"font-size:14px;color:var(--red)\">¥ 283.00</b></span>\n        <button class=\"btn btn-primary\">Go to checkout (4)</button>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"sticky-anat\"><span class=\"ap\" data-ap=\"container\"><span class=\"sticky-anat-scroll\"><span class=\"ap\" data-ap=\"element\"><span class=\"sticky-anat-bar\">分组标题 · sticky</span></span><span class=\"sticky-anat-lines\"><i></i><i></i><i></i></span></span></span><span class=\"ap\" data-ap=\"top\"><span class=\"sticky-anat-tag\">top: 0</span></span><span class=\"ap\" data-ap=\"flow\"><span class=\"sticky-anat-tag\">在文档流里占位，不遮别人</span></span></span>","demo_en":"<span class=\"sticky-anat\"><span class=\"ap\" data-ap=\"container\"><span class=\"sticky-anat-scroll\"><span class=\"ap\" data-ap=\"element\"><span class=\"sticky-anat-bar\">Group title · sticky</span></span><span class=\"sticky-anat-lines\"><i></i><i></i><i></i></span></span></span><span class=\"ap\" data-ap=\"top\"><span class=\"sticky-anat-tag\">top: 0</span></span><span class=\"ap\" data-ap=\"flow\"><span class=\"sticky-anat-tag\">Occupy space in the document flow without blocking others</span></span></span>","parts":[{"key":"container","cn":"滚动容器","en":"Scroll Container","desc":"sticky 相对最近的滚动祖先吸附","desc_en":"sticky relatively recent scrolling ancestor adsorption"},{"key":"element","cn":"吸顶元素","en":"Sticky Element","desc":"写上 position: sticky 的那个元素","desc_en":"The element with position: sticky"},{"key":"top","cn":"吸附阈值","en":"top / bottom","desc":"滚到距边缘多远时吸住，不写就不生效","desc_en":"When the scroll reaches a certain distance from the edge, it will be sucked. If you don’t write it, it will not take effect."},{"key":"flow","cn":"文档流占位","en":"In Flow","desc":"吸住后原来的位置还留着，内容不被遮挡","desc_en":"After sucking, the original position is still retained, and the content is not blocked."}]},"variants":[{"cn":"吸顶","en":"Sticky Top","demo":"<span class=\"sticky-v\"><span class=\"sticky-v-bar\">top: 0</span><span class=\"sticky-v-lines\"><i></i><i></i></span></span>","demo_en":"<span class=\"sticky-v\"><span class=\"sticky-v-bar\">top: 0</span><span class=\"sticky-v-lines\"><i></i><i></i></span></span>","when":"表头、导航滚到顶就吸住","when_en":"Scroll to the top of the header and navigation and click it."},{"cn":"吸底","en":"Sticky Bottom","demo":"<span class=\"sticky-v\"><span class=\"sticky-v-lines\"><i></i><i></i></span><span class=\"sticky-v-bar bottom\">bottom: 0</span></span>","demo_en":"<span class=\"sticky-v\"><span class=\"sticky-v-lines\"><i></i><i></i></span><span class=\"sticky-v-bar bottom\">bottom: 0</span></span>","when":"底部操作栏滚到底才贴住","when_en":"Scroll the bottom operation bar all the way to stick it"},{"cn":"分组接力","en":"Group Headers","demo":"<span class=\"sticky-v\"><span class=\"sticky-v-bar sub\">A</span><span class=\"sticky-v-lines\"><i></i></span><span class=\"sticky-v-bar sub\">B</span></span>","demo_en":"<span class=\"sticky-v\"><span class=\"sticky-v-bar sub\">A</span><span class=\"sticky-v-lines\"><i></i></span><span class=\"sticky-v-bar sub\">B</span></span>","when":"通讯录字母、日期分组标题","when_en":"Address book letter, date group title"}],"use":[{"t":"{c:table} <b>长表格表头</b>：滚到底也知道每列是什么","m":"sticky-table"},{"t":"<b>列表分组标题</b>：通讯录字母、日期分组依次接力","m":"sticky-cat"},{"t":"<b>筛选栏、{c:navbar}</b>：滚到顶部才吸住","m":"sticky-nav"},{"t":"在需要吸附的轴上设置偏移，例如 <b>top: 0</b>；没有对应偏移时不会进入吸附状态","m":"sticky-top"}],"dont":[{"t":"祖先有 <b>overflow</b>：它可能成为 sticky 的滚动容器并限制可吸附范围；先检查实际滚动容器与高度","m":"sticky-overflow","bad":true},{"t":"用 <b>fixed 模拟吸顶</b>：元素脱离文档流，可能遮挡内容或需要补位","m":"sticky-fixed","bad":true},{"t":"吸顶元素<b>没有背景色</b>：滚动内容可能与其叠加","m":"sticky-bg","bad":true},{"t":"<b>同时吸附多层控件</b>：导航、筛选和表头可能持续占用视口，应测试剩余内容区域是否足够","m":"sticky-many","bad":true}],"lessonPractice":{"title":"长表格放在独立滚动面板中，表头设置了 sticky 却没有吸住。下一步最应该检查什么？","options":[{"id":"offset-and-scroll-ancestor","label":"确认表头设置了 top，并检查实际滚动祖先、容器高度和 overflow","feedback":"Sticky 需要对应轴的偏移，并受最近滚动祖先和包含范围限制，这些条件决定它能否吸附。","correct":true},{"id":"replace-with-fixed","label":"把表头改成 fixed，让它始终固定在浏览器视口顶部","feedback":"Fixed 脱离表格和滚动面板，可能遮挡全页内容，也不再受表格边界约束。","correct":false},{"id":"raise-z-index-only","label":"保留现有布局，只把表头 z-index 提高到 99999","feedback":"层级只能处理重叠顺序，不能补上 sticky 的偏移、滚动容器或可滚动距离。","correct":false}],"en":{"title":"A long table sits in its own scroll panel, but its sticky header does not stick. What should be checked next?","options":[{"id":"offset-and-scroll-ancestor","label":"Confirm a top offset and inspect the real scroll ancestor, container height, and overflow","feedback":"Sticky needs an offset on its axis and is constrained by its nearest scroll ancestor and containing range.","correct":true},{"id":"replace-with-fixed","label":"Change the header to fixed so it remains at the top of the browser viewport","feedback":"Fixed leaves the table and scroll panel, may cover page content, and no longer respects table boundaries.","correct":false},{"id":"raise-z-index-only","label":"Keep the layout and only increase the header z-index to 99999","feedback":"Layer order handles overlap but cannot supply the missing offset, scrolling container, or scrolling distance.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请排查表头吸顶：确认 sticky 和 top 已设置，找出真正滚动的祖先，检查其 overflow、高度和表格可滚动距离。不要改成 fixed 或只加 z-index；验证表头只在表格容器范围内吸附。","en":{"title":"You can say this to an AI Agent","text":"Debug the sticky table header: confirm sticky and top, identify the actual scrolling ancestor, and inspect its overflow, height, and available scroll distance. Do not replace it with fixed or only raise z-index; verify it sticks only within the table container."}},"references":[{"title":"position 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/position","title_en":"position"},{"title":"吸顶表头：5 种改进方法","source":"NN/g","url":"https://www.nngroup.com/articles/sticky-headers/","title_en":"Sticky Headers: 5 Ways to Make Them Better"}],"scenes":["长表格吸顶表头","通讯录字母分组","吸顶筛选栏与导航","底部吸底操作栏"],"en":{"use":[{"t":"Keep table headers visible","m":"sticky-table"},{"t":"Keep section navigation nearby","m":"sticky-cat"},{"t":"Hold important actions within a long panel","m":"sticky-nav"},{"t":"Pin a page header after it reaches the top","m":"sticky-top"}],"dont":[{"t":"Make several large regions sticky at once","m":"sticky-overflow","bad":true},{"t":"Cover the content people are trying to read","m":"sticky-fixed","bad":true},{"t":"Expect sticky to work through a clipping parent","m":"sticky-bg","bad":true},{"t":"Use it on a small screen without checking remaining space","m":"sticky-many","bad":true}],"scenes":["Table header","Documentation sidebar","Page toolbar","Section heading"],"sceneUI":["<div class=\"sticky-sc-view\" style=\"height:126px\">\n      <span class=\"sticky-sc-scroll\"></span>\n      <div class=\"sticky-sc-stuck\" style=\"display:flex;align-items:center;backgrou