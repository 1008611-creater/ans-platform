{"__formatVersion":2,"__revision":"9b94cce4adb2ac9e","__entryId":"auto-complete","entry":{"sceneUI":["<div style=\"max-width:340px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\">\n        <b style=\"font-size:13px;color:var(--brand)\">Vibe 图鉴</b>\n        <input class=\"demo-input\" style=\"flex:1;padding:6px 10px;font-size:12px\" value=\"按钮\">\n        <span class=\"icon-btn\" style=\"width:28px;height:28px;font-size:13px\">🔔</span>\n      </div>\n      <div class=\"ac-panel\">\n        <span class=\"ac-item on\"><b>按钮</b> Button · 组件</span>\n        <span class=\"ac-item\"><b>按钮</b>设计规范 · 文档</span>\n        <span class=\"ac-item\">单选<b>按钮</b> Radio · 组件</span>\n      </div>\n    </div>","<div style=\"max-width:300px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:10px\">登录账号</div>\n      <div class=\"ac-wrap\" style=\"width:100%\">\n        <input class=\"demo-input\" value=\"oil-oil@\">\n        <div class=\"ac-panel\">\n          <span class=\"ac-item on\">oil-oil@<b>gmail.com</b></span>\n          <span class=\"ac-item\">oil-oil@<b>qq.com</b></span>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:320px;margin:0 auto\">\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:5px\">收货地址</div>\n      <div class=\"ac-wrap\" style=\"width:100%\">\n        <input class=\"demo-input\" value=\"南山\">\n        <div class=\"ac-panel\">\n          <span class=\"ac-item on\">深圳市<b>南山</b>区科技园南区 R2-B 栋</span>\n          <span class=\"ac-item\">深圳市<b>南山</b>区蛇口海上世界 C 区</span>\n          <span class=\"ac-item\">广州市<b>南山</b>街道 12 号</span>\n        </div>\n      </div>\n    </div>","<div class=\"ac-sc-mask\" style=\"height:150px\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:7px\"><i class=\"mk-line\" style=\"width:55%\"><