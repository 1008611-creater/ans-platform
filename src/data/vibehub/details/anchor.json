an class=\"anchor-rail\">\n      <span class=\"anchor-item\">一、背景</span>\n      <span class=\"ap\" data-ap=\"item\"><span class=\"anchor-item on\"><span class=\"ap\" data-ap=\"ind\"><i class=\"anchor-ind\"></i></span>二、方案</span></span>\n      <span class=\"anchor-item\">三、结论</span>\n    </span></div>","demo_en":"<div class=\"ap\" data-ap=\"rail\"><span class=\"anchor-rail\">\n      <span class=\"anchor-item\">1. Background</span>\n      <span class=\"ap\" data-ap=\"item\"><span class=\"anchor-item on\"><span class=\"ap\" data-ap=\"ind\"><i class=\"anchor-ind\"></i></span>2. Plan</span></span>\n      <span class=\"anchor-item\">3. Conclusion</span>\n    </span></div>","parts":[{"key":"rail","cn":"锚点轨道","en":"Rail","desc":"贴在页面一侧的竖线，所有锚点挂在上面","desc_en":"A vertical rail beside the page that holds the section links."},{"key":"item","cn":"锚点链接","en":"Link","desc":"对应页内一个章节，点击滚过去","desc_en":"Each link corresponds to a page section; click to scroll there"},{"key":"ind","cn":"指示条","en":"Indicator","desc":"标记当前读到的章节，滚动时自动跟随","desc_en":"Highlight the section currently in view as the reader scrolls"}]},"variants":[{"cn":"基础锚点","en":"Basic","demo":"<div class=\"anchor-rail\"><span class=\"anchor-item\">安装</span><span class=\"anchor-item on\"><i class=\"anchor-ind\"></i>快速上手</span><span class=\"anchor-item\">常见问题</span></div>","demo_en":"<div class=\"anchor-rail\"><span class=\"anchor-item\">Installation</span><span class=\"anchor-item on\"><i class=\"anchor-ind\"></i>Get started quickly</span><span class=\"anchor-item\">FAQ</span></div>","when":"长页面需要持续展示章节目录时","when_en":"When a long page needs a persistent table of contents"},{"cn":"页面场景","en":"In Page","demo":"<div class=\"anchor-demo\"><div class=\"anchor-page\"><span class=\"anchor-sec\">快速上手</span><i class=\"anchor-line\" style=\"width:86%\"></i><i class=\"anchor-line\" style=\"width:64%\"></i></div><div class=\"anchor-rail\"><span class=\"anchor-item\">安装</span><span class=\"anchor-item on\"><i class=\"anchor-ind\"></i>快速上手</span></div></div>","demo_en":"<div class=\"anchor-demo\"><div class=\"anchor-page\"><span class=\"anchor-sec\">Get started quickly</span><i class=\"anchor-line\" style=\"width:86%\"></i><i class=\"anchor-line\" style=\"width:64%\"></i></div><div class=\"anchor-rail\"><span class=\"anchor-item\">Installation</span><span class=\"anchor-item on\"><i class=\"anchor-ind\"></i>Get started quickly</span></div></div>","when":"需要根据当前阅读位置同步高亮章节时","when_en":"When the highlighted section should follow the current reading position"}],"use":[{"t":"<b>长文档 / 帮助中心</b>的页内目录","m":"anchor-doc"},{"t":"滚动时<b>自动高亮</b>当前读到的章节","m":"anchor-active"},{"t":"点击<b>平滑滚动</b>到对应位置，无需手动查找","m":"anchor-jump"},{"t":"产品长页<b>分节导航</b>：特性、定价、FAQ","m":"anchor-landing"}],"dont":[{"t":"页面内容较短且无需页内跳转时，通常不必加入锚点","m":"anchor-short","bad":true},{"t":"跳转到<b>其他页面</b>：使用 {c:link}","m":"anchor-cross","bad":true},{"t":"章节名<b>含糊不清</b>，用户无法判断链接对应哪段内容","m":"anchor-vague","bad":true},{"t":"锚点<b>过多且缺少分组</b>，目录本身也会难以浏览","m":"anchor-many","bad":true}],"lessonPractice":{"title":"安装文档很长，包含“准备环境、安装、配置、排错”四个章节，用户要快速跳转并知道当前读到哪里。怎样导航？","options":[{"id":"section-anchor-nav","label":"建立页内章节目录，链接到对应锚点，并随滚动高亮当前章节","feedback":"锚点直接定位同一页面的内容，高亮还能保持目录与阅读位置同步。","correct":true},{"id":"content-tabs","label":"把四个章节做成标签页，切换时卸载其他章节内容","feedback":"标签会把连续文档拆成互斥状态，用户无法自然滚动阅读全文或使用页内地址定位。","correct":false},{"id":"back-to-top-only","label":"只在每章末尾提供“回到顶部”，再让用户从头寻找下一章","feedback":"回到顶部不能直接到达目标章节，也没有说明当前阅读位置，长文档查找仍然费力。","correct":false}],"en":{"title":"A long installation guide has Environment, Install, Configure, and Troubleshoot sections. Users need fast jumps and awareness of the current section. How should it navigate?","options":[{"id":"section-anchor-nav","label":"Create an in-page table of contents linked to anchors and highlight the current section on scroll","feedback":"Anchors locate content within the same page, while highlighting keeps the directory synchronized with reading position.","correct":true},{"id":"content-tabs","label":"Turn the four sections into tabs and unmount every section except the selected one","feedback":"Tabs split a continuous document into exclusive states, preventing natural reading and addressable in-page locations.","correct":false},{"id":"back-to-top-only","label":"Only add Back to top after each section and make users find the next section again","feedback":"Returning to the top does not directly reach a target or communicate current position, so navigation remains costly.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请为这篇长文档生成页内目录，每个目录项链接到稳定的章节锚点，滚动时高亮当前章节。处理固定顶部栏的遮挡，并验证复制带锚点的网址后能直接落到正确标题。","en":{"title":"You can say this to an AI Agent","text":"Generate an in-page table of contents with stable section anchors and highlight the active section while scrolling. Account for the fixed header offset and verify that a copied anchor URL lands on the correct heading."}},"references":[{"title":"<a> 锚元素","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a","title_en":"<a>: The Anchor element"}],"scenes":["帮助文档目录","产品官网长页","API 文档导航","活动规则长文"],"en":{"use":[{"t":"Documentation table of contents","m":"anchor-doc"},{"t":"Long policy or report","m":"anchor-active"},{"t":"Single-page product site","m":"anchor-jump"},{"t":"A page with several clearly named sections","m":"anchor-landing"}],"dont":[{"t":"Use anchors for content on different pages","m":"anchor-short","bad":true},{"t":"List headings that do not exist","m":"anchor-cross","bad":true},{"t":"Cover the target heading with a sticky header","m":"anchor-vague","bad":true},{"t":"Add anchor navigation to a page too short to need it","m":"anchor-many","bad":true}],"scenes":["Documentation","Terms and policies","Long report","Single-page site"],"sceneUI":["<div style=\"display:flex;gap:14px;border:1px solid var(--border);border-radius:10px;background:var(--bg);padding:12px 16px;box-shadow:var(--shadow-card)\">\n      <div style=\"flex:1;min-width:0\">\n        <b style=\"f