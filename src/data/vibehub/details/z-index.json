round:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-float);overflow:hidden\">\n          <span class=\"zindex-sc-chip\" style=\"position:absolute;top:5px;right:5px\">z-index: 1000</span>\n          <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">All</div>\n          <div style=\"padding:7px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">In progress ✓</div>\n          <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">Completed</div>\n        </div>\n        <div style=\"margin-top:10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px\">\n          <i class=\"mk-line\" style=\"width:70%\"></i>\n          <i class=\"mk-line\" style=\"width:45%;margin-top:7px\"></i>\n        </div>\n      </div>\n      <div class=\"zindex-sc-note\">The drop-down floats on top of the card and is neither covered nor cut</div>\n    </div>","<div style=\"position:relative;height:118px;border-radius:8px;border:1px solid var(--border);background:var(--bg);overflow:hidden\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:42%\"></i></div>\n      <span style=\"position:absolute;right:14px;bottom:14px;width:42px;height:42px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:20px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(99,102,241,.4)\">＋</span>\n      <span class=\"zindex-sc-chip\" style=\"position:absolute;right:66px;bottom:26px\">z-index: 10</span>\n    </div>"],"variants":[{"demo":"<div class=\"zindex-v\"><span style=\"left:4px;top:12px;width:44px;height:24px\">1</span><span style=\"left:18px;top:4px;width:44px;height:24px;border-color:var(--brand);color:var(--brand)\">2</span></div>","when":"The card corner mark and avatar are slightly overlaid."},{"demo":"<div class=\"zindex-v\" style=\"border:1px solid var(--border-light);border-radius:6px;background:var(--bg)\"><span style=\"left:0;top:0;width:100%;height:12px;background:var(--brand-light);border-color:var(--brand);color:var(--brand)\">100</span><span style=\"left:6px;top:18px;width:56px;height:6px;background:var(--bg-hover);border:none\"></span><span style=\"left:6px;top:28px;width:44px;height:6px;background:var(--bg-hover);border:none\"></span></div>","when":"Fixed bar suppresses scrolling content"},{"demo":"<div class=\"zindex-v\"><span style=\"left:0;top:0;width:70px;height:40px\">Page</span><span style=\"left:12px;top:10px;width:52px;height:26px;border-color:var(--brand);color:var(--brand);box-shadow:var(--shadow-card)\">1000</span></div>","when":"Drop-down, bubble, text prompt"},{"demo":"<div class=\"zindex-v\"><span style=\"left:0;top:0;width:74px;height:44px;background:rgba(29,33,41,.32);border:none\"></span><span style=\"left:17px;top:10px;width:40px;height:24px;border-color:var(--brand);color:var(--brand)\">10000</span></div>","when":"Example gear: Make the modal layer higher than the ordinary page floating layer"}]},"usageMocks":{"modal-confirm":"<div class=\"mk-scene \"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:70%\"></i></div><div class=\"mk-mask\"></div><div class=\"mk-modal \"><span class=\"m-title\">确认删除这个项目？</span><i class=\"mk-line\" style=\"width:85%\"></i>\n      <div class=\"m-actions\"><span class=\"mk-btn outline\">取消</span><span class=\"mk-btn danger\">确认删除</span></div></div></div>","zindex-fixed":"<div class=\"mk-scene\"><span style=\"position:absolute;top:0;left:0;right:0;height:14px;background:var(--bg);border-bottom:1px solid var(--border);z-index:2;display:flex;align-items:center;padding:0 6px;font-size:11px;color:var(--text-2)\">导航 · z-index: 100</span><div class=\"mk-skel\" style=\"top:6px\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:65%\"></i><i class=\"mk-line\" style=\"width:72%\"></i></div></div><span style=\"font-size:12px;color:var(--text-3)\">在同一层叠规则里，让导航高于滚动内容</span>","zindex-float":"<div class=\"mk-win\" style=\"position:relative\"><span class=\"mk-select\">全部状态<i class=\"mk-caret\"></i></span><span class=\"mk-drop\" style=\"position:absolute;top:26px;left:10px;z-index:2\"><span class=\"mk-opt\">全部状态</span><span class=\"mk-opt on\">进行中</span></span><i class=\"mk-line\" style=\"width:70%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">下拉浮在内容上，不被裁不被盖</span>","zindex-scale":"<div class=\"mk-row\"><span class=\"mk-tag gray\">内容 1</span><span class=\"mk-tag blue\">吸顶 100</span><span class=\"mk-tag orange\">浮层 1000</span><span class=\"mk-tag red\">弹窗 10000</span></div><span style=\"font-size:12px;color:var(--text-3)\">定几个固定档位，全项目统一用</span>","zindex-static":"<div class=\"mk-win\"><i class=\"mk-line\" style=\"width:60%\"></i><span style=\"background:var(--red-light);color:var(--red);font-size:12px;padding:2px 8px;border-radius:3px;align-self:flex-start\">z-index: 99 但没设 position</span><i class=\"mk-line\" style=\"width:75%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">static 元素上 z-index 无效</span>","zindex-9999":"<div class=\"mk-row\"><span class=\"mk-tag red\">z-index: 9999</span><span class=\"mk-tag red\">z-index: 99999</span><span class=\"mk-tag red\">z-index: 999999</span></div><span style=\"font-size:12px;color:var(--text-3)\">用更大数值覆盖问题，层级规则难以维护</span>","zindex-nested":"<div class=\"mk-win\" style=\"position:relative\"><span style=\"display:inline-block;background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:5px;font-size:12px;color:var(--text-2)\">父级 z-index: 1<span style=\"display:inline-block;background:var(--brand-light);color:var(--brand);padding:1px 5px;border-radius:2px;margin-left:4px\">子级 9999</span></span><span style=\"position:absolute;top:18px;left:96px;background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:2px 6px;border-radius:3px\">z-index: 2</span></div><span style=\"font-size:12px;color:var(--text-3)\">子级再大，也翻不出父级的层级</span>","zindex-dom":"<div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text-2)\">代码中较早出现的内容</span><span style=\"background:var(--red-light);color:var(--red);font-size:12px;padding:1px 6px;border-radius:2px;align-self:flex-start\">用 z-index 强行改变遮盖顺序</span><span style=\"font-size:12px;color:var(--text-3)\">若视觉顺序应与文档顺序一致，应先调整 DOM 结构</span></div>"}}}