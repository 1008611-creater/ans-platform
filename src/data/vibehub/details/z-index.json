{"__formatVersion":2,"__revision":"4db04f4781b00288","__entryId":"z-index","entry":{"sceneUI":["<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\">\n        <i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:64%\"></i>\n        <span class=\"zindex-sc-chip\" style=\"align-self:flex-start;background:var(--bg-hover);color:var(--text-3)\">页面 z-index: 1</span>\n      </div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <span class=\"zindex-sc-chip\" style=\"position:absolute;left:10px;bottom:10px\">遮罩 z-index: 1000</span>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:240px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow-float)\">\n        <span class=\"zindex-sc-chip\" style=\"position:absolute;top:-10px;right:12px\">弹窗 z-index: 1001</span>\n        <b style=\"font-size:13px\">确认退出登录？</b>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\"><button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">取消</button><button class=\"btn btn-danger\" style=\"padding:5px 12px;font-size:12px\">退出</button></div>\n      </div>\n    </div>","<div>\n      <div style=\"position:relative;height:128px;border-radius:8px;overflow:hidden;background:var(--bg);border:1px solid var(--border)\">\n        <div style=\"position:absolute;top:-16px;left:0;right:0;padding:0 14px;display:flex;flex-direction:column;gap:9px\">\n          <i class=\"mk-line\" style=\"width:88%\"></i><i class=\"mk-line\" style=\"width:62%\"></i><i class=\"mk-line\" style=\"width:75%\"></i><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:48%\"></i>\n        </div>\n        <div style=\"position:absolute;top:0;left:0;right:0;z-index:2;background:var(--bg);border-bottom:1px solid var(--border);padding:8px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 2px 8px rgba(0,0,0,.06)\">\n          <b style=\"font-size:12px;flex:1\">文档中心</b>\n          <span style=\"font-size:12px;color:var(--text-2)\">指南</span>\n          <span style=\"font-size:12px;color:var(--text-2)\">API</span>\n          <span class=\"zindex-sc-chip\">z-index: 100</span>\n        </div>\n      </div>\n      <div class=\"zindex-sc-note\">同一层叠规则里，导航层级高于滚动内容</div>\n    </div>","<div>\n      <div style=\"position:relative;max-width:300px;margin:0 auto;padding-top:6px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\">\n          <b style=\"font-size:13px\">任务列表</b>\n          <span class=\"demo-select\" style=\"font-size:12px;padding:5px 26px 5px 10px;border-radius:6px;position:relative\">进行中 ▾</span>\n        </div>\n        <div style=\"position:absolute;top:36px;right:0;z-index:2;width:136px;background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-float);overflow:hidden\">\n          <span class=\"zindex-sc-chip\" style=\"position:absolute;top:5px;right:5px\">z-index: 1000</span>\n          <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">全部</div>\n          <div style=\"padding:7px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">进行中 ✓</div>\n          <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">已完成</div>\n        </div>\n        <div style=\"margin-top:10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px\">\n          <i class=\"mk-line\" style=\"width:70%\"></i>\n          <i class=\"mk-line\" style=\"width:45%;margin-top:7px\"></i>\n        </div>\n      </div>\n      <div class=\"zindex-sc-note\">下拉浮在卡片上面，不被盖住也不被裁</div>\n    </div>","<div style=\"position:relative;height:118px;border-radius:8px;border:1px solid var(--border);background:var(--bg);overflow:hidden\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:42%\"></i></div>\n      <span style=\"position:absolute;right:14px;bottom:14px;width:42px;height:42px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:20px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(99,102,241,.4)\">＋</span>\n      <span class=\"zindex-sc-chip\" style=\"position:absolute;right:66px;bottom:26px\">z-index: 10</span>\n    </div>"],"sceneUI_en":["<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\">\n        <i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:64%\"></i>\n        <span class=\"zindex-sc-chip\" style=\"align-self:flex-start;background:var(--bg-hover);color:var(--text-3)\">Page z-index: 1</span>\n      </div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <span class=\"zindex-sc-chip\" style=\"position:absolute;left:10px;bottom:10px\">Mask z-index: 1000</span>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:240px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow-float)\">\n        <span class=\"zindex-sc-chip\" style=\"position:absolute;top:-10px;right:12px\">Pop-up z-index: 1001</span>\n        <b style=\"font-size:13px\">Confirm to log out? </b>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\"><button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">Cancel</button><button class=\"btn btn-danger\" style=\"padding:5px 12px;font-size:12px\">Exit</button></div>\n      </div>\n    </div>","<div>\n      <div style=\"position:relative;height:128px;border-radius:8px;overflow:hidden;background:var(--bg);border:1px solid var(--border)\">\n        <div style=\"position:absolute;top:-16px;left:0;right:0;padding:0 14px;display:flex;flex-direction:column;gap:9px\">\n          <i class=\"mk-line\" style=\"width:88%\"></i><i class=\"mk-line\" style=\"width:62%\"></i><i class=\"mk-line\" style=\"width:75%\"></i><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:48%\"></i>\n        </div>\n        <div style=\"position:absolute;top:0;left:0;right:0;z-index:2;background:var(--bg);border-bottom:1px solid var(--border);padding:8px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 2px 8px rgba(0,0,0,.06)\">\n          <b style=\"font-size:12px;flex:1\">Document Center</b>\n          <span style=\"font-size:12px;color:var(--text-2)\">Guidelines</span>\n          <span style=\"font-size:12px;color:var(--text-2)\">API</span>\n          <span class=\"zindex-sc-chip\">z-index: 100</span>\n        </div>\n      </div>\n      <div class=\"zindex-sc-note\">In the same cascading rule, the navigation level is higher than the scrolling content</div>\n    </div>","<div>\n      <div style=\"position:relative;max-width:300px;margin:0 auto;padding-top:6px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\">\n          <b style=\"font-size:13px\">Task list</b>\n          <span class=\"demo-select\" style=\"font-size:12px;padding:5px 26px 5px 10px;border-radius:6px;position:relative\">In progress ▾</span>\n        </div>\n        <div style=\"position:absolute;top:36px;right:0;z-index:2;width:136px;background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-float);overflow:hidden\">\n          <span class=\"zindex-sc-chip\" style=\"position:absolute;top:5px;right:5px\">z-index: 1000</span>\n          <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">All</div>\n          <div style=\"padding:7px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">In progress ✓</div>\n          <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">Completed</div>\n        </div>\n        <div style=\"margin-top:10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px\">\n          <i class=\"mk-line\" style=\"width:70%\"></i>\n          <i class=\"mk-line\" style=\"width:45%;margin-top:7px\"></i>\n        </div>\n      </div>\n      <div class=\"zindex-sc-note\">The drop-down floats on top of the card and is neither covered nor cut</div>\n    </div>","<div style=\"position:relative;height:118px;border-radius:8px;border:1px solid var(--border);background:var(--bg);overflow:hidden\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:42%\"></i></div>\n      <span style=\"position:absolute;right:14px;bottom:14px;width:42px;height:42px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:20px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(99,102,241,.4)\">＋</span>\n      <span class=\"zindex-sc-chip\" style=\"position:absolute;right:66px;bottom:26px\">z-index: 10</span>\n    </div>"],"anatomy":{"demo":"<span class=\"zindex-anat-stage\"><span class=\"ap\" data-ap=\"bottom\"><span class=\"zindex-anat-b\">z-index: 1</span></span><span class=\"ap\" data-ap=\"top\"><span class=\"zindex-anat-t\">z-index: 2</span></span><span class=\"ap\" data-ap=\"value\"><span class=\"zindex-anat-note\">大的在上面</span></span></span>","demo_en":"<span class=\"zindex-anat-stage\"><span class=\"ap\" data-ap=\"bottom\"><span class=\"zindex-anat-b\">z-index: 1</span></span><span class=\"ap\" data-ap=\"top\"><span class=\"zindex-anat-t\">z-index: 2</span></span><span class=\"ap\" data-ap=\"value\"><span class=\"zindex-anat-note\">The big one is on top</span></span></span>","parts":[{"key":"bottom","cn":"下层元素","en":"Bottom","desc":"z-index 较小，被压在下面","desc_en":"The z-index is small and is suppressed below."},{"key":"top","cn":"上层元素","en":"Top","desc":"z-index 较大，盖在上面","desc_en":"The z-index is larger and covers it."},{"key":"value","cn":"层级值","en":"Z-Index","desc":"用于定位元素，以及 flex/grid 子项的层叠数值；还要看它所在的层叠上下文","desc_en":"The stacking value used to position elements and flex/grid items; it also depends on the stacking context in which it is located."}]},"variants":[{"cn":"内容叠放","en":"1 ~ 10","demo":"<div class=\"zindex-v\"><span style=\"left:4px;top:12px;width:44px;height:24px\">1</span><span style=\"left:18px;top:4px;width:44px;height:24px;border-color:var(--brand);color:var(--brand)\">2</span></div>","demo_en":"<div class=\"zindex-v\"><span style=\"left:4px;top:12px;width:44px;height:24px\">1</span><span style=\"left:18px;top:4px;width:44px;height:24px;border-color:var(--brand);color:var(--brand)\">2</span></div>","when":"卡片角标、头像轻微叠压","when_en":"The card corner mark and avatar are slightly overlaid."},{"cn":"吸顶导航","en":"100","demo":"<div class=\"zindex-v\" style=\"border:1px solid var(--border-light);border-radius:6px;background:var(--bg)\"><span style=\"left:0;top:0;width:100%;height:12px;background:var(--brand-light);border-color:var(--brand);color:var(--brand)\">100</span><span style=\"left:6px;top:18px;width:56px;height:6px;background:var(--bg-hover);border:none\"></span><span style=\"left:6px;top:28px;width:44px;height:6px;background:var(--bg-hover);border:none\"></span></div>","demo_en":"<div class=\"zindex-v\" style=\"border:1px solid var(--border-light);border-radius:6px;background:var(--bg)\"><span style=\"left:0;top:0;width:100%;height:12px;background:var(--brand-light);border-color:var(--brand);color:var(--brand)\">100</span><span style=\"left:6px;top:18px;width:56px;height:6px;background:var(--bg-hover);border:none\"></span><span style=\"left:6px;top:28px;width:44px;height:6px;background:var(--bg-hover);border:none\"></span></div>","when":"固定栏压住滚动内容","when_en":"Fixed bar suppresses scrolling content"},{"cn":"浮层","en":"1000","demo":"<div class=\"zindex-v\"><span style=\"left:0;top:0;width:70px;height:40px\">页面</span><span style=\"left:12px;top:10px;width:52px;height:26px;border-color:var(--brand);color:var(--brand);box-shadow:var(--shadow-card)\">1000</span></div>","demo_en":"<div class=\"zindex-v\"><span style=\"left:0;top:0;width:70px;height:40px\">Page</span><span style=\"left:12px;top:10px;width:52px;height:26px;border-color:var(--brand);color:var(--brand);box-shadow:var(--shadow-card)\">1000</span></div>","when":"下拉、气泡、文字提示","when_en":"Drop-down, bubble, text prompt"},{"cn":"弹窗遮罩","en":"10000","demo":"<div class=\"zindex-v\"><span style=\"left:0;top:0;width:74px;height:44px;background:rgba(29,33,41,.32);border:none\"></span><span style=\"left:17px;top:10px;width:40px;height:24px;border-color:var(--brand);color:var(--brand)\">10000</span></div>","demo_en":"<div class=\"zindex-v\"><span style=\"left:0;top:0;width:74px;height:44px;background:rgba(29,33,41,.32);border:none\"></span><span style=\"left:17px;top:10px;width:40px;height:24px;border-color:var(--brand);color:var(--brand)\">10000</span></div>","when":"示例档位：让模态层高于普通页面浮层","when_en":"Example gear: Make the modal layer higher than the ordinary page floating layer"}],"use":[{"t":"{c:modal} 盖遮罩、遮罩盖页面：<b>三层各司其职</b>","m":"modal-confirm"},{"t":"<b>吸顶导航</b>：滚动内容从它底下过","m":"zindex-fixed"},{"t":"{c:dropdown}、{c:tooltip} <b>浮在卡片上</b>不被盖住","m":"zindex-float"},{"t":"为内容、吸顶、浮层和弹窗建立少量统一层级","m":"zindex-scale"}],"dont":[{"t":"没先确认<b>定位、flex/grid 子项和层叠上下文</b>，只改数字通常没用","m":"zindex-static","bad":true},{"t":"仅靠增大 z-index 数值解决遮挡：层级规则会失去可维护性","m":"zindex-9999","bad":true},{"t":"指望子元素 z-index 9999 <b>翻出父级</b>：层级逃不出父级的上下文","m":"zindex-nested","bad":true},{"t":"用 z-index 解决<b>调一下 DOM 顺序就行</b>的问题","m":"zindex-dom","bad":true}],"lessonPractice":{"title":"下拉菜单已经设为 z-index: 99999，却仍被卡片边界裁掉。下一步最该检查什么？","options":[{"id":"increase-number","label":"继续把菜单的 z-index 增加到更大的数字","feedback":"更大的数字仍受父级层叠上下文和裁切范围限制，不能让子元素越过这些边界。","correct":false},{"id":"inspect-parents","label":"检查父级的 overflow、定位和层叠上下文","feedback":"菜单被裁掉通常不只是数值大小问题；要先找到限制它的父级边界，再决定浮层放置方式。","correct":true},{"id":"raise-all-layers","label":"把卡片及其所有子元素的 z-index 一起提高","feedback":"整体抬高可能压住其他浮层，却没有解除卡片自身的裁切，也会让全局层级更混乱。","correct":false}],"en":{"title":"A dropdown already has z-index: 99999 but is still clipped at the card boundary. What should be inspected next?","options":[{"id":"increase-number","label":"Keep increasing the dropdown's z-index to a larger number","feedback":"A larger number remains constrained by parent stacking contexts and clipping boundaries.","correct":false},{"id":"inspect-parents","label":"Inspect parent overflow, positioning, and stacking contexts","feedback":"Clipping is usually not a number problem. Find the parent boundary first, then choose the correct layer placement.","correct":true},{"id":"raise-all-layers","label":"Increase the z-index of the card and every child together","feedback":"Raising the whole card can cover other overlays without removing the card's own clipping behavior.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"下拉菜单设了很大的 z-index 仍被卡片裁掉。请先检查父级 overflow、定位和层叠上下文，找到真正限制它的边界后再修，不要继续堆数字。请验证菜单能盖过卡片，但不会压住弹窗和全局导航。","en":{"title":"You can say this to an AI Agent","text":"The dropdown is clipped despite a large z-index. Inspect parent overflow, positioning, and stacking contexts before changing the layer strategy; do not keep increasing numbers. Verify it clears the card without covering modals or global navigation."}},"references":[{"title":"z-index 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/z-index","title_en":"z-index"},{"title":"层叠上下文","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_positioned_layout/Stacking_context","title_en":"Stacking context"}],"scenes":["弹窗盖过页面","吸顶导航","下拉菜单浮层","右下角悬浮按钮"],"en":{"use":[{"t":"Keep a dropdown above nearby content","m":"modal-confirm"},{"t":"Place a dialog above its backdrop","m":"zindex-fixed"},{"t":"Order sticky and floating elements","m":"zindex-float"},{"t":"Create a shared layer scale","m":"zindex-scale"}],"dont":[{"t":"Keep increasing the number without checking the stacking context","m":"zindex-static","bad":true},{"t":"Give every component its own arbitrary z-index","m":"zindex-9999","bad":true},{"t":"Place ordinary content above a modal","m":"zindex-nested","bad":true},{"t":"Use layering to hide a layout or clipping problem","m":"zindex-dom","bad":true}],"scenes":["Dropdown layer","Sticky header","Modal","Tooltip"],"sceneUI":["<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\">\n        <i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:64%\"></i>\n        <span class=\"zindex-sc-chip\" style=\"align-self:flex-start;background:var(--bg-hover);color:var(--text-3)\">Page z-index: 1</span>\n      </div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <span class=\"zindex-sc-chip\" style=\"position:absolute;left:10px;bottom:10px\">Mask z-index: 1000</span>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:240px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow-float)\">\n        <span class=\"zindex-sc-chip\" style=\"position:absolute;top:-10px;right:12px\">Pop-up z-index: 1001</span>\n        <b style=\"font-size:13px\">Confirm to log out? </b>\n        <div style=\"display:fl