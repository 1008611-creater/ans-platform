color:var(--on-status);font-size:12px;border-radius:99px;padding:1px 6px;box-shadow:0 2px 6px rgba(0,0,0,.18)\">3</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;background:var(--bg);border:1px solid var(--border-light);border-radius:10px;padding:10px 12px\">\n      <img src=\"/assets/avatar-robot.png\" style=\"width:34px;height:34px;border-radius:50%\" alt=\"\">\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"font-size:12px;font-weight:600\">Vibe Assistant</div>\n        <div style=\"font-size:12px;color:var(--text-3)\">Your page is live now</div>\n      </div>\n      <span style=\"font-size:12px;color:var(--text-3)\">09:50</span>\n    </div>\n  </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft);border:1px solid var(--border-light);padding:14px 16px\">\n    <div style=\"display:flex;flex-direction:column;gap:8px\">\n      <i class=\"mk-line\" style=\"width:42%\"></i>\n      <div style=\"background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:55%\"></i></div>\n      <div style=\"background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px\"><i class=\"mk-line\" style=\"width:70%\"></i></div>\n    </div>\n    <span style=\"position:absolute;right:14px;bottom:14px;width:42px;height:42px;border-radius:50%;background:var(--brand);color:var(--on-brand);display:flex;align-items:center;justify-content:center;font-size:22px;line-height:1;box-shadow:0 6px 16px rgba(0,0,0,.22)\">＋</span>\n  </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;border:1px solid var(--border-light);background:var(--bg-soft)\">\n    <div style=\"padding:12px 16px;display:flex;flex-direction:column;gap:8px\">\n      <i class=\"mk-line\" style=\"width:64%\"></i>\n      <i class=\"mk-line\" style=\"width:88%\"></i>\n      <i class=\"mk-line\" style=\"width:52%\"></i>\n      <i class=\"mk-line\" style=\"width:76%\"></i>\n    </div>\n    <div style=\"position:absolute;top:0;left:0;right:0;display:flex;align-items:center;gap:14px;height:38px;padding:0 16px;background:var(--bg);border-bottom:1px solid var(--border-light);box-shadow:0 2px 10px rgba(0,0,0,.08)\">\n      <b style=\"font-size:13px;color:var(--brand)\">Vibe Guide</b>\n      <span style=\"font-size:12px;color:var(--text);border-bottom:2px solid var(--brand);padding:8px 0 6px\">Components</span>\n      <span style=\"font-size:12px;color:var(--text-3)\">Concepts</span>\n      <span style=\"font-size:12px;color:var(--text-3)\">Practice</span>\n    </div>\n  </div>","<div style=\"position:relative;height:150px;padding:12px 14px\">\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <b style=\"font-size:13px;flex:1\">Members</b>\n      <button class=\"btn btn-outline\">Role: All ▾</button>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;padding:9px 2px;border-bottom:1px solid var(--border-light)\">\n      <img src=\"/assets/avatar-fox.png\" style=\"width:26px;height:26px;border-radius:50%\" alt=\"\">\n      <span style=\"font-size:12px;flex:1\">Maya</span><span class=\"demo-tag blue\">Admin</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;padding:9px 2px\">\n      <img src=\"/assets/avatar-robot.png\" style=\"width:26px;height:26px;border-radius:50%\" alt=\"\">\n      <span style=\"font-size:12px;flex:1\">Alex</span><span class=\"demo-tag gray\">Guest</span>\n    </div>\n    <div style=\"position:absolute;top:44px;right:14px;width:150px;background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.14);padding:4px\">\n      <div style=\"display:flex;align-items:center;justify-content:space-between;font-size:12px;padding:6px 10px;border-radius:5px;background:var(--brand-light);color:var(--brand)\">All roles <span>✓</span></div>\n      <div style=\"font-size:12px;padding:6px 10px;color:var(--text)\">Admin</div>\n      <div style=\"font-size:12px;padding:6px 10px;color:var(--text)\">Editor</div>\n    </div>\n  </div>"],"anatomy":{"demo":"<span class=\"pos-anat\"><span class=\"ap\" data-ap=\"anchor\"><span class=\"pos-anat-anchor\"><i class=\"pos-anat-line\"></i><i class=\"pos-anat-line short\"></i><span class=\"ap\" data-ap=\"element\"><span class=\"pos-anat-el\">角标</span></span></span></span><span class=\"ap\" data-ap=\"offset\"><span class=\"pos-anat-tag\">top: 0 · right: 0</span></span><span class=\"ap\" data-ap=\"layer\"><span class=\"pos-anat-tag\">z-index: 1 压得住内容</span></span></span>","demo_en":"<span class=\"pos-anat\"><span class=\"ap\" data-ap=\"anchor\"><span class=\"pos-anat-anchor\"><i class=\"pos-anat-line\"></i><i class=\"pos-anat-line short\"></i><span class=\"ap\" data-ap=\"element\"><span class=\"pos-anat-el\">anchor</span></span></span></span><span class=\"ap\" data-ap=\"offset\"><span class=\"pos-anat-tag\">top: 0 · right: 0</span></span><span class=\"ap\" data-ap=\"layer\"><span class=\"pos-anat-tag\">z-index: 1 · May cover other content</span></span></span>","parts":[{"key":"anchor","cn":"包含块","en":"Containing Block","desc":"absolute 常由最近的定位祖先确定包含块；transform、contain 等也可能建立包含块，找不到时参照初始包含块，不要笼统称 body","desc_en":"Absolute often determines the containing block from the nearest positioning ancestor; transform, contain, etc. may also create a containing block. If it cannot be found, refer to the initial containing block. Do not call it body in general."},{"key":"element","cn":"定位元素","en":"Positioned Element","desc":"position 不是 static 的那个，才能用偏移量","desc_en":"Only if the position is not static can you use offset"},{"key":"offset","cn":"偏移量","en":"Offsets","desc":"top / right / bottom / left，决定离参照物各边多远","desc_en":"top / right / bottom / left, determine how far away from each side of the reference object"},{"key":"layer","cn":"层叠","en":"Stacking","desc":"z-index 可用于定位元素和 flex/grid 子项；先比较所在的层叠上下文，再比较数值","desc_en":"z-index can be used to position elements and flex/grid children; compare the stacking context first, and then compare the values"}]},"variants":[{"cn":"默认","en":"Static","demo":"<span style=\"display:flex;flex-direction:column;gap:4px;width:96px\"><i style=\"height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span class=\"pos-v-box\">static</span><i style=\"height:5px;border-radius:3px;background:var(--bg-hover);width:78%\"></i></span>","demo_en":"<span style=\"display:flex;flex-direction:column;gap:4px;width:96px\"><i style=\"height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span class=\"pos-v-box\">static</span><i style=\"height:5px;border-radius:3px;background:var(--bg-hover);width:78%\"></i></span>","when":"默认就是它，跟着文档流排队","when_en":"This is it by default, queuing with the document flow"},{"cn":"相对自己","en":"Relative","demo":"<span style=\"position:relative;display:inline-block\"><span class=\"pos-v-ghost\"></span><span class=\"pos-v-box\" style=\"position:relative;left:10px;top:-7px\">relative</span></span>","demo_en":"<span style=\"position:relative;display:inline-block\"><span class=\"pos-v-ghost\"></span><span class=\"pos-v-box\" style=\"position:relative;left:10px;top:-7px\">relative</span></span>","when":"微调位置，或给子元素当锚点","when_en":"Fine-tune the position, or use anchor points for child elements"},{"cn":"相对祖先","en":"Absolute","demo":"<span style=\"position:relative;display:inline-block;padding:9px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px\"><i style=\"display:block;width:56px;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"position:absolute;top:-7px;right:-7px;background:var(--red);color:var(--on-status);font-size:12px;padding:1px 6px;border-radius:99px\">3</span></span>","demo_en":"<span style=\"position:relative;display:inline-block;padding:9px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px\"><i style=\"display:block;width:56px;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"position:absolute;top:-7px;right:-7px;background:var(--red);color:var(--on-status);font-size:12px;padding:1px 6px;border-radius:99px\">3</span></span>","when":"角标浮层，相对最近的定位祖先","when_en":"Corner floating layer, relatively recent positioning ancestor"},{"cn":"钉在视口","en":"Fixed","demo":"<span style=\"position:relative;display:inline-block;width:76px;height:48px;background:var(--bg);border:1px solid var(--border);border-radius:6px;overflow:hidden\"><i style=\"display:block;margin:6px 8px;width:70%;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><i style=\"display:block;margin:6px 8px;width:50%;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"position:absolute;right:4px;bottom:4px;width:14px;height:14px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:12px;display:flex;align-items:center;justify-content:center\">＋</span></span>","demo_en":"<span style=\"position:relative;display:inline-block;width:76px;height:48px;background:var(--bg);border:1px solid var(--border);border-radius:6px;overflow:hidden\"><i style=\"display:block;margin:6px 8px;width:70%;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><i style=\"display:block;margin:6px 8px;width:50%;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"position:absolute;right:4px;bottom:4px;width:14px;height:14px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:12px;display:flex;align-items:center;justify-content:center\">＋</span></span>","when":"悬浮按钮、固钉操作，滚动不跟走","when_en":"Floating button and pin operation, scrolling does not follow"},{"cn":"到点吸住","en":"Sticky","demo":"<span class=\"sticky-v\"><span class=\"sticky-v-bar\">top: 0</span><span class=\"sticky-v-lines\"><i></i><i></i></span></span>","demo_en":"<span class=\"sticky-v\"><span class=\"sticky-v-bar\">top: 0</span><span class=\"sticky-v-lines\"><i></i><i></i></span></span>","when":"表头、导航滚到设定位置才吸住","when_en":"The meter header and navigation scroll to the set position and then snap."}],"use":[{"t":"在相对定位的卡片中放置绝对定位的角标","m":"pos-badge"},{"t":"<b>右下角悬浮按钮</b>：fixed 钉在视口，滚动也不动","m":"pos-fab"},{"t":"<b>吸顶导航、筛选栏</b>：sticky 滚到点才吸住，见 {c:sticky}","m":"sticky-nav"},{"t":"让下拉菜单和文字提示贴着触发元素出现","m":"zindex-float"}],"dont":[{"t":"绝对定位找错参照父级，元素会偏离预期位置","m":"pos-lost","bad":true},{"t":"元素还是 static 就写 {c:z-index}：<b>普通块级元素上的 z-index 通常不参与排序</b>，但 flex/grid 子项是例外；还要检查层叠上下文","m":"zindex-static","bad":true},{"t":"拿 <b>fixed 当吸顶</b>用：脱离文档流，不是盖住内容就是要手动补占位","m":"sticky-fixed","bad":true},{"t":"整页依赖<b>absolute 固定坐标</b>：内容变长时容易错位","m":"pos-absolute-layout","bad":true}],"lessonPractice":{"title":"“新品”角标要始终贴在商品卡片右上角，并随着卡片一起移动和换行。怎样定位最稳妥？","options":[{"id":"relative-card-absolute-badge","label":"让卡片建立定位参照，再把角标绝对定位到右上角","feedback":"父卡片成为明确参照后，角标偏移会相对卡片计算，并随卡片整体移动。","correct":true},{"id":"fixed-to-viewport","label":"把角标固定定位到视口右上角，再根据卡片位置调整数值","feedback":"Fixed 相对视口且脱离卡片，滚动或卡片换行后角标不会继续跟随目标。","correct":false},{"id":"unscoped-absolute","label":"只给角标设置 absolute 和较大的 top、right，不修改父级","feedback":"没有建立预期参照时，角标可能相对更远的包含块定位，页面变化后容易偏离卡片。","correct":false}],"en":{"title":"A New badge must stay on the top-right of its product card and move and wrap with the card. What positioning is most reliable?","options":[{"id":"relative-card-absolute-badge","label":"Establish the card as the positioning reference and absolutely position the badge at its top-right","feedback":"Once the parent card is the reference, badge offsets are calculated from it and move with the whole card.","correct":true},{"id":"fixed-to-viewport","label":"Fix the badge to the viewport's top-right and tune offsets to match the card","feedback":"Fixed positioning follows the viewport rather than the card, so scrolling and wrapping separate badge from target.","correct":false},{"id":"unscoped-absolute","label":"Only set absolute with large top and right values and leave every parent unchanged","feedback":"Without the intended reference, the badge may position against a distant containing block and drift as layout changes.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请让商品卡片作为角标的定位参照，角标绝对定位在卡片右上角，不要相对视口写固定坐标。用不同高度的卡片、网格换列和页面滚动验证角标始终跟随自己的卡片。","en":{"title":"You can say this to an AI Agent","text":"Make each product card the positioning reference and place its badge absolutely at the card's top-right, without viewport-based fixed coordinates. Test varied card heights, grid column changes, and page scrolling."}},"references":[{"title":"position 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/position","title_en":"position"}],"scenes":["卡片右上角角标","右下角悬浮按钮","吸顶导航","下拉与气泡浮层"],"en":{"use":[{"t":"Anchor a badge to an icon","m":"pos-badge"},{"t":"Fix a floating control to the viewport","m":"pos-fab"},{"t":"Create a reference for an overlay inside a component","m":"sticky-nav"},{"t":"Keep normal content in document flow by default","m":"zindex-float"}],"dont":[{"t":"Absolutely position the main page layout","m":"pos-lost","bad":true},{"t":"Use fixed coordinates that only fit one screen","m":"zindex-static","bad":true},{"t":"Remove content from flow without reserving its space","m":"sticky-fixed","bad":true},{"t":"Choose a position mode before identifying its reference box","m":"pos-absolute-layout","bad":true}],"scenes":["Badge on avatar","Floating button","Popover anchor","Sticky toolbar"],"sceneUI":["<div style=\"display:flex;flex-direction:column;gap:10px;max-width:340px;margin:0 auto;padding-top:8px\">\n    <div style=\"position:relative;display:flex;align-items:center;gap:10px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n      <img src=\"/assets/avatar-fox.png\" style=\"width:34px;height:34px;border-radius:50%\" alt=\"\">\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"font-size:12px;font-weight:600\">Design Crew</div>\n        <div style=\"font-size:12px;color:var(--text-3)\">New homepage draft just dropped</div>\n      </div>\n      <span style=\"font-size:12px;color:var(--text-3)\">10:24</span>\n      <span style=\"position:absolute;top:-6px;right:-6px;background:var(--red);color:var(--on-status);font-size:12px;border-radius:99px;padding:1px 6px;box-shadow:0 2px 6px rgba(0,0,0,.18)\">3</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;background:var(--bg);border:1px solid var(--border-light);border-radius:10px;padding:10px 12px\">\n      <img src=\"/assets/avatar-robot.png\" style=\"width:34px;height:34px;border-radius:50%\" alt=\"\">\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"font-size:12px;font-weight:600\">Vibe Assistant</div>\n        <div style=\"font-size:12px;color:var(--text-3)\">Your page is live now</div>\n      </div>\n      <span style=\"font-size:12px;color:var(--text-3)\">09:50</span>\n    </div>\n  </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft);border:1px solid var(--border-light);padding:14px 16px\">\n    <div style=\"display:flex;flex-direction:column;gap:8px\">\n      <i class=\"mk-line\" style=\"width:42%\"></i>\n      <div style=\"background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:55%\"></i></div>\n      <div style=\"background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px\"><i class=\"mk-line\" style=\"width:70%\"></i></div>\n    </div>\n    <span style=\"position:absolute;right:14px;bottom:14px;width:42px;height:42px;border-radius:50%;background:var(--brand);color:var(--on-brand);display:flex;align-items:center;justify-content:center;font-size:22px;line-height:1;box-shadow:0 6px 16px rgba(0,0,0,.22)\">＋</span>\n  </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;border:1px solid var(--border-light);background:var(--bg-soft)\">\n    <div style=\"padding:12px 16px;display:flex;flex-direction:column;gap:8px\">\n      <i class=\"mk-line\" style=\"width:64%\"></i>\n      <i class=\"mk-line\" style=\"width:88%\"></i>\n      <i class=\"mk-line\" style=\"width:52%\"></i>\n      <i class=\"mk-line\" style=\"width:76%\"></i>\n    </div>\n    <div style=\"position:absolute;top:0;left:0;right:0;display:flex;align-items:center;gap:14px;height:38px;padding:0 16px;background:var(--bg);border-bottom:1px solid var(--border-light);box-shadow:0 2px 10px rgba(0,0,0,.08)\">\n      <b style=\"font-size:13px;color:var(--brand)\">Vibe Guide</b>\n      <span style=\"font-size:12px;color:var(--text);border-bottom:2px solid var(--brand);padding:8px 0 6px\">Components</span>\n      <span style=\"font-size:12px;color:var(--text-3)\">Concepts</span>\n      <span style=\"font-size:12px;color:var(--text-3)\">Practice</span>\n    </div>\n  </div>","<div style=\"position:relative;height:150px;padding:12px 14px\">\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <b style=\"font-size:13px;flex:1\">Members</b>\n      <button class=\"btn btn-outline\">Role: All ▾</button>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;padding:9px 2px;border-bottom:1px solid var(--border-light)\">\n      <img src=\"/assets/avatar-fox.png\" style=\"width:26px;height:26px;border-radius:50%\" alt=\"\">\n      <span style=\"font-size:12px;flex:1\">Maya</span><span class=\"demo-tag blue\">Admin</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;padding:9px 2px\">\n      <img src=\"/assets/avatar-robot.png\" style=\"width:26px;height:26px;border-radius:50%\" alt=\"\">\n      <span style=\"font-size:12px;flex:1\">Alex</span><span class=\"demo-tag gray\">Guest</span>\n    </div>\n    <div style=\"position:absolute;top:44px;right:14px;width:150px;background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.14);padding:4px\">\n      <div style=\"display:flex;align-items:center;justify-content:space-between;font-size:12px;padding:6px 10px;border-radius:5px;background:var(--brand-light);color:var(--brand)\">All roles <span>✓</span></div>\n      <div style=\"font-size:12px;padding:6px 10px;color:var(--text)\">Admin</div>\n      <div style=\"font-size:12px;padding:6px 10px;color:var(--text)\">Editor</div>\n    </div>\n  </div>"],"variants":[{"demo":"<span style=\"display:flex;flex-direction:column;gap:4px;width:96px\"><i style=\"height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span class=\"pos-v-box\">static</span><i style=\"height:5px;border-radius:3px;background:var(--bg-hover);width:78%\"></i></span>","when":"This is it by default, queuing with the document flow"},{"demo":"<span style=\"position:relative;display:inline-block\"><span class=\"pos-v-ghost\"></span><span class=\"pos-v-box\" style=\"position:relative;left:10px;top:-7px\">relative</span></span>","when":"Fine-tune the position, or use anchor points for child elements"},{"demo":"<span style=\"position:relative;display:inline-block;padding:9px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px\"><i style=\"display:block;width:56px;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"position:absolute;top:-7px;right:-7px;background:var(--red);color:var(--on-status);font-size:12px;padding:1px 6px;border-radius:99px\">3</span></span>","when":"Corner floating layer, relatively recent positioning ancestor"},{"demo":"<span style=\"position:relative;display:inline-block;width:76px;height:48px;background:var(--bg);border:1px solid var(--border);border-radius:6px;overflow:hidden\"><i style=\"display:block;margin:6px 8px;width:70%;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><i style=\"display:block;margin:6px 8px;width:50%;height:5px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"position:absolute;right:4px;bottom:4px;width:14px;height:14px;border-radius:50%;background:var(--brand);color:var(--on-brand);font-size:12px;display:flex;align-items:center;justify-content:center\">＋</span></span>","when":"Floating button and pin operation, scrolling does not follow"},{"demo":"<span class=\"sticky-v\"><span class=\"sticky-v-bar\">top: 0</span><span class=\"sticky-v-lines\"><i></i><i></i></span></span>","when":"The meter header and navigation scroll to the set position and then snap."}]},"usageMocks":{"pos-badge":"<div class=\"mk-win\" style=\"position:relative;width:130px\"><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:50%\"></i><span style=\"position:absolute;top:-5px;right:-5px;background:var(--red);color:var(--on-status);font-size:11px;border-radius:99px;padding:1px 6px\">3</span></div><span style=\"font-size:12px;color:var(--text-3)\">父卡片 relative，角标 absolute 贴右上角</span>","pos-fab":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:72%\"></i></div><span style=\"position:absolute;right:10px;bottom:10px;width:22px;height:22px;border-radius:50%;background:var(--brand);color:var(--on-brand);display:flex;align-items:center;justify-content:center;font-size:12px;box-shadow:0 4px 10px rgba(29,33,41,.25)\">＋</span></div><span style=\"font-size:12px;color:var(--text-3)\">fixed 钉在视口右下角，滚动不跟走</span>","sticky-nav":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:70%\"></i></div><span style=\"position:absolute;top:0;left:0;right:0;height:14px;background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 6px;font-size:11px;color:var(--text-2);z-index:2\">筛选栏 · sticky 吸顶</span></div><span style=\"font-size:12px;color:var(--text-3)\">滚到顶部才吸住，之前跟着内容走</span>","zindex-float":"<div class=\"mk-win\" style=\"position:relative\"><span class=\"mk-select\">全部状态<i class=\"mk-caret\"></i></span><span class=\"mk-drop\" style=\"position:absolute;top:26px;left:10px;z-index:2\"><span class=\"mk-opt\">全部状态</span><span class=\"mk-opt on\">进行中</span></span><i class=\"mk-line\" style=\"width:70%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">下拉浮在内容上，不被裁不被盖</span>","pos-lost":"<div class=\"mk-scene\"><span style=\"position:absolute;top:26px;left:10px;right:40px;height:34px;background:var(--bg);border:1px dashed var(--red);border-radius:5px;display:flex;flex-direction:column;gap:4px;padding:5px 7px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:40%\"></i></span><span style=\"position:absolute;top:2px;right:2px;background:var(--red);color:var(--on-status);font-size:11px;border-radius:99px;padding:1px 6px\">角标飞到角落</span><span style=\"position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:12px;color:var(--red)\">卡片没写 relative，absolute 参照了 body</span></div>","zindex-static":"<div class=\"mk-win\"><i class=\"mk-line\" style=\"width:60%\"></i><span style=\"background:var(--red-light);color:var(--red);font-size:12px;padding:2px 8px;border-radius:3px;align-self:flex-start\">z-index: 99 但没设 position</span><i class=\"mk-line\" style=\"width:75%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">static 元素上 z-index 无效</span>","sticky-fixed":"<div class=\"mk-scene\"><span style=\"position:absolute;top:0;left:0;right:0;height:14px;background:var(--bg);border-bottom:1px solid var(--red);display:flex;align-items:center;padding:0 6px;font-size:11px;color:var(--red);z-index:2\">fixed 栏</span><div class=\"mk-skel\" style=\"top:0\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:65%\"></i></div><span style=\"position:absolute;bottom:6px;left:0;right:0;text-align:center;font-size:12px;color:var(--red)\">fixed 脱离文档流，把第一行内容盖住了</span></div>","pos-absolute-layout":"<div class=\"mk-scene\" style=\"height:96px\"><span style=\"position:absolute;top:6px;left:8px;width:58px;height:18px;background:var(--bg);border:1px solid var(--red);border-radius:3px;font-size:11px;color:var(--red);display:flex;align-items:center;justify-content:center\">top:6 left:8</span><span style=\"position:absolute;top:18px;left:62px;width:62px;height:18px;background:var(--bg);border:1px solid var(--red);border-radius:3px;font-size:11px;color:var(--red);display:flex;align-items:center;justify-content:center\">top:18 left:62</span><span style=\"position:absolute;top:42px;left:28px;width:66px;height:18px;background:var(--bg);border:1px solid var(--red);border-radius:3px;font-size:11px;color:var(--red);display:flex;align-items:center;justify-content:center\">top:42 left:28</span><span style=\"position:absolute;bottom:5px;left:0;right:0;text-align:center;font-size:12px;color:var(--red)\">全写死坐标，内容一变长全错位</span></div>"}}}