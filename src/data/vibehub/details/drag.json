{"__formatVersion":2,"__revision":"780e90d263318d60","__entryId":"drag","entry":{"sceneUI":["<div style=\"position:relative;display:flex;gap:12px;justify-content:center;height:118px\">\n      <div style=\"width:150px;background:var(--bg-soft);border:1px solid var(--border-light);border-radius:10px;padding:8px\">\n        <div style=\"font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px\">待办 · 1</div>\n        <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text)\">接口联调</div>\n      </div>\n      <div style=\"width:150px;background:var(--bg-soft);border:1px solid var(--border-light);border-radius:10px;padding:8px\">\n        <div style=\"font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px\">进行中 · 2</div>\n        <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text);margin-bottom:5px\">首页视觉走查</div>\n        <div style=\"border:1.5px dashed var(--brand);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--brand);background:var(--brand-light)\">放到这一列</div>\n      </div>\n      <div style=\"position:absolute;left:calc(50% - 70px);top:32px;width:140px;background:var(--bg);border:1px solid var(--brand);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text);opacity:.94;transform:rotate(-3deg);box-shadow:0 12px 24px rgba(29,33,41,.24)\">登录页改版</div>\n    </div>","<div style=\"position:relative;max-width:380px;margin:0 auto;padding-top:10px\">\n      <div style=\"position:absolute;right:24px;top:-3px;display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--text-2);box-shadow:0 8px 18px rgba(29,33,41,.18);transform:rotate(-2deg);opacity:.95\">📎 设计规范.md</div>\n      <div style=\"border:1.5px dashed var(--brand);border-radius:12px;background:var(--brand-light);padding:16px 12px 13px;text-align:center\">\n        <div style=\"font-size:20px;color:var(--brand)\">⬆</div>\n        <div style=\"font-size:12px;font-weight:600;color:var(--brand);margin-top:3px\">松开鼠标，上传到「项目文件」</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:2px\">设计规范.md · 2.4 MB</div>\n      </div>\n    </div>","<div style=\"position:relative;max-width:340px;margin:0 auto;display:flex;flex-direction:column;gap:5px;padding-top:12px\">\n      <span class=\"drag-item\">⠿ 写需求文档</span>\n      <span class=\"drag-slot\">放到这里</span>\n      <span class=\"drag-item\">⠿ 评审视觉稿</span>\n      <span style=\"position:absolute;left:10px;right:-8px;top:0;background:var(--bg);border:1px solid var(--brand);border-radius:6px;padding:8px 12px;font-size:12px;color:var(--text);opacity:.93;transform:rotate(-1.5deg);box-shadow:0 10px 22px rgba(29,33,41,.22)\">⠿ 约客户访谈</span>\n    </div>","<div style=\"position:relative;display:flex;height:110px;max-width:420px;margin:0 auto;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg)\">\n      <div style=\"width:34%;border-right:1px solid var(--border-light);padding:9px 10px\">\n        <div style=\"font-size:12px;font-weight:600;margin-bottom:7px\">文件</div>\n        <i class=\"mk-line\" style=\"width:82%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:64%\"></i>\n      </div>\n      <div style=\"flex:1;padding:9px 10px\">\n        <div style=\"font-size:12px;font-weight:600;margin-bottom:7px\">预览</div>\n        <i class=\"mk-line\" style=\"width:90%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:70%\"></i>\n      </div>\n      <div style=\"position:absolute;left:34%;top:0;bottom:0;width:5px;background:var(--brand);transform:translateX(-50%)\"></div>\n      <span style=\"position:absolute;left:34%;top:50%;transform:translate(-50%,-50%);background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:3px 8px;border-radius:5px;white-space:nowrap\">↔ 320 px</span>\n    </div>"],"sceneUI_en":["<div style=\"position:relative;display:flex;gap:12px;justify-content:center;height:118px\">\n      <div style=\"width:150px;background:var(--bg-soft);border:1px solid var(--border-light);border-radius:10px;padding:8px\">\n        <div style=\"font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px\">To do · 1</div>\n        <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text)\">Integration testing</div>\n      </div>\n      <div style=\"width:150px;background:var(--bg-soft);border:1px solid var(--border-light);border-radius:10px;padding:8px\">\n        <div style=\"font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px\">In progress · 2</div>\n        <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text);margin-bottom:5px\">Review homepage visuals</div>\n        <div style=\"border:1.5px dashed var(--brand);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--brand);background:var(--brand-light)\">Drop in this column</div>\n      </div>\n      <div style=\"position:absolute;left:calc(50% - 70px);top:32px;width:140px;background:var(--bg);border:1px solid var(--brand);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text);opacity:.94;transform:rotate(-3deg);box-shadow:0 12px 24px rgba(29,33,41,.24)\">Update login page</div>\n    </div>","<div style=\"position:relative;max-width:380px;margin:0 auto;padding-top:10px\">\n      <div style=\"position:absolute;right:24px;top:-3px;display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--text-2);box-shadow:0 8px 18px rgba(29,33,41,.18);transform:rotate(-2deg);opacity:.95\">📎 Design specs.md</div>\n      <div style=\"border:1.5px dashed var(--brand);border-radius:12px;background:var(--brand-light);padding:16px 12px 13px;text-align:center\">\n        <div style=\"font-size:20px;color:var(--brand)\">⬆</div>\n        <div style=\"font-size:12px;font-weight:600;color:var(--brand);margin-top:3px\">Drop to upload to Project files</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:2px\">Design specs.md · 2.4 MB</div>\n      </div>\n    </div>","<div style=\"position:relative;max-width:340px;margin:0 auto;display:flex;flex-direction:column;gap:5px;padding-top:12px\">\n      <span class=\"drag-item\">⠿ Draft requirements</span>\n      <span class=\"drag-slot\">Drop here</span>\n      <span class=\"drag-item\">⠿ Review visual design</span>\n      <span style=\"position:absolute;left:10px;right:-8px;top:0;background:var(--bg);border:1px solid var(--brand);border-radius:6px;padding:8px 12px;font-size:12px;color:var(--text);opacity:.93;transform:rotate(-1.5deg);box-shadow:0 10px 22px rgba(29,33,41,.22)\">⠿ Schedule a customer call</span>\n    </div>","<div style=\"position:relative;display:flex;height:110px;max-width:420px;margin:0 auto;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg)\">\n      <div style=\"width:34%;border-right:1px solid var(--border-light);padding:9px 10px\">\n        <div style=\"font-size:12px;font-weight:600;margin-bottom:7px\">Files</div>\n        <i class=\"mk-line\" style=\"width:82%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:64%\"></i>\n      </div>\n      <div style=\"flex:1;padding:9px 10px\">\n        <div style=\"font-size:12px;font-weight:600;margin-bottom:7px\">Preview</div>\n        <i class=\"mk-line\" style=\"width:90%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:70%\"></i>\n      </div>\n      <div style=\"position:absolute;left:34%;top:0;bottom:0;width:5px;background:var(--brand);transform:translateX(-50%)\"></div>\n      <span style=\"position:absolute;left:34%;top:50%;transform:translate(-50%,-50%);background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:3px 8px;border-radius:5px;white-space:nowrap\">↔ 320 px</span>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"handle\"><span class=\"drag-item\">⠿ 任务 B</span></span><span class=\"ap\" data-ap=\"ghost\"><span class=\"drag-ghost drag-ghost-static\">任务 B</span></span><span class=\"ap\" data-ap=\"slot\"><span class=\"drag-slot\">放到这里</span></span><span class=\"ap\" data-ap=\"alt\"><span class=\"drag-anat-chip\">↑↓ 按钮替代</span></span>","demo_en":"<span class=\"ap\" data-ap=\"handle\"><span class=\"drag-item\">⠿ Task B</span></span><span class=\"ap\" data-ap=\"ghost\"><span class=\"drag-ghost drag-ghost-static\">Task B</span></span><span class=\"ap\" data-ap=\"slot\"><span class=\"drag-slot\">Put here</span></span><span class=\"ap\" data-ap=\"alt\"><span class=\"drag-anat-chip\">↑↓ button replacement</span></span>","parts":[{"key":"handle","cn":"拖拽柄","en":"Handle","desc":"提示“能拖”，也圈定拖的热区","desc_en":"It prompts \"can be towed\" and also delimits the hot spots for towing."},{"key":"ghost","cn":"拖拽影像","en":"Ghost","desc":"跟着指针走的半透明分身","desc_en":"A translucent clone that follows the pointer"},{"key":"slot","cn":"目标占位","en":"Drop Slot","desc":"松手后会落进去的位置","desc_en":"The place where you will fall when you let go"},{"key":"alt","cn":"替代操作","en":"Alternative","desc":"按钮也能完成同样的事","desc_en":"Buttons can do the same thing"}]},"variants":[{"cn":"列表排序","en":"Reorder","demo":"<span class=\"drag-v-list\"><i>A</i><i class=\"on\">B</i><i>C</i></span>","demo_en":"<span class=\"drag-v-list\"><i>A</i><i class=\"on\">B</i><i>C</i></span>","when":"任务、看板拖动排序","when_en":"Drag and sort tasks and Kanban boards"},{"cn":"拖放区域","en":"Drop Zone","demo":"<span class=\"drag-v-zone\">拖文件到这里</span>","demo_en":"<span class=\"drag-v-zone\">Drag files here</span>","when":"文件拖进区域上传","when_en":"Drag files into the area to upload"},{"cn":"拖拽手柄","en":"Handle","demo":"<span class=\"drag-item\">⠿ 任务 B</span>","demo_en":"<span class=\"drag-item\">⠿ Task B</span>","when":"需要明确标出可开始拖动的位置","when_en":"Need to clearly mark where you can start dragging"}],"use":[{"t":"<b>拖拽中给反馈</b>：被拖元素浮起 + 半透明，用户知道“拖着呢”","m":"drag-floating"},{"t":"<b>目标位置占位</b>：虚线框提前画出松手后会落在哪","m":"drag-placeholder"},{"t":"<b>提供替代操作</b>：上移 / 下移按钮也能完成排序","m":"drag-alt"},{"t":"<b>拖拽手柄提示入口</b>：⠿ 可说明从哪里开始拖动","m":"drag-handle"}],"dont":[{"t":"<b>拖拽没有反馈</b>：元素状态和目标区域都不变化，用户无法确认是否抓取成功","m":"drag-no-feedback","bad":true},{"t":"<b>只能拖拽</b>：没有按钮或菜单替代，键盘用户和无法精确拖动的用户不能完成操作","m":"drag-only-way","bad":true},{"t":"<b>触屏拖拽未处理手势冲突</b>：页面滚动与拖动会相互抢占","m":"drag-touch","bad":true},{"t":"<b>整行都是拖拽热区</b>：想选中文字，结果把整行拖走了","m":"drag-accident","bad":true}],"lessonPractice":{"title":"任务卡支持拖拽排序，但键盘用户和手抖用户也要能调整顺序。哪套设计更完整？","options":[{"id":"drag-only","label":"只支持拖拽，并用更大的阴影表示抓取成功","feedback":"视觉反馈能说明拖拽状态，却没有给无法稳定拖动的人提供完成排序的方式。","correct":false},{"id":"drag-and-alternative","label":"显示拖拽手柄和落点，同时提供上移、下移操作","feedback":"拖动过程有清楚反馈，替代按钮又让键盘和精细操作困难的用户完成同一任务。","correct":true},{"id":"whole-row-handle","label":"把整张卡片设成拖拽区，取消文字选择和普通点击","feedback":"扩大热区会和选择文字、点击链接等操作冲突，也没有解决键盘排序问题。","correct":false}],"en":{"title":"Task cards support drag reordering, but keyboard users and people with unsteady movement must also change the order. Which design is complete?","options":[{"id":"drag-only","label":"Support dragging only and use a stronger shadow to confirm pickup","feedback":"The shadow explains drag state but provides no way to reorder for someone who cannot drag reliably.","correct":false},{"id":"drag-and-alternative","label":"Show a drag handle and drop position, plus Move up and Move down actions","feedback":"Drag feedback clarifies the gesture, while alternative actions let keyboard and motor-impaired users complete the same task.","correct":true},{"id":"whole-row-handle","label":"Make the whole card draggable and disable text selection and normal clicks","feedback":"A full-card drag target conflicts with selecting text and using links, and it still lacks keyboard reordering.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请完善任务排序：提供明确拖拽手柄、被拖状态和落点占位，同时增加上移、下移按钮。不要把整张卡片都设成拖拽区。请用鼠标、触屏和键盘调整同一张卡片，并确认最终顺序一致。","en":{"title":"You can say this to an AI Agent","text":"Improve task reordering with a clear drag handle, picked-up state, and drop placeholder, plus Move up and Move down actions. Do not make the whole card a drag target. Reorder the same card with mouse, touch, and keyboard and verify the final order."}},"demoDetail":"<div class=\"drag-play\">\n    <div class=\"drag-lane\">\n      <span class=\"drag-live\" data-drag>⠿ 任务 A</span>\n      <span class=\"drag-live alt\" data-drag>⠿ 任务 B</span>\n      <span class=\"drag-target\">放到这里</span>\n    </div>\n    <span class=\"drag-hint\">按住卡片拖动，观察拖拽时的阴影和位置反馈；松手后恢复原位</span>\n  </div>","references":[{"title":"拖放：如何设计才好用","source":"NN/g","url":"https://www.nngroup.com/articles/drag-drop/","title_en":"Drag-and-Drop: How to Design for Ease of Use"},{"title":"HTML 拖放 API","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/API/HTML_Drag_and_Drop_API","title_en":"HTML Drag and Drop API"}],"scenes":["看板拖动任务卡","文件拖拽上传","列表拖拽排序","调整面板宽度"],"en":{"demoDetail":"<div class=\"drag-play\">\n    <div class=\"drag-lane\">\n      <span class=\"drag-live\" data-drag>⠿ Task A</span>\n      <span class=\"drag-live alt\" data-drag>⠿ Task B</span>\n      <span class=\"drag-target\">Drop here</span>\n    </div>\n    <span class=\"drag-hint\">Drag a card and watch the shadow and drop-position feedback. Release it to return it to its original position.</span>\n  </div>","use":[{"t":"Reorder a list","m":"drag-floating"},{"t":"Move an item between groups","m":"drag-placeholder"},{"t":"Place an object on a canvas","m":"drag-alt"},{"t":"Adjust a continuous value with a handle","m":"drag-handle"}],"dont":[{"t":"Make dragging the only way to complete an important task","m":"drag-no-feedback","bad":true},{"t":"Hide valid drop targets","m":"drag-only-way","bad":true},{"t":"Start a drag when the user intended to scroll","m":"drag-touch","bad":true},{"t":"Move an item without confirming its new position","m":"drag-accident","bad":true}],"scenes":["Kanban board","File organizer","Layout editor","Slider handle"],"sceneUI":["<div style=\"position:relative;display:flex;gap:12px;justify-content:center;height:118px\">\n      <div style=\"width:150px;background:var(--bg-soft);border:1px solid var(--border-light);border-radius:10px;padding:8px\">\n        <div style=\"font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px\">To do · 1</div>\n        <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text)\">Integration testing</div>\n      </div>\n      <div style=\"width:150px;background:var(--bg-soft);border:1px solid var(--border-light);border-radius:10px;padding:8px\">\n        <div style=\"font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px\">In progress · 2</div>\n        <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text);margin-bottom:5px\">Review homepage visuals</div>\n        <div style=\"border:1.5px dashed var(--brand);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--brand);background:var(--brand-light)\">Drop in this column</div>\n      </div>\n      <div style=\"position:absolute;left:calc(50% - 70px);top:32px;width:140px;background:var(--bg);border:1px solid var(--brand);border-radius:7px;padding:7px 9px;font-size:12px;color:var(--text);opacity:.94;transform:rotate(-3deg);box-shadow:0 12px 24px rgba(29,33,41,.24)\">Update login page</div>\n    </div>","<div style=\"position:relative;max-width:380px;margin:0 auto;padding-top:10px\">\n      <div style=\"position:absolute;right:24px;top:-3px;display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--text-2);box-shadow:0 8px 18px rgba(29,33,41,.18);transform:rotate(-2deg);opacity:.95\">📎 Design specs.md</div>\n      <div style=\"border:1.5px dashed var(--brand);border-radius:12px;background:var(--brand-light);padding:16px 12px 13px;text-align:center\">\n        <div style=\"font-size:20px;color:var(--brand)\">⬆</div>\n        <div style=\"font-size:12px;font-weight:600;color:var(--brand);margin-top:3px\">Drop to upload to Project files</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:2px\">Design specs.md · 2.4 MB</div>\n      </div>\n    </div>","<div style=\"position:relative;max-width:340px;margin:0 auto;display:flex;flex-direction:column;gap:5px;padding-top:12px\">\n      <span class=\"drag-item\">⠿ Draft requirements</span>\n      <span class=\"drag-slot\">Drop here</span>\n      <span class=\"drag-item\">⠿ Review visual design</span>\n      <span style=\"position:absolute;left:10px;right:-8px;top:0;background:var(--bg);border:1px solid var(--brand);border-radius:6px;padding:8px 12px;font-size:12px;color:var(--text);opacity:.93;transform:rotate(-1.5deg);box-shadow:0 10px 22px rgba(29,33,41,.22)\">⠿ Schedule a customer call</span>\n    </div>","<div style=\"position:relative;display:flex;height:110px;max-width:420px;margin:0 auto;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg)\">\n      <div style=\"width:34%;border-right:1px solid var(--border-light);padding:9px 10px\">\n        <div style=\"font-size:12px;font-weight:600;margin-bottom:7px\">Files</div>\n        <i class=\"mk-line\" style=\"width:82%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:64%\"></i>\n      </div>\n      <div style=\"flex:1;padding:9px 10px\">\n        <div style=\"font-size:12px;font-weight:600;margin-bottom:7px\">Preview</div>\n        <i class=\"mk-line\" style=\"width:90%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:70%\"></i>\n      </div>\n      <div style=\"position:absolute;left:34%;top:0;bottom:0;width:5px;background:var(--brand);transform:translateX(-50%)\"></div>\n      <span style=\"position:absolute;left:34%;top:50%;transform:translate(-50%,-50%);background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:3px 8px;border-radius:5px;white-space:nowrap\">↔ 320 px</span>\n    </div>"],"variants":[{"demo":"<span class=\"drag-v-list\"><i>A</i><i class=\"on\">B</i><i>C</i></span>","when":"Drag and sort tasks and Kanban boards"},{"demo":"<span class=\"drag-v-zone\">Drag files here</span>","when":"Drag files into the area to upload"},{"demo":"<span class=\"drag-item\">⠿ Task B</span>","when":"Need to clearly mark where you can start dragging"}]},"usageMocks":{"drag-floating":"<div class=\"mk-win\" style=\"gap:4px;padding:5px\"><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--border);border-radius:4px;font-size:12px\">任务 A</span><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--brand);border-radius:4px;font-size:12px;box-shadow:0 6px 14px rgba(29,33,41,.2);opacity:.85;transform:rotate(-1.5deg)\">任务 B（拖拽中）</span><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--border);border-radius:4px;font-size:12px\">任务 C</span></div>","drag-placeholder":"<div class=\"mk-win\" style=\"gap:4px;padding:5px\"><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--border);border-radius:4px;font-size:12px\">任务 A</span><span style=\"display:block;padding:4px 8px;border:1.5px dashed var(--brand);border-radius:4px;font-size:12px;color:var(--brand);background:var(--brand-light)\">放到这里</span><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--border);border-radius:4px;font-size:12px\">任务 C</span></div>","drag-alt":"<div class=\"mk-row\"><span style=\"font-size:12px;color:var(--text)\">任务 B</span><span class=\"mk-icon-btn\" style=\"width:18px;height:18px;font-size:12px\">↑</span><span class=\"mk-icon-btn\" style=\"width:18px;height:18px;font-size:12px\">↓</span><span style=\"font-size:12px;color:var(--text-3)\">按钮也能完成排序</span></div>","drag-handle":"<span style=\"display:inline-flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:12px;color:var(--text)\"><span style=\"color:var(--text-3)\">⠿</span>任务 B</span><span style=\"font-size:12px;color:var(--text-3)\">拖拽手柄提示可从此处开始拖动</span>","drag-no-feedback":"<div class=\"mk-win\" style=\"gap:4px;padding:5px\"><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--border);border-radius:4px;font-size:12px\">任务 A</span><span style=\"display:block;padding:4px 8px;background:var(--bg);border:1px solid var(--border);border-radius:4px;font-size:12px\">任务 B</span></div><span style=\"font-size:12px;color:var(--text-3)\">拖拽过程中没有状态变化，用户无法确认是否抓取成功</span>","drag-only-way":"<span style=\"font-size:12px;color:var(--text-2);max-width:180px;text-align:left\">只提供拖拽，会让键盘用户和无法精确拖动的用户无法完成排序。</span>","drag-touch":"<span class=\"mk-phone\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:70%\"></i></span><span style=\"font-size:12px;color:var(--text-3);max-width:110px\">触屏拖动可能与页面滚动手势冲突</span>","drag-accident":"<span style=\"display:inline-flex;align-items:center;gap:4px;background:var(--bg);border:1px solid var(--red);border-radius:4px;padding:3px 6px;font-size:12px;color:var(--text-2)\"><span style=\"color:var(--red)\">⠿</span>整行都是拖拽热区</span><span style=\"font-size:12px;color:var(--text-3)\">想选中文字，结果把整行拖走了</span>"}}}