=\"flex:1;min-width:0\">\n        <div style=\"font-size:12px;font-family:monospace;color:var(--text-3);margin-bottom:8px\">/components/button<span style=\"color:var(--text-2)\">#anatomy</span></div>\n        <b style=\"font-size:14px\">Composition structure · Anatomy</b>\n        <div style=\"display:flex;flex-direction:column;gap:6px;margin-top:10px\">\n          <i class=\"mk-line\" style=\"width:100%\"></i>\n          <i class=\"mk-line\" style=\"width:85%\"></i>\n          <i class=\"mk-line\" style=\"width:60%\"></i>\n        </div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"url-anat\"><span class=\"url-bar\"><span class=\"ap url-seg proto\" data-ap=\"protocol\">https://</span><span class=\"ap url-seg host\" data-ap=\"domain\">vibeui.dev</span><span class=\"ap url-seg path\" data-ap=\"path\">/components/button</span><span class=\"ap url-seg query\" data-ap=\"query\">?tab=demo</span><span class=\"ap url-seg hash\" data-ap=\"hash\">#anatomy</span></span></span>","demo_en":"<span class=\"url-anat\"><span class=\"url-bar\"><span class=\"ap url-seg proto\" data-ap=\"protocol\">https://</span><span class=\"ap url-seg host\" data-ap=\"domain\">vibeui.dev</span><span class=\"ap url-seg path\" data-ap=\"path\">/components/button</span><span class=\"ap url-seg query\" data-ap=\"query\">?tab=demo</span><span class=\"ap url-seg hash\" data-ap=\"hash\">#anatomy</span></span></span>","parts":[{"key":"protocol","cn":"协议","en":"Protocol","desc":"https://，送信方式；现在是 {c:https} 的天下","desc_en":"https:// identifies the protocol used to access the resource; see {c:https}."},{"key":"domain","cn":"域名","en":"Domain","desc":"寄到哪个小区，见 {c:domain}；靠 {c:dns} 翻译成 IP","desc_en":"The {c:domain} identifies the host, and {c:dns} resolves it to an IP address."},{"key":"path","cn":"路径","en":"Path","desc":"小区里哪栋哪室：/components/button 就是某个页面","desc_en":"The path identifies a resource on that host; /components/button points to one page."},{"key":"query","cn":"查询参数","en":"Query","desc":"? 后面 key=value 的留言条，& 连接多条，会发给服务器","desc_en":"The query string starts with ? and sends key=value parameters; & separates multiple parameters."},{"key":"hash","cn":"锚点","en":"Hash","desc":"# 后面的页内定位，只在浏览器里生效，不发给服务器","desc_en":"The fragment starts with # and points to a location on the page. The browser handles it without sending it to the server."}]},"variants":[{"cn":"绝对地址","en":"Absolute URL","demo":"<span style=\"font-family:monospace;font-size:12px\">https://vibeui.dev/components/button</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">https://vibeui.dev/components/button</span>","when":"包含协议和域名，适合外部分享或跨站引用","when_en":"Contains protocol and domain name, suitable for external sharing or cross-site reference"},{"cn":"相对路径","en":"Relative Path","demo":"<span style=\"font-family:monospace;font-size:12px\">/components/button</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">/components/button</span>","when":"站内跳转，换域名也不用改","when_en":"Jump within the site, no need to change domain name"},{"cn":"锚点链接","en":"Anchor Link","demo":"<span style=\"font-family:monospace;font-size:12px\">#anatomy</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">#anatomy</span>","when":"只定位到当前页的某一节","when_en":"Only locate a section of the current page"}],"use":[{"t":"分享时<b>复制完整链接</b>，别人打开就是同一页","m":"toast-copy"},{"t":"用 <b>path</b> 表达页面位置：/components/button 一看就懂","m":"url-path"},{"t":"搜索、筛选条件放 <b>query</b>：链接可分享、可复现","m":"url-query"},{"t":"长文档用 <b>#hash 锚点</b>，打开直接滚到那一节","m":"url-hash"}],"dont":[{"t":"随手转发带有<b>登录令牌或密钥的链接</b>：收到链接的人可能获得你的访问权限","m":"url-secret","bad":true},{"t":"拼 URL 时<b>中文和空格不编码</b>：链接断成一截一截","m":"url-encode","bad":true},{"t":"分享时<b>只复制域名丢了 path</b>：对方通常只会打开站点首页","m":"url-lost","bad":true},{"t":"把数据塞在 <b># 后面传给后端</b>：片段标识不会随 HTTP 请求发给服务器","m":"url-hash-server","bad":true}],"lessonPractice":{"title":"用户想把“未付款订单第 3 页”发给同事，对方打开后要看到相同结果。网址应该怎样设计？","options":[{"id":"state-only","label":"筛选和页码只放在页面内存里，分享统一的 /orders","feedback":"内存状态不会随链接传给同事，对方打开后只能看到默认订单列表。","correct":false},{"id":"shareable-query","label":"把筛选和页码写进查询参数，并确认链接可复现","feedback":"路径标明页面，查询参数保存筛选和页码；完整网址能让另一台设备恢复同一结果。","correct":true},{"id":"secret-in-url","label":"把筛选、页码和登录令牌都放进网址后一起发送","feedback":"筛选条件可以分享，但登录令牌属于敏感凭证；放进网址可能进入历史、日志和聊天记录。","correct":false}],"en":{"title":"Someone wants to send 'unpaid orders, page 3' to a teammate who should open the same result. How should the URL work?","options":[{"id":"state-only","label":"Keep filters and page number only in memory and share the same /orders URL","feedback":"In-memory state does not travel with the link, so the teammate opens the default order list.","correct":false},{"id":"shareable-query","label":"Put the filter and page in query parameters and verify that the link reproduces the view","feedback":"The path identifies the page and query parameters preserve filters and position for another device.","correct":true},{"id":"secret-in-url","label":"Put the filters, page number, and login token in the URL and send all of it","feedback":"Filters may be shareable, but a login token is sensitive and can leak through history, logs, and messages.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请让订单筛选和页码写进 URL 查询参数，复制链接、刷新和浏览器返回后都能恢复同一结果。不要把登录令牌或其他敏感信息放进网址。请用新标签页打开复制的链接完成验收。","en":{"title":"You can say this to an AI Agent","text":"Store order filters and page number in URL query parameters so sharing, refresh, and browser Back restore the same result. Never put login tokens or other secrets in the URL. Verify by opening the copied link in a new tab."}},"references":[{"title":"什么是 URL？","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Howto/Web_mechanics/What_is_a_URL","title_en":"What is a URL?"}],"scenes":["地址栏里的完整网址","搜索结果页的参数","分享弹窗复制链接","文档页锚点定位"],"en":{"use":[{"t":"Open a specific page","m":"toast-copy"},{"t":"Represent a stable resource path","m":"url-path"},{"t":"Carry non-secret search or filter para