s=\"ap\" data-ap=\"label\"><span class=\"input-label\">邮箱</span></span>\n          <span class=\"ap\" data-ap=\"box\"><input class=\"demo-input\" placeholder=\"you@example.com\"></span>\n          <span class=\"ap\" data-ap=\"hint\"><span class=\"input-hint\">用于接收登录通知</span></span>","demo_en":"<span class=\"ap\" data-ap=\"label\"><span class=\"input-label\">Email</span></span>\n          <span class=\"ap\" data-ap=\"box\"><input class=\"demo-input\" placeholder=\"you@example.com\"></span>\n          <span class=\"ap\" data-ap=\"hint\"><span class=\"input-hint\">Used to receive login notifications</span></span>","parts":[{"key":"label","cn":"标签","en":"Label","desc":"说明这里需要填写什么","desc_en":"Tells users what to enter — never skip it"},{"key":"box","cn":"输入框本体","en":"Input","desc":"聚焦时高亮描边，错误时变红","desc_en":"Highlights its border on focus, turns red on error"},{"key":"hint","cn":"辅助说明","en":"Help Text","desc":"补充格式要求或错误原因","desc_en":"Adds format requirements or explains what went wrong"}]},"variants":[{"cn":"默认","en":"Default","demo":"<input class=\"demo-input\" placeholder=\"请输入内容\">","demo_en":"<input class=\"demo-input\" placeholder=\"Type something\">","when":"绝大多数一行文本输入的通用形态","when_en":"The go-to shape for most single-line text input"},{"cn":"密码","en":"Password","demo":"<input class=\"demo-input\" type=\"password\" value=\"12345678\">","when":"密码、密钥等需要遮挡的内容","when_en":"Passwords, keys, and anything that should be masked"},{"cn":"带前缀图标","en":"With Icon","demo":"<span class=\"input-icon\"><i>🔍</i><input class=\"demo-input\" placeholder=\"搜索\"></span>","demo_en":"<span class=\"input-icon\"><i>🔍</i><input class=\"demo-input\" placeholder=\"Search\"></span>","when":"搜索等场景，用图标暗示要填什么","when_en":"Search and friends — the icon hints at what to enter"},{"cn":"错误状态","en":"Error","demo":"<input class=\"demo-input input-error\" value=\"hello@\">","when":"校验不通过时，红框配上出错原因","when_en":"When validation fails — red border plus the reason why"},{"cn":"禁用","en":"Disabled","demo":"<input class=\"demo-input\" disabled value=\"不可编辑\">","demo_en":"<input class=\"demo-input\" disabled value=\"Not editable\">","when":"这一项暂时不允许用户修改","when_en":"This field can't be edited right now"}],"use":[{"t":"<b>登录、注册</b>：账号密码这类短文本","m":"in-login"},{"t":"<b>搜索</b>：输入简短关键词查找内容","m":"in-search"},{"t":"<b>表单收集信息</b>：姓名、邮箱逐行填","m":"in-form"},{"t":"<b>起名字、改标题</b>：精确的短文本编辑","m":"in-exact"}],"dont":[{"t":"需要填写<b>多行连续内容</b>：使用 {c:textarea}","m":"in-textarea"},{"t":"必须从<b>固定选项</b>中选择：使用 {c:select}","m":"in-select"},{"t":"将 <b>placeholder 当作标签</b>：输入后字段用途不再可见","m":"in-placeholder","bad":true},{"t":"用输入框展示只读内容，让用户误以为可以修改","m":"in-readonly","bad":true}],"lessonPractice":{"title":"结算页要填写收件人姓名，内容通常很短，也不是从固定名单里选。哪种输入方式最合适？","options":[{"id":"single-line-input","label":"带常驻“收件人姓名”标签的单行输入框","feedback":"姓名是自由填写的短文本，单行输入框既直接，也能清楚关联字段标签。","correct":true},{"id":"textarea-field","label":"可拉高的多行文本框，方便输入完整信息","feedback":"多行文本框适合评论或描述；用来填姓名会放大控件却没有增加有效能力。","correct":false},{"id":"preset-select","label":"只提供预设姓名的下拉选择器","feedback":"用户需要自由填写姓名，固定选项会阻止名单之外的有效输入。","correct":false}],"en":{"title":"Checkout needs a recipient name. It is usually short and is not chosen from a fixed list. What should the form use?","options":[{"id":"single-line-input","label":"A single-line input with a persistent Recipient name label","feedback":"A name is short free-form text, so a labeled single-line input matches both the value and the task.","correct":true},{"id":"textarea-field","label":"A resizable textarea with room for complete information","feedback":"A textarea suits comments or descriptions; its extra height adds no useful capability for a name.","correct":false},{"id":"preset-select","label":"A dropdown containing only a list of preset names","feedback":"The value must be freely entered, so fixed options would block valid names outside the list.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"在结算表单增加单行的“收件人姓名”输入框，标签在输入后仍要可见。请测试空值、正常姓名和较长姓名，并让错误提示出现在字段附近。","en":{"title":"You can say this to an AI Agent","text":"Add a single-line Recipient name input to checkout and keep its label visible after typing. Test an empty value, a normal name, and a long name, with any error shown beside the field."}},"demoDetail":"<div class=\"input-field\"><label class=\"input-label\">邮箱</label><input class=\"demo-input\" placeholder=\"you@example.com\"><span class=\"input-hint\">用于接收登录通知，不会公开</span></div>\n        <div class=\"input-field\"><label class=\"input-label\">邀请码</label><input class=\"demo-input input-error\" value=\"ABCD-1234\"><span class=\"input-hint err\">邀请码不存在，请检查后重试</span></div>","references":[{"title":"<input> 输入元素","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input","title_en":"<input> HTML input element"},{"title":"帮助用户在表单中输入数据","source":"web.dev","url":"https://web.dev/learn/forms/form-fields","title_en":"Help users enter data in forms"}],"scenes":["登录注册表单","顶部搜索框","个人信息设置","重命名弹窗"],"en":{"demoDetail":"<div class=\"input-field\"><label class=\"input-label\">Email</label><input class=\"demo-input\" placeholder=\"you@example.com\"><span class=\"input-hint\">Used for login notifications — never shown publicly</span></div>\n          <div class=\"input-field\"><label class=\"input-label\">Invite code</label><input class=\"demo-input input-error\" value=\"ABCD-1234\"><span class=\"input-hint err\">Invite code not found. Check it and try again</span></div>","use":[{"t":"Account and contact details","m":"in-login"},{"t":"Search queries","m":"in-search"},{"t":"Short names and titles","m":"in-form"},{"t":"Single-line codes or values","m":"in-exact"}],"dont":[{"t":"Collect a long answer that needs several lines","m":"in-textarea"},{"t":"Use placeholder text as the only label","m":"in-select"},{"t":"Wait until final submission to reveal every obvious error","m":"in-placeholder","bad":true},{"t":"Show read-only content in a field that looks editable","m":"in-readonly","bad":true}],"scenes":["Sign-in form","Search bar