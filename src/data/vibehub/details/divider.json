btn\" style=\"width:26px;height:26px;font-size:12px;border-radius:6px\">↩</span>\n      </div>\n      <div style=\"border:1px solid var(--border);border-top:none;border-radius:0 0 10px 10px;padding:12px 14px;display:flex;flex-direction:column;gap:7px;background:var(--bg)\">\n        <i class=\"mk-line\" style=\"width:92%\"></i>\n        <i class=\"mk-line\" style=\"width:78%\"></i>\n        <i class=\"mk-line\" style=\"width:60%\"></i>\n      </div>\n    </div>","<div style=\"max-width:300px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:14px;font-weight:600;color:var(--text);margin-bottom:12px;text-align:center\">Log in to Vibe Coding Guide</div>\n      <button class=\"btn btn-primary\" style=\"width:100%;margin-bottom:14px\">WeChat scan code to log in</button>\n      <div class=\"divider-text\" style=\"margin-bottom:12px\"><i></i><span>Other login methods</span><i></i></div>\n      <div style=\"display:flex;justify-content:center;gap:12px\">\n        <span class=\"icon-btn\">📧</span><span class=\"icon-btn\">📱</span><span class=\"icon-btn\">🐧</span>\n      </div>\n    </div>"],"anatomy":{"demo":"<div style=\"display:flex;flex-direction:column;gap:14px;align-items:stretch;width:300px;max-width:100%\">\n      <span class=\"divider-anat-block\">上文内容：基本信息</span>\n      <span class=\"ap\" data-ap=\"line\"><span class=\"divider-h\"></span></span>\n      <span class=\"divider-anat-block\">下文内容：偏好设置</span>\n      <span class=\"divider-text\"><i></i><span class=\"ap\" data-ap=\"text\">其他登录方式</span><i></i></span>\n    </div>","demo_en":"<div style=\"display:flex;flex-direction:column;gap:14px;align-items:stretch;width:300px;max-width:100%\">\n      <span class=\"divider-anat-block\">Above content: Basic information</span>\n      <span class=\"ap\" data-ap=\"line\"><span class=\"divider-h\"></span></span>\n      <span class=\"divider-anat-block\">Content below: Preferences</span>\n      <span class=\"divider-text\"><i></i><span class=\"ap\" data-ap=\"text\">Other login methods</span><i></i></span>\n    </div>","parts":[{"key":"line","cn":"线体","en":"Line","desc":"使用细线和低对比颜色，避免抢过内容","desc_en":"Use thin lines and low-contrast colors to avoid overpowering your content"},{"key":"text","cn":"文字","en":"Text","desc":"可选，如「其他登录方式」，要弱化处理","desc_en":"Optional text, such as \"other login methods,\" should be visually subdued"}]},"variants":[{"cn":"水平分割线","en":"Horizontal","demo":"<div class=\"divider-h\" style=\"width:140px\"></div>","demo_en":"<div class=\"divider-h\" style=\"width:140px\"></div>","when":"上下两块内容不相关时，轻轻隔开","when_en":"When the content above and below is unrelated, add a subtle separator."},{"cn":"带文字分割线","en":"With Text","demo":"<div class=\"divider-text\" style=\"width:170px\"><i></i><span>其他方式</span><i></i></div>","demo_en":"<div class=\"divider-text\" style=\"width:170px\"><i></i><span>Other ways</span><i></i></div>","when":"中间要说明过渡，如其他登录方式","when_en":"When a label explains the transition, such as “other login methods.”"},{"cn":"垂直分割线","en":"Vertical","demo":"<span class=\"icon-btn divider-ic\">✎</span><span class=\"divider-v\"></span><span class=\"icon-btn divider-ic\">⬇</span>","demo_en":"<span class=\"icon-btn divider-ic\">✎</span><span class=\"divider-v\"></span><span class=\"icon-btn divider-ic\">⬇</span>","when":"工具栏里隔开不同功能的图标","when_en":"Separate icons for different functions in the toolbar"},{"cn":"虚线分割线","en":"Dashed","demo":"<div class=\"divider-dashed\" style=\"width:140px\"></div>","demo_en":"<div class=\"divider-dashed\" style=\"width:140px\"></div>","when":"比实线更弱，用于次要或临时分隔","when_en":"Weaker than a solid line, used for secondary or temporary separations"}],"use":[{"t":"<b>区分内容区块</b>：表单分组、文章段落之间","m":"divider-sections"},{"t":"<b>列表项之间</b>：细线隔开每条，扫读更顺","m":"divider-list"},{"t":"<b>工具栏分组</b>：竖线隔开不同功能的图标","m":"divider-toolbar"},{"t":"<b>带文字的分割线</b>：“其他登录方式”这种过渡","m":"divider-text"}],"dont":[{"t":"<b>每行内容都加线</b>：满屏横线，像张 Excel","m":"divider-many","bad":true},{"t":"能用 {c:space} <b>拉开距离</b>就别画线，留白更干净","m":"divider-space-better"},{"t":"线<b>太粗太深</b>，比内容还抢眼","m":"divider-heavy","bad":true},{"t":"{c:card} 里面<b>再给每个区域划线</b>，卡片本身就是边界","m":"divider-in-card","bad":true}],"lessonPractice":{"title":"设置页有“账号、安全、通知”三组内容，当前每一行都画了深色横线，页面像表格一样零碎。怎样调整？","options":[{"id":"spacing-first-group-dividers","label":"先用留白形成分组，只在组与组关系不清时使用克制分割线","feedback":"留白承担主要层级，少量分割线只补充分组变化，页面不会被切成许多小块。","correct":true},{"id":"line-every-row","label":"保留每行分割线，再用不同颜色区分账号、安全和通知","feedback":"更多更醒目的线条会继续强调每一行，而不是帮助用户识别三组主要关系。","correct":false},{"id":"thick-section-rules","label":"把组间横线改成粗黑线，依靠强边界建立层级","feedback":"粗线会抢过标题和内容，分组可以清楚但视觉权重明显过度。","correct":false}],"en":{"title":"A settings page has Account, Security, and Notifications groups, but every row uses a dark rule and the page feels fragmented. How should it change?","options":[{"id":"spacing-first-group-dividers","label":"Build groups with whitespace first and use restrained dividers only where the boundary remains unclear","feedback":"Whitespace carries the hierarchy and a few dividers clarify group changes without slicing the page into fragments.","correct":true},{"id":"line-every-row","label":"Keep a divider on every row and color-code Account, Security, and Notifications","feedback":"More prominent lines continue emphasizing individual rows rather than the three important groups.","correct":false},{"id":"thick-section-rules","label":"Replace group dividers with thick black rules to create stronger hierarchy","feedback":"Heavy rules compete with headings and content, giving the boundary more visual weight than it needs.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请减少设置页的线条：账号、安全、通知主要用标题和块间距分组，只有边界仍不清楚时加一条浅色分割线。不要给每行都画线；检查分组在深色模式和手机端仍能识别。","en":{"title":"You can say this to an AI Agent","text":"Reduce rules on the settings page: group Account, Security, and Notifications primarily with headings and block spacing, adding one subtle divider only when needed. Do not rule every row, and verify dark mode and mobile grouping."}},"demoDetail":"<div class=\"divider-login\">\n    <button class=\"btn btn-primary divider-login-btn\">微信扫码登录</button>\n    <div class=\"divider-text\"><i></i><span>其他登录方式</span><i></i></div>\n    <div class=\"divider-login-icons\"><span class=\"icon-btn\">📧</span><span class=\"icon-btn\">📱</span><span class=\"icon-btn\">🐧</span></div>\n  </div>","references":[{"title":"<hr> 主题分隔（水平线）元素","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/hr","title_en":"<hr>: The Thematic Break (Horizontal Rule) element"}],"scenes":["设置页分组","评论列表分隔","编辑器工具栏","登录页“其他方式”"],"en":{"demoDetail":"<div class=\"divider-login\">\n    <button class=\"btn btn-primary divider-login-btn\">Sign in with WeChat</button>\n    <div class=\"divider-text\"><i></i><span>Other login methods</span><i></i></div>\n    <div class=\"divider-login-icons\"><span class=\"icon-btn\">📧</span><span class=\"icon-btn\">📱</span><span class=\"icon-btn\">🐧</span></div>\n  </div>","use":[{"t":"Separate groups in a long list","m":"divider-sections"},{"t":"Divide sections inside a menu","m":"divider-list"},{"t":"Mark a clear change of topic in a compact panel","m":"divider-toolbar"},{"t":"Separate a footer or action area from the content above","m":"divider-text"}],"dont":[{"t":"Draw a line between every item in a spacious layout","m":"divider-many","bad":true},{"t":"Use a divider when {c:space} already shows the grouping","m":"divider-space-better"},{"t":"Mix many line colors and weights without meaning","m":"divider-heavy","bad":true},{"t":"Use decoration as if it were a real content boundary","m":"divider-in-card","bad":true}],"scenes":["Settings groups","Menu sections","Article sections","Card footer"],"sceneUI":["<div style=\"max-width:380px;margin:0 auto\">\n      <div class=\"divider-sec\" style=\"margin-bottom:4px\">Account settings</div>\n      <div style=\"display:flex;justify-cont