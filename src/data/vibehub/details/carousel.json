{"__formatVersion":2,"__revision":"ef3ac392a4a988ef","__entryId":"carousel","entry":{"sceneUI":["<div style=\"max-width:460px;margin:0 auto\">\n      <div style=\"position:relative;height:110px;border-radius:10px;overflow:hidden;background:url('/assets/slide-summer.png') center/cover\">\n        <div style=\"position:absolute;left:14px;bottom:12px;color:#fff\">\n          <div style=\"font-size:15px;font-weight:600;text-shadow:0 1px 4px rgba(0,0,0,.4)\">夏季新品发布会</div>\n          <div style=\"font-size:12px;opacity:.92;text-shadow:0 1px 3px rgba(0,0,0,.4)\">8 月 1 日 20:00 直播间见 →</div>\n        </div>\n        <span class=\"crs-sc-arr\" style=\"left:8px\">‹</span><span class=\"crs-sc-arr\" style=\"right:8px\">›</span>\n      </div>\n      <div class=\"crs-sc-dots\" style=\"margin-top:8px\"><i class=\"on\"></i><i></i><i></i></div>\n    </div>","<div style=\"max-width:300px;margin:0 auto;border:1px solid var(--border-light);border-radius:12px;padding:18px;text-align:center;box-shadow:var(--shadow-card)\">\n      <img src=\"/assets/avatar-robot.png\" style=\"width:48px;height:48px;border-radius:12px\" alt=\"\">\n      <div style=\"font-size:14px;font-weight:600;margin-top:8px\">第 2 步 · 邀请团队成员</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin:4px 0 10px\">邀请同事加入项目，共同查看和编辑</div>\n      <div class=\"crs-sc-dots\" style=\"margin-bottom:10px\"><i></i><i class=\"on\"></i><i></i></div>\n      <button class=\"btn btn-primary\" style=\"width:100%\">下一步</button>\n    </div>","<div style=\"max-width:400px;margin:0 auto;display:flex;gap:14px;align-items:flex-start\">\n      <div style=\"flex:none\">\n        <div style=\"position:relative;width:170px;height:104px;border-radius:8px;overflow:hidden;background:url('/assets/photo-cat.png') center/cover\">\n          <span class=\"crs-sc-arr\" style=\"left:6px;width:18px;height:18px;font-size:12px\">‹</span><span class=\"crs-sc-arr\" style=\"right:6px;width:18px;height:18px;font-size:12px\">›</span>\n        </div>\n     