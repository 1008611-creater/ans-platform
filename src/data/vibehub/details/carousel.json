-shadow:0 1px 4px rgba(0,0,0,.4)\">Summer new product launch conference</div>\n          <div style=\"font-size:12px;opacity:.92;text-shadow:0 1px 3px rgba(0,0,0,.4)\">See you in the live broadcast room at 20:00 on August 1 →</div>\n        </div>\n        <span class=\"crs-sc-arr\" style=\"left:8px\">‹</span><span class=\"crs-sc-arr\" style=\"right:8px\">›</span>\n      </div>\n      <div class=\"crs-sc-dots\" style=\"margin-top:8px\"><i class=\"on\"></i><i></i><i></i></div>\n    </div>","<div style=\"max-width:300px;margin:0 auto;border:1px solid var(--border-light);border-radius:12px;padding:18px;text-align:center;box-shadow:var(--shadow-card)\">\n      <img src=\"/assets/avatar-robot.png\" style=\"width:48px;height:48px;border-radius:12px\" alt=\"\">\n      <div style=\"font-size:14px;font-weight:600;margin-top:8px\">Step 2 · Invite team members</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin:4px 0 10px\">Invite colleagues to join the project to view and edit together</div>\n      <div class=\"crs-sc-dots\" style=\"margin-bottom:10px\"><i></i><i class=\"on\"></i><i></i></div>\n      <button class=\"btn btn-primary\" style=\"width:100%\">Next</button>\n    </div>","<div style=\"max-width:400px;margin:0 auto;display:flex;gap:14px;align-items:flex-start\">\n      <div style=\"flex:none\">\n        <div style=\"position:relative;width:170px;height:104px;border-radius:8px;overflow:hidden;background:url('/assets/photo-cat.png') center/cover\">\n          <span class=\"crs-sc-arr\" style=\"left:6px;width:18px;height:18px;font-size:12px\">‹</span><span class=\"crs-sc-arr\" style=\"right:6px;width:18px;height:18px;font-size:12px\">›</span>\n        </div>\n        <div style=\"display:flex;gap:6px;margin-top:6px\">\n          <img src=\"/assets/photo-cat.png\" style=\"width:34px;height:24px;border-radius:4px;object-fit:cover;border:1.5px solid var(--brand)\" alt=\"\">\n          <img src=\"/assets/photo-cat.png\" style=\"width:34px;height:24px;border-radius:4px;object-fit:cover;object-position:top;opacity:.7\" alt=\"\">\n          <img src=\"/assets/photo-cat.png\" style=\"width:34px;height:24px;border-radius:4px;object-fit:cover;object-position:bottom;opacity:.7\" alt=\"\">\n        </div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"font-size:13px;font-weight:600;line-height:1.4\">Cream Ceramic Cat Bowl with Heightened Neck Guard</div>\n        <div style=\"font-size:16px;color:var(--red);font-weight:600;margin-top:6px\">¥49.00</div>\n        <span class=\"demo-tag red\" style=\"margin-top:4px\">20% off for a limited time</span>\n      </div>\n    </div>","<div style=\"max-width:460px;margin:0 auto\">\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:8px\">Discover</div>\n      <div style=\"position:relative;height:84px;border-radius:10px;overflow:hidden;background:url('/assets/slide-city.png') center/cover\">\n        <span class=\"demo-tag red\" style=\"position:absolute;left:10px;top:10px\">Limited time event</span>\n        <div style=\"position:absolute;left:12px;bottom:10px;color:#fff;font-size:13px;font-weight:600;text-shadow:0 1px 4px rgba(0,0,0,.45)\">City Tour · Shanghai Station Registration Now</div>\n        <span class=\"crs-sc-arr\" style=\"right:8px;width:18px;height:18px;font-size:12px\">›</span>\n      </div>\n      <div class=\"crs-sc-dots\" style=\"margin-top:8px\"><i></i><i class=\"on\"></i><i></i><i></i></div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><span class=\"cr-demo\"><span class=\"cr-body\"><span class=\"ap\" data-ap=\"arrow\"><span class=\"cr-arrow\">‹</span></span><span class=\"ap\" data-ap=\"slide\"><span class=\"cr-stage\"><span class=\"cr-slide a\">夏季新品</span></span></span><span class=\"cr-arrow\">›</span></span><span class=\"ap\" data-ap=\"dots\"><span class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><span class=\"cr-demo\"><span class=\"cr-body\"><span class=\"ap\" data-ap=\"arrow\"><span class=\"cr-arrow\">‹</span></span><span class=\"ap\" data-ap=\"slide\"><span class=\"cr-stage\"><span class=\"cr-slide a\">New summer products</span></span></span><span class=\"cr-arrow\">›</span></span><span class=\"ap\" data-ap=\"dots\"><span class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></span></span></span></span>","parts":[{"key":"root","cn":"走马灯","en":"Carousel","desc":"整个轮播区域的容器","desc_en":"Container for the entire carousel area"},{"key":"arrow","cn":"切换箭头","en":"Arrow","desc":"左右翻页","desc_en":"Moves to the previous or next slide"},{"key":"slide","cn":"轮播项","en":"Slide","desc":"每个轮播项承载的内容","desc_en":"The content in each carousel item"},{"key":"dots","cn":"指示点","en":"Dots","desc":"告诉用户第几张、共几张","desc_en":"Shows which slide is active and how many slides there are"}]},"variants":[{"cn":"滑动切换","en":"Slide","demo":"<div class=\"cr-demo\"><div class=\"cr-body\"><span class=\"cr-arrow\">‹</span><div class=\"cr-stage\"><div class=\"cr-slide a\">夏季新品发布会</div></div><span class=\"cr-arrow\">›</span></div><div class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></div></div>","demo_en":"<div class=\"cr-demo\"><div class=\"cr-body\"><span class=\"cr-arrow\">‹</span><div class=\"cr-stage\"><div class=\"cr-slide a\">Summer New Product Launch</div></div><span class=\"cr-arrow\">›</span></div><div class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></div></div>","when":"默认款，左右翻看多张图","when_en":"For the default pattern: move left and right through several images"},{"cn":"淡入淡出","en":"Fade","demo":"<div class=\"cr-demo\"><div class=\"cr-stage cr-fade\"><div class=\"cr-slide b\"></div><div class=\"cr-slide a\">夏季新品发布会</div></div><div class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></div></div>","demo_en":"<div class=\"cr-demo\"><div class=\"cr-stage cr-fade\"><div class=\"cr-slide b\"></div><div class=\"cr-slide a\">Summer new product launch conference</div></div><div class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></div></div>","when":"整屏 Banner 切换，过渡更柔和","when_en":"For a full-width banner with a softer transition"},{"cn":"卡片式","en":"Card","demo":"<div class=\"cr-demo\"><div class=\"cr-stage cr-cards\"><div class=\"cr-slide b\"></div><div class=\"cr-slide a\">夏季新品</div><div class=\"cr-slide c\"></div></div><div class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></div></div>","demo_en":"<div class=\"cr-demo\"><div class=\"cr-stage cr-cards\"><div class=\"cr-slide b\"></div><div class=\"cr-slide a\">New summer products</div><div class=\"cr-slide c\"></div></div><div class=\"cr-dots\"><i class=\"on\"></i><i></i><i></i></div></div>","when":"露出前后一张边角，暗示还能翻","when_en":"When the edges of adjacent slides should hint that users can browse further"}],"use":[{"t":"首页 <b>Banner 轮播</b>：运营活动、主推内容","m":"carousel-banner"},{"t":"<b>新手引导</b>：分步骤介绍核心功能","m":"carousel-guide"},{"t":"<b>商品多图</b>：左右切换看不同角度","m":"carousel-gallery"},{"t":"内容数量保持克制，带指示点和切换箭头","m":"carousel-auto"}],"dont":[{"t":"把<b>重要信息只放在靠后的轮播项</b>，未切换的用户无法看到","m":"carousel-hidden","bad":true},{"t":"轮播内容较多又没有当前位置提示，用户无法判断浏览进度","m":"carousel-many","bad":true},{"t":"几个并列入口通常应平铺为网格，让用户同时看到全部选项","m":"carousel-grid","bad":true},{"t":"在<b>表单 / 正文里塞轮播</b>，打断填写和阅读","m":"carousel-form","bad":true}],"lessonPractice":{"title":"手机商品详情要在一个主图区域查看 5 个角度，用户需要知道当前是第几张并能自己切换。怎样实现？","options":[{"id":"controlled-image-carousel","label":"使用走马灯，提供前后切换、当前位置和可选择的缩略图","feedback":"同一区域轮换相关图片节省窄屏空间，明确位置和入口让浏览过程由用户掌控。","correct":true},{"id":"autoplay-without-controls","label":"自动每两秒切换图片，不提供暂停、箭头或当前位置","feedback":"用户无法停留查看细节，也不知道还有多少图片或怎样返回上一张。","correct":false},{"id":"stack-full-images","label":"把 5 张大图按原尺寸纵向排列，让用户一直滚动查看","feedback":"内容都能看到，但在手机上占用过长页面，失去单个主图区域的浏览目标。","correct":false}],"en":{"title":"A mobile product page shows five angles in one main-image area. Users need their current position and manual control. How should it work?","options":[{"id":"controlled-image-carousel","label":"Use a carousel with previous and next controls, position, and selectable thumbnails","feedback":"Rotating related images in one area saves narrow-screen space, while position and controls keep users in charge.","correct":true},{"id":"autoplay-without-controls","label":"Change images every two seconds with no pause, arrows, or position","feedback":"Users cannot hold an image for inspection, know how many remain, or return to the previous one.","correct":false},{"id":"stack-full-images","label":"Stack all five full-size images vertically and require scrolling through them","feedback":"Every image is visible, but the mobile page becomes unnecessarily long and loses the intended single-image area.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把手机商品图做成可手动控制的走马灯，显示当前张数、前后按钮和缩略图，滑动与键盘也能切换。默认不要自动播放；验证首尾边界、图片加载失败和 1 张图片时的状态。","en":{"title":"You can say this to an AI Agent","text":"Build mobile product images as a user-controlled carousel with position, previous and next controls, thumbnails, swipe, and keyboard support. Do not autoplay by default. Test first and last boundaries, failed images, and a single-image product."}},"references":[{"title":"Carousel 轮播模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/carousel/","title_en":"Carousel Pattern"}],"scenes":["首页 Banner","新手引导","商品多图浏览","活动运营位"],"en":{"use":[{"t":"A small set of promotional visuals","m":"carousel-banner"},{"t":"Product image gallery","m":"carousel-guide"},{"t":"Onboarding walkthrough","m":"carousel-gallery"},{"t":"Several related stories in one reserved area","m":"carousel-auto"}],"dont":[{"t":"Hide critical content on a later slide","m":"carousel-hidden","bad":true},{"t":"Autoplay without pause controls","m":"carousel-many","bad":true},{"t":"Rotate so quickly that people cannot read","m":"carousel-grid","bad":true},{"t":"Use many slides when a list would be easier to scan","m":"carousel-form","bad":true}],"scenes":["Homepage banner","Product gallery","Feature tour","Customer stories"],"sceneUI":["<div styl