x:1;color:var(--text)\">消息</b>\n        <span class=\"icon-btn\">＋</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:7px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:30px;height:30px;border-radius:50%;flex:none;background:linear-gradient(135deg,var(--brand),#8b5cf6);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:12px\">林</span>\n        <span style=\"flex:1;font-size:12px;color:var(--text)\">林小满 <span style=\"color:var(--text-3)\">把终稿发你了</span></span>\n        <span style=\"font-size:12px;color:var(--text-3)\">10:24</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:7px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:30px;height:30px;border-radius:8px;flex:none;background:linear-gradient(135deg,#f7ba1e,#f76965);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px\">✦</span>\n        <span style=\"flex:1;font-size:12px;color:var(--text)\">灵感订阅 <span style=\"color:var(--text-3)\">本周精选已更新</span></span>\n        <span style=\"font-size:12px;color:var(--text-3)\">09:02</span>\n      </div>\n    </div>","<div style=\"display:flex;gap:10px\">\n      <div style=\"flex:1;border-radius:10px;border:1px solid var(--border-light);background:linear-gradient(160deg,#f7f9ff,#e3e9ff);padding:12px\">\n        <div style=\"font-size:12px;color:var(--text-2)\">本月活跃用户</div>\n        <div style=\"font-size:20px;font-weight:700;color:var(--text);margin:4px 0 2px\">12,408</div>\n        <div style=\"font-size:12px;color:var(--green)\">↑ 8.2% 较上月</div>\n      </div>\n      <div style=\"flex:1;border-radius:10px;border:1px solid var(--border-light);background:linear-gradient(160deg,#f7f9ff,#e3e9ff);padding:12px\">\n        <div style=\"font-size:12px;color:var(--text-2)\">平均停留时长</div>\n        <div style=\"font-size:20px;font-weight:700;color:var(--text);margin:4px 0 2px\">6分42秒</div>\n  