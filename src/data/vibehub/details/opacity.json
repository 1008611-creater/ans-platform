{"__formatVersion":2,"__revision":"e40659a08cc7b720","__entryId":"opacity","entry":{"sceneUI":["<div style=\"max-width:300px;margin:10px auto 0;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;position:relative\">\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;top:-10px;left:12px\">opacity: 0.4 = 禁用</span>\n      <label style=\"font-size:12px;color:var(--text-2)\">邮箱<input class=\"demo-input\" style=\"width:100%;margin-top:4px;padding:7px 10px;font-size:12px\" placeholder=\"请先填写邮箱\"></label>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\">\n        <button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">取消</button>\n        <button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px;opacity:.4\">提交</button>\n      </div>\n    </div>","<div>\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:6px\">\n        <b style=\"font-size:13px;flex:1\">设计规范.md</b>\n        <span class=\"icon-btn\" style=\"opacity:.45\">✎</span>\n        <span class=\"icon-btn\" style=\"opacity:.45\">⧉</span>\n        <span class=\"icon-btn\" style=\"color:var(--brand);border-color:var(--brand)\">★</span>\n      </div>\n      <div class=\"opacity-sc-note\">次要图标平时 opacity 0.45，悬停的那个恢复 1</div>\n    </div>","<div style=\"position:relative;height:140px;border-radius:8px;overflow:hidden;background:var(--bg);border:1px solid var(--border)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:64%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;left:10px;bottom:10px\">遮罩 rgba(.32)，背景隐约可见</span>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--bg);border-radius:10px;padding:10px 18px;box-shadow:var(--shadow-float);font-size:13px\"><span style=\"color:var(--green)\">✓</span> 保存成功</div>\n    </div>","<div style=\"position:relative;height:104px;display:flex;align-items:center;justify-content:center;gap:8px\">\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px;opacity:.15\">已复制链接</span>\n      <span style=\"color:var(--text-3);font-size:12px\">→</span>\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px;opacity:.5\">已复制链接</span>\n      <span style=\"color:var(--text-3);font-size:12px\">→</span>\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px\">已复制链接</span>\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;bottom:0;left:50%;transform:translateX(-50%)\">transition: opacity .2s，淡入</span>\n    </div>"],"sceneUI_en":["<div style=\"max-width:300px;margin:10px auto 0;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;position:relative\">\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;top:-10px;left:12px\">opacity: 0.4 = disabled</span>\n      <label style=\"font-size:12px;color:var(--text-2)\">Email<input class=\"demo-input\" style=\"width:100%;margin-top:4px;padding:7px 10px;font-size:12px\" placeholder=\"Please fill in your email first\"></label>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\">\n        <button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">Cancel</button>\n        <button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px;opacity:.4\">Submit</button>\n      </div>\n    </div>","<div>\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:6px\">\n        <b style=\"font-size:13px;flex:1\">Design specification.md</b>\n        <span class=\"icon-btn\" style=\"opacity:.45\">✎</span>\n        <span class=\"icon-btn\" style=\"opacity:.45\">⧉</span>\n        <span class=\"icon-btn\" style=\"color:var(--brand);border-color:var(--brand)\">★</span>\n      </div>\n      <div class=\"opacity-sc-note\">The secondary icon usually has an opacity of 0.45, and the hovered one returns to 1</div>\n    </div>","<div style=\"position:relative;height:140px;border-radius:8px;overflow:hidden;background:var(--bg);border:1px solid var(--border)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:64%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;left:10px;bottom:10px\">Mask rgba(.32), the background is vaguely visible</span>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--bg);border-radius:10px;padding:10px 18px;box-shadow:var(--shadow-float);font-size:13px\"><span style=\"color:var(--green)\">✓</span> Saved</div>\n    </div>","<div style=\"position:relative;height:104px;display:flex;align-items:center;justify-content:center;gap:8px\">\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px;opacity:.15\">Copied link</span>\n      <span style=\"color:var(--text-3);font-size:12px\">→</span>\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px;opacity:.5\">Copied link</span>\n      <span style=\"color:var(--text-3);font-size:12px\">→</span>\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px\">Copied link</span>\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;bottom:0;left:50%;transform:translateX(-50%)\">transition: opacity .2s, fade in</span>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"backdrop\"><span class=\"opacity-anat-stage\"><span class=\"ap\" data-ap=\"element\"><span class=\"opacity-anat-el\">opacity: 0.45</span></span><span class=\"ap\" data-ap=\"reveal\"><span class=\"opacity-anat-note\">背景透出来</span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"backdrop\"><span class=\"opacity-anat-stage\"><span class=\"ap\" data-ap=\"element\"><span class=\"opacity-anat-el\">opacity: 0.45</span></span><span class=\"ap\" data-ap=\"reveal\"><span class=\"opacity-anat-note\">Background shines through</span></span></span></span>","parts":[{"key":"backdrop","cn":"下层背景","en":"Backdrop","desc":"透过来看见的东西","desc_en":"something seen through"},{"key":"element","cn":"半透明元素","en":"Element","desc":"opacity 小于 1，整体变淡","desc_en":"If opacity is less than 1, the overall color becomes lighter."},{"key":"reveal","cn":"透出效果","en":"See-through","desc":"透明度越低，背景透得越多","desc_en":"The lower the transparency, the more the background shows through"}]},"variants":[{"cn":"禁用","en":"0.4","demo":"<span class=\"opacity-v\" style=\"opacity:.4\">禁用</span>","demo_en":"<span class=\"opacity-v\" style=\"opacity:.4\">Disable</span>","when":"不可点的按钮、输入框","when_en":"Unclickable buttons and input boxes"},{"cn":"悬停","en":"0.8","demo":"<span class=\"opacity-v\" style=\"opacity:.8\">悬停</span>","demo_en":"<span class=\"opacity-v\" style=\"opacity:.8\">hover</span>","when":"次要图标平时淡一点","when_en":"Secondary icons are usually lighter"},{"cn":"遮罩","en":"0.5","demo":"<span class=\"opacity-v\" style=\"background:var(--inverse-bg);opacity:.5\">遮罩</span>","demo_en":"<span class=\"opacity-v\" style=\"background:var(--inverse-bg);opacity:.5\">Mask</span>","when":"弹窗背后压暗页面","when_en":"Darken the page behind the pop-up window"},{"cn":"完全隐藏","en":"0","demo":"<span style=\"display:inline-block;border:1px dashed var(--text-3);border-radius:6px\"><span class=\"opacity-v\" style=\"opacity:0\">0</span></span>","demo_en":"<span style=\"display:inline-block;border:1px dashed var(--text-3);border-radius:6px\"><span class=\"opacity-v\" style=\"opacity:0\">0</span></span>","when":"占位做淡入动画时使用","when_en":"Use placeholder when doing fade-in animation"}],"use":[{"t":"<b>禁用态变淡</b>：{c:button}、{c:input} 不可用降到 0.4 左右","m":"opacity-disabled"},{"t":"<b>悬停反馈</b>：次要图标平时 0.5，悬停恢复 1","m":"opacity-hover"},{"t":"<b>半透明遮罩</b>：{c:modal} 背后压暗但隐约可见","m":"opacity-mask"},{"t":"<b>淡入淡出</b>：配 transition 是最常用的动效","m":"opacity-fade"}],"dont":[{"t":"只需让<b>背景透明</b>时使用 rgba；opacity 会同时降低内容透明度","m":"opacity-vs-rgba","bad":true},{"t":"正文透明度过低会降低<b>文字对比度</b>，影响阅读","m":"opacity-text","bad":true},{"t":"不要把 opacity: 0 当成移除元素，它仍会占位并可能响应点击","m":"opacity-zero","bad":true},{"t":"<b>多层半透明元素叠加</b>会改变最终颜色和对比度，应检查合成结果","m":"opacity-stack","bad":true}],"lessonPractice":{"title":"浮层需要半透明背景，让后面的页面隐约可见，但浮层里的文字和按钮必须保持清晰。应该怎样实现？","options":[{"id":"transparent-background-color","label":"给背景颜色设置透明度，保持文字和按钮本身完全不透明","feedback":"半透明颜色只影响背景层，子内容仍维持原有对比度和点击可见性。","correct":true},{"id":"opacity-on-container","label":"直接降低整个浮层的 opacity，让背景和所有内容一起变淡","feedback":"Opacity 会同时影响子元素，文字和按钮也会失去清晰度，无法满足当前限制。","correct":false},{"id":"invisible-interactive-layer","label":"需要隐藏时设 opacity: 0，继续保留浮层的点击和焦点","feedback":"透明为零不等于移除，元素仍可能挡住页面并接收键盘焦点。","correct":false}],"en":{"title":"A surface needs a translucent background revealing the page behind, while its text and buttons remain crisp. What should be done?","options":[{"id":"transparent-background-color","label":"Apply transparency to the background color while keeping text and controls fully opaque","feedback":"A translucent color affects only the background layer, preserving content contrast and visible interaction.","correct":true},{"id":"opacity-on-container","label":"Lower opacity on the entire surface so its background and all content fade together","feedback":"Opacity affects descendants too, reducing the clarity of text and buttons against the requirement.","correct":false},{"id":"invisible-interactive-layer","label":"Set opacity: 0 when hidden but keep the surface clickable and focusable","feedback":"Zero opacity does not remove the element; it may still block the page and receive keyboard focus.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请只让浮层背景半透明，使用带 alpha 的背景色，不要降低整个容器 opacity。文字和按钮保持原对比度；隐藏状态还要同步 pointer-events、可见性和焦点，验证透明层不会挡住下面页面。","en":{"title":"You can say this to an AI Agent","text":"Make only the surface background translucent with an alpha color rather than lowering container opacity. Keep text and button contrast, and synchronize pointer events, visibility, and focus when hidden so the layer never blocks the page."}},"references":[{"title":"opacity 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/opacity","title_en":"opacity"}],"scenes":["禁用按钮","悬停反馈","弹窗半透明遮罩","淡入淡出动画"],"en":{"use":[{"t":"Soften a disabled visual state","m":"opacity-disabled"},{"t":"Fade an element during a transition","m":"opacity-hover"},{"t":"Create a subtle overlay","m":"opacity-mask"},{"t":"Reduce the emphasis of decorative content","m":"opacity-fade"}],"dont":[{"t":"Lower body-text contrast until it is hard to read","m":"opacity-vs-rgba","bad":true},{"t":"Use opacity when only the background should change","m":"opacity-text","bad":true},{"t":"Hide content visually while leaving an unexpected click target","m":"opacity-zero","bad":true},{"t":"Use transparency as the only sign that a control is disabled","m":"opacity-stack","bad":true}],"scenes":["Disabled state","Fade transition","Overlay","Decorative image"],"sceneUI":["<div style=\"max-width:300px;margin:10px auto 0;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;position:relative\">\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;top:-10px;left:12px\">opacity: 0.4 = disabled</span>\n      <label style=\"font-size:12px;color:var(--text-2)\">Email<input class=\"demo-input\" style=\"width:100%;margin-top:4px;padding:7px 10px;font-size:12px\" placeholder=\"Please fill in your email first\"></label>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\">\n        <button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">Cancel</button>\n        <button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px;opacity:.4\">Submit</button>\n      </div>\n    </div>","<div>\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:6px\">\n        <b style=\"font-size:13px;flex:1\">Design specification.md</b>\n        <span class=\"icon-btn\" style=\"opacity:.45\">✎</span>\n        <span class=\"icon-btn\" style=\"opacity:.45\">⧉</span>\n        <span class=\"icon-btn\" style=\"color:var(--brand);border-color:var(--brand)\">★</span>\n      </div>\n      <div class=\"opacity-sc-note\">The secondary icon usually has an opacity of 0.45, and the hovered one returns to 1</div>\n    </div>","<div style=\"position:relative;height:140px;border-radius:8px;overflow:hidden;background:var(--bg);border:1px solid var(--border)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:64%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;left:10px;bottom:10px\">Mask rgba(.32), the background is vaguely visible</span>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--bg);border-radius:10px;padding:10px 18px;box-shadow:var(--shadow-float);font-size:13px\"><span style=\"color:var(--green)\">✓</span> Saved</div>\n    </div>","<div style=\"position:relative;height:104px;display:flex;align-items:center;justify-content:center;gap:8px\">\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px;opacity:.15\">Copied link</span>\n      <span style=\"color:var(--text-3);font-size:12px\">→</span>\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px;opacity:.5\">Copied link</span>\n      <span style=\"color:var(--text-3);font-size:12px\">→</span>\n      <span style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px;border-radius:8px\">Copied link</span>\n      <span class=\"opacity-sc-chip\" style=\"position:absolute;bottom:0;left:50%;transform:translateX(-50%)\">transition: opacity .2s, fade in</span>\n    </div>"],"variants":[{"demo":"<span class=\"opacity-v\" style=\"opacity:.4\">Disable</span>","when":"Unclickable buttons and input boxes"},{"demo":"<span class=\"opacity-v\" style=\"opacity:.8\">hover</span>","when":"Secondary icons are usually lighter"},{"demo":"<span class=\"opacity-v\" style=\"background:var(--inverse-bg);opacity:.5\">Mask</span>","when":"Darken the page behind the pop-up window"},{"demo":"<span style=\"display:inline-block;border:1px dashed var(--text-3);border-radius:6px\"><span class=\"opacity-v\" style=\"opacity:0\">0</span></span>","when":"Use placeholder when doing fade-in animation"}]},"usageMocks":{"opacity-disabled":"<div class=\"mk-row\"><span class=\"mk-btn primary\">可用</span><span class=\"mk-btn primary\" style=\"opacity:.4\">禁用</span></div><span style=\"font-size:12px;color:var(--text-3)\">禁用态：opacity 降到 0.4 左右</span>","opacity-hover":"<div class=\"mk-row\"><span class=\"mk-icon-btn\" style=\"opacity:.55\">✎</span><span style=\"font-size:12px;color:var(--text-3)\">→</span><span class=\"mk-icon-btn\">✎</span></div><span style=\"font-size:12px;color:var(--text-3)\">次要图标淡一点，悬停恢复 1</span>","opacity-mask":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div><div class=\"mk-mask\"></div><span style=\"position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--bg);border-radius:4px;padding:3px 10px;font-size:12px\">弹窗</span></div><span style=\"font-size:12px;color:var(--text-3)\">遮罩半透明，页面还隐约可见</span>","opacity-fade":"<div class=\"mk-row\"><span style=\"width:22px;height:16px;background:var(--brand);border-radius:3px\"></span><span style=\"width:22px;height:16px;background:var(--brand);border-radius:3px;opacity:.6\"></span><span style=\"width:22px;height:16px;background:var(--brand);border-radius:3px;opacity:.3\"></span><span style=\"width:22px;height:16px;background:var(--brand);border-radius:3px;opacity:.08\"></span></div><span style=\"font-size:12px;color:var(--text-3)\">配合 transition，淡入淡出最常用</span>","opacity-vs-rgba":"<div class=\"mk-row\"><span style=\"background:var(--brand);opacity:.4;color:var(--on-brand);font-size:12px;padding:3px 8px;border-radius:3px\">opacity .4</span><span style=\"background:rgba(22,93,255,.4);color:#fff;font-size:12px;padding:3px 8px;border-radius:3px\">rgba .4</span></div><span style=\"font-size:12px;color:var(--text-3)\">左边连文字一起淡，右边只淡背景</span>","opacity-text":"<span style=\"font-size:12px;color:var(--text);opacity:.35;line-height:1.8;text-align:left\">正文透明度过低，文字对比度不足。</span>","opacity-zero":"<div class=\"mk-win\" style=\"position:relative\"><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:55%\"></i><span style=\"position:absolute;inset:8px;border:1px dashed var(--red);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--red)\">这里有个 opacity: 0 的按钮，还点得到</span></div>","opacity-stack":"<div class=\"mk-row\"><span style=\"position:relative;width:24px;height:24px;border-radius:4px;background:var(--brand);opacity:.5\"><span style=\"position:absolute;inset:5px;border-radius:3px;background:var(--brand);opacity:.5\"></span></span><span style=\"font-size:12px;color:var(--text-3);max-width:130px\">多层透明度会叠加，实际颜色更难预测</span></div>"}}}