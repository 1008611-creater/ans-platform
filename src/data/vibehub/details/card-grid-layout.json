" style=\"width:100%;height:56px;object-fit:cover;border-radius:6px;display:block\">\n        <img src=\"/assets/slide-city.png\" style=\"width:100%;height:56px;object-fit:cover;border-radius:6px;display:block\">\n        <img src=\"/assets/slide-forest.png\" style=\"width:100%;height:56px;object-fit:cover;border-radius:6px;display:block\">\n        <img src=\"/assets/cover-mountain.png\" style=\"width:100%;height:56px;object-fit:cover;border-radius:6px;display:block\">\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">\"Summer\" related materials 12,408 pieces · Sorted by popularity</div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"container\"><span class=\"cardgrid-anat-box\"><span class=\"cardgrid-anat-cell\"></span><span class=\"ap\" data-ap=\"card\"><span class=\"cardgrid-anat-cell on\">卡片</span></span><span class=\"ap\" data-ap=\"gap\"><span class=\"cardgrid-anat-gap\"></span></span><span class=\"cardgrid-anat-cell\"></span><span class=\"cardgrid-anat-cell\"></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"container\"><span class=\"cardgrid-anat-box\"><span class=\"cardgrid-anat-cell\"></span><span class=\"ap\" data-ap=\"card\"><span class=\"cardgrid-anat-cell on\">Card</span></span><span class=\"ap\" data-ap=\"gap\"><span class=\"cardgrid-anat-gap\"></span></span><span class=\"cardgrid-anat-cell\"></span><span class=\"cardgrid-anat-cell\"></span></span></span>","parts":[{"key":"container","cn":"网格容器","en":"Container","desc":"display: grid，定义列和间距","desc_en":"The grid container, which defines the columns and spacing"},{"key":"card","cn":"卡片","en":"Card","desc":"结构一致的成员，同构才好扫读","desc_en":"Cards with the same structure are easier to scan consistently"},{"key":"gap","cn":"网格间距","en":"Gap","desc":"格子之间的缝，一处声明全管","desc_en":"The gaps between cards, declared once for the whole grid"}]},"variants":[{"cn":"自适应列","en":"AutoFill","demo":"<span style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(22px,1fr));gap:4px;width:110px\"><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i></span>","demo_en":"<span style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(22px,1fr));gap:4px;width:110px\"><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i></span>","when":"卡片有合理最小宽度、列数需要随容器变化时","when_en":"When the card has a reasonable minimum width and the number of columns needs to change with the container"},{"cn":"固定两列","en":"Two Cols","demo":"<span style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:5px;width:110px\"><i class=\"cardgrid-v-cell\" style=\"height:26px\"></i><i class=\"cardgrid-v-cell\" style=\"height:26px\"></i></span>","demo_en":"<span style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:5px;width:110px\"><i class=\"cardgrid-v-cell\" style=\"height:26px\"></i><i class=\"cardgrid-v-cell\" style=\"height:26px\"></i></span>","when":"卡片内容多，需要大预览","when_en":"The card contains a lot of content and requires a large preview"},{"cn":"固定三列","en":"Three Cols","demo":"<span style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:4px;width:110px\"><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i></span>","demo_en":"<span style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:4px;width:110px\"><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i><i class=\"cardgrid-v-cell\"></i></span>","when":"内容宽度稳定的后台列表","when_en":"Backend list with stable content width"}],"use":[{"t":"<b>卡片结构一致</b>：相同信息放在相同位置，便于快速比较，见 {c:card}","m":"card-product"},{"t":"使用 Grid 的自动列宽，让卡片随容器换行","m":"cardgrid-autofill"},{"t":"<b>间距统一</b>：gap 一处管所有格距，见 {c:space}","m":"cardgrid-gap"},{"t":"<b>同行高度拉齐</b>：卡片一样高，墙面才整齐","m":"cardgrid-align"}],"dont":[{"t":"列数写死 repeat(4, 1fr)，<b>窄屏直接溢出</b>","m":"cardgrid-fixed","bad":true},{"t":"未控制卡片高度：<b>网格行高不齐</b>","m":"cardgrid-ragged","bad":true},{"t":"每张卡片结构不同：<b>列表扫描效率降低</b>","m":"cardgrid-mixed","bad":true},{"t":"格距<b>缺少统一规则</b>：使用一处 gap 管理","m":"space-random","bad":true}],"lessonPractice":{"title":"模板库有几十张结构一致的卡片，容器宽度会变化，卡片标题和操作不能被压得过窄。怎样排布？","options":[{"id":"responsive-card-grid","label":"使用卡片网格，设定可读的最小卡宽，并让列数随容器自动变化","feedback":"最小卡宽保护内容结构，自动列数和统一 gap 能在不同容器中保持稳定扫描。","correct":true},{"id":"fixed-four-columns","label":"始终使用四等分列，屏幕变窄时继续缩小卡片里的标题和按钮","feedback":"固定列数忽略内容所需的最小宽度，标题、图片和操作最终会拥挤或溢出。","correct":false},{"id":"different-card-structures","label":"让每张卡片根据内容自由改变字段顺序和操作位置","feedback":"网格仍然存在，但同类信息不再对齐，用户难以快速比较和连续浏览。","correct":false}],"en":{"title":"A template library has dozens of structurally consistent cards in containers of changing width. Titles and actions cannot become too narrow. How should it lay out?","options":[{"id":"responsive-card-grid","label":"Use a card grid with a readable minimum card width and automatic column count","feedback":"Minimum width protects card structure, while automatic columns and one gap preserve scanning across containers.","correct":true},{"id":"fixed-four-columns","label":"Always use four equal columns and keep shrinking card titles and actions as the screen narrows","feedback":"A fixed count ignores content's minimum width, eventually crowding or overflowing titles, images, and actions.","correct":false},{"id":"different-card-structures","label":"Let every card rearrange fields and actions independently according to its content","feedback":"The grid remains, but comparable information no longer aligns, weakening scanning and comparison.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把模板列表做成响应式卡片网格，依据标题、图片和操作确定最小卡宽，用一处 gap 管理间距，容器变窄时自动减少列数。用长标题、缺图和手机宽度验证卡片结构一致。","en":{"title":"You can say this to an AI Agent","text":"Build the template list as a responsive card grid. Derive minimum card width from title, image, and actions, manage spacing with one gap, and reduce columns automatically. 