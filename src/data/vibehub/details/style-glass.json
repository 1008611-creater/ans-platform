 2;background:rgba(255,255,255,.22);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.35);border-radius:16px;padding:12px;color:#fff\"><div style=\"font-size:12px\">☀️ Brightness</div><div style=\"height:6px;border-radius:3px;background:rgba(255,255,255,.3);margin-top:8px\"><div style=\"width:70%;height:100%;border-radius:3px;background:#fff\"></div></div></div>\n        <div style=\"grid-column:span 2;background:rgba(255,255,255,.22);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.35);border-radius:16px;padding:12px;color:#fff\"><div style=\"font-size:12px\">🔊 volume</div><div style=\"height:6px;border-radius:3px;background:rgba(255,255,255,.3);margin-top:8px\"><div style=\"width:45%;height:100%;border-radius:3px;background:#fff\"></div></div></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span style=\"display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"bg\"><span class=\"style-glass-chip\"><i style=\"background:linear-gradient(120deg,#4338ca,#ec4899)\"></i>鲜艳背景</span></span><span style=\"color:var(--text-3)\">+</span>\n      <span class=\"ap\" data-ap=\"tint\"><span class=\"style-glass-chip\"><i style=\"background:rgba(124,58,237,.18)\"></i>半透明底色</span></span><span style=\"color:var(--text-3)\">+</span>\n      <span class=\"ap\" data-ap=\"blur\"><span class=\"style-glass-chip\"><i style=\"background:repeating-linear-gradient(45deg,#e9e4f7 0 4px,#d8ccf0 4px 8px)\"></i>blur 模糊</span></span><span style=\"color:var(--text-3)\">+</span>\n      <span class=\"ap\" data-ap=\"edge\"><span class=\"style-glass-chip\"><i style=\"background:rgba(255,255,255,.3);border:1.5px solid rgba(255,255,255,.9)\"></i>半透白描边</span></span><span style=\"color:var(--text-3)\">=</span>\n      <span class=\"ap\" data-ap=\"shadow\"><span class=\"style-glass-chip\"><i style=\"background:rgba(255,255,255,.6);border:none;box-shadow:0 6px 14px rgba(80,20,120,.3)\"></i>悬浮软阴影</span></span>\n    </span>","demo_en":"<span style=\"display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"bg\"><span class=\"style-glass-chip\"><i style=\"background:linear-gradient(120deg,#4338ca,#ec4899)\"></i>Bright background</span></span><span style=\"color:var(--text-3)\">+</span>\n      <span class=\"ap\" data-ap=\"tint\"><span class=\"style-glass-chip\"><i style=\"background:rgba(124,58,237,.18)\"></i>Translucent background</span></span><span style=\"color:var(--text-3)\">+</span>\n      <span class=\"ap\" data-ap=\"blur\"><span class=\"style-glass-chip\"><i style=\"background:repeating-linear-gradient(45deg,#e9e4f7 0 4px,#d8ccf0 4px 8px)\"></i>blur blur</span></span><span style=\"color:var(--text-3)\">+</span>\n      <span class=\"ap\" data-ap=\"edge\"><span class=\"style-glass-chip\"><i style=\"background:rgba(255,255,255,.3);border:1.5px solid rgba(255,255,255,.9)\"></i> Semi-transparent white stroke</span></span><span style=\"color:var(--text-3)\">=</span>\n      <span class=\"ap\" data-ap=\"shadow\"><span class=\"style-glass-chip\"><i style=\"background:rgba(255,255,255,.6);border:none;box-shadow:0 6px 14px rgba(80,20,120,.3)\"></i>Suspended soft shadow</span></span>\n    </span>","parts":[{"key":"bg","cn":"背景内容","en":"Backdrop","desc":"背后需要有可感知的明暗或色彩变化，模糊后仍不能干扰前景","desc_en":"There needs to be perceptible changes in light and shade or color behind the scene, and the blur should not interfere with the foreground."},{"key":"tint","cn":"半透明底色","en":"Tint","desc":"透明度按主题和对比度调整；完全不透明时看不到背后的模糊","desc_en":"Transparency adjusts by subject and contrast; no blur behind is visible at full opacity"},{"key":"blur","cn":"背景模糊","en":"blur()","desc":"blur 数值按组件尺寸和背景复杂度调试，并提供无滤镜回退","desc_en":"The blur value is debugged according to component size and background complexity, and provides filter-free fallback."},{"key":"edge","cn":"边缘高光","en":"Edge Light","desc":"细描边可增强材质边界，颜色和强度要适配明暗主题","desc_en":"Thin strokes can enhance material boundaries, and the color and intensity should match the light and dark theme."},{"key":"shadow","cn":"悬浮软阴影","en":"Shadow","desc":"投影可以把浮层从背景中托起，但不要求使用彩色或固定范围","desc_en":"Drop shadows can lift overlays from the background, but do not require the use of color or a fixed range"}]},"use":[{"t":"音乐和视频界面的控制层，需要保留背景联系","m":"style-glass-use-music"},{"t":"仪表盘浮层，用材质表达前后关系","m":"style-glass-use-float"},{"t":"展示型登录页，但表单边界必须清楚","m":"style-glass-use-login"},{"t":"作品集和主题页面，局部增加轻盈层次","m":"style-glass-use-portfolio"}],"dont":[{"t":"把长篇正文直接放在复杂模糊背景上","m":"style-glass-dont-read","bad":true},{"t":"没有层级需求时仍让所有区域变成玻璃","m":"style-glass-dont-plain","bad":true},{"t":"大面积持续模糊，却没有测试目标设备性能","m":"style-glass-dont-perf","bad":true},{"t":"背景过透，导致文字和边界难以识别","m":"style-glass-dont-contrast","bad":true}],"principles":[{"t":"<b>先确认背后有可感知的内容</b>：半透明和模糊共同建立材质，但参数要按背景现场调试","m":"style-glass-three"},{"t":"<b>细描边可以模拟边缘高光</b>：颜色、粗细和透明度跟随明暗主题，不必固定为 1px 白线","m":"style-glass-edge"},{"t":"<b>透明度、边界和阴影共同表达层级</b>：近层通常更清楚，远层可以更弱","m":"style-glass-layer"},{"t":"<b>背景只需提供足够变化</b>：图片、渐变或普通内容都可以，关键是模糊后仍不干扰文字","m":"style-glass-bg"},{"t":"<b>用实色或 tint 保证对比</b>：深浅和透明度由文字颜色、背景与对比测试决定","m":"style-glass-contrast"}],"prompt":"做一个音乐活动的报名页，在有层次的背景上放置半透明信息面板。活动时间、地点、票价和报名按钮必须清楚可辨；玻璃效果不能降低可读性。活动信息只用我提供的资料，缺少的先标“待补充”，不要自行生成。","prompt_en":"Glassmorphism interface on a controlled vivid gradient, translucent cards, backdrop blur, 1px semi-transparent white borders, soft colored shadows, stable high-contrast text surfaces","references":[{"title":"backdrop-filter","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/backdrop-filter","title_en":"backdrop-filter"}],"scenes":["音乐播放器玻璃卡","渐变底登录页","玻璃拟态仪表盘","iOS 式控制中心"],"en":{"prompt":"Glassmorphism interface on a controlled vivid gradient, translucent cards, backdrop blur, 1px semi-transparent white borders, soft colored shadows, stable high-contrast text surfaces","use":[{"t":"Media controls over imagery","m":"style-glass-use-music"},{"t":"Floating navigation","m":"style-glass-use-float"},{"t":"A compact overlay or status panel","m":"style-glass-use-login"},{"t":"A visual product with controlled backgrounds","m":"style-glass-use-portfolio"}],"dont":[{"t":"Place body text on unpredictable transparent backgrounds","m":"style-glass-dont-read","bad":true},{"t":"Nest many blurred panels","m":"style-glass-dont-plain","bad":true},{"t":"Use glass on every card and control","m":"style-glass-dont-perf","bad":true},{"t":"Rely on blur alone to show boundaries","m":"style-glass-dont-contrast","bad":true}],"principles":[{"t":"Use translucency only where a real layer relationship exists","m":"style-glass-three"},{"t":"Keep text contrast stable across changing backgrounds","m":"style-glass-edge"},{"t":"Pair blur with a visible tint and edge","m":"style-glass-layer"},{"t":"Limit the number of overlapping glass surfaces","m":"style-glass-bg"},{"t":"Provide a clear fallback when blur is unavailable","m":"style-glass-contrast"}],"scenes":["Media player","Floating navbar","Dashboard overlay","Visual landing page"],"sceneUI":["<div style=\"max-width:560px;margin:0 auto;border-radius:18px;overflow:hidden;position:relative;background:linear-gradient(130deg,#1e1b4b,#6d28d9 45%,#db2777 85%);padding:30px 24px\">\n      <span style=\"position:absolute;width:150px;height:150px;border-radius:50%;background:#38bdf8;filter:blur(40px);opacity:.7;left:-40px;top:-30px\"></span>\n      <span style=\"position:absolute;width:130px;height:130px;border-radius:50%;background:#fbbf24;filter:blur(40px);opacity:.6;right:-20px;bottom:-30px\"></span>\n      <div style=\"position:relative;background:rgba(255,255,255,.13);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.32);border-radius:20px;padding:16px 18px;color:#fff\">\n        <div style=\"display:flex;align-items:center;gap:12px\">\n          <img src=\"/assets/slide-forest.png\" style=\"width:52px;height:52px;border-radius:12px;object-fit:c