/span><span class=\"mk-input\" style=\"min-width:40px;justify-content:center\">50</span><span class=\"mk-btn outline\">＋</span></div></div>","num-range":"<div class=\"mk-win\"><div class=\"mk-row \"><span class=\"mk-btn outline\">−</span><span class=\"mk-input\" style=\"min-width:40px;justify-content:center\">1</span><span class=\"mk-btn outline\">＋</span></div><span style=\"font-size:12px;color:var(--text-3)\">最小 1、最大 99，超出会被拦下</span></div>","num-price":"<div class=\"mk-win\"><div class=\"mk-row \"><span style=\"width:34px;color:var(--text-3)\">价格</span><span class=\"mk-input\" style=\"min-width:64px;justify-content:center\">19.90</span><span style=\"color:var(--text-3)\">元</span></div><span style=\"font-size:12px;color:var(--text-3)\">自动保留两位小数</span></div>","num-phone":"<div class=\"mk-win\"><div class=\"mk-row \"><span style=\"width:34px;color:var(--text-3)\">手机</span><span class=\"mk-btn outline\">−</span><span class=\"mk-input\" style=\"min-width:40px;justify-content:center\">138****6688</span><span class=\"mk-btn outline\">＋</span></div><span style=\"font-size:12px;color:var(--red)\">手机号又不能加减</span></div>","num-slider":"<div class=\"mk-row \"><span style=\"color:var(--text-3)\">预算</span><span class=\"mk-progress\" style=\"width:110px\"><i style=\"width:45%\"></i></span><span style=\"color:var(--text-2)\">≈ 450</span></div>","num-date":"<div class=\"mk-win\"><div class=\"mk-row \"><span class=\"mk-input\">2026-07-21 📅</span></div><span style=\"font-size:12px;color:var(--text-3)\">日期有专门的选择器</span></div>","num-big":"<div class=\"mk-win\"><div class=\"mk-row \"><span class=\"mk-btn outline\">−</span><span class=\"mk-input\" style=\"min-width:40px;justify-content:center\">12,800</span><span class=\"mk-btn outline\">＋</span></div><span style=\"font-size:12px;color:var(--red)\">数值范围较大，应支持直接输入</span></div>"}}}