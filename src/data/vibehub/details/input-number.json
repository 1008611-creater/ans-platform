{"__formatVersion":2,"__revision":"8537e375ffd2860a","__entryId":"input-number","entry":{"sceneUI":["<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div style=\"display:flex;align-items:center;gap:12px\">\n            <img src=\"/assets/photo-cat.png\" style=\"width:52px;height:52px;border-radius:8px;object-fit:cover\" alt=\"\">\n            <div style=\"flex:1;min-width:0\">\n              <div style=\"font-size:13px;font-weight:600\">无线机械键盘 · 茶轴</div>\n              <div style=\"font-size:12px;color:var(--text-3);margin:2px 0\">87 键 / 蓝牙双模</div>\n              <div style=\"font-size:13px;color:var(--red);font-weight:600\">¥ 329.00</div>\n            </div>\n            <span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"2\"><button class=\"num-btn\">＋</button></span>\n          </div>\n          <div style=\"display:flex;justify-content:flex-end;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border-light);font-size:12px;color:var(--text-2)\">共 2 件，合计 <b style=\"color:var(--red)\">¥ 658.00</b></div>\n        </div>","<div style=\"max-width:360px;margin:0 auto\">\n          <div style=\"font-size:13px;font-weight:600;margin-bottom:6px\">库存管理 · 无线机械键盘</div>\n          <div class=\"input-number-sc-row\" style=\"border-top:0\"><span>现货库存</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"50\"><button class=\"num-btn\">＋</button></span><em>件</em></div>\n          <div class=\"input-number-sc-row\"><span>库存预警</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"10\"><button class=\"num-btn\">＋</button></span><em>件</em></div>\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">低于预警值时，会在工作台提醒你补货</div>\n        </div>","<div style=\"max-width:380px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:10px\">\n            <div style=\"flex:1\"><div style=\"font-size:13px;font-weight:600\">手冲咖啡体验课</div><div style=\"font-size:12px;color:var(--text-3)\">每人限购 5 份 · 7 月 26 日开课</div></div>\n            <span class=\"demo-tag red\">限时</span>\n          </div>\n          <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px\">\n            <span style=\"font-size:12px;color:var(--text-2)\">购买份数</span>\n            <span style=\"display:flex;align-items:center;gap:10px\"><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"3\"><button class=\"num-btn\">＋</button></span><button class=\"btn btn-primary\">立即报名</button></span>\n          </div>\n        </div>","<div style=\"max-width:360px;margin:0 auto\">\n          <div style=\"font-size:13px;font-weight:600;margin-bottom:6px\">商品定价</div>\n          <div class=\"input-number-sc-row\" style=\"border-top:0\"><span>售价</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"19.90\"><button class=\"num-btn\">＋</button></span><em>元</em></div>\n          <div class=\"input-number-sc-row\"><span>会员价</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"16.90\"><button class=\"num-btn\">＋</button></span><em>元</em></div>\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">自动保留两位小数，最低不低于 0.01 元</div>\n        </div>"],"sceneUI_en":["<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div style=\"display:flex;align-items:center;gap:12px\">\n            <img src=\"/assets/photo-cat.png\" style=\"width:52px;height:52px;border-radius:8px;object-fit:cover\" alt=\"\">\n            <div style=\"flex:1;min-width:0\">\n              <div style=\"font-size:13px;font-weight:600\">Wireless mechanical keyboard · Brown switches</div>\n              <div style=\"font-size:12px;color:var(--text-3);margin:2px 0\">87 keys / Bluetooth dual mode</div>\n              <div style=\"font-size:13px;color:var(--red);font-weight:600\">¥ 329.00</div>\n            </div>\n            <span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"2\"><button class=\"num-btn\">+</button></span>\n          </div>\n          <div style=\"display:flex;justify-content:flex-end;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border-light);font-size:12px;color:var(--text-2)\">Total 2 items, total <b style=\"color:var(--red)\">¥ 658.00</b></div>\n        </div>","<div style=\"max-width:360px;margin:0 auto\">\n          <div style=\"font-size:13px;font-weight:600;margin-bottom:6px\">Inventory management · Wireless mechanical keyboard</div>\n          <div class=\"input-number-sc-row\" style=\"border-top:0\"><span>Stock on hand</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"50\"><button class=\"num-btn\">+</button></span><em>pieces</em></div>\n          <div class=\"input-number-sc-row\"><span>Low-stock alert</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"10\"><button class=\"num-btn\">+</button></span><em>items</em></div>\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">We’ll notify you on the dashboard when stock falls below this level</div>\n        </div>","<div style=\"max-width:380px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:10px\">\n            <div style=\"flex:1\"><div style=\"font-size:13px;font-weight:600\">Hand-brewed coffee trial class</div><div style=\"font-size:12px;color:var(--text-3)\">Limit 5 seats per person · Class starts on July 26th</div></div>\n            <span class=\"demo-tag red\">Limited time</span>\n          </div>\n          <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px\">\n            <span style=\"font-size:12px;color:var(--text-2)\">Number of copies to purchase</span>\n            <span style=\"display:flex;align-items:center;gap:10px\"><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"3\"><button class=\"num-btn\">+</button></span><button class=\"btn btn-primary\">Register now</button></span>\n          </div>\n        </div>","<div style=\"max-width:360px;margin:0 auto\">\n          <div style=\"font-size:13px;font-weight:600;margin-bottom:6px\">Product pricing</div>\n          <div class=\"input-number-sc-row\" style=\"border-top:0\"><span>Price</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"19.90\"><button class=\"num-btn\">+</button></span><em>yuan</em></div>\n          <div class=\"input-number-sc-row\"><span>Member price</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"16.90\"><button class=\"num-btn\">+</button></span><em>yuan</em></div>\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">Automatically retain two decimal places, the minimum is not less than 0.01 yuan</div>\n        </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><span class=\"num-demo\"><span class=\"ap\" data-ap=\"minus\"><button class=\"num-btn\">−</button></span><span class=\"ap\" data-ap=\"box\"><input class=\"num-input\" value=\"3\"></span><span class=\"ap\" data-ap=\"plus\"><button class=\"num-btn\">＋</button></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><span class=\"num-demo\"><span class=\"ap\" data-ap=\"minus\"><button class=\"num-btn\">−</button></span><span class=\"ap\" data-ap=\"box\"><input class=\"num-input\" value=\"3\"></span><span class=\"ap\" data-ap=\"plus\"><button class=\"num-btn\">＋</button></span></span></span>","parts":[{"key":"root","cn":"数字输入控件","en":"InputNumber","desc":"输入框和加减按钮组成一个控件，也常叫数字步进器（Numeric Stepper）","desc_en":"The input and plus/minus buttons form one control, also called a numeric stepper."},{"key":"minus","cn":"减少按钮","en":"Minus","desc":"点一下减一个步长","desc_en":"Click to decrease the value by one step"},{"key":"box","cn":"数值输入框","en":"Input","desc":"也可以直接键盘输入","desc_en":"Users can also type a value directly"},{"key":"plus","cn":"增加按钮","en":"Plus","desc":"到上限后置灰","desc_en":"Disable it after it reaches the upper limit."}]},"variants":[{"cn":"默认","en":"Default","demo":"<span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"3\"><button class=\"num-btn\">＋</button></span>","demo_en":"<span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"3\"><button class=\"num-btn\">＋</button></span>","when":"数量、库存等常规纯数字输入","when_en":"For simple numeric input, such as quantity or inventory"},{"cn":"带单位","en":"With Unit","demo":"<span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"10\"><button class=\"num-btn\">＋</button><span class=\"num-unit\">件</span></span>","demo_en":"<span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"10\"><button class=\"num-btn\">＋</button><span class=\"num-unit\">piece</span></span>","when":"价格、件数等需要标清计量单位","when_en":"Prices and quantities need a visible unit."},{"cn":"小尺寸","en":"Small","demo":"<span class=\"num-demo sm\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"1\"><button class=\"num-btn\">＋</button></span>","demo_en":"<span class=\"num-demo sm\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"1\"><button class=\"num-btn\">＋</button></span>","when":"卡片、行内等空间紧张的地方","when_en":"In cards, rows, and other tight spaces"},{"cn":"禁用","en":"Disabled","demo":"<span class=\"num-demo disabled\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"0\" disabled><button class=\"num-btn\">＋</button></span>","demo_en":"<span class=\"num-demo disabled\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"0\" disabled><button class=\"num-btn\">＋</button></span>","when":"这个数值当前不允许改动","when_en":"This value is currently not allowed to be changed"}],"use":[{"t":"<b>购物车改数量</b>：点加减比敲键盘快","m":"num-cart"},{"t":"<b>设置库存、限购</b>：整数且有业务含义","m":"num-stock"},{"t":"<b>有明确上下限</b>：超出范围自动拦下","m":"num-range"},{"t":"<b>价格、金额</b>：需要固定小数位","m":"num-price"}],"dont":[{"t":"<b>手机号、身份证号</b>属于数字字符串：使用 {c:input}","m":"num-phone","bad":true},{"t":"只需<b>近似选择数值</b>：使用 {c:slider}","m":"num-slider"},{"t":"需要选择<b>日期或年份</b>：使用 {c:date-picker}","m":"num-date"},{"t":"<b>数值范围很大</b>：支持直接键盘输入，不只依赖加减按钮","m":"num-big","bad":true}],"lessonPractice":{"title":"购物车数量必须是 1–20 的整数，用户常用加减调整，但实际库存可能随时变化。怎样实现更完整？","options":[{"id":"number-and-business-check","label":"提供可输入和步进的数字控件，限制范围，并在提交时再校验库存","feedback":"控件负责数值格式和基本范围，提交校验负责判断当时是否还有足够库存。","correct":true},{"id":"slider-for-quantity","label":"使用带 20 个刻度的滑块，让用户拖到需要购买的数量","feedback":"滑块适合近似或连续调节，精确选择购物数量时输入和加减通常更直接。","correct":false},{"id":"range-only-check","label":"把最大值设置为 20，只要控件没有超出范围就直接创建订单","feedback":"1–20 只是允许填写的范围，并不能证明提交时仍有对应库存，订单仍可能超卖。","correct":false}],"en":{"title":"Cart quantity must be an integer from 1 to 20 and users often adjust it by one, but live stock can change. What is the complete approach?","options":[{"id":"number-and-business-check","label":"Allow typing and step controls, constrain the range, and verify stock again on submit","feedback":"The control handles numeric format and basic range, while submission checks whether enough stock exists at that moment.","correct":true},{"id":"slider-for-quantity","label":"Use a slider with 20 marks and let users drag to the quantity they want","feedback":"Sliders fit approximate or continuous adjustment. Typing and step buttons are clearer for exact purchase quantities.","correct":false},{"id":"range-only-check","label":"Set the maximum to 20 and create the order whenever the control stays in range","feedback":"The allowed input range does not prove that the requested stock still exists when the order is submitted.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把购物车数量做成可直接输入、也可按 1 加减的数字输入框，范围为 1–20 且只接受整数。前端显示范围错误，提交时仍以后端实时库存为准，并验证库存变化时会给出可重试提示。","en":{"title":"You can say this to an AI Agent","text":"Make cart quantity an integer number input that supports direct entry and step-by-one controls from 1 to 20. Show range errors in the UI, but validate against live server stock on submit and verify the retry message when stock changes."}},"demoDetail":"<span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"3\"><button class=\"num-btn\">＋</button></span>\n        <span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"19.90\"><button class=\"num-btn\">＋</button><span class=\"num-unit\">元</span></span>","references":[{"title":"数字类型输入框","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/number","title_en":"<input type=\"number\">"}],"scenes":["购物车数量","商品库存设置","限购份数","价格录入"],"en":{"demoDetail":"<span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"3\"><button class=\"num-btn\">+</button></span>\n        <span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"19.90\"><button class=\"num-btn\">+</button><span class=\"num-unit\">yuan</span></span>","use":[{"t":"Product quantity","m":"num-cart"},{"t":"Stock level","m":"num-stock"},{"t":"Price or budget","m":"num-range"},{"t":"A number with clear limits","m":"num-price"}],"dont":[{"t":"Collect a phone number or account number that is not used in calculations","m":"num-phone","bad":true},{"t":"Hide the unit when it changes the meaning","m":"num-slider"},{"t":"Rely on the browser control as the only validation","m":"num-date"},{"t":"Use tiny step buttons as the only way to enter a large value","m":"num-big","bad":true}],"scenes":["Shopping quantity","Inventory editor","Budget setting","Team size"],"sceneUI":["<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div style=\"display:flex;align-items:center;gap:12px\">\n            <img src=\"/assets/photo-cat.png\" style=\"width:52px;height:52px;border-radius:8px;object-fit:cover\" alt=\"\">\n            <div style=\"flex:1;min-width:0\">\n              <div style=\"font-size:13px;font-weight:600\">Wireless mechanical keyboard · Brown switches</div>\n              <div style=\"font-size:12px;color:var(--text-3);margin:2px 0\">87 keys / Bluetooth dual mode</div>\n              <div style=\"font-size:13px;color:var(--red);font-weight:600\">¥ 329.00</div>\n            </div>\n            <span class=\"num-demo\"><button class=\"num-btn\">−</button><input class=\"num-input\" value=\"2\"><button class=\"num-btn\">+</button></span>\n          </div>\n          <div style=\"display:flex;justify-content:flex-end;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border-light);font-size:12px;color:var(--text-2)\">Total 2 items, total <b style=\"color:var(--red)\">¥ 658.00</b></div>\n        </div>","<div style=\"max-width:360px;margin:0 auto\">\n          <div style=\"font-size:13px;font-weight:600;margin-bottom:6px\">Inventory management · Wireless mechanical keyboard</div>\n          <div class=\"input-number-sc-row\" style=\"border-top:0\"><span>Stock on hand</span><span class=\"num-demo\"><button class=\"num-btn\">−</button><in