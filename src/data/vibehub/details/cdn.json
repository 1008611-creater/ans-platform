{"__formatVersion":2,"__revision":"8327905b227200c7","__entryId":"cdn","entry":{"sceneUI":["<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-card);text-align:center\">\n      <div style=\"font-size:28px;margin-bottom:6px\">🚀</div>\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">部署成功</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:12px\">vibeui.dev 已更新，用时 38 秒</div>\n      <div style=\"display:flex;justify-content:center;gap:6px;flex-wrap:wrap\">\n        <span class=\"demo-tag green\">✓ 已分发至 26 个边缘节点</span>\n      </div>\n      <div style=\"margin-top:12px;font-size:12px;color:var(--text-3)\">静态资源经全球 CDN 加速，HTTPS 证书已自动续期</div>\n    </div>","<div>\n      <b style=\"font-size:14px;display:block;margin-bottom:10px\">边缘节点 · 实时延迟</b>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 香港</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">服务：深圳、广州</span>\n        <span class=\"demo-tag green\">18ms</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 法兰克福</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">服务：柏林、巴黎</span>\n        <span class=\"demo-tag green\">22ms</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 洛杉矶</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">服务：旧金山、西雅图</span>\n        <span class=\"demo-tag green\">26ms</span>\n      </div>\n      <div style=\"margin-top:10px;font-size:12px;color:var(--text-3)\">同一批文件，每个用户都从最近的节点取</div>\n    </div>","<div>\n      <b style=\"font-size:14px;display:block;margin-bottom:12px\">CDN 缓存 · 最近 7 天</b>\n      <div style=\"display:flex;gap:12px;margin-bottom:12px\">\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">缓存命中率</div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--green)\">92.4%</div>\n        </div>\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">回源请求</div>\n          <div style=\"font-size:20px;font-weight:700\">7.6%</div>\n        </div>\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">源站带宽省下</div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--brand)\">86 GB</div>\n        </div>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3)\">九成多的请求在节点就解决了，源站几乎没压力</div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px\">\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">刷新缓存</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:12px\">让全球节点丢掉旧文件，重新回源取最新版</div>\n      <div style=\"display:flex;gap:8px;margin-bottom:12px\">\n        <input class=\"demo-input\" style=\"flex:1;font-family:monospace\" value=\"/assets/logo.png\">\n        <button class=\"btn btn-primary\">Purge</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;background:var(--green-light);border-radius:8px;padding:8px 12px\">\n        <span style=\"font-size:12px;color:var(--green)\">✓ 已刷新 26 个节点，约 30 秒内全球生效</span>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-card);text-align:center\">\n      <div style=\"font-size:28px;margin-bottom:6px\">🚀</div>\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">Deployed successfully</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:12px\">vibeui.dev updated in 38 seconds</div>\n      <div style=\"display:flex;justify-content:center;gap:6px;flex-wrap:wrap\">\n        <span class=\"demo-tag green\">✓ Distributed to 26 edge nodes</span>\n      </div>\n      <div style=\"margin-top:12px;font-size:12px;color:var(--text-3)\">Static resources are accelerated by global CDN, and the HTTPS certificate has been automatically renewed</div>\n    </div>","<div>\n      <b style=\"font-size:14px;display:block;margin-bottom:10px\">Edge node · Real-time delay</b>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 Hong Kong</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Services: Shenzhen, Guangzhou</span>\n        <span class=\"demo-tag green\">18ms</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 Frankfurt</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Services: Berlin, Paris</span>\n        <span class=\"demo-tag green\">22ms</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 Los Angeles</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Services: San Francisco, Seattle</span>\n        <span class=\"demo-tag green\">26ms</span>\n      </div>\n      <div style=\"margin-top:10px;font-size:12px;color:var(--text-3)\">For the same batch of files, each user will fetch them from the nearest node</div>\n    </div>","<div>\n      <b style=\"font-size:14px;display:block;margin-bottom:12px\">CDN cache · Last 7 days</b>\n      <div style=\"display:flex;gap:12px;margin-bottom:12px\">\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Cache hit rate</div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--green)\">92.4%</div>\n        </div>\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Back to origin request</div>\n          <div style=\"font-size:20px;font-weight:700\">7.6%</div>\n        </div>\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Save origin site bandwidth</div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--brand)\">86 GB</div>\n        </div>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3)\">More than 90% of requests are resolved at the node, and the origin site has almost no pressure</div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px\">\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">Refresh cache</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:12px\">Let global nodes discard old files and go back to the source to get the latest version</div>\n      <div style=\"display:flex;gap:8px;margin-bottom:12px\">\n        <input class=\"demo-input\" style=\"flex:1;font-family:monospace\" value=\"/assets/logo.png\">\n        <button class=\"btn btn-primary\">Purge</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;background:var(--green-light);border-radius:8px;padding:8px 12px\">\n        <span style=\"font-size:12px;color:var(--green)\">✓ 26 nodes have been refreshed and will take effect globally in about 30 seconds</span>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"cdn-anat\"><span class=\"ap cdn-origin\" data-ap=\"origin\"><span class=\"dns-ico\">🖥️</span><span class=\"cdn-node-name\">源站</span></span><span class=\"cdn-arrow\">→</span><span class=\"ap\" data-ap=\"edge\"><span class=\"cdn-edges\"><span class=\"cdn-edge\">📍 香港节点<span class=\"cdn-ms\">18ms</span></span><span class=\"cdn-edge\">📍 法兰克福节点<span class=\"cdn-ms\">22ms</span></span></span></span><span class=\"ap cdn-cache\" data-ap=\"cache\">缓存 30 天</span></span>","demo_en":"<span class=\"cdn-anat\"><span class=\"ap cdn-origin\" data-ap=\"origin\"><span class=\"dns-ico\">🖥️</span><span class=\"cdn-node-name\">Origin</span></span><span class=\"cdn-arrow\">→</span><span class=\"ap\" data-ap=\"edge\"><span class=\"cdn-edges\"><span class=\"cdn-edge\">📍 Hong Kong node <span class=\"cdn-ms\">18ms</span></span><span class=\"cdn-edge\">📍 Frankfurt node <span class=\"cdn-ms\">22ms</span></span></span></span><span class=\"ap cdn-cache\" data-ap=\"cache\">Cache for 30 days</span></span>","parts":[{"key":"origin","cn":"源站","en":"Origin","desc":"文件的原件，只有节点没存货时才被取用","desc_en":"The origin is contacted only when an edge node does not have the requested file."},{"key":"edge","cn":"边缘节点","en":"Edge Node","desc":"离用户近的分发仓，存着文件副本直接发","desc_en":"An edge location near the user that caches files and serves them directly"},{"key":"cache","cn":"缓存","en":"Cache","desc":"节点把文件留一份的时长；到期或 Purge 才回源换新","desc_en":"How long an edge node keeps a cached file before fetching a fresh copy from the origin"}]},"variants":[{"cn":"静态资源加速","en":"Static Assets","demo":"<span style=\"font-family:monospace;font-size:12px\">cdn.vibeui.dev/logo.png</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">cdn.vibeui.dev/logo.png</span>","when":"图片、JS、CSS 放边缘节点发","when_en":"Images, JS, CSS are sent to edge nodes"},{"cn":"全站加速","en":"Full Site","demo":"<span style=\"font-family:monospace;font-size:12px\">vibeui.dev <span class=\"demo-tag blue\">Edge</span></span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">vibeui.dev <span class=\"demo-tag blue\">Edge</span></span>","when":"HTML 也走节点，动态部分回源","when_en":"HTML also uses nodes, and dynamic parts return to the source"},{"cn":"对象存储 + CDN","en":"OSS + CDN","demo":"<span style=\"font-family:monospace;font-size:12px\">uploads.vibeui.dev/u/8f2k.jpg</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">uploads.vibeui.dev/u/8f2k.jpg</span>","when":"用户上传的图也交给 CDN 发","when_en":"Images uploaded by users are also sent to CDN"}],"use":[{"t":"把<b>适合缓存的图片、JS、CSS 等资源</b>交给 CDN，通常能减少源站距离和负载，但仍要测真实访问","m":"cdn-assets"},{"t":"用托管平台部署时，<b>确认 CDN 是否启用、覆盖区域和缓存规则</b>，不要假定每次发布都会全球同步","m":"cdn-platform"},{"t":"让用户<b>由合适的边缘节点获取内容</b>；节点不一定物理最近，实际速度还受网络和缓存命中影响","m":"cdn-edge"},{"t":"文件更新后<b>刷新缓存（Purge）</b>，节点重新回源取新文件","m":"cdn-purge"}],"dont":[{"t":"大图片全<b>从源站直出</b>：海外用户每张图都在转圈","m":"cdn-origin-only","bad":true},{"t":"改了图<b>文件名不变</b>：节点还在发旧缓存，用户看到旧图","m":"cdn-stale","bad":true},{"t":"把<b>实时数据也长时间缓存</b>：余额、库存全是旧数据","m":"cdn-api-cache","bad":true},{"t":"<b>HTML 缓存设一年</b>：发了新版，用户死活刷不出来","m":"cdn-html-cache","bad":true}],"lessonPractice":{"title":"海外用户加载产品图片很慢；接入 CDN 后发布新图，部分地区却仍看到旧版本。怎样处理更完整？","options":[{"id":"cacheable-versioned-assets","label":"让静态图走 CDN，并使用版本化地址或刷新缓存后验证各地区结果","feedback":"CDN 缩短静态资源路径，版本化或 Purge 则解决节点继续命中旧缓存的问题。","correct":true},{"id":"same-url-longer-cache","label":"继续使用同一个图片地址并延长缓存时间，等待各地区节点自然更新","feedback":"同一地址配合更长缓存会让旧副本保留更久，而且无法确定各节点何时一致。","correct":false},{"id":"origin-only-verification","label":"发布后绕过 CDN 检查源站；源站是新图就视为所有地区已更新","feedback":"源站更新不代表边缘节点已经刷新，仍要检查版本、缓存状态和实际地区结果。","correct":false}],"en":{"title":"Product images load slowly overseas. After adding a CDN, some regions still show an old image after release. What is the complete response?","options":[{"id":"cacheable-versioned-assets","label":"Serve static images through the CDN and use versioned URLs or purge before regional verification","feedback":"The CDN shortens delivery for static assets, while versioning or purge prevents nodes from serving an old cache.","correct":true},{"id":"same-url-longer-cache","label":"Keep the same image URL and extend its cache lifetime while waiting for every region to update naturally","feedback":"A longer cache on the same URL preserves old copies for longer and provides no reliable update point.","correct":false},{"id":"origin-only-verification","label":"Bypass the CDN after release and treat a fresh origin image as proof every region has updated","feedback":"A fresh origin does not prove edge caches have refreshed; verify versions, cache state, and real regions.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请让图片、JS 和 CSS 使用 CDN 与版本化文件名，发布后验证缓存命中和多地区结果。库存、余额等实时数据不要长缓存；如果接口仍慢，分别测 CDN、源站和后端处理时间。","en":{"title":"You can say this to an AI Agent","text":"Serve images, JS, and CSS through the CDN with versioned filenames, then verify cache hits and multiple regions after release. Do not long-cache inventory or balances; measure CDN, origin, and backend time separately for slow APIs."}},"references":[{"title":"CDN 词汇表","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Glossary/CDN","title_en":"CDN"},{"title":"内容分发网络（CDN）","source":"web.dev","url":"https://web.dev/articles/content-delivery-networks","title_en":"Content delivery networks (CDNs)"}],"scenes":["部署成功全球分发","节点与延迟对照","缓存命中率看板","手动刷新缓存"],"en":{"use":[{"t":"Deliver images and static assets","m":"cdn-assets"},{"t":"Reduce latency across regions","m":"cdn-platform"},{"t":"Cache public files with stable versions","m":"cdn-edge"},{"t":"Absorb repeated requests before they reach the origin","m":"cdn-purge"}],"dont":[{"t":"Cache private or personalized responses as public","m":"cdn-origin-only","bad":true},{"t":"Change a file without updating or invalidating its cache","m":"cdn-stale","bad":true},{"t":"Assume a CDN fixes slow application logic","m":"cdn-api-cache","bad":true},{"t":"Ignore cost and regional requirements","m":"cdn-html-cache","bad":true}],"scenes":["Image delivery","JavaScript assets","Global website","Download files"],"sceneUI":["<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-card);text-align:center\">\n      <div style=\"font-size:28px;margin-bottom:6px\">🚀</div>\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">Deployed successfully</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:12px\">vibeui.dev updated in 38 seconds</div>\n      <div style=\"display:flex;justify-content:center;gap:6px;flex-wrap:wrap\">\n        <span class=\"demo-tag green\">✓ Distributed to 26 edge nodes</span>\n      </div>\n      <div style=\"margin-top:12px;font-size:12px;color:var(--text-3)\">Static resources are accelerated by global CDN, and the HTTPS certificate has been automatically renewed</div>\n    </div>","<div>\n      <b style=\"font-size:14px;display:block;margin-bottom:10px\">Edge node · Real-time delay</b>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 Hong Kong</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Services: Shenzhen, Guangzhou</span>\n        <span class=\"demo-tag green\">18ms</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 Frankfurt</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Services: Berlin, Paris</span>\n        <span class=\"demo-tag green\">22ms</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">📍 Los Angeles</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Services: San Francisco, Seattle</span>\n        <span class=\"demo-tag green\">26ms</span>\n      </div>\n      <div style=\"margin-top:10px;font-size:12px;color:var(--text-3)\">For the same batch of files, each user will fetch them from the nearest node</div>\n    </div>","<div>\n      <b style=\"font-size:14px;display:block;margin-bottom:12px\">CDN cache · Last 7 days</b>\n      <div style=\"display:flex;gap:12px;margin-bottom:12px\">\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Cache hit rate</div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--green)\">92.4%</div>\n        </div>\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Back to origin request</div>\n          <div style=\"font-size:20px;font-weight:700\">7.6%</div>\n        </div>\n        <div style=\"flex:1;background:var(--bg-soft);border-radius:10px;padding:12px 14px\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Save origin site bandwidth</div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--brand)\">86 GB</div>\n        </div>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3)\">More than 90% of requests are resolved at the node, and the origin site has almost no pressure</div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px\">\n      <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">Refresh cache</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:12px\">Let global nodes discard old files and go back to the source to get the latest version</div>\n      <div style=\"display:flex;gap:8px;margin-bottom:12px\">\n        <input class=\"demo-input\" style=\"flex:1;font-family:monospace\" value=\"/assets/logo.png\">\n        <button class=\"btn btn-primary\">Purge</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;background:var(--green-light);border-radius:8px;padding:8px 12px\">\n        <span style=\"font-size:12px;color:var(--green)\">✓ 26 nodes have been refreshed and will take effect globally in about 30 seconds</span>\n      </div>\n    </div>"],"variants":[{"demo":"<span style=\"font-family:monospace;font-size:12px\">cdn.vibeui.dev/logo.png</span>","when":"Images, JS, CSS are sent to edge nodes"},{"demo":"<span style=\"font-family:monospace;font-size:12px\">vibeui.dev <span class=\"demo-tag blue\">Edge</span></span>","when":"HTML also uses nodes, and dynamic parts return to the source"},{"demo":"<span style=\"font-family:monospace;font-size:12px\">uploads.vibeui.dev/u/8f2k.jpg</span>","when":"Images uploaded by users are also sent to CDN"}]},"usageMocks":{"cdn-assets":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"font-size:12px\">logo.png</span><span class=\"mk-tag blue\">CDN</span></div><div class=\"mk-row between\"><span style=\"font-size:12px\">app.js</span><span class=\"mk-tag blue\">CDN</span></div><span style=\"font-size:12px;color:var(--text-3)\">CDN 可缓存并分发静态资源</span></div>","cdn-platform":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div><span class=\"mk-toast-float\"><span class=\"mk-toast\"><i class=\"mk-dot\"></i>部署成功，已分发至全球节点</span></span></div>","cdn-edge":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"font-size:12px\">深圳用户</span><span class=\"mk-tag green\">香港节点 · 18ms</span></div><div class=\"mk-row between\"><span style=\"font-size:12px\">柏林用户</span><span class=\"mk-tag green\">法兰克福 · 22ms</span></div></div>","cdn-purge":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"font-size:12px\">logo.png 更新了</span><span class=\"mk-btn outline\">刷新缓存</span></div><span style=\"font-size:12px;color:var(--text-3)\">Purge 后节点重新回源取新文件</span></div>","cdn-origin-only":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"font-size:12px\">柏林用户</span><span class=\"mk-tag red\">直连源站 · 380ms</span></div><span style=\"font-size:12px;color:var(--text-3)\">用户与源站距离较远时，资源传输延迟会增加</span></div>","cdn-stale":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"font-size:12px\">logo.png</span><span class=\"mk-tag orange\">缓存 30 天</span></div><span style=\"font-size:12px;color:var(--red)\">缺少版本化或刷新策略时，用户可能继续看到旧资源</span></div>","cdn-api-cache":"<div class=\"mk-win\"><div class=\"mk-row\"><span style=\"font-size:12px;font-family:monospace\">/api/balance</span><span class=\"mk-tag red\">缓存 1 小时</span></div><span style=\"font-size:12px;color:var(--red)\">账户余额等私有动态数据需要严格的缓存策略与鉴权隔离</span></div>","cdn-html-cache":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"font-size:12px\">index.html</span><span class=\"mk-tag red\">缓存 1 年</span></div><span style=\"font-size:12px;color:var(--text-3)\">缓存期过长且没有更新策略时，用户可能继续看到旧版本</span></div>"}}}