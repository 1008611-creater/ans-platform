desc_en":"Usually a slash or chevron, used only as a visual separator"},{"key":"cur","cn":"当前页","en":"Current","desc":"纯文本不可点，就是用户所在的这一页","desc_en":"Plain text for the current page; it is not clickable."}]},"variants":[{"cn":"基础用法","en":"Basic","demo":"<div class=\"breadcrumb-demo\"><a class=\"breadcrumb-link\">首页</a><span class=\"breadcrumb-sep\">/</span><a class=\"breadcrumb-link\">组件</a><span class=\"breadcrumb-sep\">/</span><span class=\"breadcrumb-cur\">面包屑</span></div>","demo_en":"<div class=\"breadcrumb-demo\"><a class=\"breadcrumb-link\">Homepage</a><span class=\"breadcrumb-sep\">/</span><a class=\"breadcrumb-link\">Component</a><span class=\"breadcrumb-sep\">/</span><span class=\"breadcrumb-cur\">Breadcrumb</span></div>","when":"存在清楚的多级信息层级，并需要返回上级时","when_en":"When there is a clear multi-level information hierarchy and it is necessary to go back to the previous level"},{"cn":"带图标","en":"With Icon","demo":"<div class=\"breadcrumb-demo\"><a class=\"breadcrumb-link\">🏠 首页</a><span class=\"breadcrumb-sep\">/</span><span class=\"breadcrumb-cur\">组件</span></div>","demo_en":"<div class=\"breadcrumb-demo\"><a class=\"breadcrumb-link\">🏠 Home</a><span class=\"breadcrumb-sep\">/</span><span class=\"breadcrumb-cur\">Component</span></div>","when":"首级入口需要与其他路径项区分时","when_en":"When the first-level entry needs to be distinguished from other path items"},{"cn":"自定义分隔符","en":"Separator","demo":"<div class=\"breadcrumb-demo\"><a class=\"breadcrumb-link\">首页</a><span class=\"breadcrumb-sep\">›</span><span class=\"breadcrumb-cur\">组件</span></div>","demo_en":"<div class=\"breadcrumb-demo\"><a class=\"breadcrumb-link\">Homepage</a><span class=\"breadcrumb-sep\">›</span><span class=\"breadcrumb-cur\">Component</span></div>","when":"设计系统已定义路径分隔符样式时","when_en":"When the design system has defined a path separator style"}],"use":[{"t":"站点有<b>多级层级</b>，需要标明当前页的位置","m":"breadcrumb-path"},{"t":"用户想<b>快速回到上一级</b>，点链接直接跳","m":"breadcrumb-back"},{"t":"文件目录、商品分类这类<b>树状结构</b>","m":"breadcrumb-files"},{"t":"深层页面配合 {c:menu}，帮助用户确认当前位置","m":"breadcrumb-deep"}],"dont":[{"t":"页面层级很浅：标题通常已足够说明位置","m":"breadcrumb-flat","bad":true},{"t":"表示<b>操作步骤</b>：使用 {c:steps}","m":"breadcrumb-as-steps","bad":true},{"t":"路径太长<b>不收缩</b>，一行放不下全摊开","m":"breadcrumb-long","bad":true},{"t":"当前页做成<b>可点击链接</b>，无法带来新的导航结果","m":"breadcrumb-current","bad":true}],"lessonPractice":{"title":"用户正在“项目 / 夏季活动 / 数据报告”页面，需要看懂它属于哪一层并返回项目。怎样展示？","options":[{"id":"hierarchy-path","label":"显示“项目 / 夏季活动 / 数据报告”，上级可点击","feedback":"这条路径表达页面在内容层级中的位置，并让用户直接返回任一上级。","correct":true},{"id":"visit-history","label":"显示用户刚才访问过的三个页面，按时间倒序排列","feedback":"访问历史会随进入方式变化，不能稳定说明当前页面属于哪个项目和层级。","correct":false},{"id":"task-steps","label":"显示“第 3 步”，并把前两个页面标记为已完成","feedback":"这些页面是层级位置，不是必须按顺序完成的流程；步骤状态会暗示不存在的任务进度。","correct":false}],"en":{"title":"Someone is on Projects / Summer campaign / Data report and needs to understand the hierarchy and return to Projects. What should be shown?","options":[{"id":"hierarchy-path","label":"Show 'Projects / Summer campaign / Data report' with linked parent levels","feedback":"The path communicates the page's stable place in the hierarchy and provides direct navigation to each parent.","correct":true},{"id":"visit-history","label":"List the last three visited pages in reverse chronological order","feedback":"Visit history changes with the route taken and does not reliably explain where the current page belongs.","correct":false},{"id":"task-steps","label":"Show 'Step 3' and mark the previous two pages as completed","feedback":"These are locations in a hierarchy, not stages of a required process, so completion states are misleading.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请在数据报告页显示“项目 / 夏季活动 / 数据报告”面包屑。上级可以返回，当前页只表示位置，不要按访问历史生成。请从不同入口直接打开报告，确认路径仍然一致，窄屏不会挤出页面。","en":{"title":"You can say this to an AI Agent","text":"Show Projects / Summer campaign / Data report breadcrumbs on the report page. Link parent levels and keep the current page as location text, not visit history. Open the report from different entry points and verify a stable path without narrow-screen overflow."}},"references":[{"title":"面包屑模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/breadcrumb/","title_en":"Breadcrumb Pattern"}],"scenes":["电商商品详情页","云盘文件目录","后台多级页面","帮助中心文章页"],"en":{"use":[{"t":"Deep documentation","m":"breadcrumb-path"},{"t":"Product category hierarchy","m":"breadcrumb-back"},{"t":"File or folder path","m":"breadcrumb-files"},{"t":"A detail page several levels below the start","m":"breadcrumb-deep"}],"dont":[{"t":"Use it as a record of every page the user visited","m":"breadcrumb-flat","bad":true},{"t":"Show it on a one-level site","m":"breadcrumb-as-steps","bad":true},{"t":"Make the current item look like another link","m":"breadcrumb-long","bad":true},{"t":"Replace the main page title with a breadcrumb","m":"breadcrumb-current","bad":true}],"scenes":["Documentation","Online store category","File browser","Admin detail page"],"sceneUI":["<div style=\"border:1px solid var(--border);border-radius:10px;background:var(--bg);padding:12px 16px;box-shadow:var(--shadow-card)\">\n      <div class=\"bc-sc\" style=\"margin-bottom:11px\"><a>Homepage</a><span class=\"sep\">/</span><a>Digital Video</a><span class=\"sep\">/</span><a>Headphones</a><span class=\"sep\">/</span><span class=\"cur\">Wireless Noise Canceling Headphones Pro</span></div>\n      <div style=\"display:flex;align-items:center;gap:12px\">\n        <div style=\"width:60px;height:60px;flex:none;border-radius:8px;background:var(--bg-soft);border:1px solid var(--border-light);display:flex;align-items:center;justify-content:center;font-size:26px\">🎧</div>\n        <div style=\"flex:1;min-width:0\">\n          <b style=\"font-size:13px\">Shengkuo Q45 Noise Canceling Headphones</b>\n          <div style=\"margin-top:3px\"><span style=\"font-size:15px;color:var(--red);font-weight:700\">¥ 899</span> <span style=\"font-size:12px;color:var(--text-