{"__formatVersion":2,"__revision":"5ddcd550ff2f38e9","__entryId":"dropdown","entry":{"sceneUI":["<div style=\"position:relative;border:1px solid var(--border);border-radius:10px;background:var(--bg);padding:12px 16px;box-shadow:var(--shadow-card)\">\n      <b style=\"font-size:13px\">项目文件</b>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:8px 0;margin-top:6px;border-top:1px solid var(--border-light);font-size:12px\">\n        <span style=\"flex:1\">📄 首页改版方案.fig</span><span style=\"font-size:12px;color:var(--text-3)\">2 小时前</span>\n        <span class=\"icon-btn\" style=\"width:24px;height:24px;font-size:12px;border-color:var(--brand);color:var(--brand)\">···</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:8px 0;border-top:1px solid var(--border-light);font-size:12px;color:var(--text-3)\">\n        <span style=\"flex:1\">📄 设计规范.md</span><span style=\"font-size:12px\">昨天</span>\n        <span class=\"icon-btn\" style=\"width:24px;height:24px;font-size:12px\">···</span>\n      </div>\n      <div class=\"dropdown-panel\" style=\"position:absolute;right:16px;top:56px;width:132px;min-width:0;box-shadow:var(--shadow-float)\">\n        <span class=\"dropdown-item\" style=\"font-size:12px\">重命名</span>\n        <span class=\"dropdown-item\" style=\"font-size:12px\">复制链接</span>\n        <span class=\"dropdown-sep\"></span>\n        <span class=\"dropdown-item danger\" style=\"font-size:12px\">删除</span>\n      </div>\n    </div>","<div style=\"position:relative;height:158px;border:1px solid var(--border);border-radius:10px;background:var(--bg);box-shadow:var(--shadow-card);overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border-light)\">\n        <b style=\"font-size:13px;flex:1\">工作台</b>\n        <span class=\"icon-btn\" style=\"width:26px;height:26px;font-size:12px\">🔔</span>\n        <img src=\"/assets/avatar-fox.png\" style=\"width:26px