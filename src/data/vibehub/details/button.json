{"__formatVersion":2,"__revision":"054141b0b4ce3354","__entryId":"button","entry":{"sceneUI":["<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:22px 24px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:15px;font-weight:600;margin-bottom:14px\">欢迎回来</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" value=\"you@example.com\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:14px\" type=\"password\" value=\"••••••••\">\n      <button class=\"btn btn-primary\" style=\"width:100%\">登 录</button>\n    </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:45%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:280px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-float)\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">确认删除这个项目？</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:14px\">删除后无法恢复，请谨慎操作。</div>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px\"><button class=\"btn btn-outline\">取消</button><button class=\"btn btn-danger\">确认删除</button></div>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:22px 24px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:15px;font-weight:600;margin-bottom:14px\">Welcome back</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" value=\"you@example.com\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:14px\" type=\"password\" value=\"••••••••\">\n      <button class=\"btn btn-primary\" style=\"width:100%\">Sign In</button>\n    </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:45%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:280px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-float)\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">Delete this project?</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:14px\">This can't be undone. Please proceed with care.</div>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px\"><button class=\"btn btn-outline\">Cancel</button><button class=\"btn btn-danger\">Delete</button></div>\n      </div>\n    </div>","<div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;padding:8px 0\">\n      <img src=\"/assets/empty-box.png\" style=\"width:76px;height:60px;object-fit:contain\" alt=\"\">\n      <div style=\"font-size:13px;font-weight:600\">No projects yet</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">Create your first project and start collaborating</div>\n      <button class=\"btn btn-primary\">Create now</button>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:12px\">\n        <b style=\"font-size:14px;flex:1\">Project files</b>\n        <button class=\"btn btn-outline\">Export</button>\n        <button class=\"btn btn-primary\">＋ New file</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\"><span style=\"font-size:13px;flex:1\">📄 homepage-redesign.fig</span><span style=\"font-size:12px;color:var(--text-3)\">2 hours ago</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\"><span style=\"font-size:13px;flex:1\">📄 design-guidelines.md</span><span style=\"font-size:12px;color:var(--text-3)\">Yesterday</span></div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><button class=\"btn btn-primary\"><span class=\"ap\" data-ap=\"icon\">＋</span><span class=\"ap\" data-ap=\"label\">新建项目</span></button></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><button class=\"btn btn-primary\"><span class=\"ap\" data-ap=\"icon\">+</span><span class=\"ap\" data-ap=\"label\">New project</span></button></span>","parts":[{"key":"root","cn":"按钮本体","en":"Button","desc":"整块可点击区域，有主要 / 次要 / 危险等类型","desc_en":"The full clickable area, available in primary, outline, and danger styles"},{"key":"icon","cn":"图标","en":"Icon","desc":"可选，用来强化动作含义；单独做图标按钮时要提供读屏可识别的名称，含义不直观时再配 Tooltip","desc_en":"Optional; reinforces the action. Icon-only buttons need an accessible name and a tooltip when their meaning is not obvious"},{"key":"label","cn":"文案","en":"Label","desc":"动词开头，说清点完会发生什么","desc_en":"Starts with a verb and says exactly what happens on click"}]},"variants":[{"cn":"主要按钮","en":"Primary","demo":"<button class=\"btn btn-primary\">保存</button>","demo_en":"<button class=\"btn btn-primary\">Save</button>","when":"在同一操作区域留给最重要的动作","when_en":"One per screen, reserved for the most important action"},{"cn":"次要按钮","en":"Outline","demo":"<button class=\"btn btn-outline\">取消</button>","demo_en":"<button class=\"btn btn-outline\">Cancel</button>","when":"取消、返回这类退一步的操作用它","when_en":"For step-back actions like cancel or go back"},{"cn":"文字按钮","en":"Text","demo":"<button class=\"btn btn-text\">查看详情</button>","demo_en":"<button class=\"btn btn-text\">View details</button>","when":"最轻量的操作，比如展开详情、收起","when_en":"The lightest actions — expand details, collapse"},{"cn":"危险按钮","en":"Danger","demo":"<button class=\"btn btn-danger\">删除</button>","demo_en":"<button class=\"btn btn-danger\">Delete</button>","when":"删除、清空等不可挽回的操作才用","when_en":"Only for irreversible actions like delete or clear"},{"cn":"加载与禁用","en":"Loading & Disabled","demo":"<button class=\"btn btn-primary\" disabled><span class=\"btn-spin\"></span>提交中</button><button class=\"btn btn-outline\" disabled>不可点</button>","demo_en":"<button class=\"btn btn-primary\" disabled><span class=\"btn-spin\"></span>Submitting</button><button class=\"btn btn-outline\" disabled>Unavailable</button>","when":"提交中或条件未满足时，防止重复点击","when_en":"While submitting or when requirements aren't met — blocks double clicks"}],"lessonPractice":{"title":"设置页里有“保存”“取消修改”“删除账号”和“重设密码”。哪些应该做成按钮？","options":[{"id":"clear-actions","label":"保存、取消修改、删除用按钮；重设密码用链接","feedback":"对。前三项会直接改变或放弃当前状态，应该触发动作；重设密码会前往另一页，适合用链接。删除还要在执行前确认。","correct":true},{"id":"all-primary","label":"保存和删除用按钮；取消修改和重设密码都用链接","feedback":"“取消修改”会直接放弃当前编辑，也是在执行动作；如果它不是离开页面，就不该用链接表达。","correct":false},{"id":"swap-button-link","label":"四项都做成相同样式的按钮，并排放在一起","feedback":"都使用按钮不代表层级相同。删除账号需要降低视觉优先级并单独确认，不能和保存并列成同一种操作。","correct":false}],"en":{"title":"An account settings page has save profile, discard edits, delete account, and reset password. What is the clearest arrangement?","options":[{"id":"clear-actions","label":"Use buttons for save, discard, and delete; keep reset password as a link and confirm deletion","feedback":"Correct. The first three change or discard current state, while reset password navigates to another page. Deletion also needs confirmation.","correct":true},{"id":"all-primary","label":"Make save, discard, delete, and reset password all navigation links","feedback":"Save, discard, and delete act on the current page; links do not express that behavior or handle submission state well.","correct":false},{"id":"swap-button-link","label":"Use one Confirm button for every operation and infer the intent afterward","feedback":"Each action needs an explicit target; destructive account deletion cannot be mixed with routine saving.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请整理账号设置页：保存资料、放弃本次修改和删除账号使用各自明确的按钮，删除前确认；“重设密码”保留为链接。不要改布局。分别触发保存、放弃修改和删除确认，确认保存中不能重复提交。","en":{"title":"You can say this to an AI Agent","text":"Clarify the account settings page: give save profile, discard edits, and delete account their own buttons, with confirmation before delete; keep Reset password as a link. Do not change layout. Trigger save, discard, and delete confirmation, and confirm saving cannot be submitted twice."}},"demoDetail":"<div class=\"button-panel\">\n    <div class=\"button-panel-title\">登录账号</div>\n    <input class=\"demo-input\" type=\"text\" placeholder=\"邮箱\" value=\"you@example.com\">\n    <button class=\"btn btn-primary button-panel-submit\">登 录</button>\n    <div class=\"button-panel-foot\"><span class=\"link-a\">忘记密码</span><span class=\"link-a\">注册新账号</span></div>\n  </div>","references":[{"title":"按钮模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/button/","title_en":"Button Pattern"},{"title":"<button> 按钮元素","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button","title_en":"<button>: The Button element"}],"scenes":["登录表单提交","删除确认弹窗"],"en":{"demoDetail":"<div class=\"button-panel\">\n    <div class=\"button-panel-title\">Sign in to your account</div>\n    <input class=\"demo-input\" type=\"text\" placeholder=\"Email\" value=\"you@example.com\">\n    <button class=\"btn btn-primary button-panel-submit\">Sign In</button>\n    <div class=\"button-panel-foot\"><span class=\"link-a\">Forgot password</span><span class=\"link-a\">Create an account</span></div>\n  </div>","use":[],"dont":[],"scenes":["Sign-in form","Delete confirmation","Empty project state","File toolbar"],"sceneUI":["<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:22px 24px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:15px;font-weight:600;margin-bottom:14px\">Welcome back</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" value=\"you@example.com\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:14px\" type=\"password\" value=\"••••••••\">\n      <button class=\"btn btn-primary\" style=\"width:100%\">Sign In</button>\n    </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:45%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:280px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-float)\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:4px\">Delete this project?</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:14px\">This can't be undone. Please proceed with care.</div>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px\"><button class=\"btn btn-outline\">Cancel</button><button class=\"btn btn-danger\">Delete</button></div>\n      </div>\n    </div>","<div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;padding:8px 0\">\n      <img src=\"/assets/empty-box.png\" style=\"width:76px;height:60px;object-fit:contain\" alt=\"\">\n      <div style=\"font-size:13px;font-weight:600\">No projects yet</div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">Create your first project and start collaborating</div>\n      <button class=\"btn btn-primary\">Create now</button>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:12px\">\n        <b style=\"font-size:14px;flex:1\">Project files</b>\n        <button class=\"btn btn-outline\">Export</button>\n        <button class=\"btn btn-primary\">＋ New file</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\"><span style=\"font-size:13px;flex:1\">📄 homepage-redesign.fig</span><span style=\"font-size:12px;color:var(--text-3)\">2 hours ago</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\"><span style=\"font-size:13px;flex:1\">📄 design-guidelines.md</span><span style=\"font-size:12px;color:var(--text-3)\">Yesterday</span></div>\n    </div>"],"distinctions":[{"label":"Segmented control","text":"{c:button} runs an action when clicked. {c:segmented} shows which one of several mutually exclusive options is selected, usually to switch a view or mode.","targetId":"segmented"}]}}}