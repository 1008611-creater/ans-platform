{"__formatVersion":2,"__revision":"d9810b8bc38630b5","__entryId":"skeleton","entry":{"sceneUI":["<div class=\"skeleton-frame\" style=\"display:flex;flex-direction:column;gap:10px\">\n      <div style=\"display:flex;align-items:center;gap:8px\"><i class=\"skeleton-block\" style=\"width:52px;height:14px;border-radius:7px\"></i><i class=\"skeleton-line\" style=\"width:34px\"></i><i class=\"skeleton-line\" style=\"width:34px\"></i><i class=\"skeleton-line\" style=\"width:34px\"></i><i class=\"skeleton-avatar\" style=\"width:22px;height:22px;margin-left:auto\"></i></div>\n      <i class=\"skeleton-line\" style=\"width:44%;height:13px\"></i>\n      <i class=\"skeleton-line\" style=\"width:78%\"></i>\n      <div style=\"display:flex;gap:8px\"><i class=\"skeleton-block\" style=\"width:64px;height:22px;border-radius:11px\"></i><i class=\"skeleton-block\" style=\"width:64px;height:22px;border-radius:11px\"></i></div>\n    </div>","<div class=\"skeleton-frame\" style=\"display:flex;flex-direction:column;gap:12px\">\n      <div class=\"skeleton-row\"><i class=\"skeleton-avatar\" style=\"width:28px;height:28px\"></i><div class=\"skeleton-lines\"><i class=\"skeleton-line\" style=\"width:52%\"></i><i class=\"skeleton-line\" style=\"width:80%\"></i></div></div>\n      <div class=\"skeleton-row\"><i class=\"skeleton-avatar\" style=\"width:28px;height:28px\"></i><div class=\"skeleton-lines\"><i class=\"skeleton-line\" style=\"width:44%\"></i><i class=\"skeleton-line\" style=\"width:72%\"></i></div></div>\n      <div class=\"skeleton-row\"><i class=\"skeleton-avatar\" style=\"width:28px;height:28px\"></i><div class=\"skeleton-lines\"><i class=\"skeleton-line\" style=\"width:58%\"></i><i class=\"skeleton-line\" style=\"width:84%\"></i></div></div>\n    </div>","<div class=\"skeleton-frame\" style=\"display:flex;gap:10px\">\n      <div style=\"flex:1;display:flex;flex-direction:column;gap:7px\"><i class=\"skeleton-block\" style=\"height:44px\"></i><i class=\"skeleton-line\" style=\"width:80%\"></i><i class=\"skeleton-line\" style=\"width:55%\"></i></div>\n      <div style=\"flex:1;display:flex;flex-direction:column;gap:7px\"><i class=\"skeleton-block\" style=\"height:44px\"></i><i class=\"skeleton-line\" style=\"width:70%\"></i><i class=\"skeleton-line\" style=\"width:48%\"></i></div>\n      <div style=\"flex:1;display:flex;flex-direction:column;gap:7px\"><i class=\"skeleton-block\" style=\"height:44px\"></i><i class=\"skeleton-line\" style=\"width:76%\"></i><i class=\"skeleton-line\" style=\"width:52%\"></i></div>\n    </div>","<div class=\"skeleton-frame\" style=\"display:flex;flex-direction:column;gap:9px\">\n      <i class=\"skeleton-line\" style=\"width:38%;height:14px\"></i>\n      <i class=\"skeleton-line\" style=\"width:24%\"></i>\n      <i class=\"skeleton-line\" style=\"width:100%\"></i>\n      <i class=\"skeleton-line\" style=\"width:96%\"></i>\n      <i class=\"skeleton-line\" style=\"width:88%\"></i>\n      <i class=\"skeleton-line\" style=\"width:42%\"></i>\n    </div>"],"anatomy":{"demo":"<div class=\"ap\" data-ap=\"root\"><div class=\"skeleton-demo\"><div class=\"skeleton-row\"><div class=\"ap\" data-ap=\"avatar\"><i class=\"skeleton-avatar\"></i></div><div class=\"skeleton-lines\"><div class=\"ap\" data-ap=\"title\"><i class=\"skeleton-line\" style=\"width:45%\"></i></div><div class=\"ap\" data-ap=\"line\"><i class=\"skeleton-line\" style=\"width:88%\"></i></div></div></div></div></div>","demo_en":"<div class=\"ap\" data-ap=\"root\"><div class=\"skeleton-demo\"><div class=\"skeleton-row\"><div class=\"ap\" data-ap=\"avatar\"><i class=\"skeleton-avatar\"></i></div><div class=\"skeleton-lines\"><div class=\"ap\" data-ap=\"title\"><i class=\"skeleton-line\" style=\"width:45%\"></i></div><div class=\"ap\" data-ap=\"line\"><i class=\"skeleton-line\" style=\"width:88%\"></i></div></div></div></div></div>","parts":[{"key":"root","cn":"骨架组","en":"Skeleton","desc":"一组占位色块，形状对齐真实布局","desc_en":"A set of placeholder color blocks, the shapes aligned with the real layout"},{"key":"avatar","cn":"头像 / 图占位","en":"Avatar","desc":"圆形或方块，对应媒体位","desc_en":"Circle or square, corresponding to the media position"},{"key":"title","cn":"标题占位","en":"Title","desc":"短而粗的一行","desc_en":"short, thick line"},{"key":"line","cn":"正文行占位","en":"Line","desc":"长短错落的灰条，模仿段落","desc_en":"Long and short gray bars, imitating paragraphs"}]},"variants":[{"cn":"列表项","en":"List Item","demo":"<div class=\"skeleton-demo\"><div class=\"skeleton-row\"><i class=\"skeleton-avatar\"></i><div class=\"skeleton-lines\"><i class=\"skeleton-line\" style=\"width:55%\"></i><i class=\"skeleton-line\" style=\"width:80%\"></i></div></div></div>","demo_en":"<div class=\"skeleton-demo\"><div class=\"skeleton-row\"><i class=\"skeleton-avatar\"></i><div class=\"skeleton-lines\"><i class=\"skeleton-line\" style=\"width:55%\"></i><i class=\"skeleton-line\" style=\"width:80%\"></i></div></div></div>","when":"信息流、消息列表加载时占位","when_en":"Place space when loading information flow and message list"},{"cn":"文章段落","en":"Paragraph","demo":"<div class=\"skeleton-demo\"><i class=\"skeleton-line\" style=\"width:38%;height:13px\"></i><i class=\"skeleton-line\" style=\"width:100%\"></i><i class=\"skeleton-line\" style=\"width:92%\"></i><i class=\"skeleton-line\" style=\"width:60%\"></i></div>","demo_en":"<div class=\"skeleton-demo\"><i class=\"skeleton-line\" style=\"width:38%;height:13px\"></i><i class=\"skeleton-line\" style=\"width:100%\"></i><i class=\"skeleton-line\" style=\"width:92%\"></i><i class=\"skeleton-line\" style=\"width:60%\"></i></div>","when":"长文详情页加载，先摆出段落形状","when_en":"The long article details page is loaded, first lay out the paragraph shape"},{"cn":"卡片","en":"Card","demo":"<div class=\"skeleton-demo\" style=\"width:150px\"><i class=\"skeleton-block\"></i><i class=\"skeleton-line\" style=\"width:70%\"></i><i class=\"skeleton-line\" style=\"width:45%\"></i></div>","demo_en":"<div class=\"skeleton-demo\" style=\"width:150px\"><i class=\"skeleton-block\"></i><i class=\"skeleton-line\" style=\"width:70%\"></i><i class=\"skeleton-line\" style=\"width:45%\"></i></div>","when":"图片、封面类卡片加载前占位","when_en":"Pictures and cover cards occupy space before loading"}],"use":[{"t":"<b>首屏加载</b>：先给轮廓，内容陆续到位","m":"skel-first"},{"t":"<b>列表 / 信息流</b>：画几条假条目占位","m":"skel-list"},{"t":"<b>卡片 / 图片位</b>：大图未出先占好位置","m":"skel-card"},{"t":"<b>长文详情页</b>：段落形状防止布局跳动","m":"skel-text"}],"dont":[{"t":"只有几百毫秒的短加载：骨架可能闪现并干扰浏览","m":"pg-loading"},{"t":"有明确进度：使用 {c:progress} 显示完成程度","m":"pg-upload"},{"t":"骨架与真实结构差异过大：内容出现时会引发明显跳动","m":"skel-mismatch","bad":true},{"t":"加载失败后仍持续显示骨架：使用 {c:result} 说明结果和后续操作","m":"skel-forever","bad":true}],"lessonPractice":{"title":"文章列表结构固定，数据通常要等一两秒才返回。加载期间怎样减少页面跳动？","options":[{"id":"matching-skeleton","label":"先显示接近图片和标题形状的骨架，数据到达后替换","feedback":"骨架提前占住真实内容的位置，结构相近时能减少内容出现后的布局变化。","correct":true},{"id":"empty-message","label":"先显示“还没有文章”，数据回来后再改成列表","feedback":"请求尚未结束，空状态会错误地告诉用户没有数据，并在结果到达时改变含义。","correct":false},{"id":"fake-progress","label":"显示从 0% 自动增长的进度条，不读取真实进度","feedback":"系统不知道完成比例，伪造百分比可能提前走完，也无法稳定文章列表的布局。","correct":false}],"en":{"title":"An article list has a known layout, but its data usually takes one or two seconds to arrive. How can loading reduce layout movement?","options":[{"id":"matching-skeleton","label":"Reserve image and title shapes with a skeleton, then replace it with data","feedback":"A skeleton that resembles the incoming structure reserves space and reduces movement when real content appears.","correct":true},{"id":"empty-message","label":"Show 'No articles yet' first and replace it when data arrives","feedback":"The request is still pending, so an empty state incorrectly claims that no data exists.","correct":false},{"id":"fake-progress","label":"Animate a progress bar from 0% without reading actual progress","feedback":"The system does not know completion percentage, and fake progress does not reserve the article layout.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"文章列表等待数据时，请显示接近真实图片和标题布局的骨架，数据到达后原位替换；请求失败时改成错误和重试，不要一直保留骨架。请确认内容出现时页面没有明显跳动。","en":{"title":"You can say this to an AI Agent","text":"While article data is pending, show a skeleton matching the real image and title layout, then replace it in place. On failure, switch to an error and retry instead of keeping the skeleton. Confirm that content arrival causes no obvious layout jump."}},"scenes":["首页首屏加载","列表加载占位","图片卡片占位","文章详情加载"],"en":{"use":[{"t":"Initial card or list loading","m":"skel-first"},{"t":"Profile content with a known shape","m":"skel-list"},{"t":"A page where layout stability matters","m":"skel-card"},{"t":"Short waits before real content appears","m":"skel-text"}],"dont":[{"t":"Show a skeleton for a task with no known layout","m":"pg-loading"},{"t":"Keep it running after a request failed","m":"pg-upload"},{"t":"Animate a complex placeholder that distracts from the page","m":"skel-mismatch","bad":true},{"t":"Use it to hide a consistently slow experience","m":"skel-forever","bad":true}],"scenes":["Article feed","Profile page","Dashboard cards","Search results"],"variants":[{"demo":"<div class=\"skeleton-demo\"><div class=\"skeleton-row\"><i class=\"skeleton-avatar\"></i><div class=\"skeleton-lines\"><i class=\"skeleton-line\" style=\"width:55%\"></i><i class=\"skeleton-line\" style=\"width:80%\"></i></div></div></div>","when":"Place space when loading information flow and message list"},{"demo":"<div class=\"skeleton-demo\"><i class=\"skeleton-line\" style=\"width:38%;height:13px\"></i><i class=\"skeleton-line\" style=\"width:100%\"></i><i class=\"skeleton-line\" style=\"width:92%\"></i><i class=\"skeleton-line\" style=\"width:60%\"></i></div>","when":"The long article details page is loaded, first lay out the paragraph shape"},{"demo":"<div class=\"skeleton-demo\" style=\"width:150px\"><i class=\"skeleton-block\"></i><i class=\"skeleton-line\" style=\"width:70%\"></i><i class=\"skeleton-line\" style=\"width:45%\"></i></div>","when":"Pictures and cover cards occupy space before loading"}]},"usageMocks":{"skel-first":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:36%;height:9px\"></i><i class=\"mk-line\" style=\"width:92%\"></i><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div></div>","skel-list":"<div class=\"mk-win\"><div class=\"mk-row\"><i style=\"width:16px;height:16px;border-radius:50%;background:#e5e6eb;flex:none\"></i><i class=\"mk-line\" style=\"width:58%\"></i></div><div class=\"mk-row\"><i style=\"width:16px;height:16px;border-radius:50%;background:#e5e6eb;flex:none\"></i><i class=\"mk-line\" style=\"width:44%\"></i></div></div>","skel-card":"<div class=\"mk-win\"><i style=\"display:block;height:26px;border-radius:4px;background:#e5e6eb\"></i><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:45%\"></i></div>","skel-text":"<div class=\"mk-win\"><i class=\"mk-line\" style=\"width:100%\"></i><i class=\"mk-line\" style=\"width:96%\"></i><i class=\"mk-line\" style=\"width:88%\"></i><i class=\"mk-line\" style=\"width:45%\"></i></div>","pg-loading":"<div class=\"mk-row \"><span class=\"mk-spinner\"></span><span style=\"font-size:12px;color:var(--text-2)\">加载中，请稍候…</span></div>","pg-upload":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"color:var(--text)\">📎 设计稿.sketch</span><span style=\"flex:1\"></span><span style=\"color:var(--text-3)\">66%</span></div><span class=\"mk-progress \" style=\"width:100%\"><i style=\"width:66%\"></i></span></div>","skel-mismatch":"<div class=\"mk-win\"><div class=\"mk-row\"><i style=\"width:16px;height:16px;border-radius:50%;background:#e5e6eb;flex:none\"></i><i class=\"mk-line\" style=\"width:52%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">真实内容是个表单，骨架和布局对不上</span></div>","skel-forever":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:88%\"></i><i class=\"mk-line\" style=\"width:64%\"></i></div><div style=\"position:absolute;bottom:6px;width:100%;text-align:center;font-size:12px;color:var(--red)\">请求已失败，骨架屏却没有切换为错误状态</div></div>"}}}