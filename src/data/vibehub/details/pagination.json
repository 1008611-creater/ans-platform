ass=\"ap\" data-ap=\"ellipsis\"><span class=\"pagination-ellipsis\">…</span></span>\n      <span class=\"pagination-item\">10</span>\n      <span class=\"pagination-item\">›</span>\n    </div>","demo_en":"<div class=\"pagination-demo\">\n      <span class=\"ap\" data-ap=\"pager\"><span class=\"pagination-item\">‹</span></span>\n      <span class=\"pagination-item\">1</span>\n      <span class=\"ap\" data-ap=\"page\"><span class=\"pagination-item on\">2</span></span>\n      <span class=\"ap\" data-ap=\"ellipsis\"><span class=\"pagination-ellipsis\">…</span></span>\n      <span class=\"pagination-item\">10</span>\n      <span class=\"pagination-item\">›</span>\n    </div>","parts":[{"key":"pager","cn":"翻页按钮","en":"Prev / Next","desc":"‹ › 前后翻页，翻到顶会置灰","desc_en":"‹ › Turn the page back and forth, it will be grayed out when you turn to the top"},{"key":"page","cn":"页码","en":"PageItem","desc":"当前页高亮，点击直达对应页","desc_en":"The current page is highlighted, click to go directly to the corresponding page"},{"key":"ellipsis","cn":"省略号","en":"Ellipsis","desc":"页数太多时折叠中间的页码","desc_en":"Collapse the middle page number when there are too many pages"}]},"variants":[{"cn":"基础分页","en":"Basic","demo":"<div class=\"pagination-demo\"><span class=\"pagination-item\">‹</span><span class=\"pagination-item on\">1</span><span class=\"pagination-item\">2</span><span class=\"pagination-item\">3</span><span class=\"pagination-ellipsis\">…</span><span class=\"pagination-item\">10</span><span class=\"pagination-item\">›</span></div>","demo_en":"<div class=\"pagination-demo\"><span class=\"pagination-item\">‹</span><span class=\"pagination-item on\">1</span><span class=\"pagination-item\">2</span><span class=\"pagination-item\">3</span><span class=\"pagination-ellipsis\">…</span><span class=\"pagination-item\">10</span><span class=\"pagination-item\">›</span></div>","when":"页数多、需要直接跳到某一页","when_en":"There are many pages and you need to jump directly to a certain page"},{"cn":"简洁分页","en":"Simple","demo":"<div class=\"pagination-demo\"><span class=\"pagination-item\">‹</span><span class=\"pagination-simple\">3 / 12</span><span class=\"pagination-item\">›</span></div>","demo_en":"<div class=\"pagination-demo\"><span class=\"pagination-item\">‹</span><span class=\"pagination-simple\">3 / 12</span><span class=\"pagination-item\">›</span></div>","when":"空间有限且只需前后翻页时","when_en":"When space is limited and you only need to turn pages forward and backward"},{"cn":"迷你分页","en":"Mini","demo":"<div class=\"pagination-demo mini\"><span class=\"pagination-item\">‹</span><span class=\"pagination-item on\">1</span><span class=\"pagination-item\">2</span><span class=\"pagination-item\">3</span><span class=\"pagination-item\">›</span></div>","demo_en":"<div class=\"pagination-demo mini\"><span class=\"pagination-item\">‹</span><span class=\"pagination-item on\">1</span><span class=\"pagination-item\">2</span><span class=\"pagination-item\">3</span><span class=\"pagination-item\">›</span></div>","when":"弹窗、小卡片里地方很小的分页","when_en":"Pop-up windows and small pagination in small cards"}],"use":[{"t":"<b>长表格 / 订单列表</b>，一页一页翻着看","m":"pagination-table"},{"t":"搜索结果<b>成百上千条</b>，按页消化","m":"pagination-search"},{"t":"需要<b>记住位置</b>，下次还能翻回来","m":"pagination-mark"},{"t":"数据量大，<b>按页加载</b>减轻前后端压力","m":"pagination-load"}],"dont":[{"t":"内容只有<b>一页</b>：无需显示分页控件","m":"pagination-one","bad":true},{"t":"信息流需要<b>连续浏览</b>：可使用无限加载或“加载更多”","m":"pagination-feed","bad":true},{"t":"几百页页码<b>全部铺开</b>不加省略号","m":"pagination-mess","bad":true},{"t":"只是在同页切换<b>几个分类</b>：使用 {c:tabs}","m":"pagination-as-tabs","bad":true}],"lessonPractice":{"title":"审计日志有几万条，用户需要分享“错误日志第 4 页”，回来后还要保持筛选条件。怎样浏览更合适？","options":[{"id":"stable-pages","label":"使用分页，并把页码和筛选条件同步到网址","feedback":"稳定页码适合定位和返回大量记录；写入网址后，同一筛选结果还能分享和复现。","correct":true},{"id":"endless-feed","label":"持续自动加载更多，不记录用户已经滚到的位置","feedback":"连续加载适合随意浏览，但很难准确分享第 4 页，也不利于返回原来的日志位置。","correct":false},{"id":"category-tabs","label":"把每 20 条日志做成一个标签页，并按数字命名","feedback":"标签页用于少量并列类别，不是大量结果的页码；数量增长后会迅速挤满导航。","correct":false}],"en":{"title":"An audit log has tens of thousands of entries. People must share 'error logs, page 4' and return with filters preserved. Which browsing pattern fits?","options":[{"id":"stable-pages","label":"Use pagination and keep the page number and filters in the URL","feedback":"Stable pages support precise return and sharing, while URL parameters reproduce the same filtered result.","correct":true},{"id":"endless-feed","label":"Load entries continuously without recording the current position","feedback":"Continuous loading supports casual browsing but makes page 4 difficult to share or revisit precisely.","correct":false},{"id":"category-tabs","label":"Turn each group of 20 logs into a numerically named tab","feedback":"Tabs represent a small set of peer categories, not thousands of sequential result pages.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请给审计日志增加分页，把页码和筛选条件同步到网址。切页时保留筛选，刷新、返回和复制链接后都能恢复同一结果。请验证第一页、中间页、最后一页以及没有结果的情况。","en":{"title":"You can say this to an AI Agent","text":"Add pagination to the audit log and keep page number and filters in the URL. Preserve filters across page changes and restore the same result after refresh, back navigation, or sharing. Verify the first, middle, last, and empty pages."}},"scenes":["订单列表翻页","搜索结果浏览","数据表格按页加载","博客文章列表"],"en":{"use":[{"t":"Search results","m":"pagination-table"},{"t":"Admin tables","m":"pagination-search"},{"t":"A stable archive","m":"pagination-mark"},{"t":"Data where total pages and position matter","m":"pagination-load"}],"dont":[{"t":"Reset filters whenever the page changes","m":"pagination-one","bad":true},{"t":"Use tiny page links that are hard to select","m":"pagination-feed","bad":true},{"t":"Show page numbers when the total is unknown","m":"pagination-mess","bad":true},{"t":"Paginate a short list that fits comfortably","m":"pagination-as-tabs","bad":true}],"scenes":["Order table","Search results","Article archive","Mem