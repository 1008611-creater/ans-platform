{"__formatVersion":2,"__revision":"3410817d9c5f3d86","__entryId":"empty","entry":{"sceneUI":["<div style=\"max-width:440px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:14px;flex:1\">成员列表</b><button class=\"btn btn-primary\" style=\"padding:4px 12px;font-size:12px\">＋ 邀请成员</button></div>\n      <div style=\"border:1px solid var(--border-light);border-radius:10px;overflow:hidden\">\n        <div style=\"display:flex;padding:8px 14px;background:var(--bg-soft);font-size:12px;color:var(--text-3)\"><span style=\"flex:2\">姓名</span><span style=\"flex:1\">角色</span><span style=\"flex:1\">加入时间</span></div>\n        <div style=\"display:flex;flex-direction:column;align-items:center;padding:12px 0\">\n          <img src=\"/assets/empty-box.png\" style=\"width:60px;height:46px;object-fit:contain\" alt=\"\">\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">还没有成员，邀请一位一起协作吧</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:6px\" value=\"狼人杀 攻略\">\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">共找到 0 条结果</div>\n      <div style=\"display:flex;flex-direction:column;align-items:center;padding:8px 0\">\n        <img src=\"/assets/empty-box.png\" style=\"width:64px;height:50px;object-fit:contain\" alt=\"\">\n        <div style=\"font-size:13px;font-weight:600;margin-top:4px\">没有找到相关内容</div>\n        <div style=\"font-size:12px;color:var(--text-3)\">换个关键词试试，比如「桌游」</div>\n      </div>\n    </div>","<div style=\"display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 0\">\n      <img src=\"/assets/empty-box.png\" style=\"width:76px;height:58px;object-fit:contain\" alt=\"\">\n      <div style=\"font-size:14px;font-weight:600;margin-top:2px\">还没有任何项目</div>\n      <div style=\"font-size:12px;color:var(--text-3)\">项目用来组织你的设计稿和文件</div>\n      <button class=\"btn btn-primary\" style=\"margin-top:6px\">＋ 新建项目</button>\n    </div>","<div style=\"max-width:420px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:14px;flex:1\">回收站</b><span style=\"font-size:12px;color:var(--text-3)\">文件保留 30 天</span></div>\n      <div style=\"border:1px dashed var(--border);border-radius:10px;display:flex;flex-direction:column;align-items:center;padding:14px 0\">\n        <img src=\"/assets/empty-box.png\" style=\"width:64px;height:50px;object-fit:contain\" alt=\"\">\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">回收站是空的，已删除的文件会出现在这里</div>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:440px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:14px;flex:1\">Member list</b><button class=\"btn btn-primary\" style=\"padding:4px 12px;font-size:12px\">+ Invite members</button></div>\n      <div style=\"border:1px solid var(--border-light);border-radius:10px;overflow:hidden\">\n        <div style=\"display:flex;padding:8px 14px;background:var(--bg-soft);font-size:12px;color:var(--text-3)\"><span style=\"flex:2\">Name</span><span style=\"flex:1\">Character</span><span style=\"flex:1\">Join time</span></div>\n        <div style=\"display:flex;flex-direction:column;align-items:center;padding:12px 0\">\n          <img src=\"/assets/empty-box.png\" style=\"width:60px;height:46px;object-fit:contain\" alt=\"\">\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">There are no members yet, please invite one to collaborate</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:6px\" value=\"Werewolf Strategy\">\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">0 results found</div>\n      <div style=\"display:flex;flex-direction:column;align-items:center;padding:8px 0\">\n        <img src=\"/assets/empty-box.png\" style=\"width:64px;height:50px;object-fit:contain\" alt=\"\">\n        <div style=\"font-size:13px;font-weight:600;margin-top:4px\">No relevant content found</div>\n        <div style=\"font-size:12px;color:var(--text-3)\">Try changing keywords, such as \"board game\"</div>\n      </div>\n    </div>","<div style=\"display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 0\">\n      <img src=\"/assets/empty-box.png\" style=\"width:76px;height:58px;object-fit:contain\" alt=\"\">\n      <div style=\"font-size:14px;font-weight:600;margin-top:2px\">No items yet</div>\n      <div style=\"font-size:12px;color:var(--text-3)\">Projects are used to organize your design drafts and files</div>\n      <button class=\"btn btn-primary\" style=\"margin-top:6px\">+ New project</button>\n    </div>","<div style=\"max-width:420px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:14px;flex:1\">Recycle Bin</b><span style=\"font-size:12px;color:var(--text-3)\">File retention for 30 days</span></div>\n      <div style=\"border:1px dashed var(--border);border-radius:10px;display:flex;flex-direction:column;align-items:center;padding:14px 0\">\n        <img src=\"/assets/empty-box.png\" style=\"width:64px;height:50px;object-fit:contain\" alt=\"\">\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">The recycle bin is empty and deleted files will appear here</div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><span class=\"ep-demo\"><span class=\"ap\" data-ap=\"illus\"><span class=\"ep-illus\"></span></span><span class=\"ap\" data-ap=\"text\"><span class=\"ep-text\"><b>还没有任何项目</b><span>创建第一个项目，开始协作吧</span></span></span><span class=\"ap\" data-ap=\"action\"><button class=\"btn btn-primary\">新建项目</button></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><span class=\"ep-demo\"><span class=\"ap\" data-ap=\"illus\"><span class=\"ep-illus\"></span></span><span class=\"ap\" data-ap=\"text\"><span class=\"ep-text\"><b>No projects yet</b><span>Create your first project and start collaborating</span></span></span><span class=\"ap\" data-ap=\"action\"><button class=\"btn btn-primary\">New project</button></span></span></span>","parts":[{"key":"root","cn":"空状态","en":"Empty","desc":"整个空白区域的容器","desc_en":"Container for the whole empty state"},{"key":"illus","cn":"插画","en":"Illustration","desc":"用于辅助识别，不应抢过核心文案","desc_en":"Helps users recognize the state, but should not overpower the core copy."},{"key":"text","cn":"文案","en":"Description","desc":"说清为什么是空的","desc_en":"Explain why it is empty"},{"key":"action","cn":"引导按钮","en":"Action","desc":"可选，提供明确的下一步操作","desc_en":"Optional, provide clear next steps"}]},"variants":[{"cn":"简单文字","en":"Simple","demo":"<div class=\"ep-demo\"><div class=\"ep-text\"><b>暂无收藏</b><span>收藏的内容会出现在这里</span></div></div>","demo_en":"<div class=\"ep-demo\"><div class=\"ep-text\"><b>No collection yet</b><span>Collection content will appear here</span></div></div>","when":"次要区域，说清是空的就够了","when_en":"For a secondary area where a simple empty message is enough."},{"cn":"带引导按钮","en":"With Action","demo":"<div class=\"ep-demo\"><div class=\"ep-illus\"></div><div class=\"ep-text\"><b>还没有任何项目</b></div><button class=\"btn btn-primary\">新建项目</button></div>","demo_en":"<div class=\"ep-demo\"><div class=\"ep-illus\"></div><div class=\"ep-text\"><b>No projects yet</b></div><button class=\"btn btn-primary\">New project</button></div>","when":"需要引导用户创建第一条数据时","when_en":"When you need to guide users to create the first piece of data"},{"cn":"自定义插画","en":"Custom","demo":"<div class=\"ep-demo\"><div class=\"ep-illus alt\"></div><div class=\"ep-text\"><b>回收站是空的</b><span>删除的文件会在这里保留 30 天</span></div></div>","demo_en":"<div class=\"ep-demo\"><div class=\"ep-illus alt\"></div><div class=\"ep-text\"><b>The recycle bin is empty</b><span>Deleted files will remain here for 30 days</span></div></div>","when":"重品牌感的页面，插画贴合业务场景","when_en":"A brand-heavy page with illustrations that fit the business scenario"}],"use":[{"t":"列表 / 表格<b>还没有数据</b>，告诉用户这里本来有什么","m":"empty-table"},{"t":"提供明确的<b>引导按钮</b>：新建项目、添加成员","m":"empty-action"},{"t":"<b>搜索无结果</b>，提示换个关键词试试","m":"empty-search"},{"t":"文案<b>清楚说明</b>：为什么是空的，以及下一步能做什么","m":"empty-text"}],"dont":[{"t":"只写<b>「暂无数据」</b>，用户看不到原因和可执行的下一步","m":"empty-cold","bad":true},{"t":"页面仍在加载时，应使用 {c:skeleton} 或其他加载反馈，而不是空状态","m":"pg-loading","bad":true},{"t":"加载失败不是空状态，应使用 {c:result} 说明错误和下一步","m":"empty-error","bad":true},{"t":"插画做得<b>比内容还花哨</b>，喧宾夺主","m":"empty-fancy","bad":true}],"lessonPractice":{"title":"新团队第一次打开项目列表，请求已成功，但还没有任何项目。页面应该显示什么？","options":[{"id":"keep-loading","label":"继续显示骨架屏，等用户自己判断列表为空","feedback":"请求已经完成，继续显示加载状态会让用户误以为内容仍在路上，而不是当前确实没有项目。","correct":false},{"id":"empty-next-step","label":"说明“还没有项目”，并提供“新建项目”入口","feedback":"页面应说明本来会出现什么、为什么现在为空，并给出创建第一条数据的可执行下一步。","correct":true},{"id":"show-error","label":"显示“加载失败”，并要求用户刷新页面重试","feedback":"请求已经成功，空数据不是错误；错误提示会让用户重复请求，却仍然得不到项目。","correct":false}],"en":{"title":"A new team opens the project list for the first time. The request succeeded, but there are no projects. What should appear?","options":[{"id":"keep-loading","label":"Keep the skeleton visible and let people infer that the list is empty","feedback":"The request is finished, so a loading state incorrectly suggests that content is still on its way.","correct":false},{"id":"empty-next-step","label":"Say there are no projects yet and provide a Create project action","feedback":"The page explains what belongs here, why it is empty now, and the useful next step for creating the first item.","correct":true},{"id":"show-error","label":"Show a loading error and ask people to refresh the page","feedback":"An empty successful response is not a failure. Refreshing repeats the request without solving the absence of data.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"项目列表请求成功但结果为空时，请显示“还没有项目”和“新建项目”入口。加载中继续使用加载状态，请求失败则显示错误和重试，不要把三种情况混在一起。分别模拟并验证这三种状态。","en":{"title":"You can say this to an AI Agent","text":"When the project request succeeds with no items, show 'No projects yet' and a Create project action. Keep loading and request failure as separate states with appropriate feedback and retry. Simulate and verify all three states."}},"demoDetail":"<div class=\"ep-demo\"><div class=\"ep-illus\"></div><div class=\"ep-text\"><b>还没有任何项目</b><span>创建第一个项目，开始协作吧</span></div><button class=\"btn btn-primary\">新建项目</button></div>","references":[{"title":"复杂应用中的空状态设计：3 条准则","source":"NN/g","url":"https://www.nngroup.com/articles/empty-state-interface-design/","title_en":"Designing Empty States in Complex Applications: 3 Guidelines"}],"scenes":["空列表 / 空表格","搜索无结果","引导创建第一条数据","回收站为空"],"en":{"demoDetail":"<div class=\"ep-demo\"><div class=\"ep-illus\"></div><div class=\"ep-text\"><b>No projects yet</b><span>Create your first project and start collaborating</span></div><button class=\"btn btn-primary\">New project</button></div>","use":[{"t":"A new account with no records","m":"empty-table"},{"t":"Search with no results","m":"empty-action"},{"t":"A filter that matches nothing","m":"empty-search"},{"t":"Content removed or not yet available","m":"empty-text"}],"dont":[{"t":"Show only an illustration with no explanation","m":"empty-cold","bad":true},{"t":"Blame the user for an empty result","m":"pg-loading","bad":true},{"t":"Offer an action that cannot solve the empty state","m":"empty-error","bad":true},{"t":"Use the same message for first use, errors, and no search results","m":"empty-fancy","bad":true}],"scenes":["New project list","No search results","Empty inbox","No filtered data"],"sceneUI":["<div style=\"max-width:440px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:14px;flex:1\">Member list</b><button class=\"btn btn-primary\" style=\"padding:4px 12px;font-size:12px\">+ Invite members</button></div>\n      <div style=\"border:1px solid var(--border-light);border-radius:10px;overflow:hidden\">\n        <div style=\"display:flex;padding:8px 14px;background:var(--bg-soft);font-size:12px;color:var(--text-3)\"><span style=\"flex:2\">Name</span><span style=\"flex:1\">Character</span><span style=\"flex:1\">Join time</span></div>\n        <div style=\"display:flex;flex-direction:column;align-items:center;padding:12px 0\">\n          <img src=\"/assets/empty-box.png\" style=\"width:60px;height:46px;object-fit:contain\" alt=\"\">\n          <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">There are no members yet, please invite one to collaborate</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:6px\" value=\"Werewolf Strategy\">\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">0 results found</div>\n      <div style=\"display:flex;flex-direction:column;align-items:center;padding:8px 0\">\n        <img src=\"/assets/empty-box.png\" style=\"width:64px;height:50px;object-fit:contain\" alt=\"\">\n        <div style=\"font-size:13px;font-weight:600;margin-top:4px\">No relevant content found</div>\n        <div style=\"font-size:12px;color:var(--text-3)\">Try changing keywords, such as \"board game\"</div>\n      </div>\n    </div>","<div style=\"display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 0\">\n      <img src=\"/assets/empty-box.png\" style=\"width:76px;height:58px;object-fit:contain\" alt=\"\">\n      <div style=\"font-size:14px;font-weight:600;margin-top:2px\">No items yet</div>\n      <div style=\"font-size:12px;color:var(--text-3)\">Projects are used to organize your design drafts and files</div>\n      <button class=\"btn btn-primary\" style=\"margin-top:6px\">+ New project</button>\n    </div>","<div style=\"max-width:420px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:14px;flex:1\">Recycle Bin</b><span style=\"font-size:12px;color:var(--text-3)\">File retention for 30 days</span></div>\n      <div style=\"border:1px dashed var(--border);border-radius:10px;display:flex;flex-direction:column;align-items:center;padding:14px 0\">\n        <img src=\"/assets/empty-box.png\" style=\"width:64px;height:50px;object-fit:contain\" alt=\"\">\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">The recycle bin is empty and deleted files will appear here</div>\n      </div>\n    </div>"],"variants":[{"demo":"<div class=\"ep-demo\"><div class=\"ep-text\"><b>No collection yet</b><span>Collection content will appear here</span></div></div>","when":"For a secondary area where a simple empty message is enough."},{"demo":"<div class=\"ep-demo\"><div class=\"ep-illus\"></div><div class=\"ep-text\"><b>No projects yet</b></div><button class=\"btn btn-primary\">New project</button></div>","when":"When you need to guide users to create the first piece of data"},{"demo":"<div class=\"ep-demo\"><div class=\"ep-illus alt\"></div><div class=\"ep-text\"><b>The recycle bin is empty</b><span>Deleted files will remain here for 30 days</span></div></div>","when":"A brand-heavy page with illustrations that fit the business scenario"}]},"usageMocks":{"empty-table":"<div class=\"mk-win\"><div class=\"mk-row \"><span style=\"width:56px;font-size:12px;color:var(--text-3)\">名称</span><span style=\"width:44px;font-size:12px;color:var(--text-3)\">状态</span></div><div style=\"border-top:1px solid var(--border-light);padding:8px 0;text-align:center;font-size:12px;color:var(--text-3)\">这里还没有任何数据</div></div>","empty-action":"<div class=\"mk-win\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 0;width:100%\"><i style=\"width:26px;height:18px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"font-size:12px;color:var(--text-3)\">还没有项目</span><span class=\"mk-btn primary\">新建项目</span></div></div>","empty-search":"<div class=\"mk-win\"><span class=\"mk-input\">狼人杀</span><div style=\"display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 0;width:100%\"><i style=\"width:26px;height:18px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"font-size:12px;color:var(--text-3)\">没有找到相关内容，换个关键词试试</span></div></div>","empty-text":"<div class=\"mk-win\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 0;width:100%\"><i style=\"width:26px;height:18px;border-radius:3px;background:var(--bg-hover)\"></i><span style=\"font-size:12px;color:var(--text-3)\">收件箱是空的——邮件都处理完了 🎉</span></div></div>","empty-cold":"<div class=\"mk-win\"><div style=\"padding:8px 0;text-align:center;font-size:12px;color:var(--text-3)\">暂无数据</div><span style=\"font-size:12px;color:var(--text-3)\">用户：然后呢？我该怎么办？</span></div>","pg-loading":"<div class=\"mk-row \"><span class=\"mk-spinner\"></span><span style=\"font-size:12px;color:var(--text-2)\">加载中，请稍候…</span></div>","empty-error":"<div class=\"mk-win\"><div style=\"padding:8px 0;text-align:center;font-size:12px;color:var(--text-3)\">暂无数据</div><span style=\"font-size:12px;color:var(--text-3)\">其实是网络错误，却被当成空的</span></div>","empty-fancy":"<div class=\"mk-win\"><div style=\"width:100%;padding:6px 0;display:flex;flex-direction:column;align-items:center;gap:4px\"><i style=\"width:40px;height:28px;border-radius:6px;background:linear-gradient(135deg,#ffb3c7,#8fb3ff)\"></i><span style=\"font-size:12px;color:var(--text-3)\">空空如也～</span></div><span style=\"font-size:12px;color:var(--text-3)\">插画比内容还抢眼</span></div>"}}}