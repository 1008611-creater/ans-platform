 style=\"left:0;width:70%\"></i><i class=\"sld-th\" style=\"left:70%\"></i></span><span class=\"demo-tag blue\">Stronger</span></div>\n          <div class=\"slider-sc-row\" style=\"border-bottom:0\"><span style=\"width:52px\">Reply length</span><span class=\"sld-plain\" style=\"flex:1;width:auto\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:0;width:40%\"></i><i class=\"sld-th\" style=\"left:40%\"></i></span><span style=\"font-size:12px;color:var(--text-2)\">Moderate</span></div>\n        </div>"],"variants":[{"demo":"<input type=\"range\" class=\"demo-range\" value=\"40\">","when":"Continuous adjustment of volume, brightness, etc."},{"demo":"<span class=\"sld-plain\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:25%;width:45%\"></i><i class=\"sld-th\" style=\"left:25%\"></i><i class=\"sld-th\" style=\"left:70%\"></i></span>","when":"When users need to select a range, such as a minimum and maximum price."},{"demo":"<span class=\"sld-marks-wrap\"><input type=\"range\" class=\"demo-range\" value=\"50\"><span class=\"sld-marks\"><span>0</span><span>50</span><span>100</span></span></span>","when":"Snap the slider to a few meaningful values."},{"demo":"<input type=\"range\" class=\"demo-range\" value=\"70\" disabled>","when":"This adjustment is currently unavailable"}]},"usageMocks":{"sld-volume":"<div class=\"mk-row \"><span style=\"color:var(--text-2)\">🔊</span><span class=\"mk-progress\" style=\"width:110px\"><i style=\"width:60%\"></i></span><span style=\"color:var(--text-3)\">60</span></div>","sld-price":"<div class=\"mk-win\"><div class=\"mk-row \"><span style=\"color:var(--text-3)\">价格</span><span class=\"mk-progress\" style=\"width:110px\"><i style=\"width:50%;margin-left:25%\"></i></span></div><div class=\"mk-row \"><span style=\"color:var(--text-2)\">¥100 — ¥300</span></div></div>","sld-level":"<div class=\"mk-win\"><div class=\"mk-row \"><span style=\"width:46px;color:var(--text-3)\">创作强度</span><span class=\"mk-progress\" style=\"widt