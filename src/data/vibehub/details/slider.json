left:70%\"></i></span><span class=\"demo-tag blue\">Stronger</span></div>\n          <div class=\"slider-sc-row\" style=\"border-bottom:0\"><span style=\"width:52px\">Reply length</span><span class=\"sld-plain\" style=\"flex:1;width:auto\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:0;width:40%\"></i><i class=\"sld-th\" style=\"left:40%\"></i></span><span style=\"font-size:12px;color:var(--text-2)\">Moderate</span></div>\n        </div>"],"anatomy":{"demo":"<span class=\"sld\"><span class=\"ap\" data-ap=\"track\"><i class=\"sld-trk\"></i></span><span class=\"ap\" data-ap=\"fill\"><i class=\"sld-fl\" style=\"width:60%\"></i></span><span class=\"ap\" data-ap=\"thumb\"><i class=\"sld-th\" style=\"left:calc(60% - 8px)\"></i></span></span>\n          <span class=\"ap\" data-ap=\"value\"><b class=\"sld-val\">60</b></span>","demo_en":"<span class=\"sld\"><span class=\"ap\" data-ap=\"track\"><i class=\"sld-trk\"></i></span><span class=\"ap\" data-ap=\"fill\"><i class=\"sld-fl\" style=\"width:60%\"></i></span><span class=\"ap\" data-ap=\"thumb\"><i class=\"sld-th\" style=\"left:calc(60% - 8px)\"></i></span></span>\n          <span class=\"ap\" data-ap=\"value\"><b class=\"sld-val\">60</b></span>","parts":[{"key":"track","cn":"轨道","en":"Track","desc":"整段可选范围","desc_en":"The full selectable range"},{"key":"fill","cn":"已选部分","en":"Fill","desc":"显示当前已选范围","desc_en":"Shows the selected portion of the range"},{"key":"thumb","cn":"手柄","en":"Handle","desc":"可拖动，悬停时放大","desc_en":"Drag the thumb; enlarge it on hover"},{"key":"value","cn":"当前值","en":"Value","desc":"拖动时实时跟着变","desc_en":"Updates in real time while dragging"}]},"variants":[{"cn":"默认","en":"Default","demo":"<input type=\"range\" class=\"demo-range\" value=\"40\">","demo_en":"<input type=\"range\" class=\"demo-range\" value=\"40\">","when":"音量、亮度等连续量的调节","when_en":"Continuous adjustment of volume, brightness, etc."},{"cn":"双滑块区间","en":"Range","demo":"<span class=\"sld-plain\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:25%;width:45%\"></i><i class=\"sld-th\" style=\"left:25%\"></i><i class=\"sld-th\" style=\"left:70%\"></i></span>","demo_en":"<span class=\"sld-plain\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:25%;width:45%\"></i><i class=\"sld-th\" style=\"left:25%\"></i><i class=\"sld-th\" style=\"left:70%\"></i></span>","when":"要框定起止范围，比如价格带","when_en":"When users need to select a range, such as a minimum and maximum price."},{"cn":"带刻度","en":"With Marks","demo":"<span class=\"sld-marks-wrap\"><input type=\"range\" class=\"demo-range\" value=\"50\"><span class=\"sld-marks\"><span>0</span><span>50</span><span>100</span></span></span>","demo_en":"<span class=\"sld-marks-wrap\"><input type=\"range\" class=\"demo-range\" value=\"50\"><span class=\"sld-marks\"><span>0</span><span>50</span><span>100</span></span></span>","when":"帮用户对齐几个关键档位","when_en":"Snap the slider to a few meaningful values."},{"cn":"禁用","en":"Disabled","demo":"<input type=\"range\" class=\"demo-range\" value=\"70\" disabled>","demo_en":"<input type=\"range\" class=\"demo-range\" value=\"70\" disabled>","when":"该调节项当前不可用","when_en":"This adjustment is currently unavailable"}],"use":[{"t":"<b>音量、亮度</b>这类连续调节","m":"sld-volume"},{"t":"<b>价格区间</b>筛选：双滑块框定范围","m":"sld-price"},{"t":"调节<b>程度、强度</b>：允许近似选择","m":"sld-level"},{"t":"拖动时<b>实时预览</b>效果","m":"sld-brightness"}],"dont":[{"t":"需要<b>精确到个位</b>：使用 {c:input-number}","m":"sld-exact","bad":true},{"t":"只有<b>少量固定档位</b>：使用 {c:radio}","m":"sld-few","bad":true},{"t":"<b>范围跨度很大</b>且难以拖到目标值：配合 {c:input-number}","m":"sld-huge","bad":true},{"t":"需要<b>选择日期</b>：使用 {c:date-picker}","m":"sld-date","bad":true}],"lessonPractice":{"title":"播放器音量需要从 0 到 100 连续调整，拖动时立即听到变化，键盘用户也要能操作。怎样设计？","options":[{"id":"accessible-live-slider","label":"使用显示当前值的滑块，拖动时预览，并支持方向键调整","feedback":"音量是连续范围；当前值、实时反馈和键盘操作共同覆盖了判断与操作需要。","correct":true},{"id":"number-field-only","label":"只放一个数字输入框，输入完成并失去焦点后才更新音量","feedback":"数字输入能精确填写，却削弱了连续调节和即时试听，不能满足当前任务的主要操作方式。","correct":false},{"id":"hundred-option-select","label":"把 0 到 100 的每个整数放进下拉选择，选中后更新音量","feedback":"大量固定选项会增加查找成本，也无法提供拖动过程中的连续反馈。","correct":false}],"en":{"title":"Player volume runs continuously from 0 to 100, must update while dragging, and must work from a keyboard. How should it be designed?","options":[{"id":"accessible-live-slider","label":"Use a slider that shows its value, previews changes live, and responds to arrow keys","feedback":"Volume is a continuous range. A visible value, live feedback, and keyboard controls cover both understanding and operation.","correct":true},{"id":"number-field-only","label":"Provide only a number field and update volume after entry loses focus","feedback":"A number field supports precision but removes the continuous adjustment and immediate listening required here.","correct":false},{"id":"hundred-option-select","label":"Put every integer from 0 to 100 in a dropdown and update after selection","feedback":"A long fixed list increases search effort and cannot provide feedback throughout a continuous drag.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把音量做成 0–100 的滑块，旁边持续显示当前值，拖动时实时更新声音，并支持方向键。测试鼠标、触屏和键盘三种输入，不能只在拖动结束后才生效。","en":{"title":"You can say this to an AI Agent","text":"Build volume as a 0–100 slider with a continuously visible value, live audio updates while dragging, and arrow-key support. Test mouse, touch, and keyboard input, and do not wait until drag end to apply the value."}},"references":[{"title":"滑块模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/slider/","title_en":"Slider Pattern"}],"scenes":["音量亮度调节","价格区间筛选","图片缩放","AI 创作强度"],"en":{"use":[{"t":"Volume or brightness","m":"sld-volume"},{"t":"Price range","m":"sld-price"},{"t":"Image adjustment","m":"sld-level"},{"t":"A value where relative position is useful","m":"sld-brightness"}],"dont":[{"t":"Ask for an exact value without displaying it","m":"sld-exact","bad":true},{"t":"Use a narrow track for a very large range","m":"sld-few","bad":true},{"t":"Hide the minimum and maximum when they matter","m":"sld-huge","bad":true},{"t":"Require dragging as the only accessible input method","m":"sld-date","bad":true}],"scenes":["Media volume","Product filter","Photo editor","Preference setting"],"sceneUI":["<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div class=\"slider-sc-row\"><span style=\"width:46px\">🔊 Volume</span><span class=\"sld-plain\" style=\"flex:1;width:auto\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:0;width:60%\"></i><i class=\"sld-th\" style=\"left:60%\"></i></span><b style=\"width:24px;text-align:right\">60</b></div>\n          <div class=\"slider-sc-row\"><span style=\"width:46px\">☀️ Brightness</span><span class=\"sld-plain\" style=\"flex:1;width:auto\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:0;width:80%\"></i><i class=\"sld-th\" style=\"left:80%\"></i></span><b style=\"width:24px;text-align:right\">80</b></div>\n          <div class=\"slider-sc-row\" style=\"border-bottom:0\"><span style=\"width:46px\">🎧 Bass</span><span class=\"sld-plain\" style=\"flex:1;width:auto\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:0;width:35%\"></i><i class=\"sld-th\" style=\"left:35%\"></i></span><b style=\"width:24px;text-align:right\">35</b></div>\n        </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n          <div style=\"display:flex;justify-content:space-between;margin-bottom:10px\"><b style=\"font-size:13px\">Price range</b><span style=\"font-size:12px;color:var(--text-2)\">¥100 — ¥300</span></div>\n          <span class=\"sld-plain\" style=\"width:100%\"><i class=\"sld-trk\"></i><i class=\"sld-fl\" style=\"left:20%;width:40%\"></i><i class=\"sld-th\" style=\"left:20%\