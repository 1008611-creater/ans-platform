{"__formatVersion":2,"__revision":"8e04c7eed29badb5","__entryId":"html","entry":{"sceneUI":["<div style=\"display:flex;flex-direction:column;gap:8px;max-width:400px;margin:0 auto\">\n      <div style=\"align-self:flex-end;max-width:70%;background:var(--brand);color:var(--on-brand);border-radius:12px 12px 4px 12px;padding:8px 12px;font-size:12px\">帮我做一个个人主页</div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:10px 12px\">\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:6px\">好的，这是你的 index.html：</div>\n        <div class=\"terminal-win\"><div class=\"terminal-body\">\n          <span><span class=\"terminal-d\">&lt;</span><span style=\"color:#c792ea\">h1</span><span class=\"terminal-d\">&gt;</span>小狸的主页<span class=\"terminal-d\">&lt;/</span><span style=\"color:#c792ea\">h1</span><span class=\"terminal-d\">&gt;</span></span>\n          <span><span class=\"terminal-d\">&lt;</span><span style=\"color:#c792ea\">p</span><span class=\"terminal-d\">&gt;</span>我喜欢爬山和拍照。<span class=\"terminal-d\">&lt;/</span><span style=\"color:#c792ea\">p</span><span class=\"terminal-d\">&gt;</span></span>\n          <span><span class=\"terminal-d\">&lt;</span><span style=\"color:#c792ea\">a</span> <span class=\"terminal-a\">href</span>=<span class=\"terminal-g\">\"/photos\"</span><span class=\"terminal-d\">&gt;</span>看我的相册<span class=\"terminal-d\">&lt;/</span><span style=\"color:#c792ea\">a</span><span class=\"terminal-d\">&gt;</span></span>\n        </div></div>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:6px 12px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3);font-family:ui-monospace,Menlo,monospace\">view-source:https://my-first-page.vercel.app</div>\n      <div style=\"padding:10px 12px;font-family:ui-monospace,Menlo,monospace;font-size:12p