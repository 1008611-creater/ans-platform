 <div style=\"font-size:20px;font-weight:700;color:var(--text);line-height:1.3;margin-top:2px\">12,846</div>\n        <div style=\"font-size:12px;color:var(--green);font-weight:600;margin-top:2px\">↑ 8.3%</div></div></div>\n      <div class=\"card-d\" style=\"flex:1;width:auto;min-width:0\"><div class=\"cd-body\">\n        <div class=\"cd-text\" style=\"margin-top:0\">Refund rate</div>\n        <div style=\"font-size:20px;font-weight:700;color:var(--text);line-height:1.3;margin-top:2px\">2.1%</div>\n        <div style=\"font-size:12px;color:var(--red);font-weight:600;margin-top:2px\">↓ 0.4%</div></div></div>\n    </div>","<div style=\"display:flex;flex-direction:column;gap:10px\">\n      <div class=\"card-d\" style=\"width:100%\"><div class=\"cd-body\">\n        <div class=\"cd-title\" style=\"margin-bottom:6px\">Notification settings</div>\n        <div style=\"display:flex;align-items:center;padding:5px 0\"><span style=\"font-size:12px;color:var(--text-2);flex:1\">Email notifications</span><label class=\"demo-switch\" style=\"width:36px;height:20px\"><input type=\"checkbox\" checked><span class=\"track\"></span></label></div>\n        <div style=\"display:flex;align-items:center;padding:5px 0\"><span style=\"font-size:12px;color:var(--text-2);flex:1\">Text notifications</span><label class=\"demo-switch\" style=\"width:36px;height:20px\"><input type=\"checkbox\"><span class=\"track\"></span></label></div>\n      </div></div>\n      <div class=\"card-d\" style=\"width:100%\"><div class=\"cd-body\">\n        <div class=\"cd-title\">Privacy settings</div>\n        <div style=\"display:flex;align-items:center;padding:5px 0\"><span style=\"font-size:12px;color:var(--text-2);flex:1\">Public profile</span><label class=\"demo-switch\" style=\"width:36px;height:20px\"><input type=\"checkbox\" checked><span class=\"track\"></span></label></div>\n      </div></div>\n    </div>","<div style=\"display:flex;gap:10px;align-items:stretch\">\n      <div class=\"card-d\" style=\"flex:1;width:auto;min-width:0\">\n        <div class=\"cd-cover\" style=\"height:56px;background:url('/assets/slide-city.png') center/cover\"></div>\n        <div class=\"cd-body\"><div class=\"cd-title\">Wireless Headphones Pro</div>\n          <div style=\"display:flex;align-items:center;margin-top:4px\"><span style=\"font-size:14px;font-weight:700;color:var(--red);flex:1\">¥ 299</span><span class=\"demo-tag red\">20% off</span></div></div>\n      </div>\n      <div class=\"card-d\" style=\"flex:1;width:auto;min-width:0\">\n        <div class=\"cd-cover\" style=\"height:56px;background:url('/assets/photo-cat.png') center/cover\"></div>\n        <div class=\"cd-body\"><div class=\"cd-title\">Cat-Paw Mechanical Keyboard</div>\n          <div style=\"display:flex;align-items:center;margin-top:4px\"><span style=\"font-size:14px;font-weight:700;color:var(--red);flex:1\">¥ 199</span><span class=\"demo-tag green\">New</span></div></div>\n      </div>\n    </div>"],"variants":[{"demo":"<div class=\"card-d\" style=\"width:180px\">\n      <div class=\"cd-body\"><div class=\"cd-title\">Team Knowledge Base</div>\n      <div class=\"cd-text\">Contains 47 documents, updated weekly. </div></div></div>","when":"When a group of text needs to be understood as one unit"},{"demo":"<div class=\"card-d\" style=\"width:180px\">\n      <div class=\"cd-cover\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></div>\n      <div class=\"cd-body\"><div class=\"cd-title\">Introduction to AI illustrated books</div></div></div>","when":"When the image is the primary identifying information, place the cover at the top of the card"},{"demo":"<div class=\"card-d flat\" style=\"width:180px\">\n      <div class=\"cd-body\"><div class=\"cd-title\">Quick entry</div>\n      <div class=\"cd-text\">Weaken the border and blend into the background. </div></div></div>","when":"When the page background already separates the content area, use a subtler card border"},{"demo":"<div class=\"card-d\" style=\"width:180px\">\n      <div class=\"cd-body\"><div class=\"cd-title\">Website refresh v2</div></div>\n      <div class=\"cd-actions\"><button class=\"btn btn-outline\">Preview</button><button class=\"btn btn-primary\">Edit</button></div></div>","when":"Users want to preview or edit directly on the card"}]},"usageMocks":{"card-product":"<div class=\"mk-row\" style=\"align-items:stretch;gap:8px\"><div class=\"mk-win\" style=\"flex:1;min-width:124px;width:auto;padding:0;overflow:hidden\"><i class=\"mk-line\" style=\"width:100%;height:36px;border-radius:0;background:linear-gradient(135deg,var(--brand),#722ed1)\"></i><span style=\"padding:7px 9px;display:flex;flex-direction:column;gap:3px\"><b style=\"font-size:12px;color:var(--text)\">无线耳机</b><span style=\"font-size:12px;color:var(--red);font-weight:600\">¥ 299</span></span></div><div class=\"mk-win\" style=\"flex:1;min-width:124px;width:auto;padding:0;overflow:hidden\"><i class=\"mk-line\" style=\"width:100%;height:36px;border-radius:0;background:linear-gradient(135deg,#287947,#14c9c9)\"></i><span style=\"padding:7px 9px;display:flex;flex-direction:column;gap:3px\"><b style=\"font-size:12px;color:var(--text)\">机械键盘</b><span style=\"font-size:12px;color:var(--red);font-weight:600\">¥ 199</span></span></div></div>","card-metric":"<div class=\"mk-row \"><div class=\"mk-win\" style=\"flex:1;min-width:128px;width:auto;gap:3px\"><span style=\"font-size:12px;color:var(--text-3)\">销售额</span><span style=\"font-size:16px;font-weight:700;color:var(--text);line-height:1.3\">¥ 86.4w</span></div><div class=\"mk-win\" style=\"flex:1;min-width:128px;width:auto;gap:3px\"><span style=\"font-size:12px;color:var(--text-3)\">订单数</span><span style=\"font-size:16px;font-weight:700;color:var(--text);line-height:1.3\">12,846</span></div></div>","card-group":"<div class=\"mk-win\"><span style=\"font-size:12px;font-weight:600;color:var(--text)\">通知设置</span><div class=\"mk-row \"><span style=\"color:var(--text-2)\">邮件通知</span><span style=\"flex:1\"></span><span class=\"mk-switch on\"><i></i></span></div><div class=\"mk-row \"><span style=\"color:var(--text-2)\">短信通知</span><span style=\"flex:1\"></span><span class=\"mk-switch\"><i></i></span></div></div>","card-cover":"<div class=\"mk-win\" style=\"padding:0;overflow:hidden;width:160px;max-width:100%\"><i class=\"mk-line\" style=\"width:100%;height:38px;border-radius:0;background:linear-gradient(135deg,var(--brand),#722ed1)\"></i><span style=\"padding:7px 9px;display:flex;flex-direction:column;gap:4px\"><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:56%\"></i></span></div>","card-text":"<div class=\"mk-win\"><span style=\"font-size:12px;font-weight:600;color:var(--text)\">年度总结报告</span><i class=\"mk-line\" style=\"width:92%\"></i><i class=\"mk-line\" style=\"width:88%\"></i><i class=\"mk-line\" style=\"width:84%\"></i><i class=\"mk-line\" style=\"width:90%\"></i><span style=\"font-size:12px;color:var(--text-3);line-height:1.5\">长文已经自成内容区，额外卡片边界会干扰阅读</span></div>","card-nested":"<div class=\"mk-win\" style=\"gap:8px\"><span style=\"font-size:12px;color:var(--text-3)\">外层卡片</span><div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text-3)\">内层卡片</span><i class=\"mk-line\" style=\"width:80%\"></i></div></div>","list-menu":"<div class=\"mk-win\"><div class=\"mk-row \"><span style=\"color:var(--text)\">账号与安全</span><span style=\"flex:1\"></span><span style=\"color:var(--text-3)\">›</span></div><div style=\"border-top:1px solid var(--border-light)\"></div><div class=\"mk-row \"><span style=\"color:var(--text)\">消息通知</span><span style=\"flex:1\"></span><span style=\"color:var(--text-3)\">›</span></div><div style=\"border-top:1px solid var(--border-light)\"></div><div class=\"mk-row \"><span style=\"color:var(--text)\">隐私设置</span><span style=\"flex:1\"></span><span style=\"color:var(--text-3)\">›</span></div></div>","card-single":"<div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text-3)\">整页唯一的内容也要套个框</span><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div>"}}}