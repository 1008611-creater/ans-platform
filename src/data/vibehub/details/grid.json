d:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span></span><span style=\"font-size:12px;color:var(--text-3)\">三列等分：repeat(3, 1fr)</span>","grid-autofill":"<span style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(26px,1fr));gap:4px;width:100%\"><span style=\"height:16px;background:var(--brand-light);border:1px solid var(--brand);border-radius:3px\"></span><span style=\"height:16px;background:var(--brand-light);border:1px solid var(--brand);border-radius:3px\"></span><span style=\"height:16px;background:var(--brand-light);border:1px solid var(--brand);border-radius:3px\"></span><span style=\"height:16px;background:var(--brand-light);border:1px solid var(--brand);border-radius:3px\"></span><span style=\"height:16px;background:var(--brand-light);border:1px solid var(--brand);border-radius:3px\"></span></span><span style=\"font-size:12px;color:var(--text-3)\">auto-fill 会按最小列宽在容器中创建可容纳的列</span>","grid-layout":"<div class=\"mk-win\" style=\"padding:4px\"><span style=\"display:grid;grid-template-columns:22px 1fr;gap:4px;width:100%\"><span style=\"height:32px;background:var(--brand-light);border:1px solid var(--brand);border-radius:3px\"></span><span style=\"display:grid;grid-template-rows:repeat(2,1fr);gap:4px\"><span style=\"background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span></span></span></div><span style=\"font-size:12px;color:var(--text-3)\">Grid 可直接定义侧栏与主要内容的列宽关系</span>","grid-gap":"<span style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:100%\"><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span><span style=\"height:16px;background:var(--bg);border:1px solid var(--border);border-radius:3px\"></span></span><span style=\"font-size:12px;color:var(--text-3)\">gap 统一管格距，不用逐个写 margin</span>","flex-vs-grid":"<div class=\"mk-row\"><span style=\"display:grid;grid-template-columns:repeat(3,18px);gap:3px\"><span style=\"height:14px;background:var(--brand-light);border:1px solid var(--brand);border-radius:2px\"></span><span style=\"height:14px;background:var(--brand-light);border:1px solid var(--brand);border-radius:2px\"></span><span style=\"height:14px;background:var(--brand-light);border:1px solid var(--brand);border-radius:2px\"></span><span style=\"height:14px;background:var(--brand-light);border:1px solid var(--brand);border-radius:2px\"></span><span style=\"height:14px;background:var(--brand-light);border:1px solid var(--brand);border-radius:2px\"></span><span style=\"height:14px;background:var(--brand-light);border:1px solid var(--brand);border-radius:2px\"></span></span><span style=\"font-size:12px;color:var(--text-3);max-width:120px\">需要同时控制行列关系时，Grid 通常更直接</span></div>","grid-percent":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"gap:0\"><span style=\"width:33.33%;height:14px;background:var(--bg);border:1px solid var(--red);font-size:11px;color:var(--red);display:flex;align-items:center;justify-content:center\">33.33%</span><span style=\"width:33.33%;height:14px;background:var(--bg);border:1px solid var(--red);font-size:11px;color:var(--red);display:flex;align-items:center;justify-content:center\">33.33%</span><span style=\"width:33.33%;height:14px;background:var(--bg);border:1px solid var(--red);font-size:11px;color:var(--red);display:flex;align-items:center;justify-content:center\">33.33%</span></div><span style=\"font-size:12px;color:var(--text-3)\">手写百分比栅格，调整间距时需要额外计算</span></div>","grid-fixed":"<div class=\"mk-row\"><span class=\"mk-phone\" style=\"width:40px\"><span style=\"display:grid;grid-template-columns:repeat(4,14px);gap:2px\"><span style=\"height:10px;background:var(--red-light);border:1px solid var(--red)\"></span><span style=\"height:10px;background:var(--red-light);border:1px solid var(--red)\"></span><span style=\"height:10px;background:var(--red-light);border:1px solid var(--red)\"></span><span style=\"height:10px;background:var(--red-light);border:1px solid var(--red)\"></span></span></span><span style=\"font-size:12px;color:var(--text-3);max-width:110px\">固定列数与列宽可能在窄屏溢出</span></div>","grid-margin":"<span style=\"display:grid;grid-template-columns:repeat(3,1fr);width:100%\"><span style=\"height:14px;margin:0 6px 6px 0;background:var(--bg);border:1px solid var(--red);border-radius:3px\"></span><span style=\"height:14px;margin:0 6px 6px 0;background:var(--bg);border:1px solid var(--red);border-radius:3px\"></span><span style=\"height:14px;margin:0 0 6px;background:var(--bg);border:1px solid var(--red);border-radius:3px\"></span></span><span style=\"font-size:12px;color:var(--text-3)\">逐项使用 margin 会增加边缘间距的单独处理</span>"}}}