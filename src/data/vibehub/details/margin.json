{"__formatVersion":2,"__revision":"41bc0b152fb5440e","__entryId":"margin","entry":{"sceneUI":["<div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><b style=\"font-size:13px\">本周订单</b><span class=\"demo-tag green\">+12%</span></div>\n        <div style=\"font-size:20px;font-weight:700;margin-top:4px\">1,284</div>\n      </div>\n      <div style=\"height:22px;display:flex;align-items:center;gap:6px\">\n        <span style=\"font-size:12px;color:var(--brand)\">↕</span>\n        <span style=\"flex:1;border-top:1px dashed var(--brand)\"></span>\n        <span class=\"margin-sc-chip\">margin-bottom: 16px</span>\n        <span style=\"flex:1;border-top:1px dashed var(--brand)\"></span>\n      </div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">最近动态</b>\n        <div style=\"font-size:12px;color:var(--text-2);margin-top:4px\">小狐狸 评论了「首页改版」</div>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px\">\n      <b style=\"font-size:15px\">v2.4 更新日志</b>\n      <div style=\"display:flex;align-items:center;gap:6px;margin:3px 0\"><span style=\"border-left:2px solid var(--brand);padding-left:6px;font-size:12px;color:var(--brand)\">margin-top: 8px</span></div>\n      <p style=\"font-size:12px;color:var(--text-2);line-height:1.6;margin:0\">新增深色模式与组件搜索，修复了 12 个已知问题。</p>\n      <div style=\"display:flex;align-items:center;gap:6px;margin:6px 0\"><span style=\"border-left:2px solid var(--brand);padding-left:6px;font-size:12px;color:var(--brand)\">margin-top: 24px，新章节离远一点</span></div>\n      <b style=\"font-size:15px\">v2.3 更新日志</b>\n    </div>","<div style=\"background:var(--bg-soft);border-radius:10px;padding:16px 14px 12px\">\n      <div style=\"max-width:230px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">登录账号</b>\n        <input class=\"demo-input\" style=\"width:100%;margin-top:8px;padding:7px 10px;font-size:12px\" value=\"you@example.com\">\n      </div>\n      <div class=\"margin-sc-note\">定宽卡片写 <b style=\"color:var(--brand)\">margin: 0 auto</b>，两侧自动均分剩余空间</div>\n    </div>","<div style=\"display:flex;gap:12px\">\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--red);border-radius:8px;padding:8px 10px\">\n        <span style=\"display:flex;align-items:center;gap:5px\"><span style=\"color:#f7ba1e;font-size:13px;transform:translateY(-2px)\">★</span><span style=\"font-size:12px;color:var(--text)\">收藏</span></span>\n        <div style=\"font-size:12px;color:var(--red);margin-top:5px\">✕ 图标高出 2px，没对齐</div>\n      </div>\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--green);border-radius:8px;padding:8px 10px\">\n        <span style=\"display:flex;align-items:center;gap:5px\"><span style=\"color:#f7ba1e;font-size:13px;margin-top:2px\">★</span><span style=\"font-size:12px;color:var(--text)\">收藏</span></span>\n        <div style=\"font-size:12px;color:var(--green);margin-top:5px\">✓ margin-top: 2px 微调后对齐</div>\n      </div>\n    </div>"],"sceneUI_en":["<div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><b style=\"font-size:13px\">This week’s orders</b><span class=\"demo-tag green\">+12%</span></div>\n        <div style=\"font-size:20px;font-weight:700;margin-top:4px\">1,284</div>\n      </div>\n      <div style=\"height:22px;display:flex;align-items:center;gap:6px\">\n        <span style=\"font-size:12px;color:var(--brand)\">↕</span>\n        <span style=\"flex:1;border-top:1px dashed var(--brand)\"></span>\n        <span class=\"margin-sc-chip\">margin-bottom: 16px</span>\n        <span style=\"flex:1;border-top:1px dashed var(--brand)\"></span>\n      </div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">Latest news</b>\n        <div style=\"font-size:12px;color:var(--text-2);margin-top:4px\">Little Fox commented on \"Home Page Revision\"</div>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px\">\n      <b style=\"font-size:15px\">v2.4 update log</b>\n      <div style=\"display:flex;align-items:center;gap:6px;margin:3px 0\"><span style=\"border-left:2px solid var(--brand);padding-left:6px;font-size:12px;color:var(--brand)\">margin-top: 8px</span></div>\n      <p style=\"font-size:12px;color:var(--text-2);line-height:1.6;margin:0\">Added dark mode and component search, and fixed 12 known issues. </p>\n      <div style=\"display:flex;align-items:center;gap:6px;margin:6px 0\"><span style=\"border-left:2px solid var(--brand);padding-left:6px;font-size:12px;color:var(--brand)\">margin-top: 24px, new chapters stay away</span></div>\n      <b style=\"font-size:15px\">v2.3 update log</b>\n    </div>","<div style=\"background:var(--bg-soft);border-radius:10px;padding:16px 14px 12px\">\n      <div style=\"max-width:230px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">Login account</b>\n        <input class=\"demo-input\" style=\"width:100%;margin-top:8px;padding:7px 10px;font-size:12px\" value=\"you@example.com\">\n      </div>\n      <div class=\"margin-sc-note\">For fixed-width cards, write <b style=\"color:var(--brand)\">margin: 0 auto</b>, and the remaining space will be automatically divided equally on both sides</div>\n    </div>","<div style=\"display:flex;gap:12px\">\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--red);border-radius:8px;padding:8px 10px\">\n        <span style=\"display:flex;align-items:center;gap:5px\"><span style=\"color:#f7ba1e;font-size:13px;transform:translateY(-2px)\">★</span><span style=\"font-size:12px;color:var(--text)\">Collection</span></span>\n        <div style=\"font-size:12px;color:var(--red);margin-top:5px\">✕ The icon is 2px higher and not aligned</div>\n      </div>\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--green);border-radius:8px;padding:8px 10px\">\n        <span style=\"display:flex;align-items:center;gap:5px\"><span style=\"color:#f7ba1e;font-size:13px;margin-top:2px\">★</span><span style=\"font-size:12px;color:var(--text)\">Collection</span></span>\n        <div style=\"font-size:12px;color:var(--green);margin-top:5px\">✓ margin-top: 2px fine-tuned and aligned</div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"margin\"><span class=\"margin-anat-margin\"><span class=\"ap\" data-ap=\"border\"><span class=\"margin-anat-border\"><span class=\"ap\" data-ap=\"padding\"><span class=\"margin-anat-padding\"><span class=\"ap\" data-ap=\"content\"><span class=\"margin-anat-content\">内容</span></span></span></span></span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"margin\"><span class=\"margin-anat-margin\"><span class=\"ap\" data-ap=\"border\"><span class=\"margin-anat-border\"><span class=\"ap\" data-ap=\"padding\"><span class=\"margin-anat-padding\"><span class=\"ap\" data-ap=\"content\"><span class=\"margin-anat-content\">Content</span></span></span></span></span></span></span></span>","parts":[{"key":"margin","cn":"外边距","en":"Margin","desc":"边框以外的透明间隔，用于拉开相邻元素","desc_en":"Transparent space outside the border, used to separate adjacent elements"},{"key":"border","cn":"边框","en":"Border","desc":"元素的边界，边框外侧属于外边距间隔区域","desc_en":"The boundary of the element, beyond which is the territory of margin"},{"key":"padding","cn":"内边距","en":"Padding","desc":"内容和边框之间，带着背景色","desc_en":"Between content and border, with background color"},{"key":"content","cn":"内容","en":"Content","desc":"承载文字与图片的实体内容区域","desc_en":"The place where words and pictures really stay"}]},"variants":[{"cn":"四边相同","en":"16px","demo":"<span style=\"display:inline-block;padding:12px;background:var(--bg-soft);border:1px dashed var(--border);border-radius:6px\"><span class=\"margin-v-box\">margin: 16px</span></span>","demo_en":"<span style=\"display:inline-block;padding:12px;background:var(--bg-soft);border:1px dashed var(--border);border-radius:6px\"><span class=\"margin-v-box\">margin: 16px</span></span>","when":"四周都要均匀留空时用","when_en":"Use it when all sides need to be evenly spaced"},{"cn":"单边","en":"margin-bottom","demo":"<span style=\"display:flex;flex-direction:column;align-items:flex-start\"><span class=\"margin-v-box\" style=\"margin-bottom:10px\">标题</span><span class=\"margin-v-box\">正文</span></span>","demo_en":"<span style=\"display:flex;flex-direction:column;align-items:flex-start\"><span class=\"margin-v-box\" style=\"margin-bottom:10px\">Title</span><span class=\"margin-v-box\">Text</span></span>","when":"段落、字段只向下留距离","when_en":"Paragraphs and fields only leave space downwards"},{"cn":"水平居中","en":"0 auto","demo":"<span style=\"display:block;width:110px\"><span class=\"margin-v-box\" style=\"display:block;width:52px;margin:0 auto;text-align:center\">auto</span></span>","demo_en":"<span style=\"display:block;width:110px\"><span class=\"margin-v-box\" style=\"display:block;width:52px;margin:0 auto;text-align:center\">auto</span></span>","when":"定宽容器在页面里居中","when_en":"Fixed-width containers are centered on the page"},{"cn":"负外边距","en":"Negative","demo":"<span style=\"display:flex;align-items:center\"><span class=\"margin-v-box\">封面图</span><span class=\"margin-v-box\" style=\"margin-left:-10px;background:var(--brand-light);border-color:var(--brand)\">标题条</span></span>","demo_en":"<span style=\"display:flex;align-items:center\"><span class=\"margin-v-box\">Cover image</span><span class=\"margin-v-box\" style=\"margin-left:-10px;background:var(--brand-light);border-color:var(--brand)\">Title bar</span></span>","when":"微调对齐或故意叠一点层次","when_en":"Fine-tune alignment or deliberately layer a little more"}],"use":[{"t":"<b>拉开模块间距</b>：卡片之间、段落与标题之间","m":"margin-sections"},{"t":"<b>水平居中</b>：定宽容器写 margin: 0 auto","m":"margin-auto"},{"t":"<b>统一只加一侧</b>：比如都用 margin-bottom，间距好维护","m":"margin-one-side"},{"t":"<b>处理图标与文字的光学对齐</b>：先检查 line-height、图标画布和 flex 对齐，必要时再做局部微调","m":"margin-nudge"}],"dont":[{"t":"普通块级元素的垂直 margin 可能<b>发生外边距折叠</b>，结果不一定是两者相加","m":"margin-collapse","bad":true},{"t":"内容与边框之间的留白使用 {c:padding}","m":"margin-vs-padding"},{"t":"滥用<b>负 margin</b>调整布局：意图不清，后续维护困难","m":"margin-negative","bad":true},{"t":"用<b>空 div 加 margin</b>制造间距：改用 {c:space} 的间距体系","m":"margin-empty","bad":true}],"lessonPractice":{"title":"两张卡片彼此贴得太近，但每张卡片内部的文字与边框距离已经合适。应该调整哪里？","options":[{"id":"external-spacing","label":"调整卡片之间的外边距，或统一修改父容器的间距","feedback":"问题发生在两个组件之间，外边距或父级 gap 能改变外部关系而不破坏内部留白。","correct":true},{"id":"increase-padding","label":"增加两张卡片的内边距，让卡片内容进一步远离边框","feedback":"内边距只会扩大内容与卡片边框的距离，卡片外边界仍然彼此贴近。","correct":false},{"id":"empty-spacer-element","label":"在两张卡片中间插入一个固定高度的空白元素","feedback":"空元素把视觉间距变成额外内容，响应式变化和统一维护都会更困难。","correct":false}],"en":{"title":"Two cards sit too close together, but the text-to-border spacing inside each card is already correct. What should change?","options":[{"id":"external-spacing","label":"Adjust the cards' margin or change the parent container's shared gap","feedback":"The problem is between components, so margin or parent gap changes their external relationship without disturbing internal space.","correct":true},{"id":"increase-padding","label":"Increase both cards' padding so their content moves farther from their borders","feedback":"Padding only changes content-to-border distance. The cards' outer edges remain just as close.","correct":false},{"id":"empty-spacer-element","label":"Insert a fixed-height empty element between the two cards","feedback":"A spacer turns visual distance into extra content and becomes harder to maintain across responsive layouts.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请只调整这组卡片之间的外部间距，不改变卡片内部 padding。优先使用父容器统一 gap；如果必须用 margin，保持同一侧规则。检查桌面、手机和卡片换行后间距一致。","en":{"title":"You can say this to an AI Agent","text":"Adjust only the external spacing between these cards and preserve their internal padding. Prefer a shared parent gap; if margin is necessary, use one consistent side. Verify spacing on desktop, mobile, and after cards wrap."}},"references":[{"title":"margin 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/margin","title_en":"margin"},{"title":"掌握 margin 塌陷","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_box_model/Mastering_margin_collapsing","title_en":"Mastering margin collapsing"}],"scenes":["卡片之间的间隔","段落与标题的距离","定宽容器水平居中","图标与文字的光学对齐"],"en":{"use":[{"t":"Separate one block from another","m":"margin-sections"},{"t":"Add outer breathing room around a component","m":"margin-auto"},{"t":"Push a section away from its neighbors","m":"margin-one-side"},{"t":"Adjust one edge without changing the content area","m":"margin-nudge"}],"dont":[{"t":"Use margin to create room inside a box","m":"margin-collapse","bad":true},{"t":"Stack several margins until the result is hard to predict","m":"margin-vs-padding"},{"t":"Choose unrelated values throughout the same page","m":"margin-negative","bad":true},{"t":"Use negative margin as the default way to fix layout","m":"margin-empty","bad":true}],"scenes":["Section spacing","Card separation","Form groups","Page rhythm"],"sceneUI":["<div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><b style=\"font-size:13px\">This week’s orders</b><span class=\"demo-tag green\">+12%</span></div>\n        <div style=\"font-size:20px;font-weight:700;margin-top:4px\">1,284</div>\n      </div>\n      <div style=\"height:22px;display:flex;align-items:center;gap:6px\">\n        <span style=\"font-size:12px;color:var(--brand)\">↕</span>\n        <span style=\"flex:1;border-top:1px dashed var(--brand)\"></span>\n        <span class=\"margin-sc-chip\">margin-bottom: 16px</span>\n        <span style=\"flex:1;border-top:1px dashed var(--brand)\"></span>\n      </div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">Latest news</b>\n        <div style=\"font-size:12px;color:var(--text-2);margin-top:4px\">Little Fox commented on \"Home Page Revision\"</div>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px\">\n      <b style=\"font-size:15px\">v2.4 update log</b>\n      <div style=\"display:flex;align-items:center;gap:6px;margin:3px 0\"><span style=\"border-left:2px solid var(--brand);padding-left:6px;font-size:12px;color:var(--brand)\">margin-top: 8px</span></div>\n      <p style=\"font-size:12px;color:var(--text-2);line-height:1.6;margin:0\">Added dark mode and component search, and fixed 12 known issues. </p>\n      <div style=\"display:flex;align-items:center;gap:6px;margin:6px 0\"><span style=\"border-left:2px solid var(--brand);padding-left:6px;font-size:12px;color:var(--brand)\">margin-top: 24px, new chapters stay away</span></div>\n      <b style=\"font-size:15px\">v2.3 update log</b>\n    </div>","<div style=\"background:var(--bg-soft);border-radius:10px;padding:16px 14px 12px\">\n      <div style=\"max-width:230px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">Login account</b>\n        <input class=\"demo-input\" style=\"width:100%;margin-top:8px;padding:7px 10px;font-size:12px\" value=\"you@example.com\">\n      </div>\n      <div class=\"margin-sc-note\">For fixed-width cards, write <b style=\"color:var(--brand)\">margin: 0 auto</b>, and the remaining space will be automatically divided equally on both sides</div>\n    </div>","<div style=\"display:flex;gap:12px\">\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--red);border-radius:8px;padding:8px 10px\">\n        <span style=\"display:flex;align-items:center;gap:5px\"><span style=\"color:#f7ba1e;font-size:13px;transform:translateY(-2px)\">★</span><span style=\"font-size:12px;color:var(--text)\">Collection</span></span>\n        <div style=\"font-size:12px;color:var(--red);margin-top:5px\">✕ The icon is 2px higher and not aligned</div>\n      </div>\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--green);border-radius:8px;padding:8px 10px\">\n        <span style=\"display:flex;align-items:center;gap:5px\"><span style=\"color:#f7ba1e;font-size:13px;margin-top:2px\">★</span><span style=\"font-size:12px;color:var(--text)\">Collection</span></span>\n        <div style=\"font-size:12px;color:var(--green);margin-top:5px\">✓ margin-top: 2px fine-tuned and aligned</div>\n      </div>\n    </div>"],"variants":[{"demo":"<span style=\"display:inline-block;padding:12px;background:var(--bg-soft);border:1px dashed var(--border);border-radius:6px\"><span class=\"margin-v-box\">margin: 16px</span></span>","when":"Use it when all sides need to be evenly spaced"},{"demo":"<span style=\"display:flex;flex-direction:column;align-items:flex-start\"><span class=\"margin-v-box\" style=\"margin-bottom:10px\">Title</span><span class=\"margin-v-box\">Text</span></span>","when":"Paragraphs and fields only leave space downwards"},{"demo":"<span style=\"display:block;width:110px\"><span class=\"margin-v-box\" style=\"display:block;width:52px;margin:0 auto;text-align:center\">auto</span></span>","when":"Fixed-width containers are centered on the page"},{"demo":"<span style=\"display:flex;align-items:center\"><span class=\"margin-v-box\">Cover image</span><span class=\"margin-v-box\" style=\"margin-left:-10px;background:var(--brand-light);border-color:var(--brand)\">Title bar</span></span>","when":"Fine-tune alignment or deliberately layer a little more"}]},"usageMocks":{"margin-sections":"<div style=\"display:flex;flex-direction:column;gap:14px;width:100%\"><div class=\"mk-win\" style=\"padding:6px 10px\"><i class=\"mk-line\" style=\"width:70%\"></i></div><div class=\"mk-win\" style=\"padding:6px 10px\"><i class=\"mk-line\" style=\"width:55%\"></i></div></div><span style=\"font-size:12px;color:var(--text-3)\">模块间距按层级、密度和相邻内容关系设定</span>","margin-auto":"<div class=\"mk-win\"><span style=\"display:block;width:58%;height:18px;margin:0 auto;background:var(--brand-light);border:1px solid var(--brand);border-radius:4px\"></span><span style=\"font-size:12px;color:var(--text-3);text-align:center\">margin: 0 auto，定宽块自动居中</span></div>","margin-one-side":"<div class=\"mk-win\"><i class=\"mk-line\" style=\"width:80%\"></i><span style=\"height:10px\"></span><i class=\"mk-line\" style=\"width:65%\"></i><span style=\"font-size:12px;color:var(--text-3)\">统一用 margin-bottom，间距只朝一个方向</span></div>","margin-nudge":"<div class=\"mk-row\"><span class=\"mk-icon-btn\">★</span><span style=\"font-size:12px;color:var(--text);transform:translateY(1px)\">收藏</span></div><span style=\"font-size:12px;color:var(--text-3)\">先检查行高和对齐规则；确有光学偏差时再局部微调</span>","margin-collapse":"<div style=\"display:flex;flex-direction:column;align-items:center;gap:3px;width:100%\"><span style=\"background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:3px 10px;font-size:12px\">块 A · margin-bottom: 20</span><span style=\"font-size:12px;color:var(--red)\">↕ 合并成 20（不是 32）</span><span style=\"background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:3px 10px;font-size:12px\">块 B · margin-top: 12</span></div>","margin-vs-padding":"<div class=\"mk-win\"><span style=\"display:flex;flex-direction:column;gap:3px;border:1px dashed var(--text-3);border-radius:5px;padding:6px\"><span style=\"font-size:12px;color:var(--text-3)\">margin ↔ 拉开外部距离</span><span style=\"background:var(--brand-light);border:1px solid var(--brand);border-radius:4px;padding:6px;font-size:12px;color:var(--brand)\">padding ↔ 增加内部留白<b style=\"display:block;color:var(--text);font-size:12px\">内容</b></span></span></div>","margin-negative":"<div class=\"mk-win\" style=\"position:relative\"><i class=\"mk-line\" style=\"width:72%\"></i><i class=\"mk-line\" style=\"width:58%\"></i><span style=\"position:absolute;top:4px;right:8px;background:var(--red-light);color:var(--red);font-size:12px;padding:2px 6px;border-radius:3px\">负 margin 让元素与前一部分重叠</span></div>","margin-empty":"<div class=\"mk-win\"><i class=\"mk-line\" style=\"width:80%\"></i><span style=\"display:flex;align-items:center;justify-content:center;height:24px;border:1px dashed var(--red);border-radius:3px;font-size:12px;color:var(--red)\">仅用于制造间距的空 div</span><i class=\"mk-line\" style=\"width:65%\"></i></div>"}}}