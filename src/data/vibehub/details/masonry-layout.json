er;justify-content:center;font-size:22px\">🪑</div>\n        <div style=\"padding:6px 8px\"><div style=\"font-size:12px;font-weight:600\">人体工学椅</div><b style=\"font-size:12px;color:var(--red)\">¥ 1,299</b></div>\n      </div>\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n        <div style=\"height:46px;background:var(--bg-soft);display:flex;align-items:center;justify-content:center;font-size:22px\">💡</div>\n        <div style=\"padding:6px 8px\"><div style=\"font-size:12px;font-weight:600\">护眼台灯</div><b style=\"font-size:12px;color:var(--red)\">¥ 199</b></div>\n      </div>\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n        <div style=\"height:66px;background:var(--bg-soft);display:flex;align-items:center;justify-content:center;font-size:22px\">⌨️</div>\n        <div style=\"padding:6px 8px\"><div style=\"font-size:12px;font-weight:600\">机械键盘</div><b style=\"font-size:12px;color:var(--red)\">¥ 349</b></div>\n      </div>\n    </div>","<div style=\"columns:3;column-gap:8px;max-width:560px;margin:0 auto\">\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg)\">\n        <div style=\"height:44px;background:linear-gradient(135deg,var(--brand-light),#fff);border-bottom:1px solid var(--border-light)\"></div>\n        <div style=\"padding:6px 8px\"><div style=\"font-size:12px;font-weight:600\">作品集模板</div><div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:3px\"><span style=\"font-size:12px;color:var(--text-3)\">免费</span><button class=\"btn btn-outline\" style=\"padding:2px 8px;font-size:12px\">使用</button></div></div>\n      </div>\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg)\">\n        <div style=\"height:68px;background:linear-gradient(135deg,var(--red-light),#fff);border-bottom:1px solid var(--border-light)\"></div>\n        <div style=\"padding:6px 8px\"><div style=\"font-size:12px;font-weight:600\">活动报名页</div><div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:3px\"><span style=\"font-size:12px;color:var(--text-3)\">免费</span><button class=\"btn btn-outline\" style=\"padding:2px 8px;font-size:12px\">使用</button></div></div>\n      </div>\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg)\">\n        <div style=\"height:52px;background:linear-gradient(135deg,var(--green-light),#fff);border-bottom:1px solid var(--border-light)\"></div>\n        <div style=\"padding:6px 8px\"><div style=\"font-size:12px;font-weight:600\">博客主题</div><div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:3px\"><span style=\"font-size:12px;color:var(--text-3)\">免费</span><button class=\"btn btn-outline\" style=\"padding:2px 8px;font-size:12px\">使用</button></div></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"columns\"><span class=\"masonry-anat-wall\"><span class=\"masonry-anat-col\"><span class=\"ap\" data-ap=\"card\"><span class=\"masonry-anat-card on\">卡片</span></span><span class=\"masonry-anat-card tall\"></span></span><span class=\"masonry-anat-col\"><span class=\"masonry-anat-card tall\"></span><span class=\"masonry-anat-card\"></span></span><span class=\"masonry-anat-col\"><span class=\"masonry-anat-card short\"></span><span class=\"ap\" data-ap=\"fill\"><span class=\"masonry-anat-card fill\">补位</span></span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"columns\"><span class=\"masonry-anat-wall\"><span class=\"masonry-anat-col\"><span class=\"ap\" data-ap=\"card\"><span class=\"masonry-anat-card on\">Card</span></span><span class=\"masonry-anat-card tall\"></span></span><span class=\"masonry-anat-col\"><span class=\"masonry-anat-card tall\"></span><span class=\"masonry-anat-card\"></span></span><span class=\"masonry-anat-col\"><span class=\"masonry-anat-card short\"></span><span class=\"ap\" data-ap=\"fill\"><span class=\"masonry-anat-card fill\">Fills in</span></span></span></span></span>","parts":[{"key":"columns","cn":"等宽的列","en":"Equal Columns","desc":"列宽保持一致，只有高度自由变化","desc_en":"Columns keep equal widths while heights vary freely"},{"key":"card","cn":"不同高度的卡片","en":"Cards of Varying Height","desc":"卡片保持内容原始比例，不被裁成统一高度","desc_en":"Cards keep the natural ratio of their content instead of being cropped"},{"key":"fill","cn":"补位","en":"Gap Filling","desc":"下一张卡片进入当前最短的列，这也是顺序被打乱的原因","desc_en":"The next card joins the shortest column, which is also why the order shuffles"}]},"variants":[{"cn":"三列","en":"Three Columns","demo":"<span style=\"display:flex;gap:4px;width:110px\"><i class=\"masonry-v-col\"><b style=\"height:16px\"></b><b style=\"height:10px\"></b></i><i class=\"masonry-v-col\"><b style=\"height:10px\"></b><b style=\"height:16px\"></b></i><i class=\"masonry-v-col\"><b style=\"height:13px\"></b><b style=\"height:13px\"></b></i></span>","demo_en":"<span style=\"display:flex;gap:4px;width:110px\"><i class=\"masonry-v-col\"><b style=\"height:16px\"></b><b style=\"height:10px\"></b></i><i class=\"masonry-v-col\"><b style=\"height:10px\"></b><b style=\"height:16px\"></b></i><i class=\"masonry-v-col\"><b style=\"height:13px\"></b><b style=\"height:13px\"></b></i></span>","when":"桌面作品墙和内容流的常见列数","when_en":"The common column count for desktop galleries and feeds"},{"cn":"两列","en":"Two Columns","demo":"<span style=\"display:flex;gap:4px;width:110px\"><i class=\"masonry-v-col\"><b style=\"height:16px\"></b><b style=\"height:10px\"></b></i><i class=\"masonry-v-col\"><b style=\"height:10px\"></b><b style=\"height:16px\"></b></i></span>","demo_en":"<span style=\"display:flex;gap:4px;width:110px\"><i class=\"masonry-v-col\"><b style=\"height:16px\"></b><b style=\"height:10px\"></b></i><i class=\"masonry-v-col\"><b style=\"height:10px\"></b><b style=\"height:16px\"></b></i></span>","when":"窄屏或需要更大卡片预览时","when_en":"On narrow screens or when cards need larger previews"},{"cn":"单列","en":"Single Column","demo":"<span style=\"display:flex;width:110px\"><i class=\"masonry-v-col\"><b style=\"height:8px\"></b><b style=\"height:11px\"></b><b style=\"height:7px\"></b></i></span>","demo_en":"<span style=\"display:flex;width:110px\"><i class=\"masonry-v-col\"><b style=\"height:8px\"></b><b style=\"height:11px\"></b><b style=\"height:7px\"></b></i></span>","when":"手机端默认形态，内容回到原始顺序","when_en":"The default phone form, where content returns to its original order"}],"use":[{"t":"<b>作品墙</b>：摄影、插画比例不一，保持原始比例展示，见 {c:card}","m":"masonry-use-gallery"},{"t":"灵感、素材内容流：强调连续向下浏览，不需要逐行比较","m":"masonry-use-feed"},{"t":"商品或案例封面尺寸不统一，又希望页面紧凑","m":"masonry-use-cover"},{"t":"<b>纵向空间紧张</b>：内容持续增长，补位比整行留白更省高度","m":"masonry-use-density"}],"dont":[{"t":"内容有严格先后顺序（步骤、时间线）：<b>补位会打乱顺序</b>","m":"masonry-dont-order","bad":true},{"t":"需要逐行比较同类信息：列不对齐时比较成本更高，用 {c:card-grid-layout}","m":"masonry-dont-compare","bad":true},{"t":"手机端仍保留多列：<b>卡片被压得过窄</b>，应收成一到两列","m":"masonry-dont-mobile","bad":true},{"t":"把长文列表也塞进瀑布流：阅读顺序混乱，段落难以连续读完","m":"masonry-dont-text","bad":true}],"lessonPractice":{"title":"插画师的作品墙有上百张比例不同的图片，希望浏览紧凑、不出现整行空白。选哪种结构，验收时看什么？","options":[{"id":"masonry-with-order-check","label":"用瀑布流保持原始比例补位，并检查手机列数和补位后的阅读顺序","feedback":"补位消除了整行留白；视觉顺序会按列交错，必须在桌面和手机上确认顺序仍然可以接受。","correct":true},{"id":"uniform-crop-grid","label":"用卡片网格，把封面统一裁成相同高度，保证每行严格对齐","feedback":"统一裁切能得到整齐的行列，但会切掉作品画面；以图为主的展示墙上，裁切损失大于留白。","correct":false},{"id":"masonry-without-check","label":"用瀑布流保持原始比例，桌面上看着紧凑就不用再验收","feedback":"紧凑只是目标的一半；补位后第 4 张可能排到第 3 张上方，手机收成单列还会再变一次顺序。","correct":false}],"en":{"title":"An illustrator has a portfolio wall with hundreds of images in different aspect ratios and wants compact browsing without full-row gaps. Which structure and acceptance check fit?","options":[{"id":"masonry-with-order-check","label":"Use masonry to pack images at their natural ratio, then check column count and reading order on mobile","feedback":"Packing removes row gaps; the visual order interleaves across columns, so confirm it stays acceptable on desktop and phone.","correct":true},{"id":"uniform-crop-grid","label":"Use a card grid and crop every cover to the same height for strict row alignment","feedback":"Uniform cropping gives tidy rows but cuts into the artwork; on an image-led wall the crop costs more than the gaps.","correct":false},{"id":"masonry-without-check","label":"Use masonry at natural ratios; if the desktop looks compact, no further check is needed","feedback":"Compactness is only half the goal; after packing, card 4 can sit above card 3, and a single phone column reorders again.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"把作品墙改成瀑布流：列宽一致，图片保持原始比例，新图片补到当前最短的列；手机收成一列。改完后用桌面和手机各检查一次：矮图下方没有整行留白，从上往下浏览时内容顺序仍然合理。","en":{"title":"You can say this to an AI Agent","text":"Change the portfolio wall to masonry: equal column widths, images keep their natural ratio, and each new image fills the shortest column; collapse to one column on phones. Then verify on desktop and mobile: no full-row gaps below short images, and the content order still makes sense when scrolling."}},"references":[{"title":"CSS 网格布局：瀑布流布局","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Grid_layout/Masonry_layout","title_en":"Masonry layout - CSS grid layout"},{"title":"多列布局的基本概念","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Multicol_layout/Basic_concepts","title_en":"Basic concepts of multi-column layouts"}],"scenes":["摄影作品墙","插画灵感流","商品封面列表","素材模板库"],"en":{"use":[{"t":"Gallery walls where photos and illustrations keep their natural ratios","m":"masonry-use-gallery"},{"t":"Inspiration and asset feeds built for continuous browsing","m":"masonry-use-feed"},{"t":"Product or case covers with inconsistent sizes that should stay compact","m":"masonry-use-cover"},{"t":"Growing collections where packing saves more height than tidy rows","m":"masonry-use-density"}],"dont":[{"t":"Content with a strict order, such as steps or timelines","m":"masonry-dont-order","bad":true},{"t":"Row-by-row comparison of similar fields, where misalignment hurts","m":"masonry-dont-compare","bad":true},{"t":"Keeping multiple columns on phones until cards become too narrow","m":"masonry-dont-mobile","bad":true},{"t":"Long-form article lists, where packing breaks continuous reading","m":"masonry-dont-text","bad":true}],"scenes":["Photography wall","Illustration feed","Product covers","Template library"],"sceneUI":["<div style=\"columns:3;column-gap:8px;max-width:560px;margin:0 auto\">\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg)\">\n        <div style=\"height:56px;background:linear-gradient(150deg,#c9cdd4,#e8eaee)\"></div>\n        <div style=\"padding:5px 8px;font-size:12px;font-weight:600\">Harbor Mist</div>\n      </div>\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg)\">\n        <div style=\"height:88px;background:linear-gradient(150deg,#a9b4c2,#d5dbe3)\"></div>\n        <div style=\"padding:5px 8px;font-size:12px;font-weight:600\">Hillside Steps</div>\n      </div>\n      <div style=\"break-inside:avoid;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg)\">\n        <div style=\"height:44px;background:linear-gradient(150deg,#d9cfc2,#eee7db)\"></div>\n        <div style=\"padding:5px 8px;font-size:12px;font-weight:600\">Still Life Study</div>\n      </div>\n      <div style=\"break-inside:avoid;mar