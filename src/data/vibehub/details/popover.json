"<div class=\"popover-anat\"><div class=\"ap\" data-ap=\"card\"><div class=\"popover-card\"><div class=\"ap\" data-ap=\"title\"><div class=\"popover-title\">通知设置</div></div><div class=\"ap\" data-ap=\"body\"><div class=\"popover-body-lines\"><i class=\"popover-line\" style=\"width:88%\"></i><i class=\"popover-line\" style=\"width:70%\"></i></div><span class=\"popover-link\">管理偏好 →</span></div></div></div><div class=\"popover-arrow\"></div><div class=\"ap\" data-ap=\"trigger\"><span class=\"icon-btn\">🔔</span></div></div>","demo_en":"<div class=\"popover-anat\"><div class=\"ap\" data-ap=\"card\"><div class=\"popover-card\"><div class=\"ap\" data-ap=\"title\"><div class=\"popover-title\">Notification settings</div></div><div class=\"ap\" data-ap=\"body\"><div class=\"popover-body-lines\"><i class=\"popover-line\" style=\"width:88%\"></i><i class=\"popover-line\" style=\"width:70%\"></i></div><span class=\"popover-link\">Manage preferences →</span></div></div></div><div class=\"popover-arrow\"></div><div class=\"ap\" data-ap=\"trigger\"><span class=\"icon-btn\">🔔</span></div></div>","parts":[{"key":"card","cn":"气泡卡片","en":"Popover","desc":"就地展开的容器，箭头指向触发源","desc_en":"A floating panel anchored to its trigger."},{"key":"title","cn":"标题","en":"Title","desc":"可选，说清这张卡片是什么","desc_en":"Optional title that states what the panel contains"},{"key":"body","cn":"内容区","en":"Content","desc":"列表、说明、链接，比 Tooltip 自由","desc_en":"It may contain lists, details, links, or controls—unlike a tooltip."},{"key":"trigger","cn":"触发元素","en":"Trigger","desc":"通过点击或悬停展开，例如头像","desc_en":"Open on click or hover, such as from an avatar"}]},"variants":[{"cn":"用户卡片","en":"User Card","demo":"<div class=\"popover-card\"><div class=\"popover-user\"><span class=\"popover-avatar\">林</span><div><div class=\"popover-title\">ans-studio</div><div class=\"popover-sub\">产品经理</div></div></div></div>","demo_en":"<div class=\"popover-card\"><div class=\"popover-user\"><span class=\"popover-avatar\">Lin</span><div><div class=\"popover-title\">maya-lee</div><div class=\"popover-sub\">Product Manager</div></div></div></div>","when":"点击头像或姓名查看身份信息","when_en":"Click on the avatar or name to view identity information"},{"cn":"筛选面板","en":"Filter","demo":"<div class=\"popover-card\"><div class=\"popover-title\">筛选状态</div><div class=\"popover-check\">☑ 进行中</div><div class=\"popover-check\">☐ 已完成</div></div>","demo_en":"<div class=\"popover-card\"><div class=\"popover-title\">Filter status</div><div class=\"popover-check\">☑ In progress</div><div class=\"popover-check\">☐ Completed</div></div>","when":"几个筛选项就地展开，不占页面位置","when_en":"When several filters can expand in place without taking up page space"},{"cn":"说明带链接","en":"With Link","demo":"<div class=\"popover-card\"><div class=\"popover-title\">快捷键</div><div class=\"popover-sub\">⌘S 保存 · ⌘P 发布</div><span class=\"popover-link\">查看全部 →</span></div>","demo_en":"<div class=\"popover-card\"><div class=\"popover-title\">Shortcut keys</div><div class=\"popover-sub\">⌘S Save · ⌘P Publish</div><span class=\"popover-link\">View all →</span></div>","when":"解释一句话不够，还要给个入口","when_en":"When a brief explanation needs a link to more detail"}],"use":[{"t":"<b>点头像看人</b>：用户信息卡，带主页入口","m":"popover-user"},{"t":"<b>轻量筛选面板</b>：几个勾选项就地展开","m":"popover-filter"},{"t":"<b>说明 + 操作链接</b>：快捷键、帮助入口","m":"popover-actions"},{"t":"<b>通知 / 设置小面板</b>：比 Tooltip 丰富，比弹窗轻","m":"tip-popover"}],"dont":[{"t":"只有一句简短说明：使用 {c:tooltip}","m":"popover-as-tip","bad":true},{"t":"内容接近半页：使用 {c:modal} 或 {c:drawer}","m":"popover-huge","bad":true},{"t":"需要用户确认操作：使用 {c:popconfirm}","m":"popconfirm-delete"},{"t":"全局性公告：使用 {c:alert} 固定在页面中","m":"alert-notice"}],"lessonPractice":{"title":"成员列表中，点击头像要就地查看部门、邮箱和两个快捷操作，手机端也要能打开。用什么方式更合适？","options":[{"id":"interactive-profile-popover","label":"使用点击或聚焦打开的气泡卡片，贴近头像并支持内部操作","feedback":"内容比一句提示丰富但仍很轻量，Popover 能保持触发关系，也能覆盖键盘和触屏。","correct":true},{"id":"hover-tooltip","label":"使用只在鼠标悬停时出现的文字提示，把两个操作写成链接","feedback":"Tooltip 不适合承载多项资料和交互，触屏设备也没有稳定的悬停入口。","correct":false},{"id":"full-profile-modal","label":"每次点击头像都打开占据大半屏的个人资料弹窗","feedback":"弹窗能放下内容，但对少量资料和两个快捷操作来说层级过重，打断当前列表浏览。","correct":false}],"en":{"title":"In a member list, clicking an avatar should reveal department, email, and two quick actions in place, including on mobile. What fits best?","options":[{"id":"interactive-profile-popover","label":"Use a popover opened by click or focus, anchored to the avatar with working actions inside","feedback":"The content is richer than a hint but still lightweight. A popover preserves context and supports keyboard and touch.","correct":true},{"id":"hover-tooltip","label":"Use a text tooltip that appears only on hover and put the two actions inside it","feedback":"Tooltips do not suit multiple details and interactive actions, and touch devices have no reliable hover entry.","correct":false},{"id":"full-profile-modal","label":"Open a profile modal that occupies most of the screen whenever the avatar is clicked","feedback":"A modal can hold the content but is too heavy for a few details and two shortcuts, interrupting list browsing.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请让成员头像通过点击和键盘聚焦打开气泡卡片，卡片贴近触发点，包含部门、邮箱和两个可操作入口。支持触屏、Escape 关闭和点击外部关闭，并确认鼠标能移入卡片操作。","en":{"title":"You can say this to an AI Agent","text":"Open a member popover from avatar click and keyboard focus. Anchor it to the trigger and include department, email, and two actionable controls. Support touch, Escape, outside-click dismissal, and pointer movement into the popover."}},"references":[{"title":"Popover API","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/API/Popover_API","title_en":"Popover API"}],"scenes":["头像用户卡片","表头筛选","快捷键说明","通知设置面板"],"en":{"use":[{"t":"Show a profile preview","m":"popover-user"},{"t":"Explain a chart point","m":"popover-filter"},{"t":"Offer a few contextual controls","m":"popover-actions"},{"t":"Display compact supporting content","m":"tip-popover"}],"dont":[{"t":"Put essential information only behind hover","m":"popover-as-tip","bad":true},{"t":"Build a long form inside a small floating panel","m":"popover-huge","bad":true},{"t":"Open it without a clear anchor","m":"popconfirm-delete"},{"t":"Let it cover the control needed to close it","m":"alert-notice"}],"scenes":["Profile preview","Chart details","Formatting controls","Context help"],"sceneUI":["<div class=\"popover-scene\">\n      <div style=\"display:flex;align-items:center;gap:8px;background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:7px 12px\">\n        <b style=\"font-size:13px;color:var(--text);flex:1\">Project workspace</b>\n        <span class=\"icon-btn\">🔔</span>\n        <img src=\"/assets/avatar-fox.png\" style=\"width:26px;height:26px;border-radius:50%\" alt=\"\">\n      </div>\n      <div style=\"align-self:flex-end;display:flex;flex-direction:column;align-items:center;margin:6px 8px 0\">\n        <div class=\"popover-arrow-up\"></div>\n        <div class=\"popover-card\" style=\"width:200px\">\n          <div class=\"popover-user\"><img src=\"/assets/avatar-fox.png\" style=\"width:30px;height:30px;border-radius:50%\" alt=\"\"><div><div class=\"popover-title\">Alex Chen</div><div class=\"popover-sub\">Product Manager · Shenzhen</div></div></div>\n          <span class=\"popover-link\">View profile →</span>\n        </div>\n      </div>\n    </div>","<div class=\"popover-scene\">\n      <div style=\"display:flex;gap:22px;background:var(--bg);border:1px solid var(--border-light);border-radius:8px 8px 0 0;padding:8px 12px;font-size:12px;color:var(--text-3)\">\n        <span style=\"flex:1\">Name</span><span>Owner</span><span style=\"color:var(--brand);font-weight:600\">Status ▾</span>\n      </div>\n      <div style=\"align-self:flex-end;display:flex;flex-direction:column;align-items:center;margin-right:6px\">\n        <div class=\"popover-arrow-up\"></div>\n        <div class=\"popover-card\" style=\"width:150px;padding:10px 12px;gap:5px\">