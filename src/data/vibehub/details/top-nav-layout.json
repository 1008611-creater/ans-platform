nd);text-align:center\">max-width: 1120px · margin: 0 auto</span><i class=\"mk-line\" style=\"width:62%;margin:0 auto\"></i><i class=\"mk-line\" style=\"width:48%;margin:0 auto\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">内容定宽居中，两侧留白</span>","topnav-sticky":"<div class=\"mk-scene\"><span style=\"position:absolute;top:0;left:0;right:0;height:14px;background:var(--bg);border-bottom:1px solid var(--border);z-index:2;display:flex;align-items:center;padding:0 6px;font-size:11px;color:var(--text-2)\">顶栏 · position: sticky</span><div class=\"mk-skel\" style=\"top:6px\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:65%\"></i><i class=\"mk-line\" style=\"width:72%\"></i></div></div><span style=\"font-size:12px;color:var(--text-3)\">滚多远，导航都在手边</span>","btn-primary-one":"<div class=\"mk-win\"><div class=\"mk-row between\"><i class=\"mk-line\" style=\"width:40%\"></i><span style=\"flex:1\"></span><span class=\"mk-btn primary\">新建项目</span></div><i class=\"mk-line\" style=\"width:90%\"></i><i class=\"mk-line\" style=\"width:70%\"></i></div>","topnav-cram":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"gap:3px\"><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">首页</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">产品</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">方案</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">文档</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">博客</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">定价</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">关于</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">招聘</span><span style=\"padding:1px 5px;border:1px solid var(--red);border-radius:3px;background:var(--bg);font-size:12px;color:var(--text-2);white-space:nowrap\">活动</span></div></div><span style=\"font-size:12px;color:var(--text-3)\">入口过多，顶栏在较窄宽度下换行</span>","topnav-fullwidth":"<div class=\"mk-win\"><i class=\"mk-line\" style=\"width:100%\"></i><i class=\"mk-line\" style=\"width:100%\"></i><i class=\"mk-line\" style=\"width:97%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">宽屏内容未限宽，行长过长影响阅读</span>","menu-crowded":"<div class=\"mk-row\"><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">仪表盘</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">项目</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">任务</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">文件</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">成员</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">日程</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">报表</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">消息</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">设置</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">回收站</span></div><span style=\"font-size:12px;color:var(--red)\">入口全部平铺，主次层级无法辨认</span>","topnav-flat":"<div class=\"mk-win\" style=\"padding:0;overflow:hidden;gap:0\"><span style=\"display:block;background:var(--bg-hover);padding:5px 8px;font-size:12px;color:var(--text-3)\">顶栏与正文底色相同</span><span style=\"display:block;background:var(--bg-hover);padding:5px 8px;font-size:12px;color:var(--text-3)\">缺少视觉分层</span></div><span style=\"font-size:12px;color:var(--text-3)\">使用底色或分割线区分顶栏与内容</span>"}}}