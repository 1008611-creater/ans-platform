{"__formatVersion":2,"__revision":"0146c1be2cb87342","__entryId":"animation","entry":{"sceneUI":["<div>\n      <div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:10px\">\n          <span style=\"width:28px;height:28px;border-radius:50%;background:#e9eaee;flex:none\"></span>\n          <div style=\"flex:1\"><i class=\"mk-line\" style=\"width:45%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:28%\"></i></div>\n        </div>\n        <i class=\"mk-line\" style=\"width:100%;margin-bottom:7px;opacity:.95\"></i>\n        <i class=\"mk-line\" style=\"width:92%;margin-bottom:7px;opacity:.6\"></i>\n        <i class=\"mk-line\" style=\"width:64%;opacity:.35\"></i>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:10px\">@keyframes 呼吸：透明度 0.4 ↔ 1 循环，告诉用户“正在加载”</div>\n    </div>","<div>\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 14px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:10px\">\n        <img src=\"/assets/avatar-robot.png\" style=\"width:30px;height:30px;border-radius:50%\" alt=\"\">\n        <div style=\"flex:1\">\n          <div style=\"font-size:12px;font-weight:600\">AI 助手</div>\n          <div style=\"font-size:12px;color:var(--text-3)\">正在生成回复，大约需要 5 秒…</div>\n        </div>\n        <span class=\"mk-spinner\" style=\"width:18px;height:18px\"></span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:10px\">animation: rotate 0.8s infinite，一直转到数据回来</div>\n    </div>","<div>\n      <div style=\"display:flex;gap:10px;justify-content:center\">\n        <div style=\"width:96px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow-card)\">\n          <div style=\"font-size:12px;color:var(--text-3)\">访问量</div>\n          <div style=\"font-size:15px;font-weight:700\">12,480</div>\n          <div style=\"font-size:12px;color:var(--green)\">▲ 8.2%</div>\n        </div>\n        <div style=\"width:96px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow-card);opacity:.65;transform:translateY(5px)\">\n          <div style=\"font-size:12px;color:var(--text-3)\">新用户</div>\n          <div style=\"font-size:15px;font-weight:700\">326</div>\n          <div style=\"font-size:12px;color:var(--green)\">▲ 3.1%</div>\n        </div>\n        <div style=\"width:96px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow-card);opacity:.3;transform:translateY(10px)\">\n          <div style=\"font-size:12px;color:var(--text-3)\">转化率</div>\n          <div style=\"font-size:15px;font-weight:700\">4.6%</div>\n          <div style=\"font-size:12px;color:var(--red)\">▼ 0.4%</div>\n        </div>\n      </div>\n      <div style=\"display:flex;gap:10px;justify-content:center;margin-top:6px;font-size:12px;color:var(--text-3)\">\n        <span style=\"width:96px;text-align:center\">animation-delay: 0ms</span><span style=\"width:96px;text-align:center\">animation-delay: 100ms</span><span style=\"width:96px;text-align:center\">animation-delay: 200ms</span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:8px\">animation-delay 依次入场，页面有节奏地“亮”起来</div>\n    </div>","<div>\n      <div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:6px 12px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;align-items:center;gap:10px;padding:8px;border-radius:6px;background:var(--brand-light)\">\n          <img src=\"/assets/avatar-fox.png\" style=\"width:24px;height:24px;border-radius:50%\" alt=\"\">\n          <div style=\"flex:1;font-size:12px\"><b>新回复</b> 已加入列表，并通过短暂入场动效标出变化</div>\n          <span class=\"demo-tag blue\">新</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:10px;padding:8px\">\n          <img src=\"/assets/avatar-robot.png\" style=\"width:24px;height:24px;border-radius:50%\" alt=\"\">\n          <div style=\"flex:1;font-size:12px;color:var(--text-2)\"><b>机器人助理</b> 赞了你的文章</div>\n          <span style=\"font-size:12px;color:var(--text-3)\">1 小时前</span>\n        </div>\n      </div>\n      <div style=\"display:flex;align-items:center;justify-content:center;gap:6px;margin-top:8px;font-size:12px;color:var(--text-3)\">\n        背景高亮闪一次\n        <span style=\"width:14px;height:14px;border-radius:3px;background:var(--brand-light)\"></span>→\n        <span style=\"width:14px;height:14px;border-radius:3px;background:var(--brand-light);opacity:.5\"></span>→\n        <span style=\"width:14px;height:14px;border-radius:3px;background:var(--bg);border:1px solid var(--border)\"></span>\n        停在末帧，不循环\n      </div>\n    </div>"],"sceneUI_en":["<div>\n      <div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:10px\">\n          <span style=\"width:28px;height:28px;border-radius:50%;background:#e9eaee;flex:none\"></span>\n          <div style=\"flex:1\"><i class=\"mk-line\" style=\"width:45%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:28%\"></i></div>\n        </div>\n        <i class=\"mk-line\" style=\"width:100%;margin-bottom:7px;opacity:.95\"></i>\n        <i class=\"mk-line\" style=\"width:92%;margin-bottom:7px;opacity:.6\"></i>\n        <i class=\"mk-line\" style=\"width:64%;opacity:.35\"></i>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:10px\">@keyframes breathing: transparency 0.4 ↔ 1 loop, telling the user \"loading\"</div>\n    </div>","<div>\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 14px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:10px\">\n        <img src=\"/assets/avatar-robot.png\" style=\"width:30px;height:30px;border-radius:50%\" alt=\"\">\n        <div style=\"flex:1\">\n          <div style=\"font-size:12px;font-weight:600\">AI Assistant</div>\n          <div style=\"font-size:12px;color:var(--text-3)\">Generating reply, will take about 5 seconds...</div>\n        </div>\n        <span class=\"mk-spinner\" style=\"width:18px;height:18px\"></span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:10px\">animation: rotate 0.8s infinite, until the data comes back</div>\n    </div>","<div>\n      <div style=\"display:flex;gap:10px;justify-content:center\">\n        <div style=\"width:96px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow-card)\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Visits</div>\n          <div style=\"font-size:15px;font-weight:700\">12,480</div>\n          <div style=\"font-size:12px;color:var(--green)\">▲ 8.2%</div>\n        </div>\n        <div style=\"width:96px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow-card);opacity:.65;transform:translateY(5px)\">\n          <div style=\"font-size:12px;color:var(--text-3)\">New user</div>\n          <div style=\"font-size:15px;font-weight:700\">326</div>\n          <div style=\"font-size:12px;color:var(--green)\">▲ 3.1%</div>\n        </div>\n        <div style=\"width:96px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow-card);opacity:.3;transform:translateY(10px)\">\n          <div style=\"font-size:12px;color:var(--text-3)\">Conversion rate</div>\n          <div style=\"font-size:15px;font-weight:700\">4.6%</div>\n          <div style=\"font-size:12px;color:var(--red)\">▼ 0.4%</div>\n        </div>\n      </div>\n      <div style=\"display:flex;gap:10px;justify-content:center;margin-top:6px;font-size:12px;color:var(--text-3)\">\n        <span style=\"width:96px;text-align:center\">animation-delay: 0ms</span><span style=\"width:96px;text-align:center\">animation-delay: 100ms</span><span style=\"width:96px;text-align:center\">animation-delay: 200ms</span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:8px\">animation-delay enters the scene one by one, and the page \"lights up\" rhythmically</div>\n    </div>","<div>\n      <div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:6px 12px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;align-items:center;gap:10px;padding:8px;border-radius:6px;background:var(--brand-light)\">\n          <img src=\"/assets/avatar-fox.png\" style=\"width:24px;height:24px;border-radius:50%\" alt=\"\">\n          <div style=\"flex:1;font-size:12px\"><b>New reply</b> has been added to the list and the changes are marked with a short entry animation</div>\n          <span class=\"demo-tag blue\">New</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:10px;padding:8px\">\n          <img src=\"/assets/avatar-robot.png\" style=\"width:24px;height:24px;border-radius:50%\" alt=\"\">\n          <div style=\"flex:1;font-size:12px;color:var(--text-2)\"><b>Robot Assistant</b> liked your article</div>\n          <span style=\"font-size:12px;color:var(--text-3)\">1 hour ago</span>\n        </div>\n      </div>\n      <div style=\"display:flex;align-items:center;justify-content:center;gap:6px;margin-top:8px;font-size:12px;color:var(--text-3)\">\n        Background highlight flashes once\n        <span style=\"width:14px;height:14px;border-radius:3px;background:var(--brand-light)\"></span>→\n        <span style=\"width:14px;height:14px;border-radius:3px;background:var(--brand-light);opacity:.5\"></span>→\n        <span style=\"width:14px;height:14px;border-radius:3px;background:var(--bg);border:1px solid var(--border)\"></span>\n        Stop at the last frame, no loop\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"anim-anat\"><span class=\"ap\" data-ap=\"keyframes\"><span class=\"anim-anat-tl\"><i class=\"anim-anat-node\">0%</i><i class=\"anim-anat-bar\"></i><i class=\"anim-anat-node\">100%</i></span></span><span class=\"ap\" data-ap=\"duration\"><span class=\"anim-anat-tag\">2s</span></span><span class=\"ap\" data-ap=\"timing\"><span class=\"anim-anat-tag\">ease-in-out</span></span><span class=\"ap\" data-ap=\"iteration\"><span class=\"anim-anat-tag\">infinite ⟳</span></span></span>","demo_en":"<span class=\"anim-anat\"><span class=\"ap\" data-ap=\"keyframes\"><span class=\"anim-anat-tl\"><i class=\"anim-anat-node\">0%</i><i class=\"anim-anat-bar\"></i><i class=\"anim-anat-node\">100%</i></span></span><span class=\"ap\" data-ap=\"duration\"><span class=\"anim-anat-tag\">2s</span></span><span class=\"ap\" data-ap=\"timing\"><span class=\"anim-anat-tag\">ease-in-out</span></span><span class=\"ap\" data-ap=\"iteration\"><span class=\"anim-anat-tag\">infinite ⟳</span></span></span>","parts":[{"key":"keyframes","cn":"关键帧","en":"Keyframes","desc":"动作的节点，中间帧由浏览器补齐","desc_en":"The node of the action, the intermediate frame is completed by the browser"},{"key":"duration","cn":"时长","en":"Duration","desc":"完整播一遍要多久","desc_en":"How long does it take to play it all?"},{"key":"timing","cn":"速度曲线","en":"Timing","desc":"每一帧之间的快慢，见缓动","desc_en":"The speed between each frame, see easing"},{"key":"iteration","cn":"播放次数","en":"Iteration","desc":"1 次入场，infinite 循环","desc_en":"1 entry, infinite cycle"}]},"variants":[{"cn":"一次性","en":"Once","demo":"<span class=\"anim-v-track\"><i class=\"anim-v-ball\" style=\"left:78%\"></i></span>","demo_en":"<span class=\"anim-v-track\"><i class=\"anim-v-ball\" style=\"left:78%\"></i></span>","when":"入场编排，播完停在末帧","when_en":"Entry arrangement, stop at the last frame after playing"},{"cn":"无限循环","en":"Infinite","demo":"<span class=\"anim-v-loop\">⟳</span>","demo_en":"<span class=\"anim-v-loop\">⟳</span>","when":"加载、呼吸等持续状态","when_en":"Continuous states such as loading and breathing"},{"cn":"交替往返","en":"Alternate","demo":"<span class=\"anim-v-track\"><i class=\"anim-v-ball\" style=\"left:38%\"></i><span class=\"anim-v-arr\">↔</span></span>","demo_en":"<span class=\"anim-v-track\"><i class=\"anim-v-ball\" style=\"left:38%\"></i><span class=\"anim-v-arr\">↔</span></span>","when":"摆动闪烁这类往复动作","when_en":"Reciprocating motions such as swinging and flashing"}],"use":[{"t":"<b>加载类循环</b>：{c:progress}、{c:skeleton} 的呼吸与转动","m":"pg-loading"},{"t":"<b>关键帧编排</b>：把一段完整动作拆成节点，浏览器补齐中间","m":"anim-keyframes"},{"t":"<b>入场编排</b>：多个元素用 delay 依次出场，有节奏感","m":"anim-sequence"},{"t":"状态切换用{c:transition}，自主播放的多阶段动作再用动画","m":"anim-vs-trans"}],"dont":[{"t":"<b>过度使用循环动画</b>：会分散注意力并影响阅读","m":"anim-loop","bad":true},{"t":"简单悬停效果不必使用关键帧，过渡就能完成","m":"anim-overkill","bad":true},{"t":"未设置 <b>fill-mode: forwards</b>：动画结束后会回到初始帧","m":"anim-fillmode","bad":true},{"t":"响应 prefers-reduced-motion，减少用户不需要的动画","m":"anim-motion","bad":true}],"lessonPractice":{"title":"加载图标需要持续旋转，完成后停止；用户开启“减少动态效果”后，图标也不应持续旋转。怎样实现更合适？","options":[{"id":"stateful-reduced-animation","label":"用关键帧控制旋转，由加载状态启停，并为减少动态效果提供静态反馈","feedback":"自主循环适合 Animation，界面状态决定播放范围，减弱方案保留信息而不强迫持续运动。","correct":true},{"id":"transition-without-state-change","label":"只设置 transition，让图标在没有属性变化时自动持续旋转","feedback":"Transition 需要属性状态发生变化才能运行，不能独立定义连续循环。","correct":false},{"id":"permanent-decorative-loop","label":"让图标在加载结束后继续循环，作为页面保持活力的装饰","feedback":"完成后持续运动不再表达加载状态，只会分散注意力并违背减少动态效果偏好。","correct":false}],"en":{"title":"A loading icon spins continuously and stops when complete. Under reduced motion, it should not keep spinning. What is the right approach?","options":[{"id":"stateful-reduced-animation","label":"Use keyframes, start and stop from loading state, and provide static feedback under reduced motion","feedback":"Autonomous looping suits Animation, state defines its lifetime, and the reduced version preserves information without forced motion.","correct":true},{"id":"transition-without-state-change","label":"Use only transition and make the icon rotate continuously without any property change","feedback":"A transition requires a property state change and cannot independently define a continuous loop.","correct":false},{"id":"permanent-decorative-loop","label":"Keep the icon looping after loading so the page continues to feel active","feedback":"Motion after completion no longer communicates loading, distracts attention, and ignores reduced-motion preference.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请用 keyframes 实现加载图标旋转，只在 loading 状态播放，成功或失败后立即停止并显示对应结果。支持 prefers-reduced-motion，用静态图标或较弱反馈替代循环；不要把装饰动画永久留在页面。","en":{"title":"You can say this to an AI Agent","text":"Implement the loading spinner with keyframes only while loading. Stop immediately on success or failure and show the resulting state. Under prefers-reduced-motion, use static or weaker feedback, and leave no permanent decorative loop."}},"references":[{"title":"animation 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/animation","title_en":"animation"}],"scenes":["骨架屏呼吸循环","加载指示器旋转","页面入场编排","一次性强调闪烁"],"en":{"use":[{"t":"Loading indicator","m":"pg-loading"},{"t":"Onboarding explanation","m":"anim-keyframes"},{"t":"Attention to a new but important event","m":"anim-sequence"},{"t":"A multi-stage visual sequence","m":"anim-vs-trans"}],"dont":[{"t":"Loop decorative motion near reading content","m":"anim-loop","bad":true},{"t":"Delay a task until an animation finishes","m":"anim-overkill","bad":true},{"t":"Use movement that conflicts with the interface state","m":"anim-fillmode","bad":true},{"t":"Ignore performance and reduced-motion preferences","m":"anim-motion","bad":true}],"scenes":["Loading","Success state","Feature tour","Data update"],"sceneUI":["<div>\n      <div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:10px\">\n          <span style=\"width:28px;height:28px;border-radius:50%;background:#e9eaee;flex:none\"></span>\n          <div style=\"flex:1\"><i class=\"mk-line\" style=\"width:45%;margin-bottom:6px\"></i><i class=\"mk-line\" style=\"width:28%\"></i></div>\n        </div>\n        <i class=\"mk-line\" style=\"width:100%;margin-bottom:7px;opacity:.95\"></i>\n        <i class=\"mk-line\" style=\"width:92%;margin-bottom:7px;opacity:.6\"></i>\n        <i class=\"mk-line\" style=\"width:64%;opacity:.35\"></i>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:10px\">@keyframes breathing: transparency 0.4 ↔ 1 loop, telling the user \"loading\"</div>\n    </div>","<div>\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 14px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:10px\">\n        <img src=\"/assets/avatar-robot.png\" style=\"width:30px;height:30px;border-radius:50%\" alt=\"\">\n        <div style=\"flex:1\">\n          <div style=\"font-size:12px;font-weight:600\">AI Assistant</div>\n          <div style=\"font-size:12px;color:var(--text-3)\">Generating reply, will take about 5 seconds...</div>\n        </div>\n        <span class=\"mk-spinner\" style=\"width:18px;height:18px\"></span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);text-align:center;margin-top:10px\">ani