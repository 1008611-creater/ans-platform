{"__formatVersion":2,"__revision":"9dbbd683b963630b","__entryId":"serif-sans","entry":{"sceneUI":["<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-family:var(--font-serif);font-size:14px;font-weight:700;color:var(--text)\">屿光家具</span>\n        <span style=\"margin-left:auto;font-size:12px;color:var(--text-3)\">产品　灵感　关于</span>\n      </div>\n      <div style=\"padding:14px\">\n        <div style=\"font-family:var(--font-serif);font-size:22px;font-weight:700;line-height:1.3;color:var(--text)\">把北欧的光，<br>搬进你的客厅</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin:6px 0 10px\">2026 春夏系列现已上架，全实木手作。</div>\n        <button class=\"btn btn-primary\">浏览系列</button>\n      </div>\n    </div>","<div style=\"display:flex;gap:10px\">\n      <div style=\"flex:1.4;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px\">\n        <div style=\"font-family:var(--font-serif);font-size:15px;font-weight:700;line-height:1.4;color:var(--text)\">巷口那家面包店，为什么排队十年</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin:4px 0 8px\">美食周刊 · 林小满 · 12 分钟前</div>\n        <i class=\"mk-line\" style=\"width:100%\"></i><i class=\"mk-line\" style=\"width:92%;margin-top:6px\"></i><i class=\"mk-line\" style=\"width:64%;margin-top:6px\"></i>\n      </div>\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:8px\">\n        <span style=\"font-size:12px;color:var(--text-2)\"><b style=\"font-family:var(--font-serif);color:var(--text)\">编辑部精选</b></span>\n        <span style=\"font-family:var(--font-serif);font-size:12px;color:var(--text);line-height:1.4\">凌晨四点的城市档案馆</span>\n        <span style=\"font-family:var(--font-serif);font-size:12px;color:var(--text);line-height:1.4\">手冲咖啡的黄金两分钟</span>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;max-width:320px;margin:0 auto\">\n      <div style=\"font-size:14px;font-weight:600;color:var(--text);margin-bottom:12px\">项目设置</div>\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:4px\">项目名称</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" value=\"官网改版 v2\">\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:4px\">负责人</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:12px\" value=\"林小满\">\n      <div style=\"display:flex;justify-content:flex-end;gap:8px\"><button class=\"btn btn-outline\">取消</button><button class=\"btn btn-primary\">保存</button></div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px\">\n      <div style=\"font-size:12px;line-height:1.7;color:var(--text-2)\">我们做工具的人常忘记：用户要的不是功能清单，而是把事情做完的确定感。</div>\n      <div style=\"border-left:3px solid var(--brand);background:var(--bg-soft);border-radius:0 8px 8px 0;padding:10px 12px;margin:10px 0\">\n        <span style=\"font-family:var(--font-serif);font-size:14px;line-height:1.5;color:var(--text)\">“好的设计是尽可能少的设计。”</span>\n        <span style=\"display:block;font-size:12px;color:var(--text-3);margin-top:4px\">—— Dieter Rams</span>\n      </div>\n      <div style=\"font-size:12px;line-height:1.7;color:var(--text-2)\">添加按钮前，先确认它是否对应用户需要完成的明确操作。</div>\n    </div>"],"sceneUI_en":["<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-family:var(--font-serif);font-size:14px;font-weight:700;color:var(--text)\">Norr Home</span>\n        <span style=\"margin-left:auto;font-size:12px;color:var(--text-3)\">Shop　Stories　About</span>\n      </div>\n      <div style=\"padding:14px\">\n        <div style=\"font-family:var(--font-serif);font-size:22px;font-weight:700;line-height:1.3;color:var(--text)\">Bring Nordic light<br>into your living room</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin:6px 0 10px\">The 2026 Spring/Summer collection is live — solid wood, handmade.</div>\n        <button class=\"btn btn-primary\">Explore the Collection</button>\n      </div>\n    </div>","<div style=\"display:flex;gap:10px\">\n      <div style=\"flex:1.4;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px\">\n        <div style=\"font-family:var(--font-serif);font-size:15px;font-weight:700;line-height:1.4;color:var(--text)\">The corner bakery with a ten-year line</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin:4px 0 8px\">Food Weekly · Maya Lin · 12 min ago</div>\n        <i class=\"mk-line\" style=\"width:100%\"></i><i class=\"mk-line\" style=\"width:92%;margin-top:6px\"></i><i class=\"mk-line\" style=\"width:64%;margin-top:6px\"></i>\n      </div>\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:8px\">\n        <span style=\"font-size:12px;color:var(--text-2)\"><b style=\"font-family:var(--font-serif);color:var(--text)\">Editor's Picks</b></span>\n        <span style=\"font-family:var(--font-serif);font-size:12px;color:var(--text);line-height:1.4\">The City Archive at 4 A.M.</span>\n        <span style=\"font-family:var(--font-serif);font-size:12px;color:var(--text);line-height:1.4\">The Golden Two Minutes of Pour-Over</span>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;max-width:320px;margin:0 auto\">\n      <div style=\"font-size:14px;font-weight:600;color:var(--text);margin-bottom:12px\">Project Settings</div>\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:4px\">Project Name</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" value=\"Website Revamp v2\">\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:4px\">Owner</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:12px\" value=\"Maya Lin\">\n      <div style=\"display:flex;justify-content:flex-end;gap:8px\"><button class=\"btn btn-outline\">Cancel</button><button class=\"btn btn-primary\">Save</button></div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px\">\n      <div style=\"font-size:12px;line-height:1.7;color:var(--text-2)\">Tool builders often forget: users don't want a feature list — they want the certainty of getting things done.</div>\n      <div style=\"border-left:3px solid var(--brand);background:var(--bg-soft);border-radius:0 8px 8px 0;padding:10px 12px;margin:10px 0\">\n        <span style=\"font-family:var(--font-serif);font-size:14px;line-height:1.5;color:var(--text)\">“Good design is as little design as possible.”</span>\n        <span style=\"display:block;font-size:12px;color:var(--text-3);margin-top:4px\">—— Dieter Rams</span>\n      </div>\n      <div style=\"font-size:12px;line-height:1.7;color:var(--text-2)\">So before adding a button, ask first: what if it weren't there?</div>\n    </div>"],"anatomy":{"demo":"<span class=\"serif-anat\"><span class=\"ap\" data-ap=\"serif\"><span class=\"serif-anat-l serif-serif-f\">Ag</span></span><span class=\"ap\" data-ap=\"stroke\"><span class=\"serif-anat-note\">衬线字体：横细竖粗，末端带小脚</span></span><span class=\"ap\" data-ap=\"sans\"><span class=\"serif-anat-l\">Ag</span></span></span>","demo_en":"<span class=\"serif-anat\"><span class=\"ap\" data-ap=\"serif\"><span class=\"serif-anat-l serif-serif-f\">Ag</span></span><span class=\"ap\" data-ap=\"stroke\"><span class=\"serif-anat-note\">Serif font: thin horizontally and thick vertically, with small feet at the end</span></span><span class=\"ap\" data-ap=\"sans\"><span class=\"serif-anat-l\">Ag</span></span></span>","parts":[{"key":"serif","cn":"衬线","en":"Serif","desc":"笔画末端的小装饰，优雅感来自这里","desc_en":"The small finishing strokes at the ends of letters — where the elegance comes from"},{"key":"stroke","cn":"笔画对比","en":"Contrast","desc":"衬线字体横细竖粗，有书写感","desc_en":"Serif type pairs thin horizontals with thick verticals, echoing handwriting"},{"key":"sans","cn":"非衬线","en":"Sans-serif","desc":"去掉装饰、粗细一致，干净现代","desc_en":"No decoration, even strokes — clean and modern"}]},"variants":[{"cn":"衬线大标题","en":"Serif Display","demo":"<span class=\"serif-v serif-serif-f\" style=\"font-size:18px;font-weight:700;color:var(--text)\">品牌故事</span>","demo_en":"<span class=\"serif-v serif-serif-f\" style=\"font-size:18px;font-weight:700;color:var(--text)\">Our Story</span>","when":"品牌页、内容站要优雅编辑感","when_en":"Brand and content pages that want an elegant, editorial feel"},{"cn":"非衬线正文","en":"Sans Body","demo":"<span class=\"serif-v\" style=\"font-size:12px;color:var(--text-2);line-height:1.7;max-width:120px\">界面正文用系统字体，干净高效读得快。</span>","demo_en":"<span class=\"serif-v\" style=\"font-size:12px;color:var(--text-2);line-height:1.7;max-width:120px\">Body copy set in the system font: clean, efficient, quick to read.</span>","when":"界面正文，现代干净又高效","when_en":"UI body copy — modern, clean, and efficient"},{"cn":"衬线点缀引文","en":"Serif Quote","demo":"<span class=\"serif-v serif-serif-f\" style=\"font-size:12px;color:var(--text-2)\">“细节里藏着气质。”</span>","demo_en":"<span class=\"serif-v serif-serif-f\" style=\"font-size:12px;color:var(--text-2)\">“Character hides in the details.”</span>","when":"引文格言做点缀，少量提神","when_en":"A sparing accent for quotes and mottos"}],"use":[{"t":"为<b>标题与正文分别测试</b>：衬线可用于展示性标题，前提是语言覆盖、尺寸和品牌语境合适","m":"serif-headline"},{"t":"需要正式或编辑感时，<b>用样张对照</b>：字体不会天然证明可信，信息层级、内容和品牌同样重要","m":"serif-trust"},{"t":"为<b>界面与正文选可读字体</b>：非衬线常见，但衬线同样可能适合；重点测试字号、行高、字重和语言覆盖","m":"serif-ui-sans"},{"t":"引文或强调内容可用<b>不同字族形成层级</b>，但要保持规则一致并验证可读性","m":"serif-quote"}],"dont":[{"t":"长正文使用<b>小字号衬线</b>：细节容易模糊，影响阅读","m":"serif-body-bad","bad":true},{"t":"效率工具使用<b>衬线大标题</b>：应先确认它与产品调性和阅读效率相符","m":"serif-mismatch","bad":true},{"t":"衬线只写 Georgia <b>未提供中文 fallback</b>：中文会回退为浏览器默认字体","m":"serif-fallback","bad":true},{"t":"同级标题<b>混用衬线与非衬线</b>：应建立明确的使用规则","m":"serif-mess","bad":true}],"lessonPractice":{"title":"双语杂志网站想用衬线标题和非衬线正文，英文样张很好看，但中文会回退成浏览器默认字体。下一步怎样做？","options":[{"id":"test-covered-font-system","label":"选择覆盖中英文的字体和回退方案，用真实样张测试","feedback":"字体风格只有在语言覆盖、字号、字重和行高都可用时才成立，fallback 也应纳入系统。","correct":true},{"id":"english-font-only","label":"只指定英文字体名称，中文继续交给各个浏览器自动选择回退","feedback":"中文回退不受设计控制，双语页面可能出现字重、比例和气质明显不一致。","correct":false},{"id":"mix-by-section","label":"每个同级标题分别挑最有感觉的衬线或非衬线字体","feedback":"没有角色规则的混用会让同一层级失去一致性，也难以维护加载和回退。","correct":false}],"en":{"title":"A bilingual editorial site wants serif headings and sans-serif body text. English samples work, but Chinese falls back to browser defaults. What comes next?","options":[{"id":"test-covered-font-system","label":"Choose bilingual fonts and fallbacks, then test them with real copy","feedback":"The style only works when coverage, size, weight, and line-height remain readable, and fallback is part of the system.","correct":true},{"id":"english-font-only","label":"Specify only the English font and let each browser choose its own Chinese fallback","feedback":"Uncontrolled fallback can create visibly different weight, proportion, and tone across the bilingual page.","correct":false},{"id":"mix-by-section","label":"Choose whichever serif or sans font feels best for each heading at the same level","feedback":"Role-free mixing breaks hierarchy consistency and makes font loading and fallback difficult to maintain.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请建立双语字体规则：标题使用覆盖中英文的衬线字体或明确 fallback，正文使用可读的非衬线字体。同级元素保持一致，并用真实中文、英文、数字和粗体测试加载失败后的回退效果。","en":{"title":"You can say this to an AI Agent","text":"Create bilingual font rules: use a serif with Chinese coverage or an explicit fallback for headings and a readable sans-serif for body text. Keep peer roles consistent and test real Chinese, English, numerals, bold text, and load failure."}},"references":[{"title":"排版术语表","source":"NN/g","url":"https://www.nngroup.com/articles/typography-terms-ux/","title_en":"Typography Terms: Glossary"}],"scenes":["品牌官网大标题","杂志与内容平台","产品界面与正文","引文与格言点缀"],"en":{"use":[{"t":"Set a clear tone for headings","m":"serif-headline"},{"t":"Choose a comfortable body typeface","m":"serif-trust"},{"t":"Pair two families with distinct roles","m":"serif-ui-sans"},{"t":"Test Chinese and Latin text together when both appear","m":"serif-quote"}],"dont":[{"t":"Choose a font only because of a style label","m":"serif-body-bad","bad":true},{"t":"Mix several families without clear roles","m":"serif-mismatch","bad":true},{"t":"Use a display face for long body text","m":"serif-fallback","bad":true},{"t":"Assume one family renders every language equally well","m":"serif-mess","bad":true}],"scenes":["Editorial article","Product interface","Brand homepage","Bilingual content"],"sceneUI":["<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-family:var(--font-serif);font-size:14px;font-weight:700;color:var(--text)\">Norr Home</span>\n        <span style=\"margin-left:auto;font-size:12px;color:var(--text-3)\">Shop　Stories　About</span>\n      </div>\n      <div style=\"padding:14px\">\n        <div style=\"font-family:var(--font-serif);font-size:22px;font-weight:700;line-height:1.3;color:var(--text)\">Bring Nordic light<br>into your living room</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin:6px 0 10px\">The 2026 Spring/Summer collection is live — solid wood, handmade.</div>\n        <button class=\"btn btn-primary\">Explore the Collection</button>\n      </div>\n    </div>","<div style=\"display:flex;gap:10px\">\n      <div style=\"flex:1.4;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px\">\n        <div style=\"font-family:var(--font-serif);font-size:15px;font-weight:700;line-height:1.4;color:var(--text)\">The corner bakery with a ten-year line</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin:4px 0 8px\">Food Weekly · Maya Lin · 12 min ago</div>\n        <i class=\"mk-line\" style=\"width:100%\"></i><i class=\"mk-line\" style=\"width:92%;margin-top:6px\"></i><i class=\"mk-line\" style=\"width:64%;margin-top:6px\"></i>\n      </div>\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:8px\">\n        <span style=\"font-size:12px;color:var(--text-2)\"><b style=\"font-family:var(--font-serif);color:var(--text)\">Editor's Picks</b></span>\n        <span style=\"font-family:var(--font-serif);font-size:12px;color:var(--text);line-height:1.4\">The City Archive at 4 A.M.</span>\n        <span style=\"font-family:var(--font-serif);font-size:12px;color:var(--text);line-height:1.4\">The Golden Two Minutes of Pour-Over</span>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;max-width:320px;margin:0 auto\">\n      <div style=\"font-size:14px;font-weight:600;color:var(--text);margin-bottom:12px\">Project Settings</div>\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:4px\">Project Name</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" value=\"Website Revamp v2\">\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:4px\">Owner</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:12px\" value=\"Maya Lin\">\n      <div style=\"display:flex;justify-content:flex-end;gap:8px\"><button class=\"btn btn-outline\">Cancel</button><button class=\"btn btn-primary\">Save</button></div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px\">\n      <div style=\"font-size:12px;line-height:1.7;color:var(--text-2)\">Tool builders often forget: users don't want a feature list — they want the certainty of getting things done.</div>\n      <div style=\"border-left:3px solid var(--brand);background:var(--bg-soft);border-radius:0 8px 8px 0;padding:10px 12px;margin:10px 0\">\n        <span style=\"font-family:var(--font-serif);font-size:14px;line-height:1.5;color:var(--text)\">“Good design is as little design as possible.”</span>\n        <span style=\"display:block;font-size:12px;color:var(--text-3);margin-top:4px\">—— Dieter Rams</span>\n      </div>\n      <div style=\"font-size:12px;line-height:1.7;color:var(--text-2)\">So before adding a button, ask first: what if it weren't there?</div>\n    </div>"]},"usageMocks":{"serif-headline":"<div class=\"mk-win\"><span style=\"font-family:Georgia,'Songti SC',serif;font-size:14px;font-weight:700;color:var(--text)\">设计的气质</span><i class=\"mk-line\" style=\"width:70%\"></i><span style=\"font-size:12px;color:var(--text-3)\">衬线大标题，自带编辑感</span></div>","serif-trust":"<div class=\"mk-win\"><span style=\"font-family:Georgia,'Songti SC',serif;font-size:12px;font-weight:700;color:var(--text)\">恒丰私人银行</span><i class=\"mk-line\" style=\"width:82%\"></i><span style=\"font-size:12px;color:var(--text-3)\">金融、律所：衬线 = 可信赖</span></div>","serif-ui-sans":"<div class=\"mk-win\"><span class=\"mk-input\" style=\"width:100%\">项目名称</span><span class=\"mk-input\" style=\"width:100%\">负责人</span><span style=\"font-size:12px;color:var(--text-3)\">界面用非衬线：干净、高效、读得快</span></div>","serif-quote":"<div class=\"mk-win\"><span style=\"font-family:Georgia,'Songti SC',serif;font-size:12px;color:var(--text-2)\">“好的设计是尽可能少的设计。”</span><span style=\"font-size:12px;color:var(--text-3)\">引文可用不同字体形成对比，但仍需匹配语言与语境</span></div>","serif-body-bad":"<div class=\"mk-win\"><span style=\"font-family:Georgia,'Songti SC',serif;font-size:12px;color:var(--text-2);line-height:1.8;text-align:left\">这是一段用小字号衬线字体排版的长正文。在当前屏幕和字重下，笔画细节不够清楚。</span></div><span style=\"font-size:12px;color:var(--red)\">字号、字重或渲染不合适时，正文可读性会下降</span>","serif-mismatch":"<div class=\"mk-win\"><span style=\"font-family:Georgia,'Songti SC',serif;font-size:13px;font-weight:700;color:var(--text)\">服务器监控大盘</span><div class=\"mk-row\"><span class=\"mk-tag green\">正常</span><span class=\"mk-tag orange\">告警 3</span></div><span style=\"font-size:12px;color:var(--red)\">工程工具硬凹优雅，气质错位</span></div>","serif-fallback":"<div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text)\"><span style=\"font-family:Georgia,serif\">Vibe </span><span style=\"font-family:serif\">设计指南</span></span><span style=\"font-size:12px;color:var(--red)\">只写 Georgia，中文掉成浏览器默认衬线</span></div>","serif-mess":"<div class=\"mk-win\"><span style=\"font-family:Georgia,'Songti SC',serif;font-size:13px;font-weight:700;color:var(--text)\">本月目标</span><span style=\"font-size:13px;font-weight:700;color:var(--text)\">数据看板</span><span style=\"font-family:Georgia,'Songti SC',serif;font-size:13px;font-weight:700;color:var(--text)\">团队成员</span><span style=\"font-size:12px;color:var(--red)\">同级标题两种字体混用，气质分裂</span></div>"}}}