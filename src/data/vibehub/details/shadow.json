{"__formatVersion":2,"__revision":"327264bf8b6a6377","__entryId":"shadow","entry":{"sceneUI":["<div style=\"display:flex;gap:16px;justify-content:center;padding-top:6px\">\n      <div style=\"width:132px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px\">\n        <b style=\"font-size:12px\">设计规范.md</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">昨天 18:02 更新</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:8px\">默认 · 几乎无阴影</div>\n      </div>\n      <div style=\"width:132px;background:var(--bg);border:1px solid var(--border-light);border-radius:10px;padding:10px 12px;box-shadow:0 10px 24px rgba(0,0,0,.13);transform:translateY(-4px)\">\n        <b style=\"font-size:12px\">首页改版.fig</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">2 小时前更新</div>\n        <div style=\"font-size:12px;color:var(--brand);margin-top:8px\">悬停 · 阴影加深浮起</div>\n      </div>\n    </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:40%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:250px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:14px 16px;box-shadow:0 16px 40px rgba(0,0,0,.24)\">\n        <span class=\"shadow-sc-chip\" style=\"position:absolute;top:-10px;right:12px\">大阴影 = 最上层</span>\n        <b style=\"font-size:13px\">发布新版本？</b>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\"><button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">取消</button><button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px\">发布</button></div>\n      </div>\n    </div>","<div style=\"max-width:250px;margin:0 auto;padding-top:6px\">\n      <div class=\"demo-select-wrap\"><span class=\"demo-select\" style=\"display:block;font-size:12px;padding:7px 30px 7px 12px\">按最近更新排序</span></div>\n      <div style=\"position:relative;margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.15);overflow:hidden\">\n        <span class=\"shadow-sc-chip\" style=\"position:absolute;top:6px;right:6px\">浮层阴影</span>\n        <div style=\"padding:8px 12px;font-size:12px;color:var(--text-2)\">最近更新</div>\n        <div style=\"padding:8px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">最多收藏 ✓</div>\n        <div style=\"padding:8px 12px;font-size:12px;color:var(--text-2)\">最新发布</div>\n      </div>\n    </div>","<div style=\"max-width:320px;margin:0 auto;padding-top:6px\">\n      <div style=\"display:flex;justify-content:space-between;font-size:12px;color:var(--text-2);margin-bottom:7px\"><span>存储空间</span><span>7.2 / 10 GB</span></div>\n      <div style=\"height:10px;border-radius:99px;background:var(--bg-hover);box-shadow:inset 0 1px 3px rgba(0,0,0,.18);position:relative\">\n        <span style=\"position:absolute;left:0;top:0;bottom:0;width:72%;border-radius:99px;background:var(--brand)\"></span>\n      </div>\n      <div class=\"shadow-sc-note\">槽用 <b style=\"color:var(--brand)\">inset 内阴影</b>凹进去，填充条才像嵌在里面</div>\n    </div>"],"sceneUI_en":["<div style=\"display:flex;gap:16px;justify-content:center;padding-top:6px\">\n      <div style=\"width:132px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px\">\n        <b style=\"font-size:12px\">Design-guidelines.md</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">Updated yesterday at 6:02 PM</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:8px\">Default · Minimal shadow</div>\n      </div>\n      <div style=\"width:132px;background:var(--bg);border:1px solid var(--border-light);border-radius:10px;padding:10px 12px;box-shadow:0 10px 24px rgba(0,0,0,.13);transform:translateY(-4px)\">\n        <b style=\"font-size:12px\">Homepage-refresh.fig</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">Updated 2 hours ago</div>\n        <div style=\"font-size:12px;color:var(--brand);margin-top:8px\">Hover · Lifts with a stronger shadow</div>\n      </div>\n    </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:40%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:250px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:14px 16px;box-shadow:0 16px 40px rgba(0,0,0,.24)\">\n        <span class=\"shadow-sc-chip\" style=\"position:absolute;top:-10px;right:12px\">Big shadow = top</span>\n        <b style=\"font-size:13px\">Publish a new version? </b>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\"><button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">Cancel</button><button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px\">Publish</button></div>\n      </div>\n    </div>","<div style=\"max-width:250px;margin:0 auto;padding-top:6px\">\n      <div class=\"demo-select-wrap\"><span class=\"demo-select\" style=\"display:block;font-size:12px;padding:7px 30px 7px 12px\">Sort by latest update</span></div>\n      <div style=\"position:relative;margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.15);overflow:hidden\">\n        <span class=\"shadow-sc-chip\" style=\"position:absolute;top:6px;right:6px\">Floating shadow</span>\n        <div style=\"padding:8px 12px;font-size:12px;color:var(--text-2)\">Latest updates</div>\n        <div style=\"padding:8px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">Most collected ✓</div>\n        <div style=\"padding:8px 12px;font-size:12px;color:var(--text-2)\">Latest release</div>\n      </div>\n    </div>","<div style=\"max-width:320px;margin:0 auto;padding-top:6px\">\n      <div style=\"display:flex;justify-content:space-between;font-size:12px;color:var(--text-2);margin-bottom:7px\"><span>Storage Space</span><span>7.2 / 10 GB</span></div>\n      <div style=\"height:10px;border-radius:99px;background:var(--bg-hover);box-shadow:inset 0 1px 3px rgba(0,0,0,.18);position:relative\">\n        <span style=\"position:absolute;left:0;top:0;bottom:0;width:72%;border-radius:99px;background:var(--brand)\"></span>\n      </div>\n      <div class=\"shadow-sc-note\">The groove is recessed with <b style=\"color:var(--brand)\">inset inner shadow</b>, so that the fill bar looks like it is embedded inside</div>\n    </div>"],"anatomy":{"demo":"<span class=\"shadow-anat-stage\"><span class=\"ap\" data-ap=\"element\"><span class=\"shadow-anat-el\">卡片</span></span><span class=\"ap\" data-ap=\"shadow\"><span class=\"shadow-anat-sh\"></span></span><span class=\"ap\" data-ap=\"light\"><span class=\"shadow-anat-light\">☀</span></span></span>","demo_en":"<span class=\"shadow-anat-stage\"><span class=\"ap\" data-ap=\"element\"><span class=\"shadow-anat-el\">Card</span></span><span class=\"ap\" data-ap=\"shadow\"><span class=\"shadow-anat-sh\"></span></span><span class=\"ap\" data-ap=\"light\"><span class=\"shadow-anat-light\">☀</span></span></span>","parts":[{"key":"element","cn":"元素本体","en":"Element","desc":"投下阴影的那个盒子","desc_en":"the box that casts a shadow"},{"key":"shadow","cn":"阴影","en":"Shadow","desc":"x / y 偏移 + 模糊 + 扩散，颜色带透明度","desc_en":"x/y offset + blur + diffuse, color with transparency"},{"key":"light","cn":"光源","en":"Light","desc":"全站统一一个方向，阴影才不乱","desc_en":"If the whole site is in the same direction, the shadows will not be messy."}]},"variants":[{"cn":"浅阴影","en":"Small","demo":"<span class=\"shadow-card shadow-s1\">卡片</span>","demo_en":"<span class=\"shadow-card shadow-s1\">Card</span>","when":"普通卡片的默认层次","when_en":"The default level of ordinary cards"},{"cn":"中阴影","en":"Medium","demo":"<span class=\"shadow-card shadow-s2\">浮起</span>","demo_en":"<span class=\"shadow-card shadow-s2\">Floating</span>","when":"悬停浮起、下拉菜单","when_en":"Hover, drop-down menu"},{"cn":"浮起阴影","en":"Large","demo":"<span class=\"shadow-card shadow-s3\">弹窗</span>","demo_en":"<span class=\"shadow-card shadow-s3\">Pop-up</span>","when":"弹窗、抽屉这类最上层","when_en":"The top layer such as pop-ups and drawers"},{"cn":"内阴影","en":"Inset","demo":"<span class=\"shadow-card shadow-inset\">凹槽</span>","demo_en":"<span class=\"shadow-card shadow-inset\">Groove</span>","when":"输入框、进度槽做凹陷感","when_en":"Input boxes and progress slots are made concave."}],"use":[{"t":"{c:card} <b>悬停浮起</b>：浅阴影提示可点","m":"shadow-hover"},{"t":"{c:modal}、{c:drawer} <b>压在最上层</b>：阴影更明显","m":"shadow-float"},{"t":"{c:select} 下拉、{c:tooltip} <b>浮层边缘</b>：和页面区分开","m":"sel-list"},{"t":"<b>内阴影</b>做凹陷：输入框、进度槽往里凹","m":"shadow-inset"}],"dont":[{"t":"阴影<b>过深过重</b>：会让元素层级显得突兀","m":"shadow-heavy","bad":true},{"t":"<b>每个元素都加阴影</b>：会削弱层级区分","m":"shadow-everywhere","bad":true},{"t":"阴影方向<b>不一致</b>：应在全站统一光源方向","m":"shadow-direction","bad":true},{"t":"给<b>正文文字加投影</b>会降低字形清晰度，不能替代对比度","m":"shadow-text","bad":true}],"lessonPractice":{"title":"页面同时有普通卡片、下拉菜单和弹窗，现在每个元素都使用同样浓重的阴影。怎样建立更清楚的层级？","options":[{"id":"layered-consistent-shadows","label":"普通内容保持克制，浮层按真实高度增强阴影，并统一光源方向","feedback":"阴影差异对应界面层级，统一方向又让这些层级像来自同一个视觉系统。","correct":true},{"id":"heavy-shadow-everywhere","label":"所有卡片和控件继续使用重阴影，让每个元素都从背景中突出","feedback":"每个元素都浮起会失去相对层级，页面同时产生大量互相竞争的边界。","correct":false},{"id":"text-shadow-for-contrast","label":"给正文文字也加投影，用同一效果补足浅色文字对比度","feedback":"文字阴影会降低字形清晰度，对比度应通过前景和背景颜色解决。","correct":false}],"en":{"title":"A page has regular cards, dropdowns, and a modal, but every element uses the same heavy shadow. How should hierarchy become clearer?","options":[{"id":"layered-consistent-shadows","label":"Keep ordinary content restrained, strengthen shadows by actual elevation, and use one light direction","feedback":"Shadow differences map to interface elevation, while consistent direction makes the layers belong to one system.","correct":true},{"id":"heavy-shadow-everywhere","label":"Keep heavy shadows on every card and control so each element stands out","feedback":"When everything floats, relative hierarchy disappears and many competing boundaries fill the page.","correct":false},{"id":"text-shadow-for-contrast","label":"Add the same shadow to body text to improve contrast against light surfaces","feedback":"Text shadow reduces glyph clarity; foreground and background colors should establish readable contrast.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请建立统一阴影层级：普通卡片尽量平，Dropdown 和 Popover 使用轻阴影，Modal 使用更明确但克制的阴影，方向保持一致。不要给正文加阴影；在浅色和深色背景上分别检查边界。","en":{"title":"You can say this to an AI Agent","text":"Create a consistent shadow hierarchy: keep regular cards mostly flat, use light elevation for dropdowns and popovers, and a clearer but restrained modal shadow with one direction. Never shadow body text; test light and dark surfaces."}},"references":[{"title":"box-shadow 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/box-shadow","title_en":"box-shadow"}],"scenes":["卡片悬停浮起","弹窗与抽屉","下拉浮层","凹陷的进度槽"],"en":{"use":[{"t":"Lift a floating menu above the page","m":"shadow-hover"},{"t":"Separate a dialog from its backdrop","m":"shadow-float"},{"t":"Show an elevated card on a similar background","m":"sel-list"},{"t":"Build a small set of depth levels","m":"shadow-inset"}],"dont":[{"t":"Add a strong shadow to every container","m":"shadow-heavy","bad":true},{"t":"Use several shadow directions on the same page","m":"shadow-everywhere","bad":true},{"t":"Rely on shadow alone when contrast is too low","m":"shadow-direction","bad":true},{"t":"Make a flat item look clickable when it is not","m":"shadow-text","bad":true}],"scenes":["Dropdown","Modal","Floating card","Sticky header"],"sceneUI":["<div style=\"display:flex;gap:16px;justify-content:center;padding-top:6px\">\n      <div style=\"width:132px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px\">\n        <b style=\"font-size:12px\">Design-guidelines.md</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">Updated yesterday at 6:02 PM</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:8px\">Default · Minimal shadow</div>\n      </div>\n      <div style=\"width:132px;background:var(--bg);border:1px solid var(--border-light);border-radius:10px;padding:10px 12px;box-shadow:0 10px 24px rgba(0,0,0,.13);transform:translateY(-4px)\">\n        <b style=\"font-size:12px\">Homepage-refresh.fig</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:4px\">Updated 2 hours ago</div>\n        <div style=\"font-size:12px;color:var(--brand);margin-top:8px\">Hover · Lifts with a stronger shadow</div>\n      </div>\n    </div>","<div style=\"position:relative;height:150px;border-radius:8px;overflow:hidden;background:var(--bg-soft)\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:8px\"><i class=\"mk-line\" style=\"width:55%\"></i><i class=\"mk-line\" style=\"width:82%\"></i><i class=\"mk-line\" style=\"width:40%\"></i></div>\n      <div style=\"position:absolute;inset:0;background:rgba(29,33,41,.32)\"></div>\n      <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:250px;max-width:calc(100% - 40px);background:var(--bg);border-radius:12px;padding:14px 16px;box-shadow:0 16px 40px rgba(0,0,0,.24)\">\n        <span class=\"shadow-sc-chip\" style=\"position:absolute;top:-10px;right:12px\">Big shadow = top</span>\n        <b style=\"font-size:13px\">Publish a new version? </b>\n        <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:12px\"><button class=\"btn btn-outline\" style=\"padding:5px 12px;font-size:12px\">Cancel</button><button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px\">Publish</button></div>\n      </div>\n    </div>","<div style=\"max-width:250px;margin:0 auto;padding-top:6px\">\n      <div class=\"demo-select-wrap\"><span class=\"demo-select\" style=\"display:block;font-size:12px;padding:7px 30px 7px 12px\">Sort by latest update</span></div>\n      <div style=\"position:relative;margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.15);overflow:hidden\">\n        <span class=\"shadow-sc-chip\" style=\"position:absolute;top:6px;right:6px\">Floating shadow</span>\n        <div style=\"padding:8px 12px;font-size:12px;color:var(--text-2)\">Latest updates</div>\n        <div style=\"padding:8px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">Most collected ✓</div>\n        <div style=\"padding:8px 12px;font-size:12px;color:var(--text-2)\">Latest release</div>\n      </div>\n    </div>","<div style=\"max-width:320px;margin:0 auto;padding-top:6px\">\n      <div style=\"display:flex;justify-content:space-between;font-size:12px;color:var(--text-2);margin-bottom:7px\"><span>Storage Space</span><span>7.2 / 10 GB</span></div>\n      <div style=\"height:10px;border-radius:99px;background:var(--bg-hover);box-shadow:inset 0 1px 3px rgba(0,0,0,.18);position:relative\">\n        <span style=\"position:absolute;left:0;top:0;bottom:0;width:72%;border-radius:99px;background:var(--brand)\"></span>\n      </div>\n      <div class=\"shadow-sc-note\">The groove is recessed with <b style=\"color:var(--brand)\">inset inner shadow</b>, so that the fill bar looks like it is embedded inside</div>\n    </div>"],"variants":[{"demo":"<span class=\"shadow-card shadow-s1\">Card</span>","when":"The default level of ordinary cards"},{"demo":"<span class=\"shadow-card shadow-s2\">Floating</span>","when":"Hover, drop-down menu"},{"demo":"<span class=\"shadow-card shadow-s3\">Pop-up</span>","when":"The top layer such as pop-ups and drawers"},{"demo":"<span class=\"shadow-card shadow-inset\">Groove</span>","when":"Input boxes and progress slots are made concave."}]},"usageMocks":{"shadow-hover":"<div class=\"mk-row\"><span style=\"width:40px;height:26px;background:var(--bg);border:1px solid var(--border-light);border-radius:5px\"></span><span style=\"font-size:12px;color:var(--text-3)\">→</span><span style=\"width:40px;height:26px;background:var(--bg);border:1px solid var(--border-light);border-radius:5px;box-shadow:0 4px 12px rgba(29,33,41,.14)\"></span></div><span style=\"font-size:12px;color:var(--text-3)\">悬停时用轻微阴影增强可操作反馈</span>","shadow-float":"<div class=\"mk-scene\"><div class=\"mk-skel\"><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div><span style=\"position:absolute;top:14px;right:12px;width:56px;height:34px;background:var(--bg);border:1px solid var(--border-light);border-radius:5px;box-shadow:0 8px 24px rgba(29,33,41,.22)\"></span></div><span style=\"font-size:12px;color:var(--text-3)\">浮层可用更明显的阴影区分前后层级</span>","sel-list":"<div class=\"mk-row \"><span class=\"mk-select\">全部状态<i class=\"mk-caret\"></i></span><div class=\"mk-drop\"><span class=\"mk-opt \">全部状态</span><span class=\"mk-opt on\">进行中</span><span class=\"mk-opt \">已完成</span><span class=\"mk-opt \">已过期</span></div></div>","shadow-inset":"<div class=\"mk-row\"><span style=\"width:70px;height:14px;border-radius:99px;background:#ebedf0;box-shadow:inset 0 1px 3px rgba(29,33,41,.18)\"></span><span style=\"font-size:12px;color:var(--text-3)\">内阴影可以表现向内凹陷的表面</span></div>","shadow-heavy":"<span style=\"width:52px;height:30px;background:var(--bg);border-radius:5px;box-shadow:0 6px 10px rgba(0,0,0,.55)\"></span><span style=\"font-size:12px;color:var(--text-3)\">阴影过深过重，层级显得突兀</span>","shadow-everywhere":"<div class=\"mk-row\"><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:0 3px 8px rgba(29,33,41,.3)\"></span><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:0 3px 8px rgba(29,33,41,.3)\"></span><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:0 3px 8px rgba(29,33,41,.3)\"></span><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:0 3px 8px rgba(29,33,41,.3)\"></span></div><span style=\"font-size:12px;color:var(--text-3)\">所有元素使用同等阴影，会失去层级区分</span>","shadow-direction":"<div class=\"mk-row\"><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:0 4px 6px rgba(29,33,41,.25)\"></span><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:0 -4px 6px rgba(29,33,41,.25)\"></span><span style=\"width:24px;height:16px;background:var(--bg);border-radius:3px;box-shadow:5px 0 6px rgba(29,33,41,.25)\"></span></div><span style=\"font-size:12px;color:var(--text-3)\">阴影方向不一致，层级关系不清晰</span>","shadow-text":"<span style=\"font-size:13px;font-weight:600;color:var(--text);text-shadow:2px 2px 3px rgba(0,0,0,.5)\">正文加了投影</span><span style=\"font-size:12px;color:var(--text-3)\">过重的文字阴影会降低字形清晰度</span>"}}}