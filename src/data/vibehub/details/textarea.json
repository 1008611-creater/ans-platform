nter;margin-top:2px\"><span class=\"demo-tag gray\">📎 Attachments</span><button class=\"btn btn-primary\" style=\"padding:5px 14px\">Send</button></div>\n          </div>\n        </div>","<div style=\"max-width:380px;margin:0 auto\">\n          <div style=\"display:flex;gap:8px;margin-bottom:8px\"><span style=\"font-size:12px;color:var(--text-3);width:56px;flex-shrink:0;padding-top:5px\">Question type</span><span style=\"display:flex;gap:6px\"><span class=\"demo-tag blue\">Feature not working</span><span class=\"demo-tag gray\">Improvement suggestion</span><span class=\"demo-tag gray\">Other</span></span></div>\n          <div style=\"display:flex;gap:8px\"><span style=\"font-size:12px;color:var(--text-3);width:56px;flex-shrink:0;padding-top:7px\">Problem description</span><textarea class=\"demo-input\" rows=\"3\" style=\"flex:1;resize:none;line-height:1.6;font-family:inherit;font-size:12px\" placeholder=\"Please describe the problem you encountered, the more specific the better...\"></textarea></div>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding-left:64px\"><span style=\"font-size:12px;color:var(--text-3)\">📎 Attach screenshots</span><button class=\"btn btn-primary\">Submit feedback</button></div>\n        </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"label\"><span class=\"input-label\">反馈意见</span></span>\n          <span class=\"ap\" data-ap=\"box\"><textarea class=\"demo-input ta-demo\" rows=\"3\" placeholder=\"请描述你遇到的问题…\"></textarea></span>\n          <span class=\"ap\" data-ap=\"count\"><span class=\"ta-count\">0 / 200</span></span>","demo_en":"<span class=\"ap\" data-ap=\"label\"><span class=\"input-label\">Feedback</span></span>\n          <span class=\"ap\" data-ap=\"box\"><textarea class=\"demo-input ta-demo\" rows=\"3\" placeholder=\"Please describe the problem you encountered...\"></textarea></span>\n          <span class=\"ap\" data-ap=\"count\"><span class=\"ta-count\">0 / 200</span></span>","parts":[{"key":"label","cn":"标签","en":"Label","desc":"告诉用户写哪方面的内容","desc_en":"Tell users what to write"},{"key":"box","cn":"多行文本框本体","en":"Textarea","desc":"提供适合内容的初始高度，是否允许调整按场景决定","desc_en":"Choose a useful starting height, and allow resizing only when it helps."},{"key":"count","cn":"字数统计","en":"Word Count","desc":"接近上限时变红提醒","desc_en":"Turns red to remind when approaching the upper limit"}]},"variants":[{"cn":"默认","en":"Default","demo":"<textarea class=\"demo-input ta-demo\" rows=\"3\" placeholder=\"请输入…\"></textarea>","demo_en":"<textarea class=\"demo-input ta-demo\" rows=\"3\" placeholder=\"Please enter...\"></textarea>","when":"评论、反馈等常规多行输入","when_en":"General multi-line input such as comments and feedback"},{"cn":"带字数统计","en":"With Count","demo":"<div class=\"ta-wrap\"><textarea class=\"demo-input ta-demo\" rows=\"2\">这个组件的交互设计得很细致，值得学习。</textarea><span class=\"ta-count\">21 / 500</span></div>","demo_en":"<div class=\"ta-wrap\"><textarea class=\"demo-input ta-demo\" rows=\"2\">The interaction design of this component is very detailed and worth learning. </textarea><span class=\"ta-count\">21 / 500</span></div>","when":"有字数上限时，显示实时计数","when_en":"When there is a character limit, show a live count"},{"cn":"只读","en":"Readonly","demo":"<textarea class=\"demo-input ta-demo\" rows=\"2\" readonly>提交后不可修改的内容</textarea>","demo_en":"<textarea class=\"demo-input ta-demo\" rows=\"2\" readonly>Content that cannot be changed after submission</textarea>","when":"内容已确定，只展示不让改","when_en":"When the content is final and should be shown without editing."},{"cn":"禁用","en":"Disabled","demo":"<textarea class=\"demo-input ta-demo\" rows=\"2\" disabled placeholder=\"暂不可编辑\"></textarea>","demo_en":"<textarea class=\"demo-input ta-demo\" rows=\"2\" disabled placeholder=\"Not editable yet\"></textarea>","when":"整个多行文本框暂时不可编辑","when_en":"The entire text field is temporarily uneditable"}],"use":[{"t":"<b>发表评论、写回复</b>：内容长短不限","m":"ta-comment"},{"t":"<b>个人简介、项目描述</b>：几句话说清一件事","m":"in-textarea"},{"t":"<b>给 AI 写提示词</b>：指令往往又长又具体","m":"ta-prompt"},{"t":"<b>有字数上限</b>时配上实时计数","m":"ta-count"}],"dont":[{"t":"只需填写<b>单行内容</b>：使用 {c:input}","m":"in-exact"},{"t":"需要从<b>固定选项</b>中选择：使用 {c:select}","m":"in-select"},{"t":"需要<b>加粗、插图或排版</b>：使用富文本编辑器","m":"ta-richtext","bad":true},{"t":"用多行文本框展示只读内容；正文或描述组件更合适","m":"ta-wall","bad":true}],"lessonPractice":{"title":"客服表单要让用户描述故障经过，可能会写几段话，还要显示 500 字上限。哪种输入方式更合适？","options":[{"id":"textarea-counter","label":"使用多行文本框，并在旁边显示剩余字数","feedback":"故障描述是较长的自由文本，多行空间和可见字数限制都直接服务这项任务。","correct":true},{"id":"growing-input","label":"使用单行输入框，内容过长时左右滚动","feedback":"单行输入框会隐藏上下文，让用户难以检查和修改多段描述。","correct":false},{"id":"rich-editor","label":"使用带图片、字号和排版工具的富文本编辑器","feedback":"题目只需要纯文本描述，完整富文本工具会增加无关操作和界面负担。","correct":false}],"en":{"title":"A support form asks people to describe a failure in several paragraphs with a 500-character limit. How should it work?","options":[{"id":"textarea-counter","label":"Use a textarea and show the remaining character count nearby","feedback":"The task needs longer free-form text, so multiline space and a visible limit directly support it.","correct":true},{"id":"growing-input","label":"Use a single-line input that scrolls sideways as text grows","feedback":"A single line hides context and makes several paragraphs difficult to review and edit.","correct":false},{"id":"rich-editor","label":"Use a rich editor with images, font sizes, and layout controls","feedback":"The task only needs plain text, so rich formatting tools add unrelated choices and interface weight.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"把故障描述改成多行文本框，限制 500 字并实时显示剩余字数。请测试多段文字、达到上限和超出上限时的反馈，不能让内容只在单行里左右滚动。","en":{"title":"You can say this to an AI Agent","text":"Use a textarea for the failure description, limit it to 500 characters, and show the remaining count live. Test multiple paragraphs, the exact limit, and the over-limit feedback."}},"demoDetail":"<div class=\"ta-wrap\"><textarea clas