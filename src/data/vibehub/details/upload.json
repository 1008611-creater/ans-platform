{"__formatVersion":2,"__revision":"4346ef6acd5b5569","__entryId":"upload","entry":{"sceneUI":["<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:14px\">\n      <div class=\"upload-sc-avatar\">\n        <img src=\"/assets/avatar-fox.png\" alt=\"\">\n        <span class=\"edit\">✎</span>\n      </div>\n      <div style=\"flex:1\">\n        <b style=\"font-size:13px\">头像</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 8px\">支持 JPG / PNG，不超过 2MB</div>\n        <button class=\"btn btn-outline\" style=\"padding:5px 10px;font-size:12px\">更换头像</button>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <b style=\"font-size:13px\">提交工单</b>\n      <div class=\"ul-wrap\" style=\"width:100%;margin-top:8px;gap:8px\">\n        <div class=\"ul-file\"><span class=\"ul-ico\">🖼</span><span class=\"ul-meta\"><b>问题截图.png</b></span><span class=\"ul-done\">✓</span></div>\n        <div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>日志文件.log</b><div class=\"demo-progress\"><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:66%\"></div></div></div></span><span class=\"ul-pct\">66%</span></div>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\">\n        <b style=\"font-size:13px;flex:1\">批量导入成员</b>\n        <span style=\"font-size:12px;color:var(--brand)\">下载模板</span>\n      </div>\n      <div class=\"ul-drop\">⬆<span>拖拽 Excel / CSV 到这里</span><em>或点击选择文件，单次最多 500 行</em></div>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:10px\">\n        <button class=\"btn btn-outline\" style=\"padding:5px 10px;font-size:12px\">取消</button>\n        <button class=\"btn btn-primary\" style=\"padding:5px 10px;font-size:12px\">开始导入</button>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;color:var(--text);padding-bottom:8px\">周末去爬了塘朗山，云海绝了 🌤</div>\n      <div class=\"ul-thumbs\">\n        <span class=\"ul-thumb\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></span>\n        <span class=\"ul-thumb\" style=\"background:url('/assets/photo-cat.png') center/cover\"></span>\n        <span class=\"ul-thumb add\">＋</span>\n      </div>\n      <div style=\"display:flex;justify-content:flex-end;margin-top:10px\">\n        <button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px\">发布</button>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:14px\">\n      <div class=\"upload-sc-avatar\">\n        <img src=\"/assets/avatar-fox.png\" alt=\"\">\n        <span class=\"edit\">✎</span>\n      </div>\n      <div style=\"flex:1\">\n        <b style=\"font-size:13px\">Avatar</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 8px\">Supports JPG / PNG, no more than 2MB</div>\n        <button class=\"btn btn-outline\" style=\"padding:5px 10px;font-size:12px\">Change avatar</button>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <b style=\"font-size:13px\">Submit a work order</b>\n      <div class=\"ul-wrap\" style=\"width:100%;margin-top:8px;gap:8px\">\n        <div class=\"ul-file\"><span class=\"ul-ico\">🖼</span><span class=\"ul-meta\"><b>Problem screenshot.png</b></span><span class=\"ul-done\">✓</span></div>\n        <div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>Log file.log</b><div class=\"demo-progress\"><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:66%\"></div></div></div></span><span class=\"ul-pct\">66%</span></div>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\">\n        <b style=\"font-size:13px;flex:1\">Batch import members</b>\n        <span style=\"font-size:12px;color:var(--brand)\">Download template</span>\n      </div>\n      <div class=\"ul-drop\">⬆<span>Drag Excel / CSV here</span><em>or click to select the file, up to 500 rows at a time</em></div>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:10px\">\n        <button class=\"btn btn-outline\" style=\"padding:5px 10px;font-size:12px\">Cancel</button>\n        <button class=\"btn btn-primary\" style=\"padding:5px 10px;font-size:12px\">Start import</button>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;color:var(--text);padding-bottom:8px\">I climbed Tanglang Mountain on the weekend and the sea of clouds was stunning 🌤</div>\n      <div class=\"ul-thumbs\">\n        <span class=\"ul-thumb\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></span>\n        <span class=\"ul-thumb\" style=\"background:url('/assets/photo-cat.png') center/cover\"></span>\n        <span class=\"ul-thumb add\">+</span>\n      </div>\n      <div style=\"display:flex;justify-content:flex-end;margin-top:10px\">\n        <button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px\">Publish</button>\n      </div>\n    </div>"],"anatomy":{"demo":"<div class=\"ul-wrap\"><div class=\"ap\" data-ap=\"drop\"><div class=\"ul-drop\">⬆<span class=\"ap\" data-ap=\"hint\"><em>支持 JPG / PNG，不超过 10MB</em></span></div></div><div class=\"ap\" data-ap=\"file\"><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ap\" data-ap=\"name\"><b style=\"font-size:12px\">设计稿.fig</b></span><span class=\"ap\" data-ap=\"progress\"><span class=\"demo-progress\" style=\"width:110px\"><span class=\"bar-track\"><span class=\"bar-fill\" data-fill=\"66\"></span></span></span></span></div></div></div>","demo_en":"<div class=\"ul-wrap\"><div class=\"ap\" data-ap=\"drop\"><div class=\"ul-drop\">⬆<span class=\"ap\" data-ap=\"hint\"><em>Supports JPG / PNG, no more than 10MB</em></span></div></div><div class=\"ap\" data-ap=\"file\"><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ap\" data-ap=\"name\"><b style=\"font-size:12px\">Design draft.fig</b></span><span class=\"ap\" data-ap=\"progress\"><span class=\"demo-progress\" style=\"width:110px\"><span class=\"bar-track\"><span class=\"bar-fill\" data-fill=\"66\"></span></span></span></span></div></div></div>","parts":[{"key":"drop","cn":"拖拽区","en":"Drop Zone","desc":"虚线框，拖文件进来或点击选择","desc_en":"A dashed area where users can drag files or click to select them"},{"key":"hint","cn":"限制说明","en":"Hint","desc":"格式、大小上限，提前说清","desc_en":"State file-format and size limits up front"},{"key":"file","cn":"文件项","en":"File Item","desc":"一个文件一行，可删除、可重试","desc_en":"One file per row; users can remove and retry it"},{"key":"name","cn":"文件名","en":"File Name","desc":"显示文件叫什么","desc_en":"Shows the file name"},{"key":"progress","cn":"进度条","en":"Progress","desc":"传到哪了一目了然","desc_en":"Clearly shows upload progress"}]},"variants":[{"cn":"拖拽区","en":"Drag","demo":"<div class=\"ul-drop\" style=\"width:210px\">⬆<span>拖拽文件到这里</span><em>或点击选择</em></div>","demo_en":"<div class=\"ul-drop\" style=\"width:210px\">⬆<span>Drag the file here</span><em>or click to select</em></div>","when":"上传大文件或批量选择文件时","when_en":"When uploading large files or selecting files in batches"},{"cn":"按钮触发","en":"Button","demo":"<button class=\"btn btn-outline\">⬆ 上传文件</button>","demo_en":"<button class=\"btn btn-outline\">⬆ Upload file</button>","when":"页面空间有限，使用按钮打开文件选择器","when_en":"When space is limited, use a button to open the file picker"},{"cn":"图片卡片","en":"Picture","demo":"<div class=\"ul-thumbs\"><span class=\"ul-thumb\" style=\"background:url('/assets/photo-cat.png') center/cover\"></span><span class=\"ul-thumb\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></span><span class=\"ul-thumb add\">＋</span></div>","demo_en":"<div class=\"ul-thumbs\"><span class=\"ul-thumb\" style=\"background:url('/assets/photo-cat.png') center/cover\"></span><span class=\"ul-thumb\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></span><span class=\"ul-thumb add\">＋</span></div>","when":"上传头像或封面时，需要展示已选图片","when_en":"When uploading an avatar or cover, the selected image needs to be displayed"},{"cn":"文件列表","en":"List","demo":"<div class=\"ul-wrap\" style=\"width:230px\"><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>需求文档.pdf</b></span><span class=\"ul-done\">✓</span></div><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>设计稿.fig</b><div class=\"demo-progress\"><div class=\"bar-track\"><div class=\"bar-fill\" data-fill=\"66\"></div></div></div></span><span class=\"ul-pct\">66%</span></div></div>","demo_en":"<div class=\"ul-wrap\" style=\"width:230px\"><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>Requirements document.pdf</b></span><span class=\"ul-done\">✓</span></div><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>Design draft.fig</b><div class=\"demo-progress\"><div class=\"bar-track\"><div class=\"bar-fill\" data-fill=\"66\"></div></div></div></span><span class=\"ul-pct\">66%</span></div></div>","when":"同时上传多个文件时，需要分别显示处理进度","when_en":"When uploading multiple files, show each file’s progress separately."}],"use":[{"t":"<b>拖拽上传</b>：适合大文件或批量选择","m":"ul-drag"},{"t":"<b>图片上传带预览</b>：头像、封面，传完马上看到","m":"ul-img"},{"t":"<b>文件列表 + 进度</b>：多个文件各自的状态清清楚楚","m":"ul-list"},{"t":"<b>写清格式和大小限制</b>：传之前就知道行不行","m":"ul-limit"}],"dont":[{"t":"用户只有<b>文件链接</b>：使用 {c:input} 填写 URL","m":"ul-link","bad":true},{"t":"<b>大量小文件逐个上传</b>：先打包，或支持选择文件夹","m":"ul-many","bad":true},{"t":"<b>失败不给重试</b>：传到 99% 失败只能从头再来","m":"ul-fail","bad":true},{"t":"<b>不设大小上限</b>：1.8GB 传半小时才报错","m":"ul-big","bad":true}],"lessonPractice":{"title":"用户要上传最大 20 MB 的头像，网络中断后还要能重试。哪套方案更完整？","options":[{"id":"browser-check-only","label":"浏览器检查格式后直接当作安全文件保存","feedback":"浏览器检查能提前反馈，但请求可以被绕过；服务器仍要检查文件类型、大小和权限。","correct":false},{"id":"limits-progress-retry","label":"选择前说明限制，上传时显示进度，失败后可重试","feedback":"用户能提前判断文件是否合适，并看见传输状态；服务器还可以在保存前再次校验。","correct":true},{"id":"check-after-transfer","label":"先接收所有文件，传完以后再提示大小不符合","feedback":"最终校验仍需要，但已知限制应提前说明；传完才拒绝会浪费时间和流量。","correct":false}],"en":{"title":"People can upload avatars up to 20 MB, and a network interruption must be recoverable. Which flow is most complete?","options":[{"id":"browser-check-only","label":"Check the format in the browser and then treat the file as safe","feedback":"Browser checks improve feedback but can be bypassed. The server must still verify type, size, and permission.","correct":false},{"id":"limits-progress-retry","label":"Explain limits before selection, show progress, and allow retry after failure","feedback":"People can choose an eligible file, see the transfer state, and recover from failure while the server validates it again.","correct":true},{"id":"check-after-transfer","label":"Accept every file first and report an invalid size only after transfer","feedback":"Final server validation is still required, but known limits should be visible before a long transfer begins.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请完善头像上传：选择前写清格式和 20 MB 上限，上传时显示进度，失败后可以重试，服务器保存前再次校验文件。请分别测试超限文件、正常上传和中途断网。","en":{"title":"You can say this to an AI Agent","text":"Improve avatar upload: state the allowed formats and 20 MB limit before selection, show progress, allow retry, and validate again on the server before saving. Test an oversized file, a successful upload, and a network interruption."}},"references":[{"title":"<input type=\"file\">：文件输入控件","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/input/file","title_en":"<input type=\"file\">"},{"title":"HTML 拖放 API","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/API/HTML_Drag_and_Drop_API","title_en":"HTML Drag and Drop API"}],"scenes":["上传头像","提交附件","导入数据文件","发布配图"],"en":{"use":[{"t":"Profile image","m":"ul-drag"},{"t":"Document attachment","m":"ul-img"},{"t":"Import a data file","m":"ul-list"},{"t":"Send media or project files","m":"ul-limit"}],"dont":[{"t":"Reveal limits only after a long upload fails","m":"ul-link","bad":true},{"t":"Show no progress for a large file","m":"ul-many","bad":true},{"t":"Trust the filename or browser check as final validation","m":"ul-fail","bad":true},{"t":"Remove a failed file without offering a retry","m":"ul-big","bad":true}],"scenes":["Avatar upload","Support attachment","CSV import","Media library"],"sceneUI":["<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:14px\">\n      <div class=\"upload-sc-avatar\">\n        <img src=\"/assets/avatar-fox.png\" alt=\"\">\n        <span class=\"edit\">✎</span>\n      </div>\n      <div style=\"flex:1\">\n        <b style=\"font-size:13px\">Avatar</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 8px\">Supports JPG / PNG, no more than 2MB</div>\n        <button class=\"btn btn-outline\" style=\"padding:5px 10px;font-size:12px\">Change avatar</button>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <b style=\"font-size:13px\">Submit a work order</b>\n      <div class=\"ul-wrap\" style=\"width:100%;margin-top:8px;gap:8px\">\n        <div class=\"ul-file\"><span class=\"ul-ico\">🖼</span><span class=\"ul-meta\"><b>Problem screenshot.png</b></span><span class=\"ul-done\">✓</span></div>\n        <div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>Log file.log</b><div class=\"demo-progress\"><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:66%\"></div></div></div></span><span class=\"ul-pct\">66%</span></div>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\">\n        <b style=\"font-size:13px;flex:1\">Batch import members</b>\n        <span style=\"font-size:12px;color:var(--brand)\">Download template</span>\n      </div>\n      <div class=\"ul-drop\">⬆<span>Drag Excel / CSV here</span><em>or click to select the file, up to 500 rows at a time</em></div>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:10px\">\n        <button class=\"btn btn-outline\" style=\"padding:5px 10px;font-size:12px\">Cancel</button>\n        <button class=\"btn btn-primary\" style=\"padding:5px 10px;font-size:12px\">Start import</button>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;color:var(--text);padding-bottom:8px\">I climbed Tanglang Mountain on the weekend and the sea of clouds was stunning 🌤</div>\n      <div class=\"ul-thumbs\">\n        <span class=\"ul-thumb\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></span>\n        <span class=\"ul-thumb\" style=\"background:url('/assets/photo-cat.png') center/cover\"></span>\n        <span class=\"ul-thumb add\">+</span>\n      </div>\n      <div style=\"display:flex;justify-content:flex-end;margin-top:10px\">\n        <button class=\"btn btn-primary\" style=\"padding:5px 12px;font-size:12px\">Publish</button>\n      </div>\n    </div>"],"distinctions":[{"label":"File item","text":"{c:upload} handles choosing, transferring, and retrying a file. {c:file} displays a file that already exists or is being processed.","targetId":"file"}],"variants":[{"demo":"<div class=\"ul-drop\" style=\"width:210px\">⬆<span>Drag the file here</span><em>or click to select</em></div>","when":"When uploading large files or selecting files in batches"},{"demo":"<button class=\"btn btn-outline\">⬆ Upload file</button>","when":"When space is limited, use a button to open the file picker"},{"demo":"<div class=\"ul-thumbs\"><span class=\"ul-thumb\" style=\"background:url('/assets/photo-cat.png') center/cover\"></span><span class=\"ul-thumb\" style=\"background:url('/assets/cover-mountain.png') center/cover\"></span><span class=\"ul-thumb add\">＋</span></div>","when":"When uploading an avatar or cover, the selected image needs to be displayed"},{"demo":"<div class=\"ul-wrap\" style=\"width:230px\"><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>Requirements document.pdf</b></span><span class=\"ul-done\">✓</span></div><div class=\"ul-file\"><span class=\"ul-ico\">📄</span><span class=\"ul-meta\"><b>Design draft.fig</b><div class=\"demo-progress\"><div class=\"bar-track\"><div class=\"bar-fill\" data-fill=\"66\"></div></div></div></span><span class=\"ul-pct\">66%</span></div></div>","when":"When uploading multiple files, show each file’s progress separately."}]},"usageMocks":{"ul-drag":"<div class=\"mk-win\"><div style=\"border:1.5px dashed var(--border);border-radius:6px;padding:10px 8px;text-align:center;font-size:12px;color:var(--text-3)\">⬆ 把文件拖到这里，或点击选择</div></div>","ul-img":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"gap:6px\"><span style=\"width:34px;height:34px;border-radius:5px;background:var(--bg-hover);display:flex;align-items:center;justify-content:center;font-size:14px\">🖼</span><span style=\"width:34px;height:34px;border-radius:5px;background:var(--bg-hover);display:flex;align-items:center;justify-content:center;font-size:14px\">🖼</span><span style=\"width:34px;height:34px;border-radius:5px;border:1.5px dashed var(--border);display:flex;align-items:center;justify-content:center;color:var(--text-3)\">＋</span></div></div>","ul-list":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"color:var(--text)\">📄 需求文档.pdf</span><span style=\"color:var(--green)\">✓</span></div><div class=\"mk-row between\"><span style=\"color:var(--text)\">📄 设计稿.fig</span><span style=\"color:var(--text-3)\">66%</span></div><span class=\"mk-progress\" style=\"width:100%\"><i style=\"width:66%\"></i></span></div>","ul-limit":"<div class=\"mk-win\"><div style=\"border:1.5px dashed var(--border);border-radius:6px;padding:8px;text-align:center;font-size:12px;color:var(--text-3)\">⬆ 点击或拖拽上传</div><span style=\"font-size:12px;color:var(--text-3);text-align:center\">支持 JPG / PNG，单个不超过 10MB</span></div>","ul-link":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"width:44px;color:var(--text-3)\">视频链接</span><span class=\"mk-btn outline\">⬆ 上传</span></div><span style=\"font-size:12px;color:var(--red)\">用户手里只有一个 URL，给个输入框就行</span></div>","ul-many":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"color:var(--text)\">🖼 IMG_001.jpg</span><span style=\"color:var(--text-3);font-size:12px\">12 / 38</span></div><span class=\"mk-progress\" style=\"width:100%\"><i style=\"width:31%\"></i></span><span style=\"font-size:12px;color:var(--red)\">大量小文件逐个上传，耗时且难以管理进度</span></div>","ul-fail":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"color:var(--text)\">📄 视频素材.mp4</span><span style=\"color:var(--red)\">✕ 失败</span></div><span class=\"mk-progress stuck\" style=\"width:100%\"><i style=\"width:82%\"></i></span><span style=\"font-size:12px;color:var(--red)\">缺少重试入口，失败后需要重新上传</span></div>","ul-big":"<div class=\"mk-win\"><div class=\"mk-row between\"><span style=\"color:var(--text)\">🎬 成片-4K.mp4（1.8GB）</span><span style=\"color:var(--text-3)\">99%</span></div><span class=\"mk-progress\" style=\"width:100%\"><i style=\"width:99%\"></i></span><span style=\"font-size:12px;color:var(--red)\">传到 99% 才提示超出大小限制</span></div>"}}}