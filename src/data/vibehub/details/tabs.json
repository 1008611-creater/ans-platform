span class=\"mk-tab \">日志</span></div><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:80%\"></i></div>","tabs-flat":"<div class=\"mk-win\"><div class=\"mk-tabs\"><span class=\"mk-tab on\">评论</span><span class=\"mk-tab \">历史</span><span class=\"mk-tab \">收藏</span></div><span style=\"font-size:12px;color:var(--text-3)\">不用跳转，点一下就换内容</span></div>","tabs-short":"<div class=\"mk-win\"><div class=\"mk-tabs\"><span class=\"mk-tab on\">全部</span><span class=\"mk-tab \">进行</span><span class=\"mk-tab \">完成</span></div></div>","tabs-steps":"<div class=\"mk-win\"><div class=\"mk-steps\"><span class=\"mk-step on\"><i>1</i>填写信息</span><span class=\"mk-step-bar\"></span><span class=\"mk-step on\"><i>2</i>确认订单</span><span class=\"mk-step-bar\"></span><span class=\"mk-step \"><i>3</i>完成支付</span></div></div>","tabs-overflow":"<div class=\"mk-win\"><div class=\"mk-tabs\" style=\"overflow:hidden\"><span class=\"mk-tab on\">全部</span><span class=\"mk-tab\">前端</span><span class=\"mk-tab\">后端</span><span class=\"mk-tab\">设计</span><span class=\"mk-tab\">运营</span><span class=\"mk-tab\">产品</span><span class=\"mk-tab\">测试</span><span class=\"mk-tab\">数据</span></div><span style=\"font-size:12px;color:var(--text-3)\">放不下的标签会被挤没</span></div>","tabs-columns":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"align-items:stretch\">\n      <div class=\"mk-win\" style=\"flex:1\"><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div>\n      <div class=\"mk-win\" style=\"flex:1\"><i class=\"mk-line\" style=\"width:70%\"></i><i class=\"mk-line\" style=\"width:85%\"></i></div></div><span style=\"font-size:12px;color:var(--text-3)\">左右分栏，两边同时对照</span></div>","tabs-lost":"<div class=\"mk-win\"><div class=\"mk-tabs\"><span class=\"mk-tab on\">基本信息</span><span class=\"mk-tab \">高级设置</span></div><span class=\"mk-input \">还没保存的内容…</span><span style=\"font-size:12px;color:var(--red)\">切走标签，填的内容没了</span></div>"}}}