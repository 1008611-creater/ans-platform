mo-tabs\" style=\"max-width:none\"><button class=\"tab\">Overview</button><button class=\"tab\">Config</button><button class=\"tab active\">Logs</button></div>\n      <div style=\"margin-top:10px;background:#1d2129;border-radius:8px;padding:10px 12px;font-family:monospace;font-size:12px;line-height:1.9;color:#a9b0bd\">\n        <div><span style=\"color:#86909c\">14:32:05</span> build completed in 3.2s</div>\n        <div><span style=\"color:#86909c\">14:32:06</span> deploying to production…</div>\n        <div style=\"color:#7ee2a8\"><span style=\"color:#86909c\">14:32:09</span> ✓ deploy success</div>\n      </div>\n    </div>","<div style=\"max-width:440px;margin:0 auto\">\n      <div class=\"demo-tabs\" style=\"max-width:none\"><button class=\"tab active\">This Week</button><button class=\"tab\">This Month</button><button class=\"tab\">This Quarter</button></div>\n      <div style=\"display:flex;gap:10px;margin-top:12px\">\n        <div style=\"flex:1;border:1px solid var(--border-light);border-radius:8px;padding:10px 12px\"><div style=\"font-size:12px;color:var(--text-3)\">Visits</div><div style=\"font-size:18px;font-weight:600;margin:2px 0\">12,480</div><div style=\"font-size:12px;color:var(--green)\">↑ 18%</div></div>\n        <div style=\"flex:1;border:1px solid var(--border-light);border-radius:8px;padding:10px 12px\"><div style=\"font-size:12px;color:var(--text-3)\">New Users</div><div style=\"font-size:18px;font-weight:600;margin:2px 0\">326</div><div style=\"font-size:12px;color:var(--green)\">↑ 6%</div></div>\n        <div style=\"flex:1;border:1px solid var(--border-light);border-radius:8px;padding:10px 12px\"><div style=\"font-size:12px;color:var(--text-3)\">Conversion</div><div style=\"font-size:18px;font-weight:600;margin:2px 0\">4.2%</div><div style=\"font-size:12px;color:var(--red)\">↓ 0.8%</div></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><span class=\"tabs-anat\"><span class=\"tabs-anat-bar\"><span class=\"ap\" data-ap=\"tab\"><span class=\"tabs-anat-tab\">全部</span></span><span class=\"ap\" data-ap=\"active\"><span class=\"tabs-anat-tab on\">进行中</span></span><span class=\"tabs-anat-tab\">已完成</span></span><span class=\"ap\" data-ap=\"panel\"><span class=\"tabs-anat-panel\">进行中的 6 个项目…</span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><span class=\"tabs-anat\"><span class=\"tabs-anat-bar\"><span class=\"ap\" data-ap=\"tab\"><span class=\"tabs-anat-tab\">All</span></span><span class=\"ap\" data-ap=\"active\"><span class=\"tabs-anat-tab on\">In progress</span></span><span class=\"tabs-anat-tab\">Completed</span></span><span class=\"ap\" data-ap=\"panel\"><span class=\"tabs-anat-panel\">6 projects in progress...</span></span></span></span>","parts":[{"key":"root","cn":"标签页","en":"Tabs","desc":"整组标签 + 面板的容器","desc_en":"Container for the whole tab bar and its panel"},{"key":"tab","cn":"标签项","en":"Tab","desc":"可点击切换，文案要短","desc_en":"Click to switch — keep the label short"},{"key":"active","cn":"当前标签","en":"Active Tab","desc":"高亮 + 下划线，告诉用户现在在哪","desc_en":"A highlight and underline show users which tab is active"},{"key":"panel","cn":"内容面板","en":"Tab Panel","desc":"当前标签对应的内容区","desc_en":"The content area for the current tab"}]},"variants":[{"cn":"线条型","en":"Line","demo":"<div class=\"demo-tabs-wrap\"><div class=\"demo-tabs\"><button class=\"tab active\" data-panel=\"全部 24 个项目\">全部</button><button class=\"tab\" data-panel=\"进行中 6 个项目\">进行中</button><button class=\"tab\" data-panel=\"已完成 18 个项目\">已完成</button></div><div class=\"tabs-panel\">全部 24 个项目</div></div>","demo_en":"<div class=\"demo-tabs-wrap\"><div class=\"demo-tabs\"><button class=\"tab active\" data-panel=\"All 24 projects\">All</button><button class=\"tab\" data-panel=\"6 projects in progress\">Active</button><button class=\"tab\" data-panel=\"18 projects completed\">Done</button></div><div class=\"tabs-panel\">All 24 projects</div></div>","when":"默认款，下划线轻，不抢内容风头","when_en":"The default — a light underline that never upstages the content"},{"cn":"卡片型","en":"Card","demo":"<span class=\"tabs-v-card\"><i class=\"on\">全部</i><i>进行中</i><i>已完成</i></span>","demo_en":"<span class=\"tabs-v-card\"><i class=\"on\">All</i><i>Active</i><i>Done</i></span>","when":"想让标签分组感更强、更像独立区块","when_en":"When you want the tabs to feel like separate blocks of their own"},{"cn":"胶囊型","en":"Capsule","demo":"<span class=\"tabs-v-pill\"><i class=\"on\">全部</i><i>进行中</i><i>已完成</i></span>","demo_en":"<span class=\"tabs-v-pill\"><i class=\"on\">All</i><i>Active</i><i>Done</i></span>","when":"放在工具栏等小空间，更轻巧","when_en":"A lighter fit for tight spots like toolbars"}],"use":[{"t":"同一页面切换<b>几组平级内容</b>：全部 / 进行中 / 已完成","m":"tabs-status"},{"t":"<b>详情页内容分块</b>：概览、配置、日志，不用来回跳页","m":"tabs-detail"},{"t":"平级内容较少，且用户会频繁来回查看","m":"tabs-flat"},{"t":"标签文案<b>简短直接</b>，便于快速扫读","m":"tabs-short"}],"dont":[{"t":"内容有明确先后顺序时，使用 {c:steps} 更合适","m":"tabs-steps","bad":true},{"t":"标签过多且无法在可用宽度内清楚显示时，应改用 {c:menu} 或 {c:select}","m":"tabs-overflow","bad":true},{"t":"两组内容需要<b>左右对照</b> → 并排展示，别藏进标签","m":"tabs-columns","bad":true},{"t":"标签里放着<b>未保存的表单</b>，一切换内容就丢","m":"tabs-lost","bad":true}],"lessonPractice":{"title":"项目详情页要在“概览、成员、日志”之间切换，三个区域都属于当前项目。怎样组织最合适？","options":[{"id":"peer-tabs","label":"使用页签切换三个同级内容区，并标出当前项","feedback":"三个区域共享同一个项目上下文且层级平行，页签能保持当前位置并切换内容。","correct":true},{"id":"site-navbar","label":"把三个入口加入全站顶部导航栏","feedback":"顶部导航服务跨页面的核心目的地，不适合承载某个项目内部的局部内容。","correct":false},{"id":"ordered-steps","label":"做成必须依次完成的三个步骤","feedback":"概览、成员和日志没有完成顺序，用步骤条会制造不存在的流程约束。","correct":false}],"en":{"title":"A project detail page switches among Overview, Members, and Logs, all within the current project. How should it be organized?","options":[{"id":"peer-tabs","label":"Use tabs for the three peer sections and mark the active one","feedback":"The sections share one project context and the same level, so tabs preserve context while switching content.","correct":true},{"id":"site-navbar","label":"Add all three destinations to the global top navigation","feedback":"Global navigation serves major destinations across the site, not sections inside one project.","correct":false},{"id":"ordered-steps","label":"Turn them into three steps that must be completed in order","feedback":"Overview, Members, and Logs have no completion order, so steps would invent a false workflow.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"在项目详情中用页签切换“概览、成员、日志”，始终标出当前页签。请保留各页签合理的状态，并验证鼠标、键盘切换以及小屏下不会被裁掉。","en":{"title":"You can say this to an AI Agent","text":"Use tabs for Overview, Members, and Logs inside project details and always show the active tab. Preserve appropriate section state and test mouse, keyboard, and narrow-screen behavior."}},"references":[{"title":"Tabs 标签页模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/tabs/","title_en":"Tabs Pattern"}],"scenes":["列表状态筛选","设置页分块","详情页 概览 / 配置 / 日志","仪表盘视角切换"],"en":{"use":[{"t":"Sections of one record","m":"tabs-status"},{"t":"Switch between related views","m":"tabs-detail"},{"t":"Organize a compact settings page","m":"tabs-flat"},{"t":"Separate content that shares the same context","m":"tabs-short"}],"dont":[{"t":"Use tabs for the product's main navigation","m":"tabs-steps","bad":true},{"t":"Create so many tabs that they no longer fit","m":"tabs-overflow","bad":true},{"t":"Hide required steps behind optional-looking tabs","m":"tabs-columns","bad":true},{"t":"Discard unsaved input silently when switching","m":"tabs-lost","bad":true}],"scenes":["Project detail","Account settings","Analytics views","Code and preview"],"sceneUI":["<div style=\"max-width:420px;margin:0 auto\">\n      <div class=\"demo-tabs\" style=\"max-width:none\"><button class=\"tab active\">All 24</button><button class=\"tab\">Active 6</button><button class=\"tab\">Done 18</button></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:10px 2px;border-bottom:1px solid var(--border-light)\"><span style=\"font-