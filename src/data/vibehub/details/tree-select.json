nel\" style=\"flex:1.2;min-width:0\">\n          <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check half\"></i>研发部</div>\n          <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>林小hu</div>\n          <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>阿机</div>\n          <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>王大力</div>\n        </div>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"display:flex;gap:10px;max-width:400px;margin:0 auto;align-items:flex-start\">\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">Role: Operations Specialist</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin:3px 0 8px\">Viewable data range</div>\n        <div style=\"display:flex;gap:4px;flex-wrap:wrap\"><span class=\"demo-tag blue\">R&D Department ×</span><span class=\"demo-tag blue\">Front-End Group ×</span></div>\n        <button class=\"btn btn-primary\" style=\"margin-top:10px;padding:5px 12px;font-size:12px\">Save permissions</button>\n      </div>\n      <div class=\"ts-panel\" style=\"flex:1;min-width:0\">\n        <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check on\"></i>R&D Department</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Front-end group</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Backend Group</div>\n        <div class=\"ts-node\"><i class=\"ts-caret\">▸</i><i class=\"ts-check\"></i>Design Department</div>\n      </div>\n    </div>","<div class=\"tree-select-sc-mask\" style=\"height:150px\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:7px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:82%\"></i></div>\n      <div class=\"veil\"></div>\n      <div class=\"pop\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:10px\">Share \"Q3 Planning Document\"</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:5px\">Who can see</div>\n        <div class=\"ts-box\" style=\"width:100%;font-size:12px;padding:5px 9px\"><span class=\"demo-tag blue\">R&D Department ×</span><span class=\"demo-tag blue\">Marketing Department ×</span><i class=\"select-arrow\" style=\"margin-left:auto\"></i></div>\n      </div>\n    </div>","<div style=\"display:flex;gap:10px;max-width:400px;margin:0 auto;align-items:flex-start\">\n      <div style=\"flex:1.2;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:10px;flex-wrap:wrap\">\n          <b style=\"font-size:13px\">Content data</b><span class=\"demo-tag blue\">Apparel ×</span><span class=\"demo-tag blue\">Home ×</span>\n        </div>\n        <i class=\"mk-line\" style=\"width:92%;margin-bottom:8px\"></i>\n        <i class=\"mk-line\" style=\"width:68%;margin-bottom:8px\"></i>\n        <i class=\"mk-line\" style=\"width:80%\"></i>\n      </div>\n      <div class=\"ts-panel\" style=\"flex:1;min-width:0\">\n        <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check half\"></i>Apparel</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Men's clothing</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Women's clothing</div>\n        <div class=\"ts-node\"><i class=\"ts-caret\">▸</i><i class=\"ts-check on\"></i>Home</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:12px;color:var(--text-2);margin-bottom:6px\">Add reviewer</div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start\">\n        <div style=\"flex:1;display:flex;flex-direction:column;gap:8px;min-width:0\">\n          <span style=\"display:flex;align-items:center;gap:6px\"><img src=\"/assets/avatar-fox.png\" style=\"width:20px;height:20px;border-radius:50%\" alt=\"\"><span style=\"font-size:12px;color:var(--text)\">Alex Chen</span><span class=\"demo-tag blue\" style=\"margin-left:auto\">Selected</span></span>\n          <span style=\"display:flex;align-items:center;gap:6px\"><img src=\"/assets/avatar-robot.png\" style=\"width:20px;height:20px;border-radius:50%\" alt=\"\"><span style=\"font-size:12px;color:var(--text)\">Aji</span><span class=\"demo-tag blue\" style=\"margin-left:auto\">Selected</span></span>\n        </div>\n        <div class=\"ts-panel\" style=\"flex:1.2;min-width:0\">\n          <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check half\"></i>R&D Department</div>\n          <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Alex Chen</div>\n          <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Aji</div>\n          <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Wang Dali</div>\n        </div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"box\"><span class=\"ts-box\"><span class=\"demo-tag blue\">研发部</span><i class=\"select-arrow\"></i></span></span><span class=\"ap\" data-ap=\"panel\"><span class=\"ts-panel\"><span class=\"ap\" data-ap=\"parent\"><span class=\"ts-node\"><i class=\"ts-caret\">▾</i><span class=\"ap\" data-ap=\"check\"><i class=\"ts-check on\"></i></span>研发部</span></span><span class=\"ap\" data-ap=\"child\"><span class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>前端组</span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"box\"><span class=\"ts-box\"><span class=\"demo-tag blue\">R&D</span><i class=\"select-arrow\"></i></span></span><span class=\"ap\" data-ap=\"panel\"><span class=\"ts-panel\"><span class=\"ap\" data-ap=\"parent\"><span class=\"ts-node\"><i class=\"ts-caret\">▾</i><span class=\"ap\" data-ap=\"check\"><i class=\"ts-check on\"></i></span>R&D Department</span></span><span class=\"ap\" data-ap=\"child\"><span class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Front-end group</span></span></span></span>","parts":[{"key":"box","cn":"触发框","en":"Trigger","desc":"用标签回显已勾选的节点","desc_en":"Shows selected nodes as labels"},{"key":"panel","cn":"树面板","en":"Tree Panel","desc":"显示完整树状选项的浮层","desc_en":"Overlay showing full tree options"},{"key":"parent","cn":"父节点","en":"Parent Node","desc":"可展开收起，勾选通常带动子节点","desc_en":"Can expand and collapse. Selecting a parent usually affects its children."},{"key":"check","cn":"勾选框","en":"Checkbox","desc":"标记选中，「半选」表示部分子项选中","desc_en":"Marks selected items; “partially selected” means only some child items are selected"},{"key":"child","cn":"子节点","en":"Child Node","desc":"缩进一级，体现从属关系","desc_en":"Indent one level to reflect affiliation"}]},"variants":[{"cn":"单选树","en":"Single","demo":"<div class=\"ts-panel\" style=\"min-width:150px\"><div class=\"ts-node\"><i class=\"ts-caret\">▾</i>研发部</div><div class=\"ts-node ts-l1 on\">前端组</div><div class=\"ts-node ts-l1\">后端组</div></div>","demo_en":"<div class=\"ts-panel\" style=\"min-width:150px\"><div class=\"ts-node\"><i class=\"ts-caret\">▾</i>R&D Department</div><div class=\"ts-node ts-l1 on\">Front-end group</div><div class=\"ts-node ts-l1\">Back-end group</div></div>","when":"层级数据里只挑一个节点时用","when_en":"Used when selecting only one node in hierarchical data"},{"cn":"多选树","en":"Multiple","demo":"<div class=\"ts-panel\" style=\"min-width:150px\"><div class=\"ts-node\"><i class=\"ts-check on\"></i>研发部</div><div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>前端组</div><div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>后端组</div></div>","demo_en":"<div class=\"ts-panel\" style=\"min-width:150px\"><div class=\"ts-node\"><i class=\"ts-check on\"></i>R&D department</div><div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Front-end group</div><div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Backend Group</div></div>","when":"要跨分支勾好几个节点时用","when_en":"When users need to select several nodes across branches."},{"cn":"父子联动","en":"Cascade Check","demo":"<div class=\"ts-panel\" style=\"min-width:150px\"><div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check half\"></i>研发部</div><div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>前端组</div><div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>后端组</div></div>","demo_en":"<div class=\"ts-panel\" style=\"min-width:150px\"><div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check half\"></i>R&D Department</div><div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Front-end group</div><div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Backend Group</div></div>","when":"勾选父级时需要同步选择整个分支","when_en":"When selecting a parent should select its entire branch."},{"cn":"可搜索","en":"Searchable","demo":"<div class=\"ts-panel\" style=\"min-width:170px\"><div class=\"ts-node on\">研发部 / <b style=\"color:var(--brand)\">前端</b>组</div><div class=\"ts-node\">设计部 / <b style=\"color:var(--brand)\">前端</b>体验组</div></div>","demo_en":"<div class=\"ts-panel\" style=\"min-width:170px\"><div class=\"ts-node on\">R&D Department / <b style=\"color:var(--brand)\">Front-End</b> Group</div><div class=\"ts-node\">Design Department / <b style=\"color:var(--brand)\">Front-End</b> Experience Group</div></div>","when":"树太大时先搜出目标节点再勾","when_en":"When the tree is large, let users search for the target node first."}],"use":[{"t":"<b>按部门分配权限</b>：勾选几个部门的成员","m":"ts-dept"},{"t":"<b>跨类目多选</b>：数据范围涉及多个分类","m":"ts-cat"},{"t":"<b>父子联动要先定规则</b>：确认父级、子级和半选状态最终提交什么","m":"ts-parent"},{"t":"<b>树太大时先搜再选</b>：搜索定位到目标节点","m":"ts-search"}],"dont":[{"t":"只选<b>一个叶子节点</b>：使用 {c:cascader}","m":"sel-cascader"},{"t":"<b>选项之间没有层级</b>：使用 {c:checkbox} 平铺","m":"sel-checkbox"},{"t":"只需<b>展示结构</b>而不需要选择：使用 {c:tree}","m":"ts-view","bad":true},{"t":"数据没有真实父子关系时，使用平铺选择控件而非树选择","m":"ts-fake","bad":true}],"lessonPractice":{"title":"权限范围需要跨不同部门勾选多个小组，并显示父级半选状态。哪种控件更合适？","options":[{"id":"multi-tree-select","label":"使用多选树选择器，明确父子联动规则，并让标签、半选状态和提交节点保持一致","feedback":"对。任务需要看见层级并跨分支多选，树选择器能同时表达父子关系和选择状态。","correct":true},{"id":"single-cascader-path","label":"使用级联选择器，每次只保留从公司到一个小组的一条路径","feedback":"级联选择适合一条路径，无法同时保留多个部门下的小组范围。","correct":false},{"id":"flat-options","label":"把所有小组放进一个无层级的普通下拉框，父级范围由后端自行猜测","feedback":"扁平列表隐藏了部门关系，后端也不能从未表达的选择规则中可靠推断父级范围。","correct":false}],"en":{"title":"An access scope must select several groups across departments and show partially selected parents. Which control fits?","options":[{"id":"multi-tree-select","label":"Use a multi-select tree, define parent-child selection rules, and keep labels, partial states, and submitted nodes consistent","feedback":"Correct. The task needs visible hierarchy and cross-branch selection, which a tree selector can express together.","correct":true},{"id":"single-cascader-path","label":"Use a cascader that keeps only one path from the company to a single group","feedback":"A cascader fits one path and cannot preserve groups selected under several departments.","correct":false},{"id":"flat-options","label":"Put every group in one flat dropdown and let the backend infer parent scopes","feedback":"A flat list hides department relationships, and the backend cannot reliably infer rules the interface never expressed.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"把“可查看数据范围”改成支持多选的树选择器。勾选部门时同时选中全部子组，只选中部分子组时让父级显示半选；关闭面板后用标签回显所选范围，提交时保存真实节点 ID。节点较多时支持搜索。改完后测试展开收起、父级全选、取消一个子级、跨分支选择、搜索和提交，确认半选状态、标签和提交值始终一致。","en":{"title":"You can say this to an AI Agent","text":"Change “Visible data scope” to a multi-select tree selector. Selecting a department should select all of its child groups, while selecting only some children should show the parent as partially selected. After the panel closes, show selected scopes as labels and submit the real node IDs. Add search when the tree is large. Test expand and collapse, parent selection, clearing one child, cross-branch selection, search, and submission, and confirm the partial state, labels, and submitted values stay consistent."}},"demoDetail":"<div class=\"ts-wrap\">\n    <div class=\"ts-box\"><span class=\"demo-tag blue\">研发部</span><span class=\"demo-tag blue\">前端组</span><i class=\"select-arrow\"></i></div>\n    <div class=\"ts-panel\">\n      <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check on\"></i>研发部</div>\n      <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>前端组</div>\n      <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>后端组</div>\n      <div class=\"ts-node ts-l2\"><i class=\"ts-check\"></i>服务端</div>\n      <div class=\"ts-node\"><i class=\"ts-caret\">▸</i><i class=\"ts-check\"></i>设计部</div>\n    </div>\n  </div>","references":[{"title":"Tree View 树视图模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/treeview/","title_en":"Tree View Pattern"}],"scenes":["权限分配","可见范围设置","多类目筛选","部门人员选择"],"en":{"demoDetail":"<div class=\"ts-wrap\">\n    <div class=\"ts-box\"><span class=\"demo-tag blue\">R&D Department</span><span class=\"demo-tag blue\">Front-end group</span><i class=\"select-arrow\"></i></div>\n    <div class=\"ts-panel\">\n      <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check on\"></i>R&D Department</div>\n      <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Front-end group</div>\n      <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Backend Group</div>\n      <div class=\"ts-node ts-l2\"><i class=\"ts-check\"></i>Server</div>\n      <div class=\"ts-node\"><i class=\"ts-caret\">▸</i><i class=\"ts-check\"></i>Design Department</div>\n    </div>\n  </div>","use":[{"t":"Department selection","m":"ts-dept"},{"t":"Nested categories","m":"ts-cat"},{"t":"Permission scope","m":"ts-parent"},{"t":"Choose across several hierarchy branches","m":"ts-search"}],"dont":[{"t":"Force flat data into a tree","m":"sel-cascader"},{"t":"Hide the meaning of partial selection","m":"sel-checkbox"},{"t":"Load a huge tree without search or lazy loading","m":"ts-view","bad":true},{"t":"Submit a different level from the one the user sees","m":"ts-fake","bad":true}],"scenes":["Team directory","Category assignment","Access control","Folder picker"],"sceneUI":["<div style=\"display:flex;gap:10px;max-width:400px;margin:0 auto;align-items:flex-start\">\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">Role: Operations Specialist</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin:3px 0 8px\">Viewable data range</div>\n        <div style=\"display:flex;gap:4px;flex-wrap:wrap\"><span class=\"demo-tag blue\">R&D Department ×</span><span class=\"demo-tag blue\">Front-End Group ×</span></div>\n        <button class=\"btn btn-primary\" style=\"margin-top:10px;padding:5px 12px;font-size:12px\">Save permissions</button>\n      </div>\n      <div class=\"ts-panel\" style=\"flex:1;min-width:0\">\n        <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check on\"></i>R&D Department</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>Front-end group</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>Backend Group</div>\n        <div class=\"ts-node\"><i class=\"ts-caret\">▸</i><i class=\"ts-check\"></i>Design Department</div>\n      </div>\n    </div>","<div class=\"tree-select-sc-mask\" style=\"height:150px\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:7px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:82%\"></i></div>\n      <div class=\"veil\"></div>\n      <div class=\"pop\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:10px\">Share \"Q3 Planning Document\"</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:5px\">Who can see</div>\n        <div class=\"ts-box\" style=\"width:100%;font-size:12px;padding:5px 9px\"><span class=\"demo-tag blue\">