{"__formatVersion":2,"__revision":"c08bd3fe6ed1e8ad","__entryId":"tree-select","entry":{"sceneUI":["<div style=\"display:flex;gap:10px;max-width:400px;margin:0 auto;align-items:flex-start\">\n      <div style=\"flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow-card)\">\n        <b style=\"font-size:13px\">角色：运营专员</b>\n        <div style=\"font-size:12px;color:var(--text-3);margin:3px 0 8px\">可查看的数据范围</div>\n        <div style=\"display:flex;gap:4px;flex-wrap:wrap\"><span class=\"demo-tag blue\">研发部 ×</span><span class=\"demo-tag blue\">前端组 ×</span></div>\n        <button class=\"btn btn-primary\" style=\"margin-top:10px;padding:5px 12px;font-size:12px\">保存权限</button>\n      </div>\n      <div class=\"ts-panel\" style=\"flex:1;min-width:0\">\n        <div class=\"ts-node\"><i class=\"ts-caret\">▾</i><i class=\"ts-check on\"></i>研发部</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check on\"></i>前端组</div>\n        <div class=\"ts-node ts-l1\"><i class=\"ts-check\"></i>后端组</div>\n        <div class=\"ts-node\"><i class=\"ts-caret\">▸</i><i class=\"ts-check\"></i>设计部</div>\n      </div>\n    </div>","<div class=\"tree-select-sc-mask\" style=\"height:150px\">\n      <div style=\"padding:14px;display:flex;flex-direction:column;gap:7px\"><i class=\"mk-line\" style=\"width:60%\"></i><i class=\"mk-line\" style=\"width:82%\"></i></div>\n      <div class=\"veil\"></div>\n      <div class=\"pop\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:10px\">分享「Q3 规划文档」</div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:5px\">谁可以看</div>\n        <div class=\"ts-box\" style=\"width:100%;font-size:12px;padding:5px 9px\"><span class=\"demo-tag blue\">研发部 ×</span><span class=\"demo-tag blue\">市场部 ×</span><i class=\"select-arrow\" style=\"margin-left:auto\"></i></div>\n      </div>\n    </div>","<div style=\"display:flex;gap:10px;max-width:400px;margin:0 auto;align-it