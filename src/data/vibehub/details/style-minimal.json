ground:#0a0a0c;color:#fff;text-align:center;font-size:12px;font-weight:600;border-radius:7px;padding:6px 0;margin-top:12px\">Upgrade Pro</div>\n        </div>\n        <div style=\"flex:1;padding:16px 18px\">\n          <div style=\"font-size:12px;color:#8a8a93\">Team version</div>\n          <div style=\"font-size:22px;font-weight:700;color:#0a0a0c;margin-top:4px\">Customized</div>\n          <div style=\"font-size:12px;color:#61616a;margin-top:8px;line-height:1.8\">SSO single sign-on<br>Audit log<br>Dedicated account manager</div>\n          <div style=\"border:1px solid #e2e2e7;text-align:center;font-size:12px;border-radius:7px;padding:6px 0;margin-top:12px;color:#3c3c43\">Contact sales</div>\n        </div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"ink\"><span class=\"style-minimal-chip\"><i style=\"background:#0a0a0c\"></i>近黑正文 #0A0A0C</span></span>\n      <span class=\"ap\" data-ap=\"gray\"><span class=\"style-minimal-chip\"><i style=\"background:#6d6d76\"></i>次要灰 #6D6D76</span></span>\n      <span class=\"ap\" data-ap=\"hairline\"><span class=\"style-minimal-chip\"><i style=\"background:#f0f0f3;border-color:#e2e2e7\"></i>细分割线 1px</span></span>\n      <span class=\"ap\" data-ap=\"accent\"><span class=\"style-minimal-chip\"><i style=\"background:#5e6ad2\"></i>强调色示例</span></span>\n      <span class=\"ap\" data-ap=\"radius\"><span class=\"style-minimal-chip\"><i style=\"background:#fff;border:1px solid #d9d9de;border-radius:8px\"></i>圆角 6-8px</span></span>\n      <span class=\"ap\" data-ap=\"shadow\"><span class=\"style-minimal-chip\"><i style=\"background:#fff;border:none;box-shadow:0 1px 3px rgba(0,0,0,.15)\"></i>隐形阴影</span></span>\n    </span>","demo_en":"<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"ink\"><span class=\"style-minimal-chip\"><i style=\"background:#0a0a0c\"></i>near black text #0A0A0C</span></span>\n      <span class=\"ap\" data-ap=\"gray\"><span class=\"style-minimal-chip\"><i style=\"background:#6d6d76\"></i>Minor gray #6D6D76</span></span>\n      <span class=\"ap\" data-ap=\"hairline\"><span class=\"style-minimal-chip\"><i style=\"background:#f0f0f3;border-color:#e2e2e7\"></i>Thin dividing line 1px</span></span>\n      <span class=\"ap\" data-ap=\"accent\"><span class=\"style-minimal-chip\"><i style=\"background:#5e6ad2\"></i>Accent Color Example</span></span>\n      <span class=\"ap\" data-ap=\"radius\"><span class=\"style-minimal-chip\"><i style=\"background:#fff;border:1px solid #d9d9de;border-radius:8px\"></i>Rounded corners 6-8px</span></span>\n      <span class=\"ap\" data-ap=\"shadow\"><span class=\"style-minimal-chip\"><i style=\"background:#fff;border:none;box-shadow:0 1px 3px rgba(0,0,0,.15)\"></i>Invisible shadow</span></span>\n    </span>","parts":[{"key":"ink","cn":"正文色","en":"Ink","desc":"示例使用近黑色；纯黑或近黑都可以，关键是与背景保持足够对比度","desc_en":"The example uses near black; either pure black or near black is acceptable, the key is to maintain sufficient contrast with the background"},{"key":"gray","cn":"次要灰","en":"Gray","desc":"副文、说明和占位可以使用层级较低的灰色，但仍要保证对比度","desc_en":"Subtext, descriptions and placeholders can use lower gray levels, but still maintain contrast."},{"key":"hairline","cn":"细分割线","en":"Hairline","desc":"示例用 1px 细线轻量分区；边界仍要清楚，不能淡到看不见","desc_en":"The example uses 1px thin lines for lightweight partitioning; the border must still be clear and cannot be so faded that it cannot be seen."},{"key":"accent","cn":"强调色","en":"Accent","desc":"用于突出主操作、链接或关键状态，数量和范围由信息层级决定","desc_en":"Used to highlight main operations, links or key states, the number and scope are determined by the information hierarchy"},{"key":"radius","cn":"圆角","en":"Radius","desc":"示例使用小圆角；实际数值要与品牌气质和组件尺寸匹配","desc_en":"Example uses small rounded corners; actual values ​​should match brand ethos and component dimensions"},{"key":"shadow","cn":"轻量阴影","en":"Shadow","desc":"示例用轻阴影区分浮层；需要看得出层级，也要避免脏重","desc_en":"The example uses light shading to distinguish floating layers; it is necessary to see the layers and avoid dirty and heavy layers."}]},"use":[{"t":"SaaS 和效率工具，让功能与信息成为重点","m":"style-minimal-use-saas"},{"t":"需求尚未稳定时，先搭清结构再补品牌特征","m":"style-minimal-use-default"},{"t":"内容本身足够有力，界面可以减少干扰","m":"style-minimal-use-content"},{"t":"需要长期迭代，用少量规则保持扩展一致","m":"style-minimal-use-longterm"}],"dont":[{"t":"高情绪活动页直接照搬冷静模板，可能无法形成需要的节奏","m":"style-minimal-dont-promo","bad":true},{"t":"把没有对齐、层级和细节的半成品当成简约","m":"style-minimal-dont-shabby","bad":true},{"t":"主题色到处使用，反而失去重点","m":"style-minimal-dont-manycolor","bad":true},{"t":"不看受众就全站使用冷灰和低情绪表达","m":"style-minimal-dont-kid","bad":true}],"principles":[{"t":"<b>先用留白组织关系</b>：相关内容靠近，不相关内容拉开；具体距离按信息密度和屏幕调整","m":"style-minimal-space"},{"t":"<b>中性色为主，强调色有明确职责</b>：主操作、链接、状态可以用不同信号，但不要让颜色彼此争抢","m":"style-minimal-color"},{"t":"<b>建立可复用的间距尺度</b>：例如以 4 或 8 为基础组合常用值，遇到内容需要时可以例外","m":"style-minimal-grid"},{"t":"<b>层级先靠排版和分组</b>：字号、字重、颜色和分割线共同服务阅读顺序，边框与阴影按需要使用","m":"style-minimal-hier"},{"t":"<b>阴影只表达真实层级</b>：浮层和悬浮内容可以更明显，普通内容不必为了“高级”强行加阴影","m":"style-minimal-shadow"}],"demoDetail":"<div class=\"style-minimal-demo minimal-command\">\n    <header class=\"minimal-top\"><b><i class=\"ti ti-square-rounded\"></i>Routine</b><span>Today</span><span>Projects</span><span>Notes</span><i class=\"ti ti-command minimal-key\"></i><span class=\"minimal-avatar\">L</span></header>\n    <main class=\"minimal-workspace\"><section class=\"minimal-focus\"><small>WEDNESDAY · 23 JUL</small><h2>Good morning, Lin.</h2><p>One clear priority for a calm day.</p><article><div><i class=\"ti ti-circle-check\"></i><span><small>FOCUS BLOCK · 09:30 — 11:00</small><b>Ship the onboarding flow</b></span></div><button>Start focus <i class=\"ti ti-arrow-up-right\"></i></button></article></section><aside class=\"minimal-list\"><div class=\"minimal-list-head\"><b>Today</b><span>3 of 5</span></div><div class=\"minimal-task done\"><i class=\"ti ti-check\"></i><span>Review Q3 narrative</span><em>09:00</em></div><div class=\"minimal-task active\"><i></i><span>Ship the onboarding flow</span><em>11:30</em></div><div class=\"minimal-task\"><i></i><span>Team design critique</span><em>14:00</em></div><div class=\"minimal-task\"><i></i><span>Write weekly note</span><em>16:30</em></div></aside></main>\n    <footer class=\"minimal-footer\"><span><i></i>Everything is up to date</span><span>⌘ K to search</span></footer>\n  </div>","prompt":"帮我把这个效率工具官网做得更简洁。首屏只说明一个核心任务，页面按重要性安排标题、说明、产品画面和注册入口；删掉不能帮助理解或操作的装饰，保留必要的状态和层级。","prompt_en":"Minimal SaaS landing page, generous whitespace, black, white, and gray with one accent color, hairline dividers, subtle shadows, 8px corner radius, 8-point spacing grid, large headlines with tight tracking","references":[{"title":"UX 中的视觉层级","source":"NN/g","url":"https://www.nngroup.com/articles/visual-hierarchy-ux-definition/","title_en":"Visual Hierarchy in UX: Definition"}],"scenes":["Linear 式暗色工具官网","Vercel 式开发者落地页","Stripe 式支付产品页","极简定价页"],"en":{"prompt":"Minimal SaaS landing page, generous whitespace, black, white, and gray with one accent color, hairline dividers, subtle shadows, 8px corner radius, 8-point spacing grid, large headlines with tight tracking","use":[{"t":"Productivity and SaaS interfaces","m":"style-minimal-use-saas"},{"t":"Portfolio and product pages with strong content","m":"style-minimal-use-default"},{"t":"Reading-focused sites","m":"style-minimal-use-content"},{"t":"Products that need a calm, neutral base","m":"style-minimal-use-longterm"}],"dont":[{"t":"Remove labels or guidance just to reduce visual density","m":"style-minimal-dont-promo","bad":true},{"t":"Use low contrast and call it restraint","m":"style-minimal-dont-shabby","bad":true},{"t":"Leave large empty areas with no compositional purpose","m":"style-minimal-dont-manycolor","bad":true},{"t":"Make every section look equally quiet","m":"style-minimal-dont-kid","bad":true}],"principles":[{"t":"Keep only content and controls that support the task","m":"style-minimal-space"},{"t":"Use a small type and spacing system to create hierarchy","m":"style-minimal-color"},{"t":"Limit color, but keep important states easy to distinguish","m":"style-minimal-grid"},{"t":"Let alignment and whitespace organize the page","m":"style-minimal-hier"},{"t":"Use subtle feedback so interactive elements still feel interactive","m":"style-minimal-shadow"}],"scenes":["SaaS homepage","Product dashboard","Portfolio","Editorial page"],"sceneUI":["<div style=\"max-width:640px;margin:0 auto;background:#08090a;border:1px solid #1e1f24;border-radius:14px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:14px;padding:10px 18px;border-bottom:1px solid #16171b;font-size:12px;color:#8a8f98\">\n        <span style=\"display:flex;align-items:center;gap:6px;font-weight:700;color:#f7f8f8;font-size:13px\"><i style=\"width:13px;height:13px;border-radius:4px;background:linear-gradient(135deg,#5e6ad2,#9aa5f5);display:block\"></i>Linearline</span>\n        <span>Function</span><span>Method</span><span>Customer</span><span>Pricing</span>\n        <span style=\"margin-left:auto\">Login</span>\n        <span style=\"background:#f7f8f8;color:#08090a;border-radius:6px;padding:4px 10px;font-weight:600\">Get started</span>\n      </div>\n      <div style=\"padding:34px 24px 30px;text-align:center;background:radial-gradient(ellipse 60% 50% at 50% -10%,rgba(94,106,210,.28),transparent)\">\n        <span style=\"display:inline-block;border:1px solid #2a2b32;border-radius:999px;padding:3px 11px;font-size:12px;color:#8a8f98\">✨ New insights function is online →</span>\n        <div style=\"font-size:34px;font-weight:700;letter-spacing:-1.5px;line-height:1.15;color:#f7f8f8;margin-top:14px\">For modern software teams<br><span style=\"background:linear-gradient(90deg,#f7f8f8,#62666d);-webkit-background-clip:text;background-clip:text;color:transparent\">Collaboration tool</span></div>\n        <div style=\"font-size:13px;color:#8a8f98;margin-top:12px\">Tasks, documents, and roadmaps, all in one place. Fast is an attitude. </div>\n        <div style=\"display:flex;justify-content:center;gap:10px;margin-top:18px\">\n          <span style=\"background:#f7f8f8;color:#08090a;font-size:12px;font-weight:600;border-radius:7px;padding:8px 16px\">Start for free</span>\n          <span style=\"border:1px solid #2a2b32;color:#c4c8cf;font-size:12px;border-radius:7px;padding:8px 16px\">Contact us →</span>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;background-image:radial-gradient(#e7e7e7 1px,transparent 1px);background-size:22px 22px;border:1px solid #eaeaea;border-radius:14px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:14px;padding:10px 18px;font-size:12px;color:#666;border-bottom:1px solid rgba(0,0,0,.05)\">\n        <span style=\"font-size:15px;color:#000;font-weight:700\">▲</span><span>Document</span><span>Template</span><span>Price</span>\n        <span style=\"margin-left:auto;border:1px solid #eaeaea;border-radius:6px;padding:4px 10px;background:#fff\">Login</span>\n        <span style=\"background:#000;color:#fff;border-radius:6px;padding:4px 10px;font-weight:600\">Start deployment</span>\n      </div>\n      <div style=\"padding:36px 24px 32px;text-align:center\">\n        <div style=\"font-size:32px;font-weight:700;letter-spacing:-1.5px;color:#000\">Developed. Preview. Go online. </div>\n        <div style=\"font-size:13px;color:#666;margin-top:10px\">Push your front-end project to the global edge network with just one git push. </div>\n        <div style=\"display:flex;justify-content:center;gap:10px;margin-top:18px\">\n          <span style=\"background:#000;color:#fff;font-size:12px;font-weight:600;border-radius:7px;padding:8px 16px\">Deploy now</span>\n          <span style=\"border:1px solid #eaeaea;background:#fff;color:#333;font-size:12px;border-radius:7px;padding:8px 16px\">View template</span>\n        </div>\n        <div style=\"font-size:12px;color:#999;margin-top:22px\">Trusted by 8,000,000+ developers　·　▲ ■ ● ◆</div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid #eaeef2;border-radius:14px;overflow:hidden;position:relative\">\n      <div style=\"position:absolute;top:-40px;right:-60px;width:340px;height:200px;background:linear-gradient(115deg,#635bff,#8f7bff 45%,#00d4ff);transform:skewY(-8deg);opacity:.9\"></div>\n      <div style=\"display:flex;align-items:center;gap:16px;padding:10px 18px;font-size:12px;color:#425466;position:relative\">\n        <span style=\"font-weight:800;color:#635bff;font-size:14px\">stripay</span><span>Products</span><span>Solutions</span><span>Developers</span>\n        <span style=\"margin-left:auto;color:#635bff;font-weight:600\">Log in →</span>\n      </div>\n      <div style=\"display:flex;gap:16px;padding:16px 24px 24px;position:relative\">\n        <div style=\"flex:1.1\">\n          <div style=\"font-size:27px;font-weight:700;letter-spacing:-.8px;line-height:1.2;color:#0a2540\">Payment infrastructure built for the global Internet<br></div>\n          <div style=\"font-size:13px;color:#425466;margin-top:10px;line-height:1.6\">One Line API is connected to 135 currencies around the world, accompanying companies every step of the way from start-up to listing. </div>\n          <div style=\"display:flex;gap:10px;margin-top:14px\">\n            <span style=\"background:#635bff;color:#fff;font-size:12px;font-weight:600;border-radius:999px;padding:7px 14px\">Start now →</span>\n            <span style=\"color:#635bff;font-size:12px;font-weight:600;padding:7px 4px\">Contact sales →</span>\n          </div>\n        </div>\n        <div style=\"flex:.9;background:#fff;border:1px solid #eef1f5;border-radius:12px;box-shadow:0 12px 32px rgba(10,37,64,.14);padding:12px 14px\">\n          <div style=\"font-size:12px;color:#8492a6\">Order amount</div>\n          <div style=\"font-size:22px;font-weight:700;color:#0a2540;letter-spacing:-.5px\">¥ 1,280.00</div>\n          <div style=\"border-top:1px solid #f0f3f7;margin:10px 0\"></div>\n          <div style=\"font-size:12px;color:#425466\">💳 4242 ···· 4242</div>\n          <div style=\"background:#635bff;color:#fff;text-align:center;font-size:12px;font-weight:600;border-radius:6px;padding:7px 0;margin-top:10px\">Payment</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid #ececf0;border-radius:14px;overflow:hidden\">\n      <div style=\"text-align:center;padding:20px 20px 14px;border-bottom:1px solid #f0f0f3\">\n        <div style=\"font-size:22px;font-weight:700;letter-spacing:-.8px;color:#0a0a0c\">Simple and transparent pricing</div>\n        <div style=\"font-size:12px;color:#8a8a93;margin-top:6px\">Fictional example · Annual payment must show total price and cancellation rules <span style=\"display:inline-block;border:1px solid #e2e2e7;border-radius:999px;padding:2px 8px\">Monthly<b style=\"color:#5e6ad2\">By year</b></span></div>\n      </div>\n      <div style=\"display:flex;gap:0\">\n        <div style=\"flex:1;padding:16px 18px;border-right:1px solid #f0f0f3\">\n          <div style=\"font-size:12px;color:#8a8a93\">Free version</div>\n          <div style=\"font-size:22px;font-weight:700;color:#0a0a0c;margin-top:4px\">¥0</div>\n          <div style=\"font-size:12px;color:#61616a;margin-top:8px;line-height:1.8\">3 projects<br>Basic collaboration<br>Community support</div>\n          <div style=\"border:1px solid #e2e2e7;text-align:center;font-size:12px;border-radius:7px;padding:6px 0;margin-top:12px;color:#3c3c43\">Get started</div>\n        </div>\n        <div style=\"flex:1;padding:16px 18px;border-right:1px solid #f0f0f3;background:#fbfbfc;box-shadow:inset 0 3px 0 #0a0a0c\">\n          <div style=\"font-size:12px;color:#0a0a0c;font-weight:600\">Pro <span style=\"background:#0a0a0c;color:#fff;border-radius:999px;padding:1px 7px;font-size:12px\">Example recommendations</span></div>\n          <div style=\"font-size:22px;font-weight:700;color:#0a0a0c;margin-top:4px\">¥48<span style=\"font-size:12px;color:#8a8a93;font-weight:400\">/person/month</span></div>\n          <div style=\"font-size:12px;color:#61616a;margin-top:8px;line-height:1.8\">Unlimited projects<br>Automated process<br>Priority support</div>\n          <div style=\"background:#0a0a0c;color:#fff;text-align:center;font-size:12px;font-weight:600;border-radius:7px;padding:6px 0;margin-top:12px\">Upgrade Pro</div>\n        </div>\n        <div style=\"flex:1;padding:16px 18px\">\n          <div style=\"font-size:12px;color:#8a8a93\">Team version</div>\n          <div style=\"font-size:22px;font-weight:700;color:#0a0a0c;margin-top:4px\">Customized</div>\n          <div style=\"font-size:12px;color:#61616a;margin-top:8px;line-height:1.8\">SSO single sign-on<br>Audit log<br>Dedicated account manager</div>\n          <div style=\"border:1px solid #e2e2e7;text-align:center;font-size:12px;border-radius:7px;padding:6px 0;margin-top:12px;color:#3c3c43\">Contact sales</div>\n        </div>\n      </div>\n    </div>"]},"usageMocks":{"style-minimal-use-saas":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"width:100%\"><span style=\"width:12px;height:12px;border-radius:4px;background:#0a0a0c\"></span><span style=\"flex:1\"></span><span style=\"background:#0a0a0c;color:#fff;font-size:12px;border-radius:5px;padding:2px 8px\">免费开始</span></div><i class=\"mk-line\" style=\"width:75%\"></i><i class=\"mk-line\" style=\"width:50%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">适合让产品信息和主要行动保持清楚</span>","style-minimal-use-default":"<div class=\"mk-row\"><span style=\"border:1.5px solid #5e6ad2;background:var(--bg);border-radius:6px;padding:3px 9px;font-size:12px;color:#5e6ad2;font-weight:600\">✓ 现代简约</span><span style=\"border:1px solid var(--border);border-radius:6px;padding:3px 9px;font-size:12px;color:var(--text-3)\">复古</span><span style=\"border:1px solid var(--border);border-radius:6px;padding:3px 9px;font-size:12px;color:var(--text-3)\">赛博</span></div><span style=\"font-size:12px;color:var(--text-3)\">需求还不明确时，可先用它建立清楚、稳定的基础界面</span>","style-minimal-use-content":"<div class=\"mk-win\" style=\"text-align:left\"><span style=\"font-size:14px;font-weight:700;color:var(--text);display:block\">让排版突出主要内容</span><i class=\"mk-line\" style=\"width:85%\"></i><i class=\"mk-line\" style=\"width:60%\"></i></div><span style=\"font-size:12px;color:var(--text-3)\">减少无关装饰，让内容层级更容易识别</span>","style-minimal-use-longterm":"<div class=\"mk-row\"><span class=\"mk-tag gray\">基础规则</span><span class=\"mk-tag gray\">组件复用</span><span class=\"mk-tag blue\">持续迭代</span></div><span style=\"font-size:12px;color:var(--text-3)\">规则少而一致，后续扩展和维护更容易</span>","style-minimal-dont-promo":"<div class=\"mk-win\" style=\"text-align:left\"><span style=\"font-size:13px;color:var(--text-3)\">年货节…全场五折…（冷静版）</span><span style=\"font-size:12px;color:var(--red)\">活动页仍需足够的节奏、重点和品牌情绪</span></div>","style-minimal-dont-shabby":"<div class=\"mk-win\" style=\"text-align:left\"><span style=\"font-size:13px;color:var(--text-2)\">标题位置不一致</span><i class=\"mk-line\" style=\"width:88%\"></i><span style=\"font-size:12px;color:var(--text-3)\">缺少对齐、网格和字重层级</span><span style=\"font-size:12px;color:var(--red)\">简约仍需要清楚的结构与层级</span></div>","style-minimal-dont-manycolor":"<div class=\"mk-row\"><span style=\"width:14px;height:14px;border-radius:4px;background:#5e6ad2\"></span><span style=\"width:14px;height:14px;border-radius:4px;background:#f59e0b\"></span><span style=\"width:14px;height:14px;border-radius:4px;background:#10b981\"></span><span style=\"width:14px;height:14px;border-radius:4px;background:#ef4444\"></span></div><span style=\"font-size:12px;color:var(--red)\">主题色一多，克制感就没了</span>","style-minimal-dont-kid":"<div class=\"mk-win\" style=\"text-align:left\"><span style=\"font-size:13px;color:var(--text-3)\">面向儿童的活动页面</span><span style=\"font-size:12px;color:var(--red)\">应根据年龄、内容、可读性和品牌测试视觉语言，不能机械套用黑白极简</span></div>"}}}