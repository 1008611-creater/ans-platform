e=\"font-size:12px;color:var(--text-2);margin-top:6px;line-height:1.9\">📄 index.html<br>📄 style.css<br>📄 .gitignore<br><span style=\"color:#16a34a\">.env is ignored ✓</span></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<div class=\"push-anat\"><span class=\"ap push-cmd\" data-ap=\"cmd\">git push</span><span class=\"ap push-origin\" data-ap=\"origin\">origin</span><span class=\"ap push-branch\" data-ap=\"branch\">main</span></div>","demo_en":"<div class=\"push-anat\"><span class=\"ap push-cmd\" data-ap=\"cmd\">git push</span><span class=\"ap push-origin\" data-ap=\"origin\">origin</span><span class=\"ap push-branch\" data-ap=\"branch\">main</span></div>","parts":[{"key":"cmd","cn":"推送命令","en":"git push","desc":"将本地分支的提交同步到远程仓库","desc_en":"Publishes commits from a local branch to its remote counterpart"},{"key":"origin","cn":"远程别名","en":"origin","desc":"远程仓库的代号，clone 下来的项目默认就叫 origin","desc_en":"The remote’s short name; Git names the cloned source origin by default."},{"key":"branch","cn":"目标分支","en":"Branch","desc":"指定要推送的本地分支，通常是 main 或功能分支","desc_en":"The local branch being pushed, usually main or a feature branch"}]},"variants":[{"cn":"常规推送","en":"git push","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git push</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git push</span>","when":"将本地分支提交同步到远程","when_en":"Sync local branch commits to remote"},{"cn":"首次推送","en":"push -u","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git push -u origin main</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git push -u origin main</span>","when":"首次推送时建立本地与远程分支的跟踪关系","when_en":"Establish a tracking relationship between local and remote branches when pushing for the first time"},{"cn":"强制推送","en":"push --force","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--red)\">git push --force</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--red)\">git push --force</span>","when":"会重写远程分支历史，仅在明确了解影响时使用","when_en":"Rewrites remote history; use it only when you understand who and what it will affect"}],"use":[{"t":"完成 Commit 后，把需要共享的版本上传到 GitHub","m":"git-github"},{"t":"推送完成后刷新仓库页面，确认最新版本已经出现","m":"push-rejected"},{"t":"推送前检查版本范围，并确认真实密钥没有被记录","m":"env-var-gitignore"},{"t":"被拒绝时先取得网上变化，处理并测试后再重新 Push","m":"push-check"}],"dont":[{"t":"只 Commit 不 Push，却以为 GitHub 已经有远端副本","m":"push-local-bad","bad":true},{"t":"被拒绝后直接强制推送，可能覆盖别人已经上传的版本","m":"push-force-bad","bad":true},{"t":"把真实密钥推到远程；之后删除文件也不能消除泄露风险","m":"push-secret-bad","bad":true},{"t":"没有检查就把所有文件加入版本，可能连依赖和产物一起记录","m":"npm-commit-bad","bad":true}],"lessonPractice":{"title":"本地提交修复后，怎样把它安全地交给远端协作？","options":[{"id":"review-push","label":"先看提交和目标分支，再 push 到对应远端分支并确认远端提交号","feedback":"对。Push 会写入共享远端，先确认范围和目标分支，随后核对远端结果。","correct":true},{"id":"force-main","label":"直接强制推送到 main，让远端完全等于本地","feedback":"强制推送可能覆盖他人的远端历史，不能作为普通交付步骤。","correct":false},{"id":"copy-files","label":"把改过的文件发给同事，Git 记录不需要同步","feedback":"文件副本会丢失可追溯的提交关系，协作分支也不会更新。","correct":false}],"en":{"title":"After a local fix commit, how do you safely share it with remote collaborators?","options":[{"id":"review-push","label":"Inspect the commit and target branch, push to its remote branch, then confirm the remote hash","feedback":"Correct. Push writes shared remote state, so confirm scope and target, then verify the result.","correct":true},{"id":"force-main","label":"Force-push straight to main so remote exactly matches local","feedback":"A force push can overwrite other people’s remote history.","correct":false},{"id":"copy-files","label":"Send edited files to a teammate; Git history need not be shared","feedback":"A file copy loses traceable commit relationships and does not update the shared branch.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请查看当前分支、待推送提交和远端跟踪分支；确认只包含这次修复后，push 到对应分支。完成后给出远端分支名和最新 commit hash，不要改写 main 或使用 force。","en":{"title":"You can say this to an AI Agent","text":"Inspect the current branch, commits to push, and its upstream. Once it contains only this fix, push to that branch. Report the remote branch and latest commit hash; do not rewrite main or use force."}},"demoDetail":"<div class=\"git-story git-story--push is-detail\">\n  <div class=\"git-story-main\"><div class=\"git-transfer-visual\">\n      <div class=\"git-device-card\"><span class=\"git-device-screen\"><span class=\"git-version-dots\"><i></i><i></i><i class=\"is-current\"></i></span></span><span><b>我的电脑</b><small>多 2 个已保存版本</small></span></div>\n      <div class=\"git-motion\"><span>把新版本上传</span><small>push</small><i>→</i></div>\n      <div class=\"git-repo-card is-cloud is-success\"><span class=\"git-repo-icon\"><i></i><i></i><i></i></span><span><b>网上的项目</b><small>GitHub 收到更新</small></span></div>\n    </div></div>\n  <div class=\"git-story-answer\"><span class=\"git-command\">git push</span><p>Push 只上传已经 Commit 的版本，不会替你保存尚未提交的文件。完成后在 GitHub 检查最新版本是否出现。\n</p></div>\n</div>","references":[{"title":"git-push 官方文档","source":"git-scm","url":"https://git-scm.com/docs/git-push","title_en":"Git - git-push Documentation"},{"title":"使用远程仓库（Pro Git）","source":"git-scm","url":"https://git-scm.com/book/en/v2/Git-Basics-Working-with-Remotes","title_en":"Pro Git - Working with Remotes"}],"scenes":["终端 git push 上云","push 被拒的现场","GitHub 上确认新 commit",".gitignore 挡住 .env"],"en":{"demoDetail":"<div class=\"git-story git-story--push is-detail\">\n  <div class=\"git-story-main\"><div class=\"git-transfer-visual\">\n      <div class=\"git-device-card\"><span class=\"git-device-screen\"><span class=\"git-version-dots\"><i></i><i></i><i class=\"is-current\"></i></span></span><span><b>Local repository</b><small>Two commits ahead</small></span></div>\n      <div class=\"git-motion\"><span>Upload commits</span><small>push</small><i>→</i></div>\n      <div class=\"git-repo-card is-cloud is-success\"><span class=\"git-repo-icon\"><i></i><i></i><i></i></span><span><b>Remote repository</b><small>Branch updated on GitHub</small></span></div>\n    </div></div>\n  <div class=\"git-story-answer\"><span class=\"git-command\">git push</span><p>Push sends local commits to a remote branch. It does not include uncommitted edits. Afterward, confirm that GitHub shows the expected commit on the expected branch.\n</p></div>\n</div>","use":[{"t":"Back up committed work to the remote","m":"git-github"},{"t":"Share a branch with teammates","m":"push-rejected"},{"t":"Update a pull request","m":"env-var-gitignore"},{"t":"Publish a reviewed commit history","m":"push-check"}],"dont":[{"t":"Expect uncommitted changes to be uploaded","m":"push-local-bad","bad":true},{"t":"Force-push a shared branch without coordination","m":"push-force-bad","bad":true},{"t":"Push secrets and try to delete them later","m":"push-secret-bad","bad":true},{"t":"Ignore a rejection without checking remote changes","m":"npm-commit-bad","bad":true}],"scenes":["Publish feature branch","Update pull request","Share a fix","Sync remote backup"],"sceneUI":["<div style=\"max-width:420px;margin:0 auto\" class=\"terminal-win\">\n      <div class=\"terminal-bar\"><i></i><i></i><i></i><span>zsh — my-first-page</span></div>\n      <div class=\"terminal-body\">\n        <span><b class=\"terminal-p\">$</b> <b class=\"terminal-c\">git push</b></span>\n        <span class=\"terminal-d\">Enumerating objects: 8, done.</span>\n        <span class=\"terminal-d\">Counting objects: 100% (8/8), done.</span>\n        <span class=\"terminal-d\">Writing objects: 100% (8/8), 1.24 KiB | 1.24 MiB/s, done.</span>\n        <span class=\"terminal-d\">To github.com:maya-lee/my-first-page.git</span>\n        <span><span class=\"terminal-g\">   a3f9c21..e7b2d48</span>  main -&gt; main</span>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto\" class=\"terminal-win\">\n      <div class=\"terminal-bar\"><i></i><i></i><i></i><span>zsh — my-first-page</span></div>\n      <div class=\"terminal-body\">\n        <span><b class=\"terminal-p\">$</b> <b class=\"terminal-c\">git push</b></span>\n        <span class=\"terminal-d\">To github.com:maya-lee/my-first-page.git</span>\n        <span class=\"terminal-r\">! [rejected] main -> main (non-fast-forward)</span>\n        <span class=\"terminal-r\">error: failed to push some refs</span>\n        <span class=\"terminal-d\">hint: Updates were rejected because the remote contains</span>\n        <span class=\"terminal-d\">hint: work that you do not have locally.</span>\n        <span class=\"terminal-d\">hint: 'git pull' before pushing again.</span>\n        <span class=\"terminal-d\">Pull and integrate the remote commits, then push again</span>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;font-weight:600;flex:1\">my-first-page</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Just refreshed</span>\n      </div>\n      <div style=\"padding:4px 0\">\n        <div style=\"display:flex;align-items:center;gap:10px;padding:7px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span style=\"flex:1\">📄 index.html</span><span style=\"color:var(--text-2);font-size:12px\">Fix mobile button alignment</span><span style=\"color:var(--text-3);font-size:12px\">1 minute ago</span></div>\n        <div style=\"display:flex;align-items:center;gap:10px;padding:7px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span style=\"flex:1\">📄 style.css</span><span style=\"color:var(--text-2);font-size:12px\">Fix mobile button alignment</spa