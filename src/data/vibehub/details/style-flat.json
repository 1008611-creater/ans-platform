ckground:#fff;border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:16px;padding:10px 16px;border-bottom:1px solid #eceef2\">\n        <b style=\"font-size:13px;color:#1d2129\">方块工作室</b><span style=\"font-size:12px;color:#888;margin-left:auto\">产品</span><span style=\"font-size:12px;color:#888\">案例</span><span style=\"font-size:12px;color:#888\">联系</span>\n      </div>\n      <div style=\"text-align:center;padding:30px 20px 26px\">\n        <div style=\"font-size:26px;font-weight:200;color:#1d2129\">把想法变成产品</div>\n        <div style=\"font-size:12px;color:#888;margin:8px 0 16px\">无需设计稿，纯色块与大留白就够了</div>\n        <span class=\"style-flat-mini-btn\" style=\"padding:8px 26px;font-size:13px\">免费开始</span>\n        <span class=\"style-flat-mini-btn\" style=\"background:#eceef2;color:#3b3f46;padding:8px 26px;font-size:13px;margin-left:10px\">看案例</span>\n      </div>\n      <div style=\"display:flex;height:8px\"><span style=\"flex:1;background:#1ba1e2\"></span><span style=\"flex:1;background:#60a917\"></span><span style=\"flex:1;background:#fa6800\"></span><span style=\"flex:1;background:#aa00ff\"></span></div>\n    </div>"],"sceneUI_en":["<div class=\"style-flat-scene\">\n      <div class=\"style-flat-scene-title\"><small>PLAN A DAY</small><b>Saturday<br>in Shanghai</b><span>24 AUG</span></div>\n      <div class=\"style-flat-scene-map\"><i class=\"style-flat-map-road one\"></i><i class=\"style-flat-map-road two\"></i><i class=\"style-flat-map-dot a\"></i><i class=\"style-flat-map-dot b\"></i><i class=\"style-flat-map-dot c\"></i><b>3 stops<br><em>4.8 km walk</em></b></div>\n      <div class=\"style-flat-scene-stops\"><span>09:30<br><b>Wukang Road</b></span><span>12:15<br><b>Anfu Road</b></span><span>16:00<br><b>West Bank</b></span></div>\n    </div>","<div style=\"max-width:600px;margin:0 auto;display:flex;justify-content:center;padding:16px;background:#f2f3f5;border-radius:12px\">\n      <div style=\"width:300px;border-radius:28px;border:3px solid #1a1a1c;overflow:hidden;background:linear-gradient(#4a9ff5,#2b6fd6);color:#fff;box-shadow:0 10px 26px rgba(0,0,0,.3)\">\n        <div style=\"text-align:center;padding:26px 16px 18px\">\n          <div style=\"font-size:15px;font-weight:300\">Shenzhen</div>\n          <div style=\"font-size:64px;font-weight:100;line-height:1.1\">23°</div>\n          <div style=\"font-size:13px;opacity:.9\">Sunny, the highest is 26° and the lowest is 19°</div>\n        </div>\n        <div style=\"border-top:1px solid rgba(255,255,255,.35);display:flex;justify-content:space-around;padding:10px 8px;font-size:12px\">\n          <span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">Now<span style=\"font-size:15px\">☀</span>23°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">14 hours<span style=\"font-size:15px\">☀</span>25°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">15 hours<span style=\"font-size:15px\">⛅</span>26°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">16 hours<span style=\"font-size:15px\">☀</span>24°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">17 hours<span style=\"font-size:15px\">🌙</span>22°</span>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:16px;padding:10px 16px;border-bottom:1px solid #eceef2\">\n        <b style=\"font-size:13px;color:#1d2129\">Data Dashboard</b><span style=\"font-size:12px;color:#1ba1e2\">Overview</span><span style=\"font-size:12px;color:#888\">Orders</span><span style=\"font-size:12px;color:#888\">User</span>\n      </div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:14px 16px 4px\">\n        <div style=\"background:#1ba1e2;color:#fff;padding:10px 12px\"><div style=\"font-size:22px;font-weight:200\">Example</div><div style=\"font-size:12px;opacity:.9\">Today's order</div></div><div style=\"background:#60a917;color:#fff;padding:10px 12px\"><div style=\"font-size:22px;font-weight:200\">Example</div><div style=\"font-size:12px;opacity:.9\">Conversion rate</div></div><div style=\"background:#fa6800;color:#fff;padding:10px 12px\"><div style=\"font-size:22px;font-weight:200\">Example</div><div style=\"font-size:12px;opacity:.9\">Pending alarm</div></div><div style=\"background:#aa00ff;color:#fff;padding:10px 12px\"><div style=\"font-size:22px;font-weight:200\">Example</div><div style=\"font-size:12px;opacity:.9\">New user</div></div>\n      </div>\n      <div style=\"padding:8px 16px 14px\">\n        <div style=\"display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid #f0f1f4;font-size:12px;color:#3b3f46\"><span>#1042 Website refresh final payment</span><span>Completed</span></div>\n        <div style=\"display:flex;justify-content:space-between;padding:7px 0;font-size:12px;color:#3b3f46\"><span>#1041 Mini Program Homepage</span><span>In Progress</span></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:16px;padding:10px 16px;border-bottom:1px solid #eceef2\">\n        <b style=\"font-size:13px;color:#1d2129\">Block Studio</b><span style=\"font-size:12px;color:#888;margin-left:auto\">Products</span><span style=\"font-size:12px;color:#888\">Case Studies</span><span style=\"font-size:12px;color:#888\">Contact</span>\n      </div>\n      <div style=\"text-align:center;padding:30px 20px 26px\">\n        <div style=\"font-size:26px;font-weight:200;color:#1d2129\">Turn ideas into products</div>\n        <div style=\"font-size:12px;color:#888;margin:8px 0 16px\">Build a polished site with clean shapes, solid colors, and generous white space.</div>\n        <span class=\"style-flat-mini-btn\" style=\"padding:8px 26px;font-size:13px\">Start for free</span>\n        <span class=\"style-flat-mini-btn\" style=\"background:#eceef2;color:#3b3f46;padding:8px 26px;font-size:13px;margin-left:10px\">View case studies</span>\n      </div>\n      <div style=\"display:flex;height:8px\"><span style=\"flex:1;background:#1ba1e2\"></span><span style=\"flex:1;background:#60a917\"></span><span style=\"flex:1;background:#fa6800\"></span><span style=\"flex:1;background:#aa00ff\"></span></div>\n    </div>"],"anatomy":{"demo":"<div class=\"style-flat-anat\">\n      <span class=\"ap style-flat-mini-tile\" data-ap=\"solid\" style=\"background:#2d89ef;height:40px;min-width:64px\">纯色块</span>\n      <span class=\"ap style-flat-anat-chip style-flat-anat-radius\" data-ap=\"radius\">直角 / 微圆角</span>\n      <span class=\"ap style-flat-anat-chip\" data-ap=\"clean\">零阴影零渐变</span>\n      <span class=\"ap style-flat-mini-ico\" data-ap=\"icon\" style=\"background:#60a917\">◤</span>\n      <span class=\"ap style-flat-anat-type\" data-ap=\"type\">细字 + 大留白</span>\n    </div>","demo_en":"<div class=\"style-flat-anat\">\n      <span class=\"ap style-flat-mini-tile\" data-ap=\"solid\" style=\"background:#2d89ef;height:40px;min-width:64px\">Solid color block</span>\n      <span class=\"ap style-flat-anat-chip style-flat-anat-radius\" data-ap=\"radius\">Square or subtly rounded corners</span>\n      <span class=\"ap style-flat-anat-chip\" data-ap=\"clean\">No shadows or gradients</span>\n      <span class=\"ap style-flat-mini-ico\" data-ap=\"icon\" style=\"background:#60a917\">◤</span>\n      <span class=\"ap style-flat-anat-type\" data-ap=\"type\">Lightweight type + open space</span>\n    </div>","parts":[{"key":"solid","cn":"纯色块","en":"Solid Color Block","desc":"色块可用于分区与品牌识别，饱和度应配合内容和文字对比度","desc_en":"Use solid color blocks to separate areas and reinforce brand recognition; match saturation to the content and text contrast."},{"key":"radius","cn":"清晰边角","en":"Clear Corners","desc":"直角或小圆角都可以；选择应与品牌、组件尺寸和触控目标一致","desc_en":"Choose square or subtly rounded corners consistently for the brand, component size, and touch target."},{"key":"clean","cn":"克制装饰","en":"Restrained Ornament","desc":"减少不帮助理解的效果；需要表现层级或状态时可以适度使用","desc_en":"Avoid decorative shadows and gradients unless they clarify hierarchy or state."},{"key":"icon","cn":"几何图标","en":"Geometric Icon","desc":"图标简化为圆、方、三角等基本形，缩小也可辨","desc_en":"Reduce icons to simple, recognizable geometric forms."},{"key":"type","cn":"清楚的排版","en":"Clear Type","desc":"用合适的字号、字重和留白建立层级，避免过细文字影响阅读","desc_en":"Use type scale, weight, and whitespace to establish hierarchy without overloading the page with detail."}]},"use":[{"t":"数据后台和仪表盘，需要清楚展示高密度信息","m":"style-flat-dash"},{"t":"小屏应用，减少不必要的材质和视觉负担","m":"style-flat-mobile"},{"t":"有稳定品牌色，通过色块建立识别","m":"style-flat-brand"},{"t":"快速搭建原型，先验证结构和主要流程","m":"style-flat-quick"}],"dont":[{"t":"按钮和普通文字外观相同，用户无法判断能否点击","m":"style-flat-click-bad","bad":true},{"t":"色块缺少层级差异，无法说明信息主次","m":"style-flat-same-bad","bad":true},{"t":"浮层没有任何边界或层级提示","m":"style-flat-shadowless-bad","bad":true},{"t":"删掉必要细节后，把未完成状态当成简约","m":"style-flat-extreme-bad","bad":true}],"principles":[{"t":"用纯色和清楚分区组织信息，不依赖真实材质","m":"style-flat-color"},{"t":"减少无助于理解的阴影、渐变和纹理","m":"style-flat-nodeco"},{"t":"图标保持简洁，同时保留可辨认的功能含义","m":"style-flat-icon"},{"t":"通过字号、字重、位置和留白建立阅读顺序","m":"style-flat-type"},{"t":"让组件易于缩放和适配不同屏幕","m":"style-flat-fast"},{"t":"用边界、颜色和状态反馈保证控件仍然容易发现","m":"style-flat-affordance"}],"history":[{"year":"2010","title":"Windows Phone Metro","desc":"Windows Phone 的 Metro 使用纯色磁贴和大字号排版，成为当时系统界面中具有代表性的扁平化实践。","year_en":"2010","title_en":"Windows Phone introduces Metro","desc_en":"Solid tiles and oversized typography made flat design a system-level language several years before Apple's shift."},{"year":"2013","title":"iOS 7 转向简化视觉","desc":"iOS 7 大幅减少拟物化装饰，推动了扁平化在移动界面中的进一步普及；不同产品仍采用了不同程度的层次表现。","year_en":"2013","title_en":"iOS 7 moves fully into flat design","desc_en":"Apple removed most skeuomorphic detail, and flat interfaces became the new mainstream default."},{"year":"2014","title":"Material Design 发布","desc":"Google 以层级、动效和组件规则扩展了扁平化界面的表现方式，并强调状态与空间关系。","year_en":"2014","title_en":"Material Design adds layers back","desc_en":"Google added elevation and purposeful motion to flat surfaces, restoring some of the hierarchy that pure flat design had lost."},{"year":"2016—今","title":"Flat 2.0（Almost Flat）","desc":"轻阴影、微渐变和边界被更多产品用于表达层级与可操作性，形成了多种近扁平实践。","year_en":"2016–present","title_en":"Flat 2.0 becomes the practical default","desc_en":"Light shadows and subtle gradients returned after teams learned that completely flat controls were often difficult to recognize."}],"prompt":"做一个城市周末行程页，用清楚的色块、图标和排版区分路线、时间与地点。页面要轻快且易扫读，所有按钮和可点击区域都要能被看出来。路线、时间和地点只用现有资料，缺少的先标“待补充”，不要自己编。","prompt_en":"Flat design system, solid color blocks, simple geometric icons, minimal shadows, strong typography, generous whitespace, clear control boundaries and accessible interaction states","references":[{"title":"扁平化设计：起源、问题与 Flat 2.0","source":"NN/g","url":"https://www.nngroup.com/articles/flat-design/","title_en":"Flat Design: Its Origins, Its Problems, and Why Flat 2.0 Is Better for Users"}],"scenes":["扁平化城市日程","iOS 7 天气 App","扁平化数据仪表盘","扁平化落地页"],"en":{"prompt":"Flat design system, solid color blocks, simple geometric icons, minimal shadows, strong typography, generous whitespace, clear control boundaries and accessible interaction states","use":[{"t":"Product interface","m":"style-flat-dash"},{"t":"Responsive website","m":"style-flat-mobile"},{"t":"Illustration and icon system","m":"style-flat-brand"},{"t":"A design system that needs broad reuse","m":"style-flat-quick"}],"dont":[{"t":"Remove every boundary around controls","m":"style-flat-click-bad","bad":true},{"t":"Use color alone to show interaction","m":"style-flat-same-bad","bad":true},{"t":"Make all surfaces visually equal","m":"style-flat-shadowless-bad","bad":true},{"t":"Add flat icons that users cannot recognize","m":"style-flat-extreme-bad","bad":true}],"principles":[{"t":"Use simple shapes with clear roles","m":"style-flat-color"},{"t":"Create hierarchy through color, type, and spacing","m":"style-flat-nodeco"},{"t":"Keep icons consistent and understandable","m":"style-flat-icon"},{"t":"Make interactive elements visibly interactive","m":"style-flat-type"},{"t":"Use light depth cues when they improve usability","m":"style-flat-fast"},{"t":"Build states that do not depend on texture","m":"style-flat-affordance"}],"scenes":["Web app","Mobile interface","Marketing illustration","Design system"],"sceneUI":["<div class=\"style-flat-scene\">\n      <div class=\"style-flat-scene-title\"><small>PLAN A DAY</small><b>Saturday<br>in Shanghai</b><span>24 AUG</span></div>\n      <div class=\"style-flat-scene-map\"><i class=\"style-flat-map-road one\"></i><i class=\"style-flat-map-road two\"></i><i class=\"style-flat-map-dot a\"></i><i class=\"style-flat-map-dot b\"></i><i class=\"style-flat-map-dot c\"></i><b>3 stops<br><em>4.8 km walk</em></b></div>\n      <div class=\"style-flat-scene-stops\"><span>09:30<br><b>Wukang Road</b></span><span>12:15<br><b>Anfu Road</b></span><span>16:00<br><b>West Bank</b></span></div>\n    </div>","<div style=\"max-width:600px;margin:0 auto;display:flex;justify-content:center;padding:16px;background:#f2f3f5;border-radius:12px\">\n      <div style=\"width:300px;border-radius:28px;border:3px solid #1a1a1c;overflow:hidden;background:linear-gradient(#4a9ff5,#2b6fd6);color:#fff;box-shadow:0 10px 26px rgba(0,0,0,.3)\">\n        <div style=\"text-align:center;padding:26px 16px 18px\">\n          <div style=\"font-size:15px;font-weight:300\">Shenzhen</div>\n          <div style=\"font-size:64px;font-weight:100;line-height:1.1\">23°</div>\n          <div style=\"font-size:13px;opacity:.9\">Sunny, the highest is 26° and the lowest is 19°</div>\n 