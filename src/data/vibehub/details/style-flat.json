{"__formatVersion":2,"__revision":"2cdea794183c1b94","__entryId":"style-flat","entry":{"sceneUI":["<div class=\"style-flat-scene\">\n      <div class=\"style-flat-scene-title\"><small>PLAN A DAY</small><b>Saturday<br>in Shanghai</b><span>24 AUG</span></div>\n      <div class=\"style-flat-scene-map\"><i class=\"style-flat-map-road one\"></i><i class=\"style-flat-map-road two\"></i><i class=\"style-flat-map-dot a\"></i><i class=\"style-flat-map-dot b\"></i><i class=\"style-flat-map-dot c\"></i><b>3 stops<br><em>4.8 km walk</em></b></div>\n      <div class=\"style-flat-scene-stops\"><span>09:30<br><b>武康路</b></span><span>12:15<br><b>安福路</b></span><span>16:00<br><b>西岸</b></span></div>\n    </div>","<div style=\"max-width:600px;margin:0 auto;display:flex;justify-content:center;padding:16px;background:#f2f3f5;border-radius:12px\">\n      <div style=\"width:300px;border-radius:28px;border:3px solid #1a1a1c;overflow:hidden;background:linear-gradient(#4a9ff5,#2b6fd6);color:#fff;box-shadow:0 10px 26px rgba(0,0,0,.3)\">\n        <div style=\"text-align:center;padding:26px 16px 18px\">\n          <div style=\"font-size:15px;font-weight:300\">深圳市</div>\n          <div style=\"font-size:64px;font-weight:100;line-height:1.1\">23°</div>\n          <div style=\"font-size:13px;opacity:.9\">晴　最高 26° 最低 19°</div>\n        </div>\n        <div style=\"border-top:1px solid rgba(255,255,255,.35);display:flex;justify-content:space-around;padding:10px 8px;font-size:12px\">\n          <span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">现在<span style=\"font-size:15px\">☀</span>23°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">14 时<span style=\"font-size:15px\">☀</span>25°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">15 时<span style=\"font-size:15px\">⛅</span>26°</span><span style=\"display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.95\">