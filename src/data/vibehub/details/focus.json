{"__formatVersion":2,"__revision":"e2c04657618eb0e1","__entryId":"focus","entry":{"sceneUI":["<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:10px\">完善资料</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:8px\" value=\"林小hu\">\n      <input class=\"demo-input\" style=\"width:100%;border-color:var(--brand);box-shadow:0 0 0 3px rgba(99,102,241,.18)\" value=\"lin@example.com\">\n      <div style=\"display:flex;align-items:center;gap:6px;margin-top:10px;font-size:12px;color:var(--text-3)\">\n        <kbd style=\"border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:1px 7px;font-size:12px;background:var(--bg-soft);color:var(--text-2)\">Tab ⇥</kbd> 将焦点移动到下一个可聚焦元素\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;display:flex;gap:10px;align-items:flex-start\">\n      <img src=\"/assets/avatar-fox.png\" style=\"width:32px;height:32px;border-radius:50%;object-fit:cover\" alt=\"\">\n      <div style=\"flex:1\">\n        <div style=\"border:1px solid var(--brand);border-radius:10px;padding:9px 12px;font-size:12px;color:var(--text);background:var(--bg);box-shadow:0 0 0 3px rgba(99,102,241,.16)\">这个配色方案不错<span style=\"display:inline-block;width:1.5px;height:14px;background:var(--brand);vertical-align:-2px;margin-left:1px\"></span></div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:7px\">聚焦输入：描边与外圈共同标出当前输入位置</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:10px;padding:13px 16px\">\n        <span style=\"flex:1;font-size:13px\">推送通知</span>\n        <span style=\"border-radius:999px;box-shadow:0 0 0 2px #fff,0 0 0 5px var(--brand)\">\n          <label class=\"demo-switch\"><input type=\"checkbox\" checked><span class=\"track\"></span></label>\n        </span>\n      </div>\n      <div style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px\">🔊 画外音：「推送通知，开关，已打开」</div>\n    </div>","<div style=\"max-width:380px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;gap:8px;border:1px solid var(--brand);border-radius:8px;padding:8px 12px;background:var(--bg);box-shadow:0 0 0 3px rgba(99,102,241,.16)\">\n        <span style=\"color:var(--text-3);font-size:12px\">🔍</span>\n        <span style=\"flex:1;font-size:12px;color:var(--text)\">主题切换<span style=\"display:inline-block;width:1.5px;height:13px;background:var(--brand);vertical-align:-2px;margin-left:1px\"></span></span>\n        <kbd style=\"font-size:12px;color:var(--text-3);border:1px solid var(--border);border-radius:4px;padding:1px 5px\">⌘K</kbd>\n      </div>\n      <div style=\"margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-float);overflow:hidden\">\n        <div style=\"padding:7px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">切换为深色模式</div>\n        <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">主题与外观设置</div>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:10px\">Complete Your Profile</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:8px\" value=\"Alex Lin\">\n      <input class=\"demo-input\" style=\"width:100%;border-color:var(--brand);box-shadow:0 0 0 3px rgba(99,102,241,.18)\" value=\"alex@example.com\">\n      <div style=\"display:flex;align-items:center;gap:6px;margin-top:10px;font-size:12px;color:var(--text-3)\">\n        <kbd style=\"border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:1px 7px;font-size:12px;background:var(--bg-soft);color:var(--text-2)\">Tab ⇥</kbd> Press to move focus to the next field\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;display:flex;gap:10px;align-items:flex-start\">\n      <img src=\"/assets/avatar-fox.png\" style=\"width:32px;height:32px;border-radius:50%;object-fit:cover\" alt=\"\">\n      <div style=\"flex:1\">\n        <div style=\"border:1px solid var(--brand);border-radius:10px;padding:9px 12px;font-size:12px;color:var(--text);background:var(--bg);box-shadow:0 0 0 3px rgba(99,102,241,.16)\">Nice color palette<span style=\"display:inline-block;width:1.5px;height:14px;background:var(--brand);vertical-align:-2px;margin-left:1px\"></span></div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:7px\">Focused input: brand-color ring + glow — the cursor is easy to spot</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:10px;padding:13px 16px\">\n        <span style=\"flex:1;font-size:13px\">Push Notifications</span>\n        <span style=\"border-radius:999px;box-shadow:0 0 0 2px #fff,0 0 0 5px var(--brand)\">\n          <label class=\"demo-switch\"><input type=\"checkbox\" checked><span class=\"track\"></span></label>\n        </span>\n      </div>\n      <div style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px\">🔊 VoiceOver: “Push Notifications, switch, on”</div>\n    </div>","<div style=\"max-width:380px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;gap:8px;border:1px solid var(--brand);border-radius:8px;padding:8px 12px;background:var(--bg);box-shadow:0 0 0 3px rgba(99,102,241,.16)\">\n        <span style=\"color:var(--text-3);font-size:12px\">🔍</span>\n        <span style=\"flex:1;font-size:12px;color:var(--text)\">theme<span style=\"display:inline-block;width:1.5px;height:13px;background:var(--brand);vertical-align:-2px;margin-left:1px\"></span></span>\n        <kbd style=\"font-size:12px;color:var(--text-3);border:1px solid var(--border);border-radius:4px;padding:1px 5px\">⌘K</kbd>\n      </div>\n      <div style=\"margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-float);overflow:hidden\">\n        <div style=\"padding:7px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">Switch to dark mode</div>\n        <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">Theme & appearance settings</div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"target\"><span class=\"focus-input is-focus\">输入中…</span></span><span class=\"ap\" data-ap=\"ring\"><span class=\"focus-anat-ring\">描边 2px+</span></span><span class=\"ap\" data-ap=\"order\"><span class=\"focus-anat-chip\">Tab → 下一个</span></span>","demo_en":"<span class=\"ap\" data-ap=\"target\"><span class=\"focus-input is-focus\">Inputting...</span></span><span class=\"ap\" data-ap=\"ring\"><span class=\"focus-anat-ring\">Stroke 2px+</span></span><span class=\"ap\" data-ap=\"order\"><span class=\"focus-anat-chip\">Tab → Next</span></span>","parts":[{"key":"target","cn":"焦点元素","en":"Target","desc":"当前拿到焦点的那个控件","desc_en":"The control currently holding focus"},{"key":"ring","cn":"焦点描边","en":"Focus Ring","desc":"告诉所有人“焦点在这儿”","desc_en":"Tells everyone “focus is right here”"},{"key":"order","cn":"焦点顺序","en":"Tab Order","desc":"Tab 键的行进路线，默认按 DOM 顺序","desc_en":"The route the Tab key travels; follows DOM order by default"}]},"variants":[{"cn":"描边","en":"Outline","demo":"<span class=\"focus-v-box v-outline\">按钮</span>","demo_en":"<span class=\"focus-v-box v-outline\">Button</span>","when":"浏览器默认焦点样式已经清楚可见时","when_en":"When the browser's default focus style is already clear"},{"cn":"光晕","en":"Ring","demo":"<span class=\"focus-v-box v-glow\">输入框</span>","demo_en":"<span class=\"focus-v-box v-glow\">Input</span>","when":"品牌色外发光，更现代","when_en":"Brand-color outer glow, more modern"},{"cn":"背景高亮","en":"Background","demo":"<span class=\"focus-v-item\">菜单项</span>","demo_en":"<span class=\"focus-v-item\">Menu item</span>","when":"列表、菜单项聚焦时用","when_en":"For focused list and menu items"}],"use":[{"t":"{c:input} 可用<b>边框与外圈</b>清楚显示当前聚焦状态","m":"in-search"},{"t":"<b>焦点指示要明显</b>：与背景有足够对比并保持可见面积；具体宽度按组件和可访问性要求验证","m":"focus-ring"},{"t":"<b>Tab 顺序合理</b>：{c:form} 从上到下、从左到右，符合阅读顺序","m":"focus-order"},{"t":"自定义复选框和选择器也要支持键盘聚焦","m":"focus-custom"}],"dont":[{"t":"使用 <b>outline: none</b>却未提供替代焦点样式：键盘用户无法定位焦点","m":"focus-outline-none","bad":true},{"t":"<b>焦点描边对比度不足</b>：用户难以区分聚焦状态","m":"focus-faint","bad":true},{"t":"用 <b>div 模拟按钮</b>：若未补全语义和键盘交互，Tab 与读屏用户无法正常操作","m":"focus-div-btn","bad":true},{"t":"<b>tabindex 顺序不合理</b>：焦点移动顺序会偏离阅读和操作流程","m":"focus-jump","bad":true}],"lessonPractice":{"title":"用键盘按 Tab 时，看不出接下来会操作哪个控件。应该先补什么？","options":[{"id":"visible-focus","label":"给当前控件显示清楚的选中轮廓","feedback":"对。焦点指示告诉键盘用户当前位置，不能只在鼠标悬停时出现。","correct":true},{"id":"remove-outline","label":"只在鼠标点击控件后显示轮廓，按 Tab 时隐藏","feedback":"看不见焦点会让键盘操作失去位置，无法判断下一次 Enter 会触发什么。","correct":false},{"id":"hover-only","label":"给所有可点击控件加更明显的鼠标悬停底色","feedback":"键盘操作不依赖鼠标位置，hover 不能替代 focus。","correct":false}],"en":{"title":"A keyboard user cannot tell which control Tab will operate. What should be added first?","options":[{"id":"visible-focus","label":"Keep a clear visible focus style on interactive controls","feedback":"Correct. Focus indication tells keyboard users their position and cannot be replaced by hover.","correct":true},{"id":"remove-outline","label":"Remove the browser focus outline for a cleaner UI","feedback":"Invisible focus removes position from keyboard operation and hides what Enter will trigger.","correct":false},{"id":"hover-only","label":"Improve hover only because keyboard users also see a mouse","feedback":"Keyboard operation does not depend on pointer position; hover cannot replace focus.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请为页面上的链接、按钮和输入框补一致且高对比的 focus-visible 样式，不要移除默认焦点。只用键盘从地址栏进入页面并连续 Tab，确认每一步都能看见当前位置，Enter 能触发预期控件。","en":{"title":"You can say this to an AI Agent","text":"Add consistent high-contrast focus-visible styles for links, buttons, and inputs without removing default focus. Enter the page from the address bar using only keyboard and Tab through it; every position must be visible and Enter must trigger the expected control."}},"demoDetail":"<div class=\"focus-play\">\n    <input class=\"focus-live-input\" placeholder=\"输入框：可聚焦\" />\n    <button type=\"button\" class=\"focus-live-btn\">用 Tab 聚焦</button>\n    <input class=\"focus-dead-input\" placeholder=\"对照：outline:none\" />\n    <span class=\"focus-hint\">使用 Tab 键依次导航，比较有无可见焦点指示的差异</span>\n  </div>","references":[{"title":":focus-visible 伪类","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/:focus-visible","title_en":":focus-visible"},{"title":"理解成功标准 2.4.7：焦点可见","source":"WCAG","url":"https://www.w3.org/WAI/WCAG22/Understanding/focus-visible.html","title_en":"Understanding SC 2.4.7: Focus Visible"}],"scenes":["键盘 Tab 浏览表单","输入框聚焦输入","屏幕阅读器导航","快捷键直达搜索框"],"en":{"demoDetail":"<div class=\"focus-play\">\n    <input class=\"focus-live-input\" placeholder=\"Input: click me\" />\n    <button type=\"button\" class=\"focus-live-btn\">Tab to me</button>\n    <input class=\"focus-dead-input\" placeholder=\"Control: outline:none\" />\n    <span class=\"focus-hint\">Walk through with Tab — only the visible ring tells you where you are</span>\n  </div>","use":[{"t":"Keyboard navigation","m":"in-search"},{"t":"Form field editing","m":"focus-ring"},{"t":"Menu and dialog control","m":"focus-order"},{"t":"Any interactive element that can receive input","m":"focus-custom"}],"dont":[{"t":"Remove the browser outline without a replacement","m":"focus-outline-none","bad":true},{"t":"Show focus only after a mouse click if keyboard users need it","m":"focus-faint","bad":true},{"t":"Use an indicator with too little contrast","m":"focus-div-btn","bad":true},{"t":"Move focus somewhere unexpected after an action","m":"focus-jump","bad":true}],"scenes":["Form field","Button","Navigation","Dialog"],"sceneUI":["<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:10px\">Complete Your Profile</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:8px\" value=\"Alex Lin\">\n      <input class=\"demo-input\" style=\"width:100%;border-color:var(--brand);box-shadow:0 0 0 3px rgba(99,102,241,.18)\" value=\"alex@example.com\">\n      <div style=\"display:flex;align-items:center;gap:6px;margin-top:10px;font-size:12px;color:var(--text-3)\">\n        <kbd style=\"border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:1px 7px;font-size:12px;background:var(--bg-soft);color:var(--text-2)\">Tab ⇥</kbd> Press to move focus to the next field\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;display:flex;gap:10px;align-items:flex-start\">\n      <img src=\"/assets/avatar-fox.png\" style=\"width:32px;height:32px;border-radius:50%;object-fit:cover\" alt=\"\">\n      <div style=\"flex:1\">\n        <div style=\"border:1px solid var(--brand);border-radius:10px;padding:9px 12px;font-size:12px;color:var(--text);background:var(--bg);box-shadow:0 0 0 3px rgba(99,102,241,.16)\">Nice color palette<span style=\"display:inline-block;width:1.5px;height:14px;background:var(--brand);vertical-align:-2px;margin-left:1px\"></span></div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:7px\">Focused input: brand-color ring + glow — the cursor is easy to spot</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:10px;padding:13px 16px\">\n        <span style=\"flex:1;font-size:13px\">Push Notifications</span>\n        <span style=\"border-radius:999px;box-shadow:0 0 0 2px #fff,0 0 0 5px var(--brand)\">\n          <label class=\"demo-switch\"><input type=\"checkbox\" checked><span class=\"track\"></span></label>\n        </span>\n      </div>\n      <div style=\"background:var(--inverse-bg);color:var(--inverse-text);font-size:12px;padding:8px 14px\">🔊 VoiceOver: “Push Notifications, switch, on”</div>\n    </div>","<div style=\"max-width:380px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;gap:8px;border:1px solid var(--brand);border-radius:8px;padding:8px 12px;background:var(--bg);box-shadow:0 0 0 3px rgba(99,102,241,.16)\">\n        <span style=\"color:var(--text-3);font-size:12px\">🔍</span>\n        <span style=\"flex:1;font-size:12px;color:var(--text)\">theme<span style=\"display:inline-block;width:1.5px;height:13px;background:var(--brand);vertical-align:-2px;margin-left:1px\"></span></span>\n        <kbd style=\"font-size:12px;color:var(--text-3);border:1px solid var(--border);border-radius:4px;padding:1px 5px\">⌘K</kbd>\n      </div>\n      <div style=\"margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-float);overflow:hidden\">\n        <div style=\"padding:7px 12px;font-size:12px;background:var(--brand-light);color:var(--brand)\">Switch to dark mode</div>\n        <div style=\"padding:7px 12px;font-size:12px;color:var(--text-2)\">Theme & appearance settings</div>\n      </div>\n    </div>"]},"usageMocks":{"in-search":"<div class=\"mk-win\"><div class=\"mk-row \"><span class=\"mk-input focus\"><em>🔍 搜索你感兴趣的内容…</em></span></div><i class=\"mk-line\" style=\"width:80%\"></i><i class=\"mk-line\" style=\"width:55%\"></i></div>","focus-ring":"<span style=\"display:inline-block;border-radius:5px;box-shadow:0 0 0 2px #fff,0 0 0 4.5px var(--brand)\"><span class=\"mk-btn primary\">保存</span></span><span style=\"font-size:12px;color:var(--text-3)\">焦点指示需与背景有足够对比并保持可见面积</span>","focus-order":"<div class=\"mk-win\" style=\"gap:6px\"><span class=\"mk-input\">① 姓名</span><span class=\"mk-input focus\">② 邮箱</span><span class=\"mk-input\">③ 电话</span></div><span style=\"font-size:12px;color:var(--text-3)\">Tab 从上到下走，顺序符合阅读预期</span>","focus-custom":"<span style=\"display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:4px;border:1px solid var(--border);background:var(--bg);box-shadow:0 0 0 2px rgba(22,93,255,.25);font-size:12px;color:var(--text-2)\"><i class=\"mk-box on\"></i>自定义复选框</span><span style=\"font-size:12px;color:var(--text-3);max-width:130px\">自己画的组件，焦点样式也要自己补</span>","focus-outline-none":"<span class=\"mk-tag red\">outline: none</span><span style=\"font-size:12px;color:var(--text-3);max-width:150px\">移除默认描边而未提供替代样式，键盘用户无法识别焦点</span>","focus-faint":"<span style=\"display:inline-block;border-radius:5px;box-shadow:0 0 0 1px #e5e6eb\"><span class=\"mk-btn primary\">保存</span></span><span style=\"font-size:12px;color:var(--text-3)\">1px 浅灰描边，对比度不足</span>","focus-div-btn":"<span class=\"mk-tag red\">&lt;div onclick&gt;</span><span style=\"font-size:12px;color:var(--text-3);max-width:150px\">div 模拟按钮未补全键盘语义，Tab 无法正常聚焦</span>","focus-jump":"<div class=\"mk-win\" style=\"gap:6px\"><span class=\"mk-input\">② 姓名</span><span class=\"mk-input focus\">① 邮箱</span><span class=\"mk-input\">③ 电话</span></div><span style=\"font-size:12px;color:var(--text-3)\">tabindex 顺序不合理，焦点移动不符合操作流程</span>"}}}