{"__formatVersion":2,"__revision":"0f8546d52c56cdd0","__entryId":"disabled","entry":{"sceneUI":["<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:10px\">注册账号</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:7px\" value=\"lin@example.com\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" type=\"password\" placeholder=\"设置密码（必填）\">\n      <button class=\"btn btn-primary\" style=\"width:100%;opacity:.4;cursor:not-allowed\">注 册</button>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:7px;text-align:center\">还有必填项没填，提交按钮保持禁用</div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <img src=\"/assets/avatar-robot.png\" style=\"width:24px;height:24px;border-radius:50%;object-fit:cover\" alt=\"\">\n        <span style=\"flex:1;font-size:12px\">林小hu</span>\n        <span class=\"demo-tag gray\">访客</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px\">\n        <span style=\"flex:1;font-size:12px;color:var(--text-2)\">项目设置</span>\n        <button class=\"btn btn-outline\" style=\"opacity:.4;cursor:not-allowed\">编辑信息</button>\n        <button class=\"btn btn-danger\" style=\"opacity:.4;cursor:not-allowed\">删除项目</button>\n      </div>\n      <div style=\"padding:8px 14px;background:var(--bg-soft);font-size:12px;color:var(--text-3)\">当前是访客身份，管理操作仅管理员可用</div>\n    </div>","<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:13px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px\"><span style=\"color:var(--text-2)\">机械键盘 ×1</span><b>¥ 199.00</b></div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:10px\">配送至：深圳市南山区 · 林小hu 收</div>\n      <button class=\"btn btn-primary\" style=\"width:100%;opacity:.55;cursor:not-allowed;display:inline-flex;align-items:center;justify-content:center;gap:6px\"><span class=\"mk-spinner\" style=\"width:12px;height:12px;border-width:1.5px\"></span>提交订单中…</button>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:7px;text-align:center\">请求返回前禁用，防止重复下单</div>\n    </div>","<div style=\"display:flex;gap:14px;max-width:380px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px;align-items:center;box-shadow:var(--shadow-card)\">\n      <span style=\"position:relative;flex:none\">\n        <img src=\"/assets/photo-cat.png\" style=\"width:72px;height:72px;border-radius:8px;object-fit:cover;display:block;filter:grayscale(.6)\" alt=\"\">\n        <span style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(24,24,27,.35);border-radius:8px;color:#fff;font-size:12px;font-weight:600\">已售罄</span>\n      </span>\n      <div style=\"flex:1\">\n        <div style=\"font-size:13px;font-weight:600\">限量猫咪摆件</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 8px\">¥ 89 · 补货时间待定</div>\n        <button class=\"btn btn-primary\" style=\"opacity:.4;cursor:not-allowed\">立即购买</button>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:10px\">Register an account</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:7px\" value=\"lin@example.com\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" type=\"password\" placeholder=\"Set password (required)\">\n      <button class=\"btn btn-primary\" style=\"width:100%;opacity:.4;cursor:not-allowed\">Register</button>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:7px;text-align:center\">Complete all required fields to enable Register</div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <img src=\"/assets/avatar-robot.png\" style=\"width:24px;height:24px;border-radius:50%;object-fit:cover\" alt=\"\">\n        <span style=\"flex:1;font-size:12px\">Alex Chen</span>\n        <span class=\"demo-tag gray\">Guest</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px\">\n        <span style=\"flex:1;font-size:12px;color:var(--text-2)\">Project settings</span>\n        <button class=\"btn btn-outline\" style=\"opacity:.4;cursor:not-allowed\">Edit details</button>\n        <button class=\"btn btn-danger\" style=\"opacity:.4;cursor:not-allowed\">Delete project</button>\n      </div>\n      <div style=\"padding:8px 14px;background:var(--bg-soft);font-size:12px;color:var(--text-3)\">Guests can view project settings, but only admins can edit or delete them</div>\n    </div>","<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:13px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px\"><span style=\"color:var(--text-2)\">Mechanical keyboard ×1</span><b>¥ 199.00</b></div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:10px\">Delivery: Alex Chen · Nanshan District, Shenzhen</div>\n      <button class=\"btn btn-primary\" style=\"width:100%;opacity:.55;cursor:not-allowed;display:inline-flex;align-items:center;justify-content:center;gap:6px\"><span class=\"mk-spinner\" style=\"width:12px;height:12px;border-width:1.5px\"></span>Submitting order...</button>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:7px;text-align:center\">Keep the button disabled while the order is being submitted to prevent duplicates</div>\n    </div>","<div style=\"display:flex;gap:14px;max-width:380px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px;align-items:center;box-shadow:var(--shadow-card)\">\n      <span style=\"position:relative;flex:none\">\n        <img src=\"/assets/photo-cat.png\" style=\"width:72px;height:72px;border-radius:8px;object-fit:cover;display:block;filter:grayscale(.6)\" alt=\"\">\n        <span style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(24,24,27,.35);border-radius:8px;color:#fff;font-size:12px;font-weight:600\">Sold out</span>\n      </span>\n      <div style=\"flex:1\">\n        <div style=\"font-size:13px;font-weight:600\">Limited-edition cat figurine</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 8px\">¥ 89 · Restock date not announced</div>\n        <button class=\"btn btn-primary\" style=\"opacity:.4;cursor:not-allowed\">Buy now</button>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"look\"><span class=\"disabled-btn is-off\">提交</span></span><span class=\"ap\" data-ap=\"block\"><span class=\"disabled-anat-chip\">🚫 点击无效</span></span><span class=\"ap\" data-ap=\"reason\"><span class=\"disabled-anat-reason\">提示：先填邮箱</span></span>","demo_en":"<span class=\"ap\" data-ap=\"look\"><span class=\"disabled-btn is-off\">Submit</span></span><span class=\"ap\" data-ap=\"block\"><span class=\"disabled-anat-chip\">🚫 Invalid click</span></span><span class=\"ap\" data-ap=\"reason\"><span class=\"disabled-anat-reason\">Tip: Fill in your email address first</span></span>","parts":[{"key":"look","cn":"置灰外观","en":"Greyed","desc":"降低视觉强调，同时保持文字和状态仍可识别","desc_en":"Reduce visual emphasis while keeping text and status still legible"},{"key":"block","cn":"禁止交互","en":"Blocked","desc":"原生 disabled 通常会阻止交互与焦点；aria-disabled 只表达语义，仍需脚本阻止操作并决定焦点策略","desc_en":"Native disabled usually prevents interaction and focus; aria-disabled only expresses semantics and still requires scripts to prevent operations and determine focus strategies."},{"key":"reason","cn":"原因说明","en":"Reason","desc":"说明当前不可用的原因以及恢复条件","desc_en":"Explain why the control is unavailable and what will make it available"}]},"variants":[{"cn":"原生禁用","en":"Native disabled","demo":"<span class=\"disabled-btn is-off\">提交</span>","demo_en":"<span class=\"disabled-btn is-off\">Submit</span>","when":"原生 button、input 等当前确实不可操作时；外观数值按系统验证","when_en":"Use native disabled for controls that are truly unavailable; test their appearance and behavior in your target browsers"},{"cn":"禁用 + 提示","en":"With Reason","demo":"<span class=\"disabled-v-reason\"><span class=\"disabled-btn is-off\">注册</span><i>先填密码</i></span>","demo_en":"<span class=\"disabled-v-reason\"><span class=\"disabled-btn is-off\">Register</span><i>Fill in the password first</i></span>","when":"需要说明当前不可用及其恢复条件","when_en":"The control will become available after a clear condition is met; show that condition nearby"},{"cn":"直接隐藏","en":"Hidden","demo":"<span class=\"disabled-v-ghost\">（不渲染）</span>","demo_en":"<span class=\"disabled-v-ghost\">(no rendering)</span>","when":"该操作在当前情境中不适用，也无需解释时","when_en":"The action does not apply in this context and needs no explanation; omit it instead of showing a disabled control"}],"use":[{"t":"<b>视觉与语义一起禁用</b>：{c:button}、{c:input} 不能只改颜色","m":"disabled-grey"},{"t":"表单未完成时若禁用提交，应<b>就近说明缺少的内容</b>","m":"disabled-form"},{"t":"<b>原因直接写在旁边</b>：让键盘和触屏用户也能看到","m":"disabled-reason"},{"t":"<b>提交中防重复点击</b>：请求没回来前禁用，避免重复下单","m":"disabled-prevent"}],"dont":[{"t":"<b>禁用了不说明原因</b>：只显示灰色不可用状态，却不说明缺少的输入、库存或权限","m":"disabled-no-why","bad":true},{"t":"对长期无权限入口<b>直接隐藏</b>：用户可能不知道功能存在或如何申请；应按信息价值决定","m":"disabled-hide","bad":true},{"t":"<b>不可用态与可用态差异不足</b>：用户可能误判为可操作","m":"disabled-fake","bad":true},{"t":"<b>状态与行为不一致</b>：控件看似可用却不响应操作","m":"disabled-dead","bad":true}],"lessonPractice":{"title":"提交按钮因“公司名称”未填而禁用，但用户只看到一个灰色按钮。怎样让原因更清楚？","options":[{"id":"tooltip-reason","label":"把原因只放进按钮的鼠标悬停提示里","feedback":"原生禁用按钮通常不能聚焦，触屏也没有稳定悬停；很多用户仍然看不到原因。","correct":false},{"id":"nearby-reason","label":"在缺失字段附近说明要求，并随填写更新按钮状态","feedback":"原因和解决方法都靠近问题来源，键盘与触屏用户也能看见何时满足提交条件。","correct":true},{"id":"gray-only","label":"只降低按钮透明度，但继续让点击触发提交","feedback":"视觉上像禁用、行为却仍可执行，会产生冲突反馈，也可能提交不完整数据。","correct":false}],"en":{"title":"Submit is disabled because Company name is empty, but people only see a gray button. How can the reason become clear?","options":[{"id":"tooltip-reason","label":"Put the reason only in a mouse-hover tooltip on the button","feedback":"Native disabled buttons are often not focusable, and touch has no reliable hover, so the reason remains inaccessible.","correct":false},{"id":"nearby-reason","label":"Explain the requirement near the missing field and update the button as it is completed","feedback":"The cause and remedy appear where the problem occurs, and every input method can see when submission becomes available.","correct":true},{"id":"gray-only","label":"Lower the button opacity but still submit when it is clicked","feedback":"The visual state says unavailable while the behavior still runs, creating conflicting feedback and incomplete submissions.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"提交按钮因公司名称未填而禁用时，请在字段附近直接说明要求，并随输入更新按钮状态。不要只把原因放进 Tooltip，也不要只改灰色却仍允许提交。请用键盘和触屏验证原因可见、行为一致。","en":{"title":"You can say this to an AI Agent","text":"When Submit is disabled because Company name is missing, explain the requirement near the field and update the button as input changes. Do not rely on a tooltip or gray styling while still submitting. Verify visible reasons and consistent behavior with keyboard and touch."}},"demoDetail":"<div class=\"disabled-play\">\n    <input class=\"disabled-demo-input\" placeholder=\"邮箱（还没填）\" />\n    <span class=\"disabled-why-wrap\">\n      <button type=\"button\" class=\"disabled-live off\" disabled>提交</button>\n      <span class=\"disabled-why-tip\">先填邮箱才能提交</span>\n    </span>\n    <button type=\"button\" class=\"disabled-live\">对照：可提交</button>\n    <span class=\"disabled-hint\">表单条件未满足时，禁用提交并在附近说明缺少的内容</span>\n  </div>","references":[{"title":"aria-disabled","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Reference/Attributes/aria-disabled","title_en":"aria-disabled"}],"scenes":["表单未填完禁用提交","无权限操作置灰","提交中防重复点击","售罄商品不可购买"],"en":{"demoDetail":"<div class=\"disabled-play\">\n    <input class=\"disabled-demo-input\" placeholder=\"Email (not filled in yet)\" />\n    <span class=\"disabled-why-wrap\">\n      <button type=\"button\" class=\"disabled-live off\" disabled>Submit</button>\n      <span class=\"disabled-why-tip\">Please fill in your email address before submitting</span>\n    </span>\n    <button type=\"button\" class=\"disabled-live\">Contrast: Submit</button>\n    <span class=\"disabled-hint\">When form conditions are not met, disable submission and indicate missing content nearby</span>\n  </div>","use":[{"t":"Prevent submission until required input is present","m":"disabled-grey"},{"t":"Show an unavailable step that may become available","m":"disabled-form"},{"t":"Block an action while the same request is running","m":"disabled-reason"},{"t":"Represent a permission or state constraint","m":"disabled-prevent"}],"dont":[{"t":"Disable a control without explaining why","m":"disabled-no-why","bad":true},{"t":"Use low contrast that makes the label unreadable","m":"disabled-hide","bad":true},{"t":"Leave keyboard focus on a control that cannot respond","m":"disabled-fake","bad":true},{"t":"Disable most of the page instead of clarifying the workflow","m":"disabled-dead","bad":true}],"scenes":["Submit button","Unavailable option","Loading action","Permission-limited control"],"sceneUI":["<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:10px\">Register an account</div>\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:7px\" value=\"lin@example.com\">\n      <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" type=\"password\" placeholder=\"Set password (required)\">\n      <button class=\"btn btn-primary\" style=\"width:100%;opacity:.4;cursor:not-allowed\">Register</button>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:7px;text-align:center\">Complete all required fields to enable Register</div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <img src=\"/assets/avatar-robot.png\" style=\"width:24px;height:24px;border-radius:50%;object-fit:cover\" alt=\"\">\n        <span style=\"flex:1;font-size:12px\">Alex Chen</span>\n        <span class=\"demo-tag gray\">Guest</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px\">\n        <span style=\"flex:1;font-size:12px;color:var(--text-2)\">Project settings</span>\n        <button class=\"btn btn-outline\" style=\"opacity:.4;cursor:not-allowed\">Edit details</button>\n        <button class=\"btn btn-danger\" style=\"opacity:.4;cursor:not-allowed\">Delete project</button>\n      </div>\n      <div style=\"padding:8px 14px;background:var(--bg-soft);font-size:12px;color:var(--text-3)\">Guests can view project settings, but only admins can edit or delete them</div>\n    </div>","<div style=\"max-width:340px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:13px 18px;box-shadow:var(--shadow-card)\">\n      <div style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px\"><span style=\"color:var(--text-2)\">Mechanical keyboard ×1</span><b>¥ 199.00</b></div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-bottom:10px\">Delivery: Alex Chen · Nanshan District, Shenzhen</div>\n      <button class=\"btn btn-primary\" style=\"width:100%;opacity:.55;cursor:not-allowed;display:inline-flex;align-items:center;justify-content:center;gap:6px\"><span class=\"mk-spinner\" style=\"width:12px;height:12px;border-width:1.5px\"></span>Submitting order...</button>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:7px;text-align:center\">Keep the button disabled while the order is being submitted to prevent duplicates</div>\n    </div>","<div style=\"display:flex;gap:14px;max-width:380px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px;align-items:center;box-shadow:var(--shadow-card)\">\n      <span style=\"position:relative;flex:none\">\n        <img src=\"/assets/photo-cat.png\" style=\"width:72px;height:72px;border-radius:8px;object-fit:cover;display:block;filter:grayscale(.6)\" alt=\"\">\n        <span style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(24,24,27,.35);border-radius:8px;color:#fff;font-size:12px;font-weight:600\">Sold out</span>\n      </span>\n      <div style=\"flex:1\">\n        <div style=\"font-size:13px;font-weight:600\">Limited-edition cat figurine</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 8px\">¥ 89 · Restock date not announced</div>\n        <button class=\"btn btn-primary\" style=\"opacity:.4;cursor:not-allowed\">Buy now</button>\n      </div>\n    </div>"],"variants":[{"demo":"<span class=\"disabled-btn is-off\">Submit</span>","when":"Use native disabled for controls that are truly unavailable; test their appearance and behavior in your target browsers"},{"demo":"<span class=\"disabled-v-reason\"><span class=\"disabled-btn is-off\">Register</span><i>Fill in the password first</i></span>","when":"The control will become available after a clear condition is met; show that condition nearby"},{"demo":"<span class=\"disabled-v-ghost\">(no rendering)</span>","when":"The action does not apply in this context and needs no explanation; omit it instead of showing a disabled control"}]},"usageMocks":{"disabled-grey":"<div class=\"mk-row\"><span class=\"mk-btn primary\">提交</span><span class=\"mk-btn primary\" style=\"opacity:.4\">提交</span></div><span style=\"font-size:12px;color:var(--text-3)\">外观要说明不可用；原生 disabled 与 aria-disabled 的交互语义不同</span>","disabled-form":"<div class=\"mk-win\"><span class=\"mk-input focus\">lin@example.com</span><span class=\"mk-input\"><em>密码（必填）</em></span><span class=\"mk-btn primary\" style=\"opacity:.4;align-self:flex-start\">注册</span><span style=\"font-size:12px;color:var(--text-3)\">还有必填没填，提交保持禁用</span></div>","disabled-reason":"<span class=\"mk-tip-wrap\"><span class=\"mk-tip-bubble\">请先填写密码</span><span class=\"mk-btn primary\" style=\"opacity:.4\">注册</span></span><span style=\"font-size:12px;color:var(--text-3)\">原因应直接可见或能被键盘、触屏访问，不能只靠悬停</span>","disabled-prevent":"<span class=\"mk-btn primary\" style=\"opacity:.55;display:inline-flex;align-items:center;gap:5px\"><span class=\"mk-spinner\" style=\"width:10px;height:10px;border-width:1.5px\"></span>提交中…</span><span style=\"font-size:12px;color:var(--text-3);max-width:130px\">请求没回来前禁用，防重复提交</span>","disabled-no-why":"<span class=\"mk-btn primary\" style=\"opacity:.4\">立即购买</span><span style=\"font-size:12px;color:var(--text-3);max-width:150px\">仅显示不可用，没有说明缺少规格、库存或权限等原因</span>","disabled-hide":"<div class=\"mk-row\"><span class=\"mk-tag gray\">普通成员</span><span style=\"font-size:12px;color:var(--text-3);max-width:150px\">对长期无权限入口直接隐藏，用户可能无法发现功能或申请方式</span></div>","disabled-fake":"<span class=\"mk-btn primary\" style=\"opacity:.85\">删除项目</span><span style=\"font-size:12px;color:var(--text-3);max-width:150px\">不可用状态与可用态差异不足，用户可能误判为可操作</span>","disabled-dead":"<span class=\"mk-btn primary\">提交</span><span style=\"font-size:12px;color:var(--text-3);max-width:150px\">控件看似可用却不响应操作，状态与行为不一致</span>"}}}