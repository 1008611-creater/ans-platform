{"__formatVersion":2,"__revision":"e446d678ea000156","__entryId":"style-bento","entry":{"sceneUI":["<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:18px\">\n      <div style=\"text-align:center;margin-bottom:14px\"><div style=\"font-size:20px;font-weight:700;letter-spacing:-.5px;color:#1d1d1f\">M4 芯片，快到离谱。</div><div style=\"font-size:12px;color:#86868b;margin-top:3px\">每一项，都强一项。</div></div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:66px;gap:10px\">\n        <div style=\"grid-column:span 2;grid-row:span 2;background:#1d1d1f;border-radius:18px;padding:14px;display:flex;flex-direction:column;justify-content:space-between\"><span style=\"font-size:12px;color:#86868b\">中央处理器</span><b style=\"font-size:22px;color:#fff;letter-spacing:-.5px\">10 核 CPU<br><span style=\"font-size:13px;font-weight:400;color:#a1a1a6\">性能提升 1.6 倍</span></b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:18px;color:#1d1d1f\">18h</b><div style=\"font-size:12px;color:#86868b\">电池续航</div></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:18px;color:#1d1d1f\">示例指标</b><div style=\"font-size:12px;color:#86868b\">说明统计口径与时间范围</div></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><span style=\"font-size:18px\">🎮</span><div><b style=\"font-size:13px;color:#1d1d1f\">硬件光追</b><div style=\"font-size:12px;color:#86868b\">游戏画面直逼主机</div></div></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:18px\">\n      <div style=\"display:flex;align-items:baseline;gap:10px;margin-bottom:12px\"><b style=\"font-size:18px;color:#1d1d1f;letter-spacing:-.3px\">Paws 能做什么</b><span style=\"font-size:12px;color:#86868b\">猫咪生活，一个 App 全包</span></div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:70px;gap:10px\">\n        <div style=\"grid-column:span 2;grid-row:span 2;background:#fff;border-radius:18px;overflow:hidden;position:relative\"><img src=\"/assets/photo-cat.png\" style=\"width:100%;height:100%;object-fit:cover;display:block\" alt=\"\"><span style=\"position:absolute;left:12px;bottom:10px;background:rgba(255,255,255,.85);backdrop-filter:blur(8px);border-radius:999px;font-size:12px;color:#1d1d1f;padding:3px 10px\">🐱 成长相册</span></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><span style=\"font-size:16px\">🍖</span><b style=\"display:block;font-size:13px;color:#1d1d1f;margin-top:2px\">喂食提醒</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><span style=\"font-size:16px\">💉</span><b style=\"display:block;font-size:13px;color:#1d1d1f;margin-top:2px\">疫苗记录</b></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><b style=\"font-size:17px;color:#1d1d1f\">4.2kg</b><span style=\"font-size:12px;color:#86868b\">本月体重曲线 ↗ 健康</span></div>\n        <div style=\"background:#1d1d1f;border-radius:18px;display:flex;align-items:center;justify-content:center\"><span style=\"font-size:12px;color:#fff;font-weight:600\">App Store 下载 →</span></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid #ececf0;border-radius:16px;padding:20px\">\n      <div style=\"text-align:center;margin-bottom:14px\"><div style=\"font-size:12px;color:#5e6ad2;font-weight:600\">FEATURES</div><div style=\"font-size:19px;font-weight:700;letter-spacing:-.4px;color:#0a0a0c;margin-top:3px\">为团队速度而生的四件事</div></div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:74px;gap:10px\">\n        <div style=\"grid-column:span 2;background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">⌘K 指令面板</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">不碰鼠标，一句话直达任何页面、任何操作。</div></div>\n        <div style=\"background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">⚡️ 响应示例</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">实际响应指标需注明测试条件与口径</div></div>\n        <div style=\"background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">🔄 实时协作</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">多人光标同屏可见</div></div>\n        <div style=\"grid-column:span 2;background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">🤖 AI 自动整理</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">零散任务自动归入迭代，周报自动写好草稿。</div></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:16px\">\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:64px;gap:10px\">\n        <div style=\"grid-row:span 2;background:#fff;border-radius:18px;overflow:hidden\"><img src=\"/assets/avatar-fox.png\" style=\"width:100%;height:100%;object-fit:cover;display:block\" alt=\"\"></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:15px;color:#1d1d1f\">小狸 👋</b><div style=\"font-size:12px;color:#86868b;margin-top:2px\">独立开发者 · 深圳</div></div>\n        <div style=\"background:#1d1d1f;border-radius:18px;padding:12px;display:flex;flex-direction:column;justify-content:center\"><span style=\"font-size:12px;color:#a1a1a6\">正在播放</span><b style=\"font-size:12px;color:#fff\">夜航星 🎧</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:8px\"><span style=\"font-size:15px\">✍️</span><b style=\"font-size:12px;color:#1d1d1f\">博客</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:8px\"><span style=\"font-size:15px\">🐙</span><b style=\"font-size:12px;color:#1d1d1f\">GitHub</b></div>\n        <div style=\"grid-column:span 2;background:linear-gradient(120deg,#e8f0ff,#f3e8ff);border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><b style=\"font-size:14px;color:#1d1d1f\">📮 每周通讯</b><span style=\"font-size:12px;color:#6e6e73\">1,204 位订阅者</span></div>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:18px\">\n      <div style=\"text-align:center;margin-bottom:14px\"><div style=\"font-size:20px;font-weight:700;letter-spacing:-.5px;color:#1d1d1f\">M4 chip, ridiculously fast. </div><div style=\"font-size:12px;color:#86868b;margin-top:3px\">Each item is stronger than another. </div></div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:66px;gap:10px\">\n        <div style=\"grid-column:span 2;grid-row:span 2;background:#1d1d1f;border-radius:18px;padding:14px;display:flex;flex-direction:column;justify-content:space-between\"><span style=\"font-size:12px;color:#86868b\">CPU</span><b style=\"font-size:22px;color:#fff;letter-spacing:-.5px\">10-core CPU<br><span style=\"font-size:13px;font-weight:400;color:#a1a1a6\">1.6x performance improvement</span></b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:18px;color:#1d1d1f\">18h</b><div style=\"font-size:12px;color:#86868b\">Battery life</div></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:18px;color:#1d1d1f\">Example indicators</b><div style=\"font-size:12px;color:#86868b\">Explanation of calculation method and time range</div></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><span style=\"font-size:18px\">🎮</span><div><b style=\"font-size:13px;color:#1d1d1f\">Hardware light tracing</b><div style=\"font-size:12px;color:#86868b\">The game screen is close to the console</div></div></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:18px\">\n      <div style=\"display:flex;align-items:baseline;gap:10px;margin-bottom:12px\"><b style=\"font-size:18px;color:#1d1d1f;letter-spacing:-.3px\">What can Paws do</b><span style=\"font-size:12px;color:#86868b\">Cat Life, an App All inclusive</span></div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:70px;gap:10px\">\n        <div style=\"grid-column:span 2;grid-row:span 2;background:#fff;border-radius:18px;overflow:hidden;position:relative\"><img src=\"/assets/photo-cat.png\" style=\"width:100%;height:100%;object-fit:cover;display:block\" alt=\"\"><span style=\"position:absolute;left:12px;bottom:10px;background:rgba(255,255,255,.85);backdrop-filter:blur(8px);border-radius:999px;font-size:12px;color:#1d1d1f;padding:3px 10px\">🐱 Growth Photo Album</span></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><span style=\"font-size:16px\">🍖</span><b style=\"display:block;font-size:13px;color:#1d1d1f;margin-top:2px\">Feeding reminder</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><span style=\"font-size:16px\">💉</span><b style=\"display:block;font-size:13px;color:#1d1d1f;margin-top:2px\">Vaccine Record</b></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><b style=\"font-size:17px;color:#1d1d1f\">4.2kg</b><span style=\"font-size:12px;color:#86868b\">This month’s weight curve ↗ Health</span></div>\n        <div style=\"background:#1d1d1f;border-radius:18px;display:flex;align-items:center;justify-content:center\"><span style=\"font-size:12px;color:#fff;font-weight:600\">App Store Download →</span></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid #ececf0;border-radius:16px;padding:20px\">\n      <div style=\"text-align:center;margin-bottom:14px\"><div style=\"font-size:12px;color:#5e6ad2;font-weight:600\">FEATURES</div><div style=\"font-size:19px;font-weight:700;letter-spacing:-.4px;color:#0a0a0c;margin-top:3px\">Four things for team speed</div></div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:74px;gap:10px\">\n        <div style=\"grid-column:span 2;background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">⌘K Command Panel</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">Without touching the mouse, you can directly access any page or operation in one sentence. </div></div>\n        <div style=\"background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">⚡️ Response example</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">The actual response indicators need to indicate the test conditions and calculation method</div></div>\n        <div style=\"background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">🔄 Real-time collaboration</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">Multiple cursors are visible on the same screen</div></div>\n        <div style=\"grid-column:span 2;background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">🤖 AI automatic sorting</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">Scattered tasks are automatically classified into iterations, and a draft of the weekly report is automatically written. </div></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:16px\">\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:64px;gap:10px\">\n        <div style=\"grid-row:span 2;background:#fff;border-radius:18px;overflow:hidden\"><img src=\"/assets/avatar-fox.png\" style=\"width:100%;height:100%;object-fit:cover;display:block\" alt=\"\"></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:15px;color:#1d1d1f\">Xiaoli 👋</b><div style=\"font-size:12px;color:#86868b;margin-top:2px\">Independent developer · Shenzhen</div></div>\n        <div style=\"background:#1d1d1f;border-radius:18px;padding:12px;display:flex;flex-direction:column;justify-content:center\"><span style=\"font-size:12px;color:#a1a1a6\">Now playing</span><b style=\"font-size:12px;color:#fff\">Night Star 🎧</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:8px\"><span style=\"font-size:15px\">✍️</span><b style=\"font-size:12px;color:#1d1d1f\">Blog</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:8px\"><span style=\"font-size:15px\">🐙</span><b style=\"font-size:12px;color:#1d1d1f\">GitHub</b></div>\n        <div style=\"grid-column:span 2;background:linear-gradient(120deg,#e8f0ff,#f3e8ff);border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><b style=\"font-size:14px;color:#1d1d1f\">📮 Weekly Newsletter</b><span style=\"font-size:12px;color:#6e6e73\">1,204 subscribers</span></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"grid\"><span class=\"style-bento-chip\"><i style=\"background:repeating-linear-gradient(90deg,#d7d7dc 0 4px,#fff 4px 8px);border-color:#e5e6eb\"></i>不均匀网格</span></span>\n      <span class=\"ap\" data-ap=\"radius\"><span class=\"style-bento-chip\"><i style=\"background:#fff;border:1px solid #e5e6eb;border-radius:9px\"></i>圆角 16-24px</span></span>\n      <span class=\"ap\" data-ap=\"gap\"><span class=\"style-bento-chip\"><i style=\"background:linear-gradient(90deg,#fff 30%,#e5e6eb 30%,#e5e6eb 70%,#fff 70%);border-color:#e5e6eb\"></i>统一格距</span></span>\n      <span class=\"ap\" data-ap=\"inner\"><span class=\"style-bento-chip\"><span style=\"font-size:12px\">⚡️</span>内容优先级</span></span>\n      <span class=\"ap\" data-ap=\"bg\"><span class=\"style-bento-chip\"><i style=\"background:linear-gradient(135deg,#f5f5f7 50%,#fff 50%);border-color:#e5e6eb\"></i>灰底白格</span></span>\n    </span>","demo_en":"<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\">\n      <span class=\"ap\" data-ap=\"grid\"><span class=\"style-bento-chip\"><i style=\"background:repeating-linear-gradient(90deg,#d7d7dc 0 4px,#fff 4px 8px);border-color:#e5e6eb\"></i>Uneven grid</span></span>\n      <span class=\"ap\" data-ap=\"radius\"><span class=\"style-bento-chip\"><i style=\"background:#fff;border:1px solid #e5e6eb;border-radius:9px\"></i>Rounded corners 16-24px</span></span>\n      <span class=\"ap\" data-ap=\"gap\"><span class=\"style-bento-chip\"><i style=\"background:linear-gradient(90deg,#fff 30%,#e5e6eb 30%,#e5e6eb 70%,#fff 70%);border-color:#e5e6eb\"></i>Uniform spacing</span></span>\n      <span class=\"ap\" data-ap=\"inner\"><span class=\"style-bento-chip\"><span style=\"font-size:12px\">⚡️</span>Content Priority</span></span>\n      <span class=\"ap\" data-ap=\"bg\"><span class=\"style-bento-chip\"><i style=\"background:linear-gradient(135deg,#f5f5f7 50%,#fff 50%);border-color:#e5e6eb\"></i>White grid on gray background</span></span>\n    </span>","parts":[{"key":"grid","cn":"不均匀网格","en":"Grid","desc":"用不同跨度表达优先级；小屏重排后仍要保持阅读顺序","desc_en":"Use different spans to express priorities; the reading order must still be maintained after rearrangement for small screens"},{"key":"radius","cn":"统一圆角","en":"Radius","desc":"卡片圆角来自项目尺度，并与卡片大小和品牌气质协调","desc_en":"Card rounded corners come from project scale and are coordinated with card size and brand ethos"},{"key":"gap","cn":"统一格距","en":"Gap","desc":"一致间距帮助看出同一组；需要分组时可以使用更大的组间距","desc_en":"Consistent spacing helps groups be identified; larger group spacing can be used when grouping is required"},{"key":"inner","cn":"可扫读内容","en":"Content","desc":"标题、说明、数据和操作按优先级组织，元素数量由内容决定","desc_en":"Title, description, data and actions are organized by priority, the number of elements is determined by the content"},{"key":"bg","cn":"画布与卡片","en":"Canvas","desc":"示例用浅灰底托白卡；其他主题也可以，只要边界和对比清楚","desc_en":"The example uses a light gray background with a white card; other themes are also acceptable as long as the borders and contrast are clear"}]},"use":[{"t":"产品功能总览，同时展示多个并列能力","m":"style-bento-use-overview"},{"t":"规格比较，让重点指标占据更大区域","m":"style-bento-use-keynote"},{"t":"应用功能页，在一页说明主要能力","m":"style-bento-use-app"},{"t":"仪表盘首页，组合指标、图表和快捷入口","m":"style-bento-use-dashboard"}],"dont":[{"t":"在小卡片中放置长段正文，增加阅读负担","m":"style-bento-dont-text","bad":true},{"t":"卡片大小没有优先级，只追求随机变化","m":"style-bento-dont-random","bad":true},{"t":"卡片数量过多，用户无法快速扫读","m":"style-bento-dont-many","bad":true},{"t":"按顺序进行的流程被拆成互不相关的格子","m":"style-bento-dont-flow","bad":true}],"principles":[{"t":"<b>一格围绕一个主题</b>：可以包含标题、说明和操作，无关信息应拆到其他区块","m":"style-bento-one"},{"t":"<b>卡片大小反映优先级</b>：大格展示核心内容，小格补充信息；具体跨度由网格和屏幕决定","m":"style-bento-rhythm"},{"t":"<b>圆角和间距遵循同一套尺度</b>：数值跟随品牌与卡片尺寸，不必固定在 16～24px","m":"style-bento-radius"},{"t":"<b>格内信息保持可扫读</b>：图标、大字或一句话只是常见组合，关键是层级清楚并留出操作空间","m":"style-bento-inner"},{"t":"<b>颜色用来分组或强调</b>：不要求灰底白卡，也不限制深色卡数量，但要保持整体对比和一致性","m":"style-bento-system"}],"prompt":"为一款新耳机做功能介绍页。用大小不同的模块组织续航、降噪、佩戴和连接体验，每个模块只回答一个问题；先安排阅读顺序，再决定卡片大小。规格和效果只使用已有测试或产品资料，缺少的先标“待补充”，不要补造数据。","prompt_en":"Bento grid layout with varied card sizes, one feature per cell, 20px rounded corners, light gray canvas, white cards, icons with large type and one concise line of supporting copy","references":[{"title":"CSS Grid 布局完全指南","source":"CSS-Tricks","url":"https://css-tricks.com/snippets/css/complete-guide-grid/","title_en":"A Complete Guide to CSS Grid Layout"},{"title":"共同区域法则","source":"Laws of UX","url":"https://lawsofux.com/law-of-common-region/","title_en":"Law of Common Region"}],"scenes":["发布会式规格墙","App 功能总览页","SaaS 特性区","个人主页 bento"],"en":{"prompt":"Bento grid layout with varied card sizes, one feature per cell, 20px rounded corners, light gray canvas, white cards, icons with large type and one concise line of supporting copy","use":[{"t":"Product feature overview","m":"style-bento-use-overview"},{"t":"Portfolio or case-study index","m":"style-bento-use-keynote"},{"t":"Dashboard with several content types","m":"style-bento-use-app"},{"t":"Homepage section with visual variety","m":"style-bento-use-dashboard"}],"dont":[{"t":"Give every card equal emphasis inside a supposedly varied grid","m":"style-bento-dont-text","bad":true},{"t":"Place unrelated fragments together only to fill gaps","m":"style-bento-dont-random","bad":true},{"t":"Force the desktop mosaic into one cramped mobile row","m":"style-bento-dont-many","bad":true},{"t":"Use decorative cards that repeat the same message","m":"style-bento-dont-flow","bad":true}],"principles":[{"t":"Assign card size from content priority","m":"style-bento-one"},{"t":"Keep a clear reading path across the grid","m":"style-bento-rhythm"},{"t":"Give each cell one focused job","m":"style-bento-radius"},{"t":"Use shared spacing, corners, and surfaces to hold the set together","m":"style-bento-inner"},{"t":"Recompose the grid deliberately for narrow screens","m":"style-bento-system"}],"scenes":["Feature overview","Portfolio","Product dashboard","Company homepage"],"sceneUI":["<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:18px\">\n      <div style=\"text-align:center;margin-bottom:14px\"><div style=\"font-size:20px;font-weight:700;letter-spacing:-.5px;color:#1d1d1f\">M4 chip, ridiculously fast. </div><div style=\"font-size:12px;color:#86868b;margin-top:3px\">Each item is stronger than another. </div></div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:66px;gap:10px\">\n        <div style=\"grid-column:span 2;grid-row:span 2;background:#1d1d1f;border-radius:18px;padding:14px;display:flex;flex-direction:column;justify-content:space-between\"><span style=\"font-size:12px;color:#86868b\">CPU</span><b style=\"font-size:22px;color:#fff;letter-spacing:-.5px\">10-core CPU<br><span style=\"font-size:13px;font-weight:400;color:#a1a1a6\">1.6x performance improvement</span></b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:18px;color:#1d1d1f\">18h</b><div style=\"font-size:12px;color:#86868b\">Battery life</div></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:18px;color:#1d1d1f\">Example indicators</b><div style=\"font-size:12px;color:#86868b\">Explanation of calculation method and time range</div></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><span style=\"font-size:18px\">🎮</span><div><b style=\"font-size:13px;color:#1d1d1f\">Hardware light tracing</b><div style=\"font-size:12px;color:#86868b\">The game screen is close to the console</div></div></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:18px\">\n      <div style=\"display:flex;align-items:baseline;gap:10px;margin-bottom:12px\"><b style=\"font-size:18px;color:#1d1d1f;letter-spacing:-.3px\">What can Paws do</b><span style=\"font-size:12px;color:#86868b\">Cat Life, an App All inclusive</span></div>\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:70px;gap:10px\">\n        <div style=\"grid-column:span 2;grid-row:span 2;background:#fff;border-radius:18px;overflow:hidden;position:relative\"><img src=\"/assets/photo-cat.png\" style=\"width:100%;height:100%;object-fit:cover;display:block\" alt=\"\"><span style=\"position:absolute;left:12px;bottom:10px;background:rgba(255,255,255,.85);backdrop-filter:blur(8px);border-radius:999px;font-size:12px;color:#1d1d1f;padding:3px 10px\">🐱 Growth Photo Album</span></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><span style=\"font-size:16px\">🍖</span><b style=\"display:block;font-size:13px;color:#1d1d1f;margin-top:2px\">Feeding reminder</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px\"><span style=\"font-size:16px\">💉</span><b style=\"display:block;font-size:13px;color:#1d1d1f;margin-top:2px\">Vaccine Record</b></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><b style=\"font-size:17px;color:#1d1d1f\">4.2kg</b><span style=\"font-size:12px;color:#86868b\">This month’s weight curve ↗ Health</span></div>\n        <div style=\"background:#1d1d1f;border-radius:18px;display:flex;align-items:center;justify-content:center\"><span style=\"font-size:12px;color:#fff;font-weight:600\">App Store Download →</span></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#fff;border:1px solid #ececf0;border-radius:16px;padding:20px\">\n      <div style=\"text-align:center;margin-bottom:14px\"><div style=\"font-size:12px;color:#5e6ad2;font-weight:600\">FEATURES</div><div style=\"font-size:19px;font-weight:700;letter-spacing:-.4px;color:#0a0a0c;margin-top:3px\">Four things for team speed</div></div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:74px;gap:10px\">\n        <div style=\"grid-column:span 2;background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">⌘K Command Panel</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">Without touching the mouse, you can directly access any page or operation in one sentence. </div></div>\n        <div style=\"background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">⚡️ Response example</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">The actual response indicators need to indicate the test conditions and calculation method</div></div>\n        <div style=\"background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">🔄 Real-time collaboration</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">Multiple cursors are visible on the same screen</div></div>\n        <div style=\"grid-column:span 2;background:#fbfbfc;border:1px solid #f0f0f3;border-radius:16px;padding:13px 15px\"><b style=\"font-size:14px;color:#0a0a0c\">🤖 AI automatic sorting</b><div style=\"font-size:12px;color:#8a8a93;margin-top:4px\">Scattered tasks are automatically classified into iterations, and a draft of the weekly report is automatically written. </div></div>\n      </div>\n    </div>","<div style=\"max-width:640px;margin:0 auto;background:#f5f5f7;border:1px solid #ececf0;border-radius:16px;padding:16px\">\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:64px;gap:10px\">\n        <div style=\"grid-row:span 2;background:#fff;border-radius:18px;overflow:hidden\"><img src=\"/assets/avatar-fox.png\" style=\"width:100%;height:100%;object-fit:cover;display:block\" alt=\"\"></div>\n        <div style=\"grid-column:span 2;background:#fff;border-radius:18px;padding:12px\"><b style=\"font-size:15px;color:#1d1d1f\">Xiaoli 👋</b><div style=\"font-size:12px;color:#86868b;margin-top:2px\">Independent developer · Shenzhen</div></div>\n        <div style=\"background:#1d1d1f;border-radius:18px;padding:12px;display:flex;flex-direction:column;justify-content:center\"><span style=\"font-size:12px;color:#a1a1a6\">Now playing</span><b style=\"font-size:12px;color:#fff\">Night Star 🎧</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:8px\"><span style=\"font-size:15px\">✍️</span><b style=\"font-size:12px;color:#1d1d1f\">Blog</b></div>\n        <div style=\"background:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:8px\"><span style=\"font-size:15px\">🐙</span><b style=\"font-size:12px;color:#1d1d1f\">GitHub</b></div>\n        <div style=\"grid-column:span 2;background:linear-gradient(120deg,#e8f0ff,#f3e8ff);border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px\"><b style=\"font-size:14px;color:#1d1d1f\">📮 Weekly Newsletter</b><span style=\"font-size:12px;color:#6e6e73\">1,204 subscribers</span></div>\n      </div>\n    </div>"]},"usageMocks":{"style-bento-use-overview":"<span style=\"display:grid;grid-template-columns:repeat(3,26px);grid-auto-rows:18px;gap:4px\"><i style=\"grid-column:span 2;grid-row:span 2;background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"grid-column:span 2;background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i></span><span style=\"font-size:12px;color:var(--text-3)\">适合并列展示少量重点能力与补充信息</span>","style-bento-use-keynote":"<div class=\"mk-win\" style=\"text-align:center\"><span style=\"font-size:14px;font-weight:700;color:var(--text)\">M4 芯片</span><span style=\"font-size:12px;color:var(--text-3)\">10 核 CPU · 18h 续航 · 38 万亿次算力</span></div><span style=\"font-size:12px;color:var(--text-3)\">发布总结可用网格比较规格，但不是唯一布局</span>","style-bento-use-app":"<div class=\"mk-row\"><span style=\"width:24px;height:24px;border-radius:6px;background:#e8f0ff\"></span><span style=\"width:24px;height:24px;border-radius:6px;background:#f3e8ff\"></span><span style=\"width:24px;height:24px;border-radius:6px;background:#ffe8f0\"></span><span style=\"font-size:12px;color:var(--text-2)\">功能页</span></div><span style=\"font-size:12px;color:var(--text-3)\">App「它能做什么」一页讲完</span>","style-bento-use-dashboard":"<span style=\"display:grid;grid-template-columns:repeat(2,34px);grid-auto-rows:16px;gap:4px\"><i style=\"grid-column:span 2;background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i></span><span style=\"font-size:12px;color:var(--text-3)\">仪表盘首页按优先级组织指标、图表和入口</span>","style-bento-dont-text":"<span style=\"width:110px;background:var(--bg);border-radius:10px;padding:7px;display:block\"><i class=\"mk-line\" style=\"width:98%\"></i><i class=\"mk-line\" style=\"width:95%\"></i><i class=\"mk-line\" style=\"width:97%\"></i><i class=\"mk-line\" style=\"width:90%\"></i></span><span style=\"font-size:12px;color:var(--red)\">卡片承载长文会降低阅读效率</span>","style-bento-dont-random":"<span style=\"display:flex;gap:4px;align-items:flex-start\"><i style=\"width:30px;height:34px;background:var(--bg);border:1px solid #e5e6eb;border-radius:5px\"></i><i style=\"width:22px;height:16px;background:var(--bg);border:1px solid #e5e6eb;border-radius:5px;margin-top:10px\"></i><i style=\"width:38px;height:24px;background:var(--bg);border:1px solid #e5e6eb;border-radius:5px;margin-top:4px\"></i></span><span style=\"font-size:12px;color:var(--red)\">任意调整卡片大小会削弱布局规律</span>","style-bento-dont-many":"<div class=\"mk-row\" style=\"gap:3px;max-width:130px\"><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i><i style='width:16px;height:16px;background:#fff;border:1px solid #e5e6eb;border-radius:4px'></i></div><span style=\"font-size:12px;color:var(--red)\">过多卡片会增加扫描负担</span>","style-bento-dont-flow":"<div class=\"mk-row\"><span style=\"font-size:12px;color:var(--text-2)\">第一步 → 第二步 → 第三步</span></div><span style=\"font-size:12px;color:var(--red)\">线性流程宜采用能表达顺序的布局</span>"}}}