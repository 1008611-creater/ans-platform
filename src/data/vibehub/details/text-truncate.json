an><span style=\"font-size:12px;color:var(--text-3)\">1.8 MB</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;padding:7px 12px\">\n          <span style=\"font-size:13px\">🖼</span><span class=\"trunc-ellipsis\" style=\"flex:1;min-width:0;font-size:12px;color:var(--text)\">homepage-banner-hero-final-compressed.png</span><span style=\"font-size:12px;color:var(--text-3)\">960 KB</span>\n        </div>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:6px;margin-top:8px\">\n        <span style=\"font-size:12px;color:var(--text-3)\">Tags:</span>\n        <span class=\"demo-tag blue\" style=\"max-width:130px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Design System Coverage Audit</span>\n        <span class=\"demo-tag green\">Published</span>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:34px 12px 0\">\n        <div style=\"position:relative\">\n          <span class=\"trunc-sc-bubble\">2026 Product Plan & Roadmap — Final Approved Version v3</span>\n          <b class=\"trunc-ellipsis\" style=\"font-size:12px;color:var(--text);padding:2px 0\">2026 Product Plan & Roadmap — Final Approved Version v3</b>\n        </div>\n      </div>\n      <div style=\"margin-top:4px;border-top:1px solid var(--border-light);padding:7px 12px;display:flex;align-items:center;gap:8px\">\n        <b class=\"trunc-ellipsis\" style=\"flex:1;min-width:0;font-size:12px;color:var(--text)\">Design System Component Coverage Audit (Public Release)</b>\n      </div>\n      <div style=\"border-top:1px solid var(--border-light);padding:7px 12px;display:flex;align-items:center;gap:8px\">\n        <b class=\"trunc-ellipsis\" style=\"flex:1;min-width:0;font-size:12px;color:var(--text)\">Onboarding Flow Redesign & Staged Rollout Plan</b>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"trunc-anat\"><span class=\"ap\" data-ap=\"width\"><span class=\"trunc-anat-item\">限定宽度</span></span><span class=\"trunc-anat-plus\">+</span><span class=\"ap\" data-ap=\"nowrap\"><span class=\"trunc-anat-item\">nowrap 不换行</span></span><span class=\"trunc-anat-plus\">+</span><span class=\"ap\" data-ap=\"hidden\"><span class=\"trunc-anat-item\">overflow 藏溢出</span></span><span class=\"trunc-anat-plus\">=</span><span class=\"ap\" data-ap=\"ellipsis\"><span class=\"trunc-anat-result\">一段很长很长的标题…</span></span></span>","demo_en":"<span class=\"trunc-anat\"><span class=\"ap\" data-ap=\"width\"><span class=\"trunc-anat-item\">Limited width</span></span><span class=\"trunc-anat-plus\">+</span><span class=\"ap\" data-ap=\"nowrap\"><span class=\"trunc-anat-item\">nowrap does not wrap</span></span><span class=\"trunc-anat-plus\">+</span><span class=\"ap\" data-ap=\"hidden\"><span class=\"trunc-anat-item\">overflow hidden overflow</span></span><span class=\"trunc-anat-plus\">=</span><span class=\"ap\" data-ap=\"ellipsis\"><span class=\"trunc-anat-result\">A very long title...</span></span></span>","parts":[{"key":"width","cn":"限定宽度","en":"Width","desc":"容器或 max-width 定下边界，超出的部分才有得截","desc_en":"The container or max-width sets the boundary — without it there is nothing to cut"},{"key":"nowrap","cn":"不换行","en":"white-space","desc":"white-space: nowrap，把文字按在一行里","desc_en":"white-space: nowrap pins the text to a single line"},{"key":"hidden","cn":"溢出隐藏","en":"overflow","desc":"overflow: hidden，把超出部分先藏起来","desc_en":"overflow: hidden hides whatever spills past the edge"},{"key":"ellipsis","cn":"省略号","en":"text-overflow","desc":"text-overflow: ellipsis，在断口处补一个 …","desc_en":"text-overflow: ellipsis drops a … right where the text gets cut"}]},"variants":[{"cn":"单行省略","en":"Ellipsis","demo":"<span class=\"trunc-v trunc-ellipsis\" style=\"width:120px\">一份名字特别特别长的文件名称-final.pdf</span>","demo_en":"<span class=\"trunc-v trunc-ellipsis\" style=\"width:120px\">a-file-name-that-goes-on-and-on-final.pdf</span>","when":"列表标题、文件名一行放不下","when_en":"List titles and file names that won't fit on one line"},{"cn":"多行截断","en":"Line Clamp","demo":"<p class=\"trunc-v-p trunc-clamp2\" style=\"width:130px\">这是一段卡片摘要，内容再长也只保留前两行，超出的部分由 -webkit-line-clamp 截掉并补上省略号。</p>","demo_en":"<p class=\"trunc-v-p trunc-clamp2\" style=\"width:130px\">A card summary that stays at two lines no matter how long the content runs — -webkit-line-clamp cuts the rest and adds an ellipsis.</p>","when":"卡片摘要保留前两行就够","when_en":"Card summaries that only need the first two lines"},{"cn":"查看全文","en":"Full-text access","demo":"<span class=\"trunc-v-tip\"><span class=\"trunc-v-bubble\">2026 年度产品规划与路线图最终确认版本 v3</span><span class=\"trunc-v trunc-ellipsis\" style=\"width:110px\">2026 年度产品规划与路线图最终确认版本 v3</span></span>","demo_en":"<span class=\"trunc-v-tip\"><span class=\"trunc-v-bubble\">2026 Product Plan & Roadmap — Final Approved Version v3</span><span class=\"trunc-v trunc-ellipsis\" style=\"width:110px\">2026 Product Plan & Roadmap — Final Approved Version v3</span></span>","when":"截断后仍要留全文出口；提示必须能通过键盘触发并有触屏替代","when_en":"When truncation needs a full-text escape hatch; tooltips need keyboard and touch alternatives"}],"use":[{"t":"{c:card} <b>摘要截断</b>：多行 clamp 保留前两三行，让同组卡片保持一致高度","m":"trunc-card"},{"t":"{c:list}、{c:table} <b>标题列</b>：在有限宽度内使用单行省略号，避免挤压其他列","m":"trunc-list"},{"t":"<b>文件名、长 {c:tag}</b>：不适合换行的短文本截成一行","m":"tag-long"},{"t":"截断必配<b>全文出口</b>：可展开、进入详情、复制全文或为触屏与键盘可达的提示，不只靠悬停","m":"tip-truncate"}],"dont":[{"t":"<b>价格、日期、状态</b>等关键信息被截断：用户无法完整获取信息","m":"trunc-key","bad":true},{"t":"内容截断却<b>没有查看全文的入口</b>：用户无法访问完整信息","m":"trunc-noexit","bad":true},{"t":"正文应换行却使用 nowrap <b>强制截断</b>：内容会显示不完整","m":"trunc-nowrap","bad":true},{"t":"单行省略号需要有限或可收缩的宽度，并同时设置溢出隐藏和不换行；Flex 或 Grid 子项还可能需要 min-width: 0","m":"trunc-trio","bad":true}],"lessonPractice":{"title":"订单表的商品标题列宽有限，部分标题很长，但价格和状态必须始终完整。怎样处理？","options":[{"id":"title-ellipsis-with-access","label":"只截断商品标题并显示省略号，同时提供键盘和触屏可用的全文入口","feedback":"标题可以在有限列宽内缩短，但完整内容仍可访问，价格和状态则保留关键信息。","correct":true},{"id":"truncate-every-column","label":"标题、价格和状态都统一单行截断，让每列宽度完全一致","feedback":"价格和状态是完成判断所需的关键信息，截断后用户可能无法确认订单。","correct":false},{"id":"ellipsis-without-fulltext","label":"给长标题加省略号，完整内容只留在接口数据里，不提供查看入口","feedback":"省略号只说明内容被隐藏；没有全文出口时，用户永远无法获得缺失部分。","correct":false}],"en":{"title":"An order table has limited product-title width, but price and status must always remain complete. How should long content be handled?","options":[{"id":"title-ellipsis-with-access","label":"Truncate only the title with an ellipsis and provide a full-text path usable by keyboard and touch","feedback":"The title can shorten in a limited column while remaining accessible, and decision-critical price and status stay complete.","correct":true},{"id":"truncate-every-column","label":"Truncate title, price, and status to one line so every column has identical width","feedback":"Price and status are required for the order judgment, and hiding them can prevent confirmation.","correct":false},{"id":"ellipsis-without-fulltext","label":"Ellipsize long titles, keep the full value only in API data, and provide no viewing path","feedback":"The ellipsis only signals hidden content. Without an outlet, users can never access the missing part.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请让订单表的商品标题在有限宽度内单行省略，但价格、日期和状态保持完整。为标题提供可聚焦、触屏可用的全文查看或复制入口，并验证 Flex/Grid 下 min-width 与溢出规则生效。","en":{"title":"You can say this to an AI Agent","text":"Ellipsize product titles within the limited order-table column while keeping price, date, and status complete. Provide a focusable, touch-accessible way to view or copy the full title, and verify min-width and overflow inside Flex or Grid."}},"references":[{"title":"text-overflow 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/text-overflow","title_en":"text-overflow"},{"title":"line-clamp 属性","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/line-clamp","title_en":"line-clamp"}],"scenes":["卡片摘要两行截断","列表与表格的标题列","文件名与长标签","可访问的全文入口"],"en":{"use":[{"t":"Long filename in a compact row","m":"trunc-card"},{"t":"Card title with a fixed height","m":"trunc-list"},{"t":"Table cell with limited width","m":"tag-long"},{"t":"Preview text where the full value is available elsewhere","m":"tip-truncate"}],"dont":[{"t":"Cut off text that people must read to decide","m":"trunc-key","bad":true},{"t":"Truncate without any way to see the full value","m":"trunc-noexit","bad":true},{"t":"Use character limits when layout width is the real constraint","m":"trunc-nowrap","bad":true},{"t":"Apply the same line limit to every type of content","m":"trunc-trio","bad":true}],"scenes":["Filename","Card title","Table cell","Search result preview"],"sceneUI":["<div style=\"display:flex;gap:12px\">\n      <div style=\"flex:1;min-width:0;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:var(--shadow-card)\">\n        <div style=\"height:42px;background:url('/assets/cover-workspace.png') center/cover\"></div>\n        <div style=\"padding:8px 10px\">\n          <b class=\"trunc-ellipsis\" style=\"font-size:12px;color:var(--text)\">Building a Design System from 0 to 1: Rolling Out Component Specs, Documented</b>\n          <p class=\"trunc-clamp2\" style=\"font-size:12px;line-height:1.5;color:var(--text-2);margin:4px 0 0\">Naming, state, and spacing specs for 42 components, plus the design handoff process, review checklist, and common rework traps.</p>\n        </div>\n      </div>\n      <div style=\"flex:1;min-width:0;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:var(--shadow-card)\">\n        <div style=\"height:42px;background:url('/assets/cover-mountain.png') center/cover\"></div>\n        <div style=\"padding:8px 10px\">\n          <b class=\"trunc-ellipsis\" style=\"font-size:12px;color:var(--text)\">Weekend Hiking Routes: From the City's Edge to Above the Clouds</b>\n          <p class