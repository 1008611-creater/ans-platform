le=\"padding:10px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        <span style=\"color:var(--code-keyword)\">const</span> key = <b style=\"color:var(--brand)\">process.env.OPENAI_API_KEY</b>;<br>\n        <span style=\"color:var(--code-keyword)\">const</span> res = <span style=\"color:var(--code-keyword)\">await</span> askAI(prompt, key);\n      </div>\n      <div style=\"padding:6px 14px 10px;font-size:12px;color:var(--text-3)\">The code reads the variable name; changing the configuration value locally usually does not require modifying the code</div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:7px 14px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3)\"><span style=\"background:var(--bg-soft);border-radius:4px;padding:1px 8px;font-family:ui-monospace,Menlo,monospace;color:var(--text-2)\">.gitignore</span></div>\n      <div style=\"padding:10px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        node_modules<br>\n        dist<br>\n        <b style=\"color:var(--brand)\">.env</b>\n      </div>\n      <div style=\"padding:6px 14px 10px;font-size:12px;color:#16a34a\">🛡 Untracked files that match the rules will be skipped by git add; you still need to check git status before committing</div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;font-weight:600;flex:1\">Environment Variables</span>\n        <button class=\"btn btn-outline\">+ Add</button>\n      </div>\n      <div style=\"display:grid;grid-template-columns:1.4fr 1fr .8fr;gap:1px;background:var(--border-light)\">\n        <div style=\"background:var(--bg-soft);padding:6px 12px;font-size:12px;color:var(--text-3)\">KEY</div>\n        <div style=\"background:var(--bg-soft);padding:6px 12px;font-size:12px;color:var(--text-3)\">VALUE</div>\n        <div style=\"background:var(--bg-soft);padding:6px 12px;font-size:12px;color:var(--text-3)\">Environment</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;font-family:ui-monospace,Menlo,monospace\">OPENAI_API_KEY</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-3)\">••••••••</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-2)\">Production</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;font-family:ui-monospace,Menlo,monospace\">DATABASE_URL</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-3)\">••••••••</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-2)\">Production</div>\n      </div>\n    </div>"],"anatomy":{"demo":"<div class=\"env-var-anat\"><span class=\"ap env-var-key\" data-ap=\"key\">OPENAI_API_KEY</span><span class=\"env-var-eq\">=</span><span class=\"ap env-var-val\" data-ap=\"value\">sk-proj-••••••</span><span class=\"ap env-var-cmt\" data-ap=\"comment\">&nbsp;&nbsp;# 本地开发用，别提交</span></div>","demo_en":"<div class=\"env-var-anat\"><span class=\"ap env-var-key\" data-ap=\"key\">OPENAI_API_KEY</span><span class=\"env-var-eq\">=</span><span class=\"ap env-var-val\" data-ap=\"value\">sk-proj-••••••</span><span class=\"ap env-var-cmt\" data-ap=\"comment\"> # For local development, please do not submit</span></div>","parts":[{"key":"key","cn":"变量名","en":"Key","desc":"全大写加下划线是惯例，代码里按这个名字读","desc_en":"It is the convention to use all uppercase letters and underlines, so read this name in the code."},{"key":"value","cn":"值","en":"Value","desc":"等号后面是实际配置值；包含密钥时，截图前要遮盖","desc_en":"After the equal sign is the actual configuration value; when the key is included, it must be covered before taking the screenshot."},{"key":"comment","cn":"注释","en":"Comment","desc":"# 开头，给人看的备注，程序会忽略","desc_en":"Notes starting with # will be ignored by the program."}]},"variants":[{"cn":"本地 .env","en":".env","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">.env</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">.env</span>","when":"本地开发使用，通常应由 .gitignore 排除","when_en":"For local development use, should usually be excluded by .gitignore"},{"cn":"平台环境变量","en":"Platform Env","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">Vercel → Settings → Env</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">Vercel → Settings → Env</span>","when":"部署平台设置页里再配一份","when_en":"Add another copy to the deployment platform settings page."},{"cn":"示例模板","en":".env.example","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">.env.example</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">.env.example</span>","when":"告诉别人要配啥，不写真值","when_en":"Telling others what to wear is not true."}],"use":[{"t":"在本地 .env 中保存服务端配置，代码只读取变量名","m":"env-var-file"},{"t":"按照所用框架的方式在服务端读取环境变量","m":"env-var-code"},{"t":"用{c:gitignore}排除本地配置，并在提交前再次检查","m":"env-var-gitignore"},{"t":"<b>本地与线上分别配置</b>：在 {c:deployment} 平台的设置页中配置线上值","m":"env-var-prod"}],"dont":[{"t":"把密钥<b>直接写进代码并提交</b>：仓库访问者可能看到并使用这把密钥","m":"env-var-hardcode-bad","bad":true},{"t":"把 <b>.env 发给别人</b>：文件、截图或群聊转发都可能扩大敏感值的暴露范围","m":"env-var-share-bad","bad":true},{"t":"把 Key 写进<b>浏览器可获取的页面代码</b>：它可能被查看或提取，不应存放服务端密钥","m":"env-var-front-bad","bad":true},{"t":"改了 .env <b>不重启需要重载配置的服务</b>：程序仍可能读取旧值","m":"env-var-restart-bad","bad":true}],"lessonPractice":{"title":"要把第三方服务密钥用于后端，又不想把它提交到仓库。应该放在哪里？","options":[{"id":"server-env","label":"放在部署环境的服务端环境变量中，并让本地示例文件不含真实值","feedback":"对。密钥由运行环境提供，仓库只保留变量名和设置说明。","correct":true},{"id":"frontend-config","label":"写进前端配置文件，靠不在界面上显示来隐藏","feedback":"发到浏览器的内容可以被查看，不能存放密钥。","correct":false},{"id":"commented-key","label":"写在代码注释里，发布前再删掉","feedback":"密钥可能已进入提交历史或构建产物，临时写入同样有泄露风险。","correct":false}],"en":{"title":"A backend needs a third-party secret without committing it. Where should it live?","options":[{"id":"server-env","label":"In a server-side deployment environment variable, with a real-value-free local example","feedback":"Correct. The runtime supplies the secret; the repository keeps only its name and setup guidance.","correct":true},{"id":"frontend-config","label":"In frontend configuration, hidden by not rendering it","feedback":"Anything shipped to the browser can be inspected and cannot hold a secret.","correct":false},{"id":"commented-key","label":"In a code comment until just before release","feedback":"It can enter history or a build artifact; temporary exposure is still exposure.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把这个第三方服务密钥从代码中移到服务端环境变量，并补一个不含真实值的示例变量名。确认 git diff 和客户端构建产物都没有密钥；在配置变量后调用一次服务，确认请求仍成功。","en":{"title":"You can say this to an AI Agent","text":"Move this third-party secret from code into a server-side environment variable and add a real-value-free example variable name. Confirm neither git diff nor the client build contains the secret; after configuration, make one successful service call."}},"scenes":[".env 文件示例","代码读取变量名",".gitignore 忽略未跟踪文件","Vercel 环境变量设置页"],"en":{"use":[{"t":"Set different values for development and production","m":"env-var-file"},{"t":"Provide server-side credentials","m":"env-var-code"},{"t":"Configure an API endpoint","m":"env-var-gitignore"},{"t":"Turn deployment-specific features on or off","m":"env-var-prod"}],"dont":[{"t":"Commit a file containing real secrets","m":"env-var-hardcode-bad","bad":true},{"t":"Put private keys in variables exposed to browser code","m":"env-var-share-bad","bad":true},{"t":"Assume changing a value updates a running process automatically","m":"env-var-front-bad","bad":true},{"t":"Leave required variables undocumented","m":"env-var-restart-bad","bad":true}],"scenes":["Database connection","API credential","Site URL","Feature setting"],"sceneUI":["<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:7px 14px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3)\"><span style=\"background:var(--bg-soft);border-radius:4px;padding:1px 8px;font-family:ui-monospace,Menlo,monospace;color:var(--text-2)\">.env</span><span style=\"margin-left:auto\">🔒 Do not submit</span></div>\n      <div style=\"padding:10px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        <span style=\"color:var(--text-3)\"># For local development</span><br>\n        <b style=\"color:var(--brand)\">OPENAI_API_KEY</b>=<span style=\"color:var(--warning)\">sk-proj-8fk2••••••</span><br>\n        <b style=\"color:var(--brand)\">DATABASE_URL</b>=<span style=\"color:var(--warning)\">postgres://localhost:5432</span>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:7px 14px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3)\"><span style=\"background:var(--bg-soft);border-radius:4px;padding:1px 8px;font-family:ui-monospace,Menlo,monospace;color:var(--text-2)\">api.js</span></div>\n      <div style=\"padding:10px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        <span style=\"color:var(--code-keyword)\">const</span> key = <b style=\"color:var(--brand)\">process.env.OPENAI_API_KEY</b>;<br>\n        <span style=\"color:var(--code-keyword)\">const</span> res = <span style=\"color:var(--code-keyword)\">await</span> askAI(prompt, key);\n      </div>\n      <div style=\"padding:6px 14px 10px;font-size:12px;color:var(--text-3)\">The code reads the variable name; changing the configuration value locally usually does not require modifying the code</div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:7px 14px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3)\"><span style=\"background:var(--bg-soft);border-radius:4px;padding:1px 8px;font-family:ui-monospace,Menlo,monospace;color:var(--text-2)\">.gitignore</span></div>\n      <div style=\"padding:10px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        node_modules<br>\n        dist<br>\n        <b style=\"color:var(--brand)\">.env</b>\n      </div>\n      <div style=\"padding:6px 14px 10px;font-size:12px;color:#16a34a\">🛡 Untracked files that match the rules will be skipped by git add; you still need to check git status before committing</div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;font-weight:600;flex:1\">Environment Variables</span>\n        <button class=\"btn btn-outline\">+ Add</button>\n      </div>\n      <div style=\"display:grid;grid-template-columns:1.4fr 1fr .8fr;gap:1px;background:var(--border-light)\">\n        <div style=\"background:var(--bg-soft);padding:6px 12px;font-size:12px;color:var(--text-3)\">KEY</div>\n        <div style=\"background:var(--bg-soft);padding:6px 12px;font-size:12px;color:var(--text-3)\">VALUE</div>\n        <div style=\"background:var(--bg-soft);padding:6px 12px;font-size:12px;color:var(--text-3)\">Environment</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;font-family:ui-monospace,Menlo,monospace\">OPENAI_API_KEY</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-3)\">••••••••</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-2)\">Production</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;font-family:ui-monospace,Menlo,monospace\">DATABASE_URL</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-3)\">••••••••</div>\n        <div style=\"background:var(--bg);padding:7px 12px;font-size:12px;color:var(--text-2)\">Production</div>\n      </div>\n    </div>"],"variants":[{"demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">.env</span>","when":"For local development use, should usually be excluded by .gitignore"},{"demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">Vercel → Settings → Env</span>","when":"Add another copy to the deployment platform settings page."},{"demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">.env.example</span>","when":"Telling others what to wear is not true."}]},"usageMocks":{"env-var-file":"<div class=\"mk-win\"><span style=\"display:block;width:100%;text-align:left;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\"><span style=\"color:var(--text-3)\">.env</span><br><b style=\"color:var(--brand)\">OPENAI_API_KEY</b>=sk-••••••<br><b style=\"color:var(--brand)\">DATABASE_URL</b>=postgres://••••</span><span style=\"font-size:12px;color:var(--text-3)\">本地配置一行一个；敏感值不要提交、截图或转发</span></div>","env-var-code":"<div class=\"mk-win\"><span style=\"display:block;width:100%;text-align:left;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">const key = <b style=\"color:var(--brand)\">process.env.OPENAI_API_KEY</b></span><span style=\"font-size:12px;color:var(--text-3)\">代码读取变量名；替换配置值通常无需修改代码</span></div>","env-var-gitignore":"<div class=\"mk-win\"><span style=\"display:block;width:100%;text-align:left;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\"><span style=\"color:var(--text-3)\">.gitignore</span><br>node_modules<br><b style=\"color:var(--brand)\">.env</b></span><span style=\"font-size:12px;color:var(--text-3)\">匹配规则的未跟踪文件会被跳过；已跟踪文件要另行处理</span></div>","env-var-prod":"<div class=\"mk-row\"><span style=\"border:1px solid var(--border);border-radius:5px;padding:3px 8px;font-size:12px;color:var(--text-2)\">💻 本地 .env</span><span style=\"border:1px solid var(--border);border-radius:5px;padding:3px 8px;font-size:12px;color:var(--text-2)\">☁️ 平台设置页</span></div><span style=\"font-size:12px;color:var(--text-3)\">本地与线上环境分别配置，避免混用凭证和地址</span>","env-var-hardcode-bad":"<div class=\"mk-win\"><span style=\"display:block;width:100%;text-align:left;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--red)\">const key = \"sk-proj-8fk2…\"</span><span style=\"font-size:12px;color:var(--red)\">提交到仓库的密钥可能出现在提交历史、克隆副本或构建产物中</span></div>","env-var-share-bad":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"width:100%\"><span class=\"mk-tag red\">.env</span><span style=\"font-size:12px;color:var(--text-2)\">→ 转发给同事 / 截图发群</span></div><span style=\"font-size:12px;color:var(--red)\">通过文件或截图分享可能暴露其中的敏感值</span></div>","env-var-front-bad":"<div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text-2)\">右键 → 查看网页源代码</span><span style=\"display:block;width:100%;text-align:left;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--red)\">&lt;script&gt; key=\"sk-…\" &lt;/script&gt;</span><span style=\"font-size:12px;color:var(--red)\">写进前端代码后，访问者可能直接读取</span></div>","env-var-restart-bad":"<div class=\"npm-term\"><div class=\"npm-tb\"><span style=\"color:#8a91a0\">改了 .env，直接刷新页面…</span><span style=\"color:#f87171\">401 Unauthorized（仍在使用旧 Key）</span></div></div><span style=\"font-size:12px;color:var(--red)\">多数服务需重启或重新部署后才会读取新的环境变量</span>"}}}