{"__formatVersion":2,"__revision":"05962366019b6136","__entryId":"api","entry":{"sceneUI":["<div style=\"display:flex;gap:16px\">\n      <div style=\"width:104px;flex:none\">\n        <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">天气 API</div>\n        <div style=\"font-size:12px;color:var(--brand);font-weight:600;padding:3px 0\">查询天气</div>\n        <div style=\"font-size:12px;color:var(--text-2);padding:3px 0\">城市列表</div>\n        <div style=\"font-size:12px;color:var(--text-2);padding:3px 0\">用量统计</div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n          <span class=\"demo-tag green\">GET</span>\n          <span style=\"font-size:12px;font-family:monospace\">/api/weather</span>\n        </div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:8px\">查询指定城市的实时天气</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-bottom:4px\">参数</div>\n        <div style=\"display:flex;gap:8px;font-size:12px;padding:6px 0;border-top:1px solid var(--border-light)\">\n          <span style=\"width:56px;font-family:monospace\">city</span><span class=\"demo-tag gray\">必填</span><span style=\"color:var(--text-2)\">城市拼音，如 shenzhen</span>\n        </div>\n        <div style=\"display:flex;gap:8px;font-size:12px;padding:6px 0;border-top:1px solid var(--border-light)\">\n          <span style=\"width:56px;font-family:monospace\">days</span><span class=\"demo-tag gray\">可选</span><span style=\"color:var(--text-2)\">预报天数，默认 1</span>\n        </div>\n      </div>\n    </div>","<div style=\"background:#1d2129;border-radius:10px;padding:14px 16px;font-family:monospace;font-size:12px;line-height:1.9\">\n      <div style=\"color:#a6d189\">$ curl https://api.vibeui.dev/weather?city=shenzhen \\</div>\n      <div style=\"color:#a6d189\">&nbsp;&nbsp;-H \"Authorization: Bearer sk-••••3f2k\"</div>\n      <div style=\"color:#c9cdd4\">{</div>\n      <div style=\"color:#c9cdd4\">&nbsp;&nbsp;<span style=\"color:#7db3ff\">\"city\"</span>: <span style=\"color:#a6d189\">\"深圳\"</span>,</div>\n      <div style=\"color:#c9cdd4\">&nbsp;&nbsp;<span style=\"color:#7db3ff\">\"temp\"</span>: <span style=\"color:#ffb86c\">31</span>,</div>\n      <div style=\"color:#c9cdd4\">&nbsp;&nbsp;<span style=\"color:#7db3ff\">\"text\"</span>: <span style=\"color:#a6d189\">\"多云\"</span></div>\n      <div style=\"color:#c9cdd4\">}</div>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border-light);padding-bottom:8px;margin-bottom:8px\">\n        <span style=\"font-size:12px;color:var(--text-3)\">Elements</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Console</span>\n        <span style=\"font-size:12px;color:var(--text);border-bottom:2px solid var(--brand);padding-bottom:8px;margin-bottom:-9px;font-weight:600\">Network</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;font-size:12px;padding:6px 8px;background:var(--brand-light);border-radius:6px;margin-bottom:8px\">\n        <span style=\"flex:1;font-family:monospace\">weather?city=shenzhen</span>\n        <span class=\"demo-tag green\">GET</span>\n        <span style=\"color:var(--green)\">200</span>\n        <span style=\"color:var(--text-3)\">86 ms</span>\n      </div>\n      <div style=\"display:flex;gap:14px;font-size:12px;color:var(--text-3);margin-bottom:6px\">\n        <span style=\"color:var(--brand);font-weight:600\">Preview</span><span>Headers</span><span>Response</span>\n      </div>\n      <div style=\"background:var(--bg-soft);border-radius:8px;padding:8px 12px;font-family:monospace;font-size:12px;line-height:1.8;color:var(--text)\">\n        ▾ city: \"深圳\"<br>\n        &nbsp;&nbsp;temp: 31<br>\n        &nbsp;&nbsp;text: \"多云\"\n      </div>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n        <b style=\"font-size:14px;flex:1\">API Keys</b>\n        <button class=\"btn btn-primary\">＋ 创建新 Key</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">生产环境</span>\n        <span style=\"font-size:12px;font-family:monospace;color:var(--text-3)\">sk-live-••••3f2k</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">3 天前用过</span>\n        <button class=\"btn btn-text\" style=\"padding:3px 6px;font-size:12px\">吊销</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">本地调试</span>\n        <span style=\"font-size:12px;font-family:monospace;color:var(--text-3)\">sk-test-••••9a01</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">刚刚用过</span>\n        <button class=\"btn btn-text\" style=\"padding:3px 6px;font-size:12px\">吊销</button>\n      </div>\n      <div style=\"margin-top:10px;background:var(--red-light);border-radius:8px;padding:8px 12px;font-size:12px;color:var(--red)\">\n        ⚠ 部分服务商只在创建时完整显示密钥；请按服务商规则安全保存\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"display:flex;gap:16px\">\n      <div style=\"width:104px;flex:none\">\n        <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">Weather API</div>\n        <div style=\"font-size:12px;color:var(--brand);font-weight:600;padding:3px 0\">Check the weather</div>\n        <div style=\"font-size:12px;color:var(--text-2);padding:3px 0\">City list</div>\n        <div style=\"font-size:12px;color:var(--text-2);padding:3px 0\">Usage statistics</div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n          <span class=\"demo-tag green\">GET</span>\n          <span style=\"font-size:12px;font-family:monospace\">/api/weather</span>\n        </div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:8px\">Query the real-time weather of a specified city</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-bottom:4px\">Parameters</div>\n        <div style=\"display:flex;gap:8px;font-size:12px;padding:6px 0;border-top:1px solid var(--border-light)\">\n          <span style=\"width:56px;font-family:monospace\">city</span><span class=\"demo-tag gray\">Required</span><span style=\"color:var(--text-2)\">City pinyin, such as shenzhen</span>\n        </div>\n        <div style=\"display:flex;gap:8px;font-size:12px;padding:6px 0;border-top:1px solid var(--border-light)\">\n          <span style=\"width:56px;font-family:monospace\">days</span><span class=\"demo-tag gray\">Optional</span><span style=\"color:var(--text-2)\">Number of forecast days, default 1</span>\n        </div>\n      </div>\n    </div>","<div style=\"background:#1d2129;border-radius:10px;padding:14px 16px;font-family:monospace;font-size:12px;line-height:1.9\">\n      <div style=\"color:#a6d189\">$ curl https://api.vibeui.dev/weather?city=shenzhen \\</div>\n      <div style=\"color:#a6d189\"> -H \"Authorization: Bearer sk-••••3f2k\"</div>\n      <div style=\"color:#c9cdd4\">{</div>\n      <div style=\"color:#c9cdd4\"> <span style=\"color:#7db3ff\">\"city\"</span>: <span style=\"color:#a6d189\">\"Shenzhen\"</span>,</div>\n      <div style=\"color:#c9cdd4\"> <span style=\"color:#7db3ff\">\"temp\"</span>: <span style=\"color:#ffb86c\">31</span>,</div>\n      <div style=\"color:#c9cdd4\"> <span style=\"color:#7db3ff\">\"text\"</span>: <span style=\"color:#a6d189\">\"Cloudy\"</span></div>\n      <div style=\"color:#c9cdd4\">}</div>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border-light);padding-bottom:8px;margin-bottom:8px\">\n        <span style=\"font-size:12px;color:var(--text-3)\">Elements</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Console</span>\n        <span style=\"font-size:12px;color:var(--text);border-bottom:2px solid var(--brand);padding-bottom:8px;margin-bottom:-9px;font-weight:600\">Network</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;font-size:12px;padding:6px 8px;background:var(--brand-light);border-radius:6px;margin-bottom:8px\">\n        <span style=\"flex:1;font-family:monospace\">weather?city=shenzhen</span>\n        <span class=\"demo-tag green\">GET</span>\n        <span style=\"color:var(--green)\">200</span>\n        <span style=\"color:var(--text-3)\">86 ms</span>\n      </div>\n      <div style=\"display:flex;gap:14px;font-size:12px;color:var(--text-3);margin-bottom:6px\">\n        <span style=\"color:var(--brand);font-weight:600\">Preview</span><span>Headers</span><span>Response</span>\n      </div>\n      <div style=\"background:var(--bg-soft);border-radius:8px;padding:8px 12px;font-family:monospace;font-size:12px;line-height:1.8;color:var(--text)\">\n        ▾ city: \"Shenzhen\"<br>\n        Temp: 31<br>\n        text: \"Cloudy\"\n      </div>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n        <b style=\"font-size:14px;flex:1\">API Keys</b>\n        <button class=\"btn btn-primary\">+ Create new Key</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">Production environment</span>\n        <span style=\"font-size:12px;font-family:monospace;color:var(--text-3)\">sk-live-••••3f2k</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Used 3 days ago</span>\n        <button class=\"btn btn-text\" style=\"padding:3px 6px;font-size:12px\">Revocation</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">Local debugging</span>\n        <span style=\"font-size:12px;font-family:monospace;color:var(--text-3)\">sk-test-••••9a01</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Just used</span>\n        <button class=\"btn btn-text\" style=\"padding:3px 6px;font-size:12px\">Revocation</button>\n      </div>\n      <div style=\"margin-top:10px;background:var(--red-light);border-radius:8px;padding:8px 12px;font-size:12px;color:var(--red)\">\n        ⚠ Some service providers only display the key completely when creating it; please save it safely according to the service provider’s rules\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"api-anat\" style=\"display:flex;flex-direction:column;gap:8px\"><span class=\"api-req\"><span class=\"api-code\"><span class=\"api-line\"><span class=\"ap api-method\" data-ap=\"method\">GET</span> <span class=\"ap\" data-ap=\"endpoint\" style=\"color:var(--brand)\">https://api.vibeui.dev/weather?city=shenzhen</span></span><span class=\"api-line\" style=\"color:var(--text-3)\">Authorization: Bearer <span class=\"ap api-key-token\" data-ap=\"key\">sk-••••3f2k</span></span></span></span><span class=\"api-arrow\">↓</span><span class=\"api-resp\"><span class=\"ap\" data-ap=\"response\"><span class=\"api-status-ok\">200 OK</span> { \"city\": \"深圳\", \"temp\": 31 }</span></span></span>","demo_en":"<span class=\"api-anat\" style=\"display:flex;flex-direction:column;gap:8px\"><span class=\"api-req\"><span class=\"api-code\"><span class=\"api-line\"><span class=\"ap api-method\" data-ap=\"method\">GET</span> <span class=\"ap\" data-ap=\"endpoint\" style=\"color:var(--brand)\">https://api.vibeui.dev/weather?city=shenzhen</span></span><span class=\"api-line\" style=\"color:var(--text-3)\">Authorization: Bearer <span class=\"ap api-key-token\" data-ap=\"key\">sk-••••3f2k</span></span></span></span><span class=\"api-arrow\">↓</span><span class=\"api-resp\"><span class=\"ap\" data-ap=\"response\"><span class=\"api-status-ok\">200 OK</span> { \"city\": \"Shenzhen\", \"temp\": 31 }</span></span></span>","parts":[{"key":"method","cn":"请求方法","en":"Method","desc":"GET 常用于读取，POST 常用于提交或触发处理；具体语义见 {c:http} 和接口文档","desc_en":"GET is commonly used to read data, while POST commonly submits data or triggers an action. Check {c:http} and the API documentation for the exact contract."},{"key":"endpoint","cn":"接口地址","en":"Endpoint","desc":"API 可访问的地址或路径；请求方法、端点和参数共同说明本次操作","desc_en":"The address or path accessible to the API; the request method, endpoint, and parameters together describe this operation"},{"key":"key","cn":"API Key","en":"API Key","desc":"用于识别调用方的凭证；先看服务商把它定义为密钥还是公开标识。密钥必须保密，公开标识仍受服务商限制","desc_en":"Credentials used to identify the caller; first depends on whether the service provider defines it as a key or a public identity. The key must be kept secret, and the public identification is still restricted by the service provider"},{"key":"response","cn":"响应","en":"Response","desc":"包含状态码、响应头与可选响应体；先确认状态，再按约定解析数据","desc_en":"Contains status code, response header and optional response body; confirm the status first, and then parse the data according to the agreement"}]},"variants":[{"cn":"REST","en":"REST API","demo":"<span style=\"font-family:monospace;font-size:12px\"><span class=\"demo-tag green\">GET</span> /api/users/42</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\"><span class=\"demo-tag green\">GET</span> /api/users/42</span>","when":"常用资源地址和 HTTP 方法表达操作","when_en":"Common resource addresses and HTTP methods to express operations"},{"cn":"GraphQL","en":"GraphQL","demo":"<span style=\"font-family:monospace;font-size:12px\"><span class=\"demo-tag blue\">POST</span> /graphql { user { name } }</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\"><span class=\"demo-tag blue\">POST</span> /graphql { user { name } }</span>","when":"一个地址，前端按需取字段","when_en":"An address, the front end takes fields on demand"},{"cn":"WebSocket","en":"WebSocket","demo":"<span style=\"font-family:monospace;font-size:12px\">wss://api.vibeui.dev/live</span>","demo_en":"<span style=\"font-family:monospace;font-size:12px\">wss://api.vibeui.dev/live</span>","when":"长连接，服务端主动推消息","when_en":"Long connection, the server actively pushes messages"}],"use":[{"t":"调用前先确认文档里的地址、方法和参数","m":"api-doc"},{"t":"把 API 密钥保存在服务端环境变量中","m":"api-key"},{"t":"根据状态码分别处理成功、未找到和服务端错误","m":"api-status"},{"t":"先确认 JSON 结构，再读取需要的字段","m":"api-json"}],"dont":[{"t":"把 API 密钥写进浏览器可以看到的代码","m":"api-key-leak","bad":true},{"t":"忽略失败状态，仍把返回内容当成成功数据处理","m":"api-no-status","bad":true},{"t":"直接把开发错误原文展示给普通用户","m":"api-raw-error","bad":true},{"t":"在循环和频繁输入中连续发出大量重复请求","m":"api-spam","bad":true}],"flowLesson":{"title":"一次保存经过哪些部分？","instruction":"突出显示的步骤表示当前术语在这条流程里负责的位置。","steps":[{"id":"input","label":"填写并点击保存","owner":"前端","detail":"读取输入，显示保存中"},{"id":"request","label":"发出保存请求","owner":"前端","detail":"按 API 约定发送地址、方法和数据"},{"id":"validate","label":"接收、检查并处理","owner":"后端","detail":"接收请求，检查输入、身份和权限"},{"id":"write","label":"写入记录","owner":"数据库","detail":"长期保存这次修改"},{"id":"response","label":"返回保存结果","owner":"后端","detail":"把状态码、结果数据或错误信息组成响应"},{"id":"display","label":"显示结果","owner":"前端","detail":"根据真实响应更新页面"}],"focusStepIds":["request","response"],"boundary":"收到 HTTP 200 只说明请求被正常响应；是否真的成功，还要按 API 约定检查响应数据和业务状态。","practice":{"title":"点保存没有结果，怎样先判断是不是 API 出了问题？","options":[{"id":"network","label":"在 Network 中核对地址、方法、请求数据、状态码、响应内容，以及页面是否按结果更新","feedback":"对。这些证据能说明请求是否遵守约定、服务端实际返回什么，以及界面是否把这个结果正确显示出来。","correct":true},{"id":"status-only","label":"按接口文档重写一遍请求参数，然后直接重试","feedback":"文档可能与实际调用不同；应先看浏览器真正发出的请求和收到的响应。"},{"id":"server-only","label":"先重启 API 服务，再用原来的页面操作重试","feedback":"重启可能暂时恢复服务，但不能定位地址、方法、数据或响应约定是否出错。"}]},"agentPrompt":"点保存以后没有结果。先看这次 API 请求的地址、方法、提交数据、状态码和响应内容，确认问题发生在请求、返回还是页面处理。改完后重新保存，确认响应符合约定、页面显示正确结果；如果这是持久化操作，再刷新确认数据还在。","en":{"title":"Which parts handle one save?","instruction":"Highlighted steps show what this term is responsible for in the flow.","steps":[{"id":"input","label":"Edit and save","owner":"Frontend","detail":"Read the input and show a pending state"},{"id":"request","label":"Send the request","owner":"Frontend","detail":"Use the API contract's URL, method, and data"},{"id":"validate","label":"Receive, check, and process","owner":"Backend","detail":"Receive the request and validate the input, identity, and permission"},{"id":"write","label":"Write the record","owner":"Database","detail":"Persist the change"},{"id":"response","label":"Return the result","owner":"Backend","detail":"Return success, failure, and the reason under the API contract"},{"id":"display","label":"Show the result","owner":"Frontend","detail":"Update the page from the real response"}],"focusStepIds":["request","response"],"boundary":"An HTTP 200 only means the request received a normal response. Business success still depends on the API contract and response data.","practice":{"title":"Saving produces no result. How do you first check whether the API is involved?","options":[{"id":"network","label":"In Network, inspect the URL, method, request data, status, response body, and whether the page updates from it","feedback":"Correct. These show whether the request followed the contract, what the service returned, and whether the UI handled it correctly.","correct":true},{"id":"status-only","label":"Rewrite the request parameters from the API docs, then retry immediately","feedback":"The docs may differ from the live call; inspect the request and response that actually occurred first."},{"id":"server-only","label":"Restart the API service first, then retry the same page action","feedback":"Restarting may restore a transient failure, but it does not locate a contract mismatch."}]},"agentPrompt":"Saving produces no result. Inspect the API URL, method, submitted data, status, response body, and how the page handles it. Fix the cause, save again, confirm the response matches the contract and the page shows the right result; if it persists data, refresh to confirm it remains."}},"references":[{"title":"API 词汇表","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Glossary/API","title_en":"API"}],"scenes":["API 文档页","终端 curl 调接口","开发者工具看请求","API Key 管理"],"en":{"use":[{"t":"Load data into a page","m":"api-doc"},{"t":"Create or update a record","m":"api-key"},{"t":"Connect two services","m":"api-status"},{"t":"Expose a stable programmatic capability","m":"api-json"}],"dont":[{"t":"Send secret credentials to browser code","m":"api-key-leak","bad":true},{"t":"Return a different shape without updating the contract","m":"api-no-status","bad":true},{"t":"Use one endpoint for many unrelated actions","m":"api-raw-error","bad":true},{"t":"Treat every client input as safe","m":"api-spam","bad":true}],"scenes":["Product list","Account update","Payment request","Third-party integration"],"sceneUI":["<div style=\"display:flex;gap:16px\">\n      <div style=\"width:104px;flex:none\">\n        <div style=\"font-size:12px;color:var(--text-3);margin-bottom:6px\">Weather API</div>\n        <div style=\"font-size:12px;color:var(--brand);font-weight:600;padding:3px 0\">Check the weather</div>\n        <div style=\"font-size:12px;color:var(--text-2);padding:3px 0\">City list</div>\n        <div style=\"font-size:12px;color:var(--text-2);padding:3px 0\">Usage statistics</div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n          <span class=\"demo-tag green\">GET</span>\n          <span style=\"font-size:12px;font-family:monospace\">/api/weather</span>\n        </div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:8px\">Query the real-time weather of a specified city</div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-bottom:4px\">Parameters</div>\n        <div style=\"display:flex;gap:8px;font-size:12px;padding:6px 0;border-top:1px solid var(--border-light)\">\n          <span style=\"width:56px;font-family:monospace\">city</span><span class=\"demo-tag gray\">Required</span><span style=\"color:var(--text-2)\">City pinyin, such as shenzhen</span>\n        </div>\n        <div style=\"display:flex;gap:8px;font-size:12px;padding:6px 0;border-top:1px solid var(--border-light)\">\n          <span style=\"width:56px;font-family:monospace\">days</span><span class=\"demo-tag gray\">Optional</span><span style=\"color:var(--text-2)\">Number of forecast days, default 1</span>\n        </div>\n      </div>\n    </div>","<div style=\"background:#1d2129;border-radius:10px;padding:14px 16px;font-family:monospace;font-size:12px;line-height:1.9\">\n      <div style=\"color:#a6d189\">$ curl https://api.vibeui.dev/weather?city=shenzhen \\</div>\n      <div style=\"color:#a6d189\"> -H \"Authorization: Bearer sk-••••3f2k\"</div>\n      <div style=\"color:#c9cdd4\">{</div>\n      <div style=\"color:#c9cdd4\"> <span style=\"color:#7db3ff\">\"city\"</span>: <span style=\"color:#a6d189\">\"Shenzhen\"</span>,</div>\n      <div style=\"color:#c9cdd4\"> <span style=\"color:#7db3ff\">\"temp\"</span>: <span style=\"color:#ffb86c\">31</span>,</div>\n      <div style=\"color:#c9cdd4\"> <span style=\"color:#7db3ff\">\"text\"</span>: <span style=\"color:#a6d189\">\"Cloudy\"</span></div>\n      <div style=\"color:#c9cdd4\">}</div>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border-light);padding-bottom:8px;margin-bottom:8px\">\n        <span style=\"font-size:12px;color:var(--text-3)\">Elements</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Console</span>\n        <span style=\"font-size:12px;color:var(--text);border-bottom:2px solid var(--brand);padding-bottom:8px;margin-bottom:-9px;font-weight:600\">Network</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;font-size:12px;padding:6px 8px;background:var(--brand-light);border-radius:6px;margin-bottom:8px\">\n        <span style=\"flex:1;font-family:monospace\">weather?city=shenzhen</span>\n        <span class=\"demo-tag green\">GET</span>\n        <span style=\"color:var(--green)\">200</span>\n        <span style=\"color:var(--text-3)\">86 ms</span>\n      </div>\n      <div style=\"display:flex;gap:14px;font-size:12px;color:var(--text-3);margin-bottom:6px\">\n        <span style=\"color:var(--brand);font-weight:600\">Preview</span><span>Headers</span><span>Response</span>\n      </div>\n      <div style=\"background:var(--bg-soft);border-radius:8px;padding:8px 12px;font-family:monospace;font-size:12px;line-height:1.8;color:var(--text)\">\n        ▾ city: \"Shenzhen\"<br>\n        Temp: 31<br>\n        text: \"Cloudy\"\n      </div>\n    </div>","<div>\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n        <b style=\"font-size:14px;flex:1\">API Keys</b>\n        <button class=\"btn btn-primary\">+ Create new Key</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">Production environment</span>\n        <span style=\"font-size:12px;font-family:monospace;color:var(--text-3)\">sk-live-••••3f2k</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Used 3 days ago</span>\n        <button class=\"btn btn-text\" style=\"padding:3px 6px;font-size:12px\">Revocation</button>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;flex:1\">Local debugging</span>\n        <span style=\"font-size:12px;font-family:monospace;color:var(--text-3)\">sk-test-••••9a01</span>\n        <span style=\"font-size:12px;color:var(--text-3)\">Just used</span>\n        <button class=\"btn btn-text\" style=\"padding:3px 6px;font-size:12px\">Revocation</button>\n      </div>\n      <div style=