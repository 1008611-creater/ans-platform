{"__formatVersion":2,"__revision":"bef6f016bd702b7d","__entryId":"corner-feel","entry":{"sceneUI":["<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:0;padding:12px 14px\">\n      <div style=\"display:flex;align-items:center;margin-bottom:10px\">\n        <b style=\"font-size:13px;flex:1;color:var(--text)\">大额转账复核</b>\n        <span class=\"demo-tag gray\" style=\"border-radius:0\">待确认</span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-2);display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid var(--border-light)\"><span>收款方</span><span style=\"color:var(--text)\">恒晟贸易有限公司</span></div>\n      <div style=\"font-size:12px;color:var(--text-2);display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid var(--border-light)\"><span>金额</span><span style=\"color:var(--text);font-weight:600\">¥ 500,000.00</span></div>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:10px\">\n        <button class=\"btn btn-outline\" style=\"border-radius:0\">驳回</button>\n        <button class=\"btn btn-primary\" style=\"border-radius:0\">复核通过</button>\n      </div>\n    </div>","<div style=\"background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:12px 14px;max-width:340px;margin:0 auto\">\n      <div style=\"display:flex;align-items:center;margin-bottom:10px\">\n        <b style=\"font-size:13px;flex:1;color:var(--text)\">新建报销单</b>\n        <span class=\"icon-btn\" style=\"border-radius:4px\">×</span>\n      </div>\n      <input class=\"demo-input\" style=\"width:100%;border-radius:4px;margin-bottom:8px\" value=\"差旅费 · 上海出差\">\n      <span class=\"custom-select\" data-custom-select style=\"width:100%;margin-bottom:10px\">\n    <button type=\"button\" class=\"custom-select-trigger\" data-custom-select-trigger\n      aria-haspopup=\"listbox\" aria-expanded=\"false\" style=\"border-radius:4px\">\n      <span class=\"custom-select-value\" data-custom-select