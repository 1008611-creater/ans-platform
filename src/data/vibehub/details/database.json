{"__formatVersion":2,"__revision":"7185bc26331afc15","__entryId":"database","entry":{"sceneUI":["<div style=\"max-width:440px;margin:0 auto;display:flex;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"width:110px;flex:none;border-right:1px solid var(--border-light);background:var(--bg-soft);padding:8px 0\">\n        <div style=\"padding:4px 12px;font-size:12px;color:var(--text-3)\">TABLES</div>\n        <div style=\"padding:5px 12px;font-size:12px;background:var(--brand-light);color:var(--brand);border-radius:4px;margin:0 6px\">users</div>\n        <div style=\"padding:5px 12px;font-size:12px;color:var(--text-2)\">posts</div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid var(--border-light)\">\n          <span style=\"font-size:12px;font-weight:600;flex:1\">users</span>\n          <button class=\"btn btn-primary\" style=\"background:#1f883d;color:#fff;border-color:#1f883d\">+ Insert row</button>\n        </div>\n        <div style=\"display:grid;grid-template-columns:34px 1fr 1fr;gap:1px;background:var(--border-light)\">\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">id</div>\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">name</div>\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">city</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px;color:var(--text-3)\">1</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">小狸</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">深圳</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px;color:var(--text-3)\">2</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">阿机</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">杭州</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n        <b style=\"font-size:14px;flex:1\">用户列表</b>\n        <span class=\"demo-tag green\">来自 users 表</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:26px;height:26px;border-radius:50%;background:var(--brand-light);color:var(--brand);font-size:12px;display:flex;align-items:center;justify-content:center;flex:none\">狸</span>\n        <span style=\"font-size:12px;flex:1\">小狸</span><span style=\"font-size:12px;color:var(--text-3)\">深圳</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:26px;height:26px;border-radius:50%;background:var(--brand-light);color:var(--brand);font-size:12px;display:flex;align-items:center;justify-content:center;flex:none\">机</span>\n        <span style=\"font-size:12px;flex:1\">阿机</span><span style=\"font-size:12px;color:var(--text-3)\">杭州</span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:8px\">页面打开时再向数据库查询已保存的数据</div>\n    </div>","<div style=\"display:flex;flex-direction:column;gap:8px;max-width:400px;margin:0 auto\">\n      <div style=\"align-self:flex-end;max-width:80%;background:var(--brand);color:var(--on-brand);border-radius:12px 12px 4px 12px;padding:8px 12px;font-size:12px\">帮我找出最近 7 天注册的用户</div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:10px 12px\">\n        <div class=\"terminal-win\"><div class=\"terminal-body\">\n          <span><span class=\"terminal-a\">SELECT</span> * <span class=\"terminal-a\">FROM</span> users</span>\n          <span><span class=\"terminal-a\">WHERE</span> created_at &gt; now() - interval <span class=\"terminal-g\">'7 days'</span>;</span>\n        </div></div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">执行前核对表、条件、参数和预计影响范围</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px;font-weight:600\">CRUD 速认</div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\">增</span><span style=\"flex:1\">注册新用户</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">INSERT</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\" style=\"background:var(--green-light);color:#16a34a;border-color:#16a34a\">查</span><span style=\"flex:1\">打开用户列表页</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">SELECT</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\" style=\"background:#fff7ed;color:#d97706;border-color:#d97706\">改</span><span style=\"flex:1\">修改昵称</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">UPDATE</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;font-size:12px\"><span class=\"db-op\" style=\"background:var(--red-light);color:var(--red);border-color:var(--red)\">删</span><span style=\"flex:1\">注销账号</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">DELETE</span></div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:440px;margin:0 auto;display:flex;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"width:110px;flex:none;border-right:1px solid var(--border-light);background:var(--bg-soft);padding:8px 0\">\n        <div style=\"padding:4px 12px;font-size:12px;color:var(--text-3)\">TABLES</div>\n        <div style=\"padding:5px 12px;font-size:12px;background:var(--brand-light);color:var(--brand);border-radius:4px;margin:0 6px\">users</div>\n        <div style=\"padding:5px 12px;font-size:12px;color:var(--text-2)\">posts</div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid var(--border-light)\">\n          <span style=\"font-size:12px;font-weight:600;flex:1\">users</span>\n          <button class=\"btn btn-primary\" style=\"background:#1f883d;color:#fff;border-color:#1f883d\">+ Insert row</button>\n        </div>\n        <div style=\"display:grid;grid-template-columns:34px 1fr 1fr;gap:1px;background:var(--border-light)\">\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">id</div>\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">name</div>\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">city</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px;color:var(--text-3)\">1</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Little Fox</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Shenzhen</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px;color:var(--text-3)\">2</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Aji</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Hangzhou</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n        <b style=\"font-size:14px;flex:1\">User list</b>\n        <span class=\"demo-tag green\">From users table</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:26px;height:26px;border-radius:50%;background:var(--brand-light);color:var(--brand);font-size:12px;display:flex;align-items:center;justify-content:center;flex:none\">ri</span>\n        <span style=\"font-size:12px;flex:1\">Xiaoli</span><span style=\"font-size:12px;color:var(--text-3)\">Shenzhen</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:26px;height:26px;border-radius:50%;background:var(--brand-light);color:var(--brand);font-size:12px;display:flex;align-items:center;justify-content:center;flex:none\">Machine</span>\n        <span style=\"font-size:12px;flex:1\">Aji</span><span style=\"font-size:12px;color:var(--text-3)\">Hangzhou</span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:8px\">Query the database for saved data when the page is opened</div>\n    </div>","<div style=\"display:flex;flex-direction:column;gap:8px;max-width:400px;margin:0 auto\">\n      <div style=\"align-self:flex-end;max-width:80%;background:var(--brand);color:var(--on-brand);border-radius:12px 12px 4px 12px;padding:8px 12px;font-size:12px\">Help me find the users who registered in the last 7 days</div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:10px 12px\">\n        <div class=\"terminal-win\"><div class=\"terminal-body\">\n          <span><span class=\"terminal-a\">SELECT</span> * <span class=\"terminal-a\">FROM</span> users</span>\n          <span><span class=\"terminal-a\">WHERE</span> created_at > now() - interval <span class=\"terminal-g\">'7 days'</span>;</span>\n        </div></div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">Pre-execution checklist, conditions, parameters and expected impact scope</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px;font-weight:600\">CRUD Quick Recognition</div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\">Add</span><span style=\"flex:1\">Register new user</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">INSERT</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\" style=\"background:var(--green-light);color:#16a34a;border-color:#16a34a\">Check</span><span style=\"flex:1\">Open user list page</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">SELECT</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\" style=\"background:#fff7ed;color:#d97706;border-color:#d97706\">Change</span><span style=\"flex:1\">Modify nickname</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">UPDATE</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;font-size:12px\"><span class=\"db-op\" style=\"background:var(--red-light);color:var(--red);border-color:var(--red)\">Delete</span><span style=\"flex:1\">Cancel account</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">DELETE</span></div>\n    </div>"],"anatomy":{"demo":"<div class=\"db-anat\">\n      <span class=\"ap db-tname\" data-ap=\"table\">📋 users（表）</span>\n      <div class=\"db-row db-head\"><span class=\"db-cell\">id</span><span class=\"ap db-cell\" data-ap=\"col\">名字（列）</span><span class=\"db-cell\">城市</span></div>\n      <span class=\"ap db-row\" data-ap=\"row\" style=\"display:flex\"><span class=\"db-cell\">1</span><span class=\"db-cell\">小狸</span><span class=\"ap db-cell\" data-ap=\"cell\">深圳（单元格）</span></span>\n    </div>","demo_en":"<div class=\"db-anat\">\n      <span class=\"ap db-tname\" data-ap=\"table\">📋 users (table)</span>\n      <div class=\"db-row db-head\"><span class=\"db-cell\">id</span><span class=\"ap db-cell\" data-ap=\"col\">Name (column)</span><span class=\"db-cell\">City</span></div>\n      <span class=\"ap db-row\" data-ap=\"row\" style=\"display:flex\"><span class=\"db-cell\">1</span><span class=\"db-cell\">Xiaoli</span><span class=\"ap db-cell\" data-ap=\"cell\">Shenzhen (cell)</span></span>\n    </div>","parts":[{"key":"table","cn":"表","en":"Table","desc":"一类数据一张表：用户一张、文章一张，互不混装","desc_en":"One table for one type of data: one for users and one for articles, do not mix each other"},{"key":"col","cn":"列（字段）","en":"Column","desc":"竖着看，每列是一种字段：名字、城市、注册时间","desc_en":"Looking vertically, each column is a field: name, city, registration time"},{"key":"row","cn":"行（记录）","en":"Row","desc":"横着看，每行是一条完整的记录：一个用户","desc_en":"Viewed sideways, each line is a complete record: a user"},{"key":"cell","cn":"单元格","en":"Cell","desc":"行和列的交叉点，存一个具体的值","desc_en":"The intersection of rows and columns stores a specific value"}]},"variants":[{"cn":"Supabase","en":"Supabase","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">supabase.com</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">supabase.com</span>","when":"托管 PostgreSQL 及相关认证、存储能力；适合需要关系型数据的项目","when_en":"Hosted PostgreSQL and related certifications and storage capabilities; suitable for projects requiring relational data"},{"cn":"Firebase","en":"Firebase","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">firebase.google.com</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">firebase.google.com</span>","when":"提供 Cloud Firestore 等文档型数据服务及实时同步能力","when_en":"Provides document-based data services such as Cloud Firestore and real-time synchronization capabilities"},{"cn":"SQLite","en":"SQLite","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">data.db</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">data.db</span>","when":"适合嵌入式或单机场景；数据库通常存储在一个文件中","when_en":"Suitable for embedded or stand-alone scenarios; the database is usually stored in a file"}],"use":[{"t":"关系表外观看起来由行和列组成，但数据还会受到类型、约束、关系、事务和权限控制","m":"database-table"},{"t":"<b>增查改删 CRUD</b>描述常见数据操作；注册常新增记录，账号注销则可能采用停用、匿名化或删除","m":"database-crud"},{"t":"先理解关系型和文档型数据模型，再选择托管服务","m":"database-hosted"},{"t":"让 AI 辅助查询前，先说明<b>数据库类型、结构和权限边界</b>，并确认目标系统是否支持 SQL 及其具体方言","m":"database-ai"}],"dont":[{"t":"数据只放在<b>页面变量或进程内存</b>：页面变量会随刷新或关闭丢失，进程内存会随服务重启或实例替换丢失，都不能代替持久化存储","m":"database-memory-bad","bad":true},{"t":"拿 <b>Excel / txt 当多人在线库</b>：缺少并发控制时，同时写入可能造成覆盖或冲突","m":"database-excel-bad","bad":true},{"t":"没有评估部署、权限、备份和维护成本，就直接选择<b>自托管数据库</b>","m":"database-selfhost-bad","bad":true},{"t":"删除表或数据库前<b>没有验证可用备份</b>：误删后可能无法恢复","m":"database-drop-bad","bad":true}],"flowLesson":{"title":"保存以后，刷新为什么还能读到？","instruction":"突出显示的步骤分别负责写入和再次读取；两步都正确，刷新后才会看到同一条数据。","steps":[{"id":"input","label":"点击保存","owner":"前端","detail":"读取当前内容，显示保存中"},{"id":"request","label":"发出保存请求","owner":"前端","detail":"按 API 约定提交当前内容"},{"id":"validate","label":"接收并检查请求","owner":"后端","detail":"检查输入、身份和权限"},{"id":"write","label":"写入记录","owner":"数据库","detail":"长期保存这次修改"},{"id":"response","label":"返回保存结果","owner":"后端","detail":"按 API 约定告诉页面写入是否成功"},{"id":"refresh","label":"刷新后请求后端","owner":"前端","detail":"按 API 约定请求这条数据"},{"id":"read","label":"查询同一条记录","owner":"后端 → 数据库","detail":"后端按同一标识查询，数据库返回已保存内容"},{"id":"display","label":"返回并显示内容","owner":"后端 → 前端","detail":"后端按 API 约定返回，前端重新渲染页面"}],"focusStepIds":["write","read"],"boundary":"图片和大文件常放在对象存储，数据库保存文件地址、归属和状态等记录；不是所有持久数据都要直接塞进数据库字段。","practice":{"title":"后端返回成功，刷新后仍读不到数据。怎样确认数据库这一段？","options":[{"id":"record","label":"按主键和归属查询写入记录，再核对刷新请求使用的是同一标识","feedback":"对。主键和归属能确认真实记录，刷新标识则能判断读取目标是否一致。","correct":true},{"id":"write-status","label":"按创建时间查看最新一条相似记录，把它当作本次保存结果","feedback":"并发写入时最新记录未必属于本次请求；还需核对主键、用户或项目归属。"},{"id":"similar-record","label":"比较保存前后的总行数，只要增加一行就认为读写目标一致","feedback":"行数变化不能证明是哪条记录；更新操作甚至不会增加行数。"}]},"agentPrompt":"页面提示保存成功，但刷新后数据没了。先确认后端是否真的写入数据库，再检查刷新时查询的是不是同一条记录。改完后保存、刷新，并直接查一次数据库确认。","en":{"title":"Why is saved data still there after refresh?","instruction":"The highlighted steps write and read the record. Both must target the same data for refresh to show it.","steps":[{"id":"input","label":"Save the edit","owner":"Frontend","detail":"Read the content and show a pending state"},{"id":"request","label":"Send the save request","owner":"Frontend","detail":"Submit the content under the API contract"},{"id":"validate","label":"Receive and validate","owner":"Backend","detail":"Check the input, identity, and permission"},{"id":"write","label":"Write the record","owner":"Database","detail":"Persist the change"},{"id":"response","label":"Return the result","owner":"Backend","detail":"Report success or failure under the API contract"},{"id":"refresh","label":"Request the backend after refresh","owner":"Frontend","detail":"Request the same data under the API contract"},{"id":"read","label":"Read the same record","owner":"Backend → Database","detail":"The backend queries by the same identifier, and the database returns the saved content"},{"id":"display","label":"Return and show the content","owner":"Backend → Frontend","detail":"The backend returns it under the API contract, and the frontend renders it"}],"focusStepIds":["write","read"],"boundary":"Images and large files often live in object storage, while the database keeps their URL, owner, and status. Not every persistent byte belongs in a database field.","practice":{"title":"The backend returns success, but refresh still cannot load the data. How do you verify the database step?","options":[{"id":"record","label":"Query the written record by id and owner, then confirm refresh uses the same identifier","feedback":"Correct. The id and owner prove the record, while the refresh identifier proves the read target.","correct":true},{"id":"write-status","label":"Find the newest similar record by timestamp and treat it as this save","feedback":"Under concurrent writes, the newest record may belong to another request; verify id and ownership."},{"id":"similar-record","label":"Compare the total row count before and after saving; one extra row proves the targets match","feedback":"A row count cannot identify the record, and an update may not change the count at all."}]},"agentPrompt":"The page reports success, but the data disappears after refresh. Confirm that the backend actually wrote to the database and that refresh queries the same record. Fix the cause, then save, refresh, and inspect the database record directly."}},"references":[{"title":"数据库（术语表）","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Glossary/Database","title_en":"Database"}],"scenes":["Supabase 表格编辑器","页面从库里读数据","审查 AI 生成的 SQL","CRUD 四种操作速认"],"en":{"use":[{"t":"Store user and account records","m":"database-table"},{"t":"Keep orders or content","m":"database-crud"},{"t":"Query and relate persistent data","m":"database-hosted"},{"t":"Support transactions, constraints, and reliable updates","m":"database-ai"}],"dont":[{"t":"Connect a private database directly from browser code","m":"database-memory-bad","bad":true},{"t":"Store the only copy of important data without backups","m":"database-excel-bad","bad":true},{"t":"Change the schema in production without a migration plan","m":"database-selfhost-bad","bad":true},{"t":"Trust input before validation and authorization","m":"database-drop-bad","bad":true}],"scenes":["User accounts","Orders","Content system","Application settings"],"sceneUI":["<div style=\"max-width:440px;margin:0 auto;display:flex;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"width:110px;flex:none;border-right:1px solid var(--border-light);background:var(--bg-soft);padding:8px 0\">\n        <div style=\"padding:4px 12px;font-size:12px;color:var(--text-3)\">TABLES</div>\n        <div style=\"padding:5px 12px;font-size:12px;background:var(--brand-light);color:var(--brand);border-radius:4px;margin:0 6px\">users</div>\n        <div style=\"padding:5px 12px;font-size:12px;color:var(--text-2)\">posts</div>\n      </div>\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid var(--border-light)\">\n          <span style=\"font-size:12px;font-weight:600;flex:1\">users</span>\n          <button class=\"btn btn-primary\" style=\"background:#1f883d;color:#fff;border-color:#1f883d\">+ Insert row</button>\n        </div>\n        <div style=\"display:grid;grid-template-columns:34px 1fr 1fr;gap:1px;background:var(--border-light)\">\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">id</div>\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">name</div>\n          <div style=\"background:var(--bg-soft);padding:5px 8px;font-size:12px;color:var(--text-3)\">city</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px;color:var(--text-3)\">1</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Little Fox</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Shenzhen</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px;color:var(--text-3)\">2</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Aji</div>\n          <div style=\"background:var(--bg);padding:6px 8px;font-size:12px\">Hangzhou</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:360px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px\">\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px\">\n        <b style=\"font-size:14px;flex:1\">User list</b>\n        <span class=\"demo-tag green\">From users table</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:26px;height:26px;border-radius:50%;background:var(--brand-light);color:var(--brand);font-size:12px;display:flex;align-items:center;justify-content:center;flex:none\">ri</span>\n        <span style=\"font-size:12px;flex:1\">Xiaoli</span><span style=\"font-size:12px;color:var(--text-3)\">Shenzhen</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--border-light)\">\n        <span style=\"width:26px;height:26px;border-radius:50%;background:var(--brand-light);color:var(--brand);font-size:12px;display:flex;align-items:center;justify-content:center;flex:none\">Machine</span>\n        <span style=\"font-size:12px;flex:1\">Aji</span><span style=\"font-size:12px;color:var(--text-3)\">Hangzhou</span>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);margin-top:8px\">Query the database for saved data when the page is opened</div>\n    </div>","<div style=\"display:flex;flex-direction:column;gap:8px;max-width:400px;margin:0 auto\">\n      <div style=\"align-self:flex-end;max-width:80%;background:var(--brand);color:var(--on-brand);border-radius:12px 12px 4px 12px;padding:8px 12px;font-size:12px\">Help me find the users who registered in the last 7 days</div>\n      <div style=\"background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:10px 12px\">\n        <div class=\"terminal-win\"><div class=\"terminal-body\">\n          <span><span class=\"terminal-a\">SELECT</span> * <span class=\"terminal-a\">FROM</span> users</span>\n          <span><span class=\"terminal-a\">WHERE</span> created_at > now() - interval <span class=\"terminal-g\">'7 days'</span>;</span>\n        </div></div>\n        <div style=\"font-size:12px;color:var(--text-3);margin-top:6px\">Pre-execution checklist, conditions, parameters and expected impact scope</div>\n      </div>\n    </div>","<div style=\"max-width:400px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px;font-weight:600\">CRUD Quick Recognition</div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\">Add</span><span style=\"flex:1\">Register new user</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">INSERT</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\" style=\"background:var(--green-light);color:#16a34a;border-color:#16a34a\">Check</span><span style=\"flex:1\">Open user list page</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">SELECT</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px\"><span class=\"db-op\" style=\"background:#fff7ed;color:#d97706;border-color:#d97706\">Change</span><span style=\"flex:1\">Modify nickname</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">UPDATE</span></div>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 14px;font-size:12px\"><span class=\"db-op\" style=\"background:var(--red-light);color:var(--red);border-color:var(--red)\">Delete</span><span style=\"flex:1\">Cancel account</span><span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-3)\">DELETE</span></div>\n    </div>"],"distinctions":[{"label":"Browser storage","text":"A {c:database} lets the backend store and query data centrally for many users. {c:browser-storage} better suits device-local theme choices, offline drafts, and short-lived caches.","targetId":"browser-storage"}],"variants":[{"demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">supabase.com</span>","when":"Hosted PostgreSQL and related certifications and storage capabilities; suitable for projects requiring relational data"},{"demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">firebase.google.com</span>","when":"Provides document-based data services such as Cloud Firestore and real-time synchronization capabilities"},{"demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">data.db</span>","when":"Suitable for embedded or stand-alone scenarios; the database is usually stored in a file"}]},"usageMocks":{"database-table":"<div class=\"mk-win\"><span style=\"display:block;width:100%;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\"><span style=\"color:var(--text-3)\">users 表</span><br>id │ 名字 │ 城市<br>1&nbsp;&nbsp;│ 小狸 │ 深圳<br>2&nbsp;&nbsp;│ 阿机 │ 杭州</span><span style=\"font-size:12px;color:var(--text-3)\">行是记录、列是字段，像 Excel 一样看</span></div>","database-crud":"<div class=\"mk-row\"><span class=\"mk-tag blue\">增</span><span class=\"mk-tag green\">查</span><span class=\"mk-tag orange\">改</span><span class=\"mk-tag red\">删</span></div><span style=\"font-size:12px;color:var(--text-3)\">注册=增、列表=查、改资料=改、注销=删</span>","database-hosted":"<div class=\"mk-row\"><span class=\"mk-tag gray\">⚡ Supabase · SQL</span><span class=\"mk-tag gray\">🔥 Firebase · 文档</span></div><span style=\"font-size:12px;color:var(--text-3)\">都是托管服务，但数据模型和查询方式不同</span>","database-ai":"<div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text-2)\">“找出最近 7 天注册的用户”</span><span style=\"display:block;width:100%;text-align:left;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--brand)\">SELECT * FROM users WHERE …</span><span style=\"font-size:12px;color:var(--text-3)\">可用自然语言说明目标，再审查 AI 生成的 SQL</span></div>","database-memory-bad":"<div class=\"mk-win\"><span style=\"font-size:12px;color:var(--text-2)\">用户数据存在页面变量里</span><span style=\"font-size:12px;color:var(--red)\">⟳ 刷新页面后，该内存数据通常会丢失</span></div>","database-excel-bad":"<div class=\"mk-win\"><div class=\"mk-row\" style=\"width:100%\"><span style=\"font-size:12px\">📊 用户表.xlsx</span><span style=\"flex:1\"></span><span style=\"font-size:12px;color:var(--red)\">两人同时保存，互相覆盖</span></div><span style=\"font-size:12px;color:var(--red)\">Excel 不是多人在线数据库</span></div>","database-selfhost-bad":"<div class=\"npm-term\"><div class=\"npm-tb\"><span><b style=\"color:#4ade80\">$</b> <b style=\"color:#fff\">brew install mysql</b></span><span style=\"color:#8a91a0\">端口 · 权限 · 启动 · 备份</span><span style=\"color:#f87171\">维护范围尚未评估</span></div></div><span style=\"font-size:12px;color:var(--red)\">选择自托管前，先确认部署和维护成本</span>","database-drop-bad":"<div class=\"npm-term\"><div class=\"npm-tb\"><span><b style=\"color:#4ade80\">$</b> <b style=\"color:#fff\">DROP TABLE users;</b></span><span style=\"color:#f87171\">1,024 行记录，已删除</span></div></div><span style=\"font-size:12px;color:var(--red)\">没有可用备份时，删除可能无法恢复</span>"}}}