ss=\"rate-demo\" style=\"font-size:14px\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"half\">★</i><i>★</i></span><b style=\"font-size:13px\">3.5</b></span>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:6px\"><span style=\"font-size:12px;color:var(--text-3)\">The review summary and sample size should indicate the source</span><button class=\"btn btn-outline\">Write a review</button></div>\n          </div>\n        </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><span class=\"rate-demo\"><span class=\"ap\" data-ap=\"stars\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i>★</i></span></span></span>\n          <span class=\"ap\" data-ap=\"text\"><span class=\"rate-text\">4 分 · 满意</span></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><span class=\"rate-demo\"><span class=\"ap\" data-ap=\"stars\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i>★</i></span></span></span>\n          <span class=\"ap\" data-ap=\"text\"><span class=\"rate-text\">4 stars · Satisfied</span></span>","parts":[{"key":"root","cn":"评分整体","en":"Rate","desc":"通常五颗，数量和图标都可换","desc_en":"Usually five icons; both the count and icon can vary"},{"key":"stars","cn":"星星","en":"Star","desc":"实心已选、空心未选，支持半颗","desc_en":"Filled icons show the selected rating; outlines show the rest. Half-star ratings are also possible."},{"key":"text","cn":"辅助文案","en":"Text","desc":"分值和对应感受，如“4 分 · 满意”","desc_en":"The score and what it means, such as “4 stars · Satisfied.”"}]},"variants":[{"cn":"默认","en":"Default","demo":"<span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i>★</i><i>★</i></span>","demo_en":"<span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i>★</i><i>★</i></span>","when":"五星制打分，表达几分满意","when_en":"Use a five-star scale to show satisfaction"},{"cn":"半星","en":"Half Star","demo":"<span class=\"rate-row\"><span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"half\">★</i><i>★</i></span><span class=\"rate-text\">3.5</span></span>","demo_en":"<span class=\"rate-row\"><span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"half\">★</i><i>★</i></span><span class=\"rate-text\">3.5</span></span>","when":"想要更细的分数粒度时","when_en":"When you need half-star precision"},{"cn":"只读展示","en":"Readonly","demo":"<span class=\"rate-row\"><span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"half\">★</i></span><b class=\"rate-score\">4.8</b></span>","demo_en":"<span class=\"rate-row\"><span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"half\">★</i></span><b class=\"rate-score\">4.8</b></span>","when":"展示综合评分，不让用户改","when_en":"Show a read-only overall rating"},{"cn":"自定义图标","en":"Custom Icon","demo":"<span class=\"rate-demo heart\"><i class=\"on\">♥</i><i class=\"on\">♥</i><i class=\"on\">♥</i><i class=\"on\">♥</i><i>♥</i></span>","demo_en":"<span class=\"rate-demo heart\"><i class=\"on\">♥</i><i class=\"on\">♥</i><i class=\"on\">♥</i><i class=\"on\">♥</i><i>♥</i></span>","when":"想要品牌感，用爱心等图形替换星星","when_en":"Use an icon such as a heart when it better fits the brand."}],"use":[{"t":"<b>订单、商品评价</b>：交易后的标准动作","m":"rate-product"},{"t":"<b>满意度调查</b>：用一次点击收集反馈","m":"rate-satis"},{"t":"<b>半星</b>表达更细的程度","m":"rate-half"},{"t":"<b>只读展示</b>综合评分和评分人数","m":"rate-avg"}],"dont":[{"t":"只需收集<b>赞 / 不赞</b>：使用点赞或点踩按钮","m":"rate-like"},{"t":"<b>0～10 分推荐度</b>（NPS）：使用与量表一致的数字选择","m":"rate-nps","bad":true},{"t":"需要了解<b>低分原因</b>：配合 {c:textarea} 收集文字反馈","m":"rate-text"},{"t":"<b>购买数量</b>等精确数值：使用 {c:input-number}","m":"rate-count","bad":true}],"lessonPractice":{"title":"订单完成后要收集 1–5 分的满意程度，用户还要看懂自己当前选了几分。怎样设计？","options":[{"id":"ordered-rate-with-text","label":"使用五级评分控件，并同步显示“已选 4 分”等可读文字","feedback":"评分控件表达有顺序的等级，文字分值让当前选择不只依赖星星数量或颜色。","correct":true},{"id":"binary-like-buttons","label":"改成“满意”和“不满意”两个按钮，省去中间等级","feedback":"二选一只能收集正负态度，无法保留当前任务要求的五级满意程度。","correct":false},{"id":"free-number-input","label":"提供普通数字输入框，允许填写 1–5 之间的任意小数","feedback":"自由数字会超出评价规则，也缺少评分控件提供的固定等级和直观反馈。","correct":false}],"en":{"title":"After an order, the product collects satisfaction from 1 to 5 and users must understand their current selection. How should it work?","options":[{"id":"ordered-rate-with-text","label":"Use a five-level rating control and also show readable text such as Selected 4 of 5","feedback":"The control expresses ordered levels, while text makes the current value available without relying only on stars or color.","correct":true},{"id":"binary-like-buttons","label":"Replace it with Satisfied and Dissatisfied buttons and remove the middle levels","feedback":"A binary choice captures positive or negative sentiment but loses the five degrees required by this task.","correct":false},{"id":"free-number-input","label":"Use a regular number field and allow any decimal value from 1 to 5","feedback":"Free numbers can exceed the rating rules and do not provide the fixed levels and immediate feedback of a rating control.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把商品评价做成 1–5 分评分控件，选择时同步显示可读分值，并支持键盘操作。是否允许半分以现有业务规则为准；测试未评分、已评分和只读综合评分三种状态。","en":{"title":"You can say this to an AI Agent","text":"Use a 1–5 rating control for product feedback, show its value in text, and support keyboard input. Preserve the existing rule for half ratings, then test unrated, selected, and read-only aggregate states."}},"demoDetail":"<span class=\"rate-row\"><span class=\"rate-demo\"><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"on\">★</i><i class=\"half\">★</i><i>★</i></span><span class=\"rate-text\">半星 · 3.5</span></span>\n        <span class=\"rate-row\"><span class=\"rate-demo\"><i