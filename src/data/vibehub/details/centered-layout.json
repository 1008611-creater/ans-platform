 </div>"],"sceneUI_en":["<div style=\"background:var(--bg-soft);border-radius:8px;padding:12px 16px\">\n      <div style=\"max-width:300px;margin:0 auto;background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:12px 16px\">\n        <div style=\"font-size:13px;font-weight:700;line-height:1.4;margin-bottom:6px\">Why did I move my blog to a static site</div>\n        <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px\">\n          <img src=\"/assets/avatar-fox.png\" style=\"width:16px;height:16px;border-radius:50%\">\n          <span style=\"font-size:12px;color:var(--text-3)\">Ali · 3 days ago · Read in 6 minutes</span>\n        </div>\n        <i class=\"mk-line\" style=\"width:100%;margin-bottom:5px\"></i>\n        <i class=\"mk-line\" style=\"width:94%;margin-bottom:5px\"></i>\n        <i class=\"mk-line\" style=\"width:97%;margin-bottom:5px\"></i>\n        <i class=\"mk-line\" style=\"width:62%\"></i>\n      </div>\n    </div>","<div style=\"background:var(--bg-soft);border-radius:8px;padding:12px 16px;display:flex;justify-content:center\">\n      <div style=\"width:230px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 16px 14px;box-shadow:var(--shadow-card)\">\n        <div class=\"demo-tabs\" style=\"margin-bottom:10px\">\n          <span class=\"tab active\" style=\"font-size:12px;padding:6px 12px\">Login</span>\n          <span class=\"tab\" style=\"font-size:12px;padding:6px 12px\">Register</span>\n        </div>\n        <input class=\"demo-input\" style=\"width:100%;padding:6px 10px;font-size:12px;margin-bottom:8px\" value=\"you@example.com\">\n        <input class=\"demo-input\" style=\"width:100%;padding:6px 10px;font-size:12px;margin-bottom:10px\" type=\"password\" value=\"••••••••\">\n        <button class=\"btn btn-primary\" style=\"width:100%;padding:5px;font-size:12px\">Log in</button>\n        <div style=\"text-align:center;font-size:12px;color:var(--text-3);margin-top:7px\">Forgot your password? </div>\n      </div>\n    </div>","<div style=\"background:var(--bg-soft);border-radius:8px;padding:12px 16px\">\n      <div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border-light);border-radius:8px;padding:12px 16px\">\n        <div style=\"font-size:13px;font-weight:700;margin-bottom:9px\">Personal information</div>\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:9px\">\n          <img src=\"/assets/avatar-robot.png\" style=\"width:30px;height:30px;border-radius:50%\">\n          <button class=\"btn btn-outline\" style=\"padding:3px 10px;font-size:12px\">Change avatar</button>\n        </div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:3px\">Nickname</div>\n        <input class=\"demo-input\" style=\"width:100%;padding:5px 10px;font-size:12px;margin-bottom:8px\" value=\"Ali\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between\">\n          <span style=\"font-size:12px;color:var(--text)\">Weekly featured emails</span>\n          <label class=\"demo-switch\"><input type=\"checkbox\" checked><span class=\"track\"></span></label>\n        </div>\n      </div>\n    </div>","<div style=\"background:var(--bg-soft);border-radius:8px;padding:14px 16px;display:flex;justify-content:center\">\n      <div style=\"width:240px;text-align:center;background:var(--bg);border:1px solid var(--border-light);border-radius:10px;padding:15px 16px\">\n        <div style=\"width:34px;height:34px;margin:0 auto 8px;border-radius:50%;background:var(--green-light);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:16px\">✓</div>\n        <div style=\"font-size:13px;font-weight:700;margin-bottom:3px\">Subscription successful! </div>\n        <div style=\"font-size:12px;color:var(--text-2);margin-bottom:10px\">Front-end Weekly is delivered to you@example.com on time at 8 a.m. every Friday</div>\n        <button class=\"btn btn-outline\" style=\"padding:4px 14px;font-size:12px\">Back to homepage</button>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"page\"><span class=\"centered-wire centered-anat\"><span class=\"ap\" data-ap=\"column\"><span class=\"centered-wire-col\"><span class=\"ap\" data-ap=\"content\"><span class=\"centered-anat-content\">登录卡片</span></span></span></span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"page\"><span class=\"centered-wire centered-anat\"><span class=\"ap\" data-ap=\"column\"><span class=\"centered-wire-col\"><span class=\"ap\" data-ap=\"content\"><span class=\"centered-anat-content\">Login card</span></span></span></span></span></span>","parts":[{"key":"page","cn":"页面留白","en":"Page","desc":"两侧空白，帮注意力聚焦到中间","desc_en":"Leave blank space on both sides to help focus attention on the middle"},{"key":"column","cn":"内容栏","en":"Column","desc":"居中限宽 600~720px，一行 60~75 字符","desc_en":"Centered width limit 600~720px, 60~75 characters per line"},{"key":"content","cn":"内容本体","en":"Content","desc":"文章、表单或一张登录卡片","desc_en":"Article, form, or a login card"}]},"variants":[{"cn":"阅读栏","en":"Reading","demo":"<span class=\"centered-wire\" style=\"width:110px;padding:6px 0\"><span class=\"centered-wire-col\" style=\"width:60%;min-height:0;padding:4px\"><i style=\"display:block;width:100%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:90%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:95%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i></span></span>","demo_en":"<span class=\"centered-wire\" style=\"width:110px;padding:6px 0\"><span class=\"centered-wire-col\" style=\"width:60%;min-height:0;padding:4px\"><i style=\"display:block;width:100%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:90%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:95%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i></span></span>","when":"长文阅读，一行 60~75 字符","when_en":"Long text reading, 60~75 characters per line"},{"cn":"登录卡片","en":"Auth Card","demo":"<span class=\"centered-wire\" style=\"width:110px;padding:8px 0\"><span class=\"centered-wire-col\" style=\"width:44%;min-height:0;padding:5px;border-style:solid\"><i style=\"display:block;width:100%;height:5px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:100%;height:5px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:70%;height:6px;border-radius:3px;background:var(--brand);margin:3px auto 1px\"></i></span></span>","demo_en":"<span class=\"centered-wire\" style=\"width:110px;padding:8px 0\"><span class=\"centered-wire-col\" style=\"width:44%;min-height:0;padding:5px;border-style:solid\"><i style=\"display:block;width:100%;height:5px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:100%;height:5px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:70%;height:6px;border-radius:3px;background:var(--brand);margin:3px auto 1px\"></i></span></span>","when":"登录、注册、找回密码","when_en":"Log in, register, retrieve password"},{"cn":"表单栏","en":"Form","demo":"<span class=\"centered-wire\" style=\"width:110px;padding:6px 0;justify-content:flex-start;padding-left:22px\"><span class=\"centered-wire-col\" style=\"width:56%;min-height:0;padding:4px;align-items:flex-start\"><i style=\"display:block;width:34%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:100%;height:5px;border-radius:2px;border:1px solid var(--border);margin:1px 0 3px\"></i><i style=\"display:block;width:34%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:100%;height:5px;border-radius:2px;border:1px solid var(--border);margin:1px 0\"></i></span></span>","demo_en":"<span class=\"centered-wire\" style=\"width:110px;padding:6px 0;justify-content:flex-start;padding-left:22px\"><span class=\"centered-wire-col\" style=\"width:56%;min-height:0;padding:4px;align-items:flex-start\"><i style=\"display:block;width:34%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:100%;height:5px;border-radius:2px;border:1px solid var(--border);margin:1px 0 3px\"></i><i style=\"display:block;width:34%;height:3px;border-radius:2px;background:var(--bg-hover);margin:2px 0\"></i><i style=\"display:block;width:100%;height:5px;border-radius:2px;border:1px solid var(--border);margin:1px 0\"></i></span></span>","when":"设置页、单列表单","when_en":"Settings page, single column form"}],"use":[{"t":"<b>行宽 60~75 字符</b>：眼球不用长途移动，见 {c:typography}","m":"centered-measure"},{"t":"<b>大留白聚焦</b>：两侧的空白是设计的一部分","m":"centered-blank"},{"t":"<b>登录、注册</b>：一张窄卡片放页面正中","m":"in-login"},{"t":"<b>长文阅读</b>：正文限宽，配好字号行高","m":"typography-body"}],"dont":[{"t":"宽屏正文<b>未限宽</b>：单行字符过多会影响阅读","m":"centered-wide","bad":true},{"t":"窄栏放入仪表盘：<b>网格空间不足</b>，数据界面可使用 {c:sidebar-layout}","m":"centered-dashboard","bad":true},{"t":"登录卡片<b>未居中</b>：会造成两侧留白失衡","m":"centered-left","bad":true},{"t":"长正文使用<b>居中对齐</b>：每行起点不一致，阅读效率降低","m":"centered-text","bad":true}],"lessonPractice":{"title":"博客正文在大屏上铺满 1600 像素，单行文字很长，读者经常找不到下一行开头。怎样调整？","options":[{"id":"constrained-centered-column","label":"限制正文最大宽度并居中，保留两侧留白和左对齐行文","feedback":"稳定行宽减少视线横向移动，居中窄栏让阅读任务在宽屏上仍然集中。","correct":true},{"id":"full-width-copy","label":"继续让正文占满屏幕，只增加字号、行高和段落间距","feedback":"字号变化不能解决行长随视口无限增长的问题，宽屏阅读仍需长距离回扫。","correct":false},{"id":"center-aligned-paragraphs","label":"保持全文宽度，但把每段正文改成居中对齐","feedback":"每行起点不一致会进一步降低长文阅读效率，也没有控制单行长度。","correct":false}],"en":{"title":"A blog article spans a 1600-pixel display, producing very long lines that make the next line hard to find. How should it change?","options":[{"id":"constrained-centered-column","label":"Constrain and center the article column, keep side whitespace, and retain left-aligned paragraphs","feedback":"Stable line length reduces horizontal eye movement, and a centered narrow column keeps reading focused on wide screens.","correct":true},{"id":"full-width-copy","label":"Keep the article full-width and increase type size, line-height, and paragraph spacing","feedback":"Type size does not stop line length growing with the viewport, so wide-screen return sweeps remain long.","correct":false},{"id":"center-aligned-paragraphs","label":"Keep the full width but center-align every paragraph","feedback":"Variable line starts make long-form reading harder and still do not constrain line length.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把博客正文改为居中窄栏，根据中英文、字号和设备测试可读最大宽度，段落保持左对齐。两侧留白随视口变化，手机保留安全内边距；检查代码块和图片可以在需要时适度超出正文栏。","en":{"title":"You can say this to an AI Agent","text":"Change the blog body to a centered narrow column with a readable maximum width tested for Chinese, English, type size, and devices. Keep paragraphs left-aligned, preserve mobile padding, and let code or images widen only when justified."}},"references":[{"title":"排版","source":"web.dev","url":"https://web.dev/learn/design/typography/","title_en":"Typography"}],"scenes":["博客文章页","登录注册","设置表单","订阅确认页"],"en":{"use":[{"t":"Article or essay","m":"centered-measure"},{"t":"Sign-in and account setup","m":"centered-blank"},{"t":"Focused form","m":"in-login"},{"t":"Simple settings or editor","m":"typography-body"}],"dont":[{"t":"Place wide tables in a narrow column","m":"centered-wide","bad":true},{"t":"Center-align long body paragraphs","m":"centered-dashboard","bad":true},{"t":"Let the column grow too wide on large screens","m":"centered-left","bad":true},{"t":"Use excessive empty margins when more context is needed","m":"centered-text","bad":true}],"scenes":["Article","Login","Cre