bsp;&nbsp;<span class=\"ap\" data-ap=\"scripts\"><b class=\"npm-k\">\"scripts\"</b>: { \"dev\": \"vite\", \"build\": \"vite build\" }</span></span>\n      <span class=\"md-l\">}</span>\n    </div>","parts":[{"key":"name","cn":"项目名","en":"name","desc":"项目的名字和版本，发布、分享时用到","desc_en":"The name and version of the project, used when publishing and sharing"},{"key":"deps","cn":"依赖清单","en":"dependencies","desc":"装了哪些包、什么版本；install 就照它搬货","desc_en":"Which packages and versions are installed; install and move the goods accordingly."},{"key":"scripts","cn":"快捷命令","en":"scripts","desc":"npm run dev 跑的就是这里写的命令","desc_en":"npm run dev runs the command written here"}]},"variants":[{"cn":"安装","en":"install","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">npm install</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">npm install</span>","when":"装新包，或重建 node_modules","when_en":"Install new packages, or rebuild node_modules"},{"cn":"运行脚本","en":"run","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">npm run dev</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">npm run dev</span>","when":"执行 scripts 里的快捷命令","when_en":"Execute shortcut commands in scripts"},{"cn":"卸载","en":"uninstall","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">npm uninstall lodash</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">npm uninstall lodash</span>","when":"包用不上了，从清单划掉","when_en":"The bag is no longer needed, so cross it off the list."},{"cn":"锁版本","en":"lockfile","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">package-lock.json</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(