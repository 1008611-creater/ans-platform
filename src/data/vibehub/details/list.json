<div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">Account & security</span></span><span class=\"l-extra\">›</span></div>\n        <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">Notifications</span></span><span class=\"l-extra\">›</span></div>\n      </div>\n      <div style=\"font-size:12px;color:var(--text-3);margin:0 0 4px 4px\">General</div>\n      <div class=\"list-demo\" style=\"max-width:none\">\n        <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">Privacy</span></span><span class=\"l-extra\">›</span></div>\n      </div>\n    </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><div class=\"list-demo\" style=\"max-width:360px\">\n      <span class=\"ap\" data-ap=\"item\" style=\"display:block\"><div class=\"list-item\">\n        <span class=\"ap\" data-ap=\"avatar\"><span class=\"avatar-d\" style=\"background:#165dff\">林</span></span>\n        <span class=\"ap\" data-ap=\"main\"><span class=\"l-main\"><span class=\"l-title\">评论者提交了一条评论</span><span class=\"l-sub\">评论摘要 · 发布时间</span></span></span>\n        <span class=\"ap\" data-ap=\"extra\"><span class=\"l-extra\">查看 ›</span></span>\n      </div></span>\n    </div></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><div class=\"list-demo\" style=\"max-width:360px\">\n      <span class=\"ap\" data-ap=\"item\" style=\"display:block\"><div class=\"list-item\">\n        <span class=\"ap\" data-ap=\"avatar\"><span class=\"avatar-d\" style=\"background:#165dff\">Lin</span></span>\n        <span class=\"ap\" data-ap=\"main\"><span class=\"l-main\"><span class=\"l-title\">The commenter submitted a comment</span><span class=\"l-sub\">Comment Summary · Published</span></span></span>\n        <span class=\"ap\" data-ap=\"extra\"><span class=\"l-extra\">View ›</span></span>\n      </div></span>\n    </div></span>","parts":[{"key":"root","cn":"列表","en":"List","desc":"若干结构相同的列表项垂直排列","desc_en":"Several items with the same structure, arranged vertically"},{"key":"item","cn":"列表项","en":"Item","desc":"一条内容一行，整行通常可点","desc_en":"One item per row; the whole row is usually clickable"},{"key":"avatar","cn":"头像 / 图标","en":"Avatar","desc":"可选，快速识别来源或类型","desc_en":"Optional; quickly identifies the source or type"},{"key":"main","cn":"主内容","en":"Content","desc":"标题 + 摘要，视线的落点","desc_en":"Title and summary, which carry the main information"},{"key":"extra","cn":"附加区","en":"Extra","desc":"时间、状态或操作按钮","desc_en":"Time, status, or an action button"}]},"variants":[{"cn":"基础列表","en":"Basic","demo":"<div class=\"list-demo\" style=\"max-width:250px\">\n      <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">账号与安全</span><span class=\"l-sub\">密码、绑定手机</span></span><span class=\"l-extra\">›</span></div>\n      <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">消息通知</span><span class=\"l-sub\">推送、邮件</span></span><span class=\"l-extra\">›</span></div></div>","demo_en":"<div class=\"list-demo\" style=\"max-width:250px\">\n      <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">Account and security</span><span class=\"l-sub\">Password, linked phone number</span></span><span class=\"l-extra\">›</span></div>\n      <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">Notifications</span><span class=\"l-sub\">Push, email</span></span><span class=\"l-extra\">›</span></div></div>","when":"菜单和设置页需要展示纯文字条目时","when_en":"When menus and settings pages need to display plain text entries"},{"cn":"带头像","en":"With Avatar","demo":"<div class=\"list-demo\" style=\"max-width:250px\">\n      <div class=\"list-item\"><span class=\"avatar-d sm\" style=\"background:#287947\">K</span>\n        <span class=\"l-main\"><span class=\"l-title\">用户关注了你</span><span class=\"l-sub\">发布时间</span></span></div></div>","demo_en":"<div class=\"list-demo\" style=\"max-width:250px\">\n      <div class=\"list-item\"><span class=\"avatar-d sm\" style=\"background:#287947\">K</span>\n        <span class=\"l-main\"><span class=\"l-title\">User followed you</span><span class=\"l-sub\">Publish time</span></span></div></div>","when":"内容与人物强相关，需要识别来源时","when_en":"When the content is tied to a person and users need to identify the source"},{"cn":"带操作","en":"With Actions","demo":"<div class=\"list-demo\" style=\"max-width:250px\">\n      <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">首页 Banner 终稿</span><span class=\"l-sub\">Sketch · 2.4 MB</span></span>\n        <button class=\"btn btn-outline\">下载</button></div></div>","demo_en":"<div class=\"list-demo\" style=\"max-width:250px\">\n      <div class=\"list-item\"><span class=\"l-main\"><span class=\"l-title\">Home Banner Final Draft</span><span class=\"l-sub\">Sketch · 2.4 MB</span></span>\n        <button class=\"btn btn-outline\">Download</button></div></div>","when":"每条记录都需要独立操作时，例如下载文件","when_en":"When each record needs to be operated independently, such as downloading a file"}],"use":[{"t":"<b>消息、通知、动态</b>这类按时间排的内容","m":"list-msg"},{"t":"<b>文章、资讯流</b>：标题 + 摘要 + 来源时间","m":"list-article"},{"t":"每条带<b>缩略图和少量相关操作</b>的内容集合","m":"list-thumb"},{"t":"<b>设置页、菜单</b>这种简单的导航列表","m":"list-menu"}],"dont":[{"t":"需要<b>多列精确对比</b>：使用 {c:table}","m":"tag-table"},{"t":"<b>图片是主体</b>的内容，如商品、作品：使用 {c:card} 网格","m":"list-grid","bad":true},{"t":"只有<b>一两条数据</b>，列表反而显得空荡荡","m":"list-one","bad":true},{"t":"表达<b>流程步骤</b>：使用 {c:steps} 或 {c:timeline}","m":"tabs-steps"}],"lessonPractice":{"title":"通知中心要按时间展示几十条消息，每条只有标题、摘要、时间和一个查看入口，不需要逐列比较。怎样组织？","options":[{"id":"scannable-list","label":"使用纵向列表，让每条消息保持相同结构并按时间排列","feedback":"这些记录结构一致、以顺序浏览为主，列表能让用户连续扫读并进入单条详情。","correct":true},{"id":"comparison-table","label":"使用四列表格，把标题、摘要、时间和操作分别对齐","feedback":"表格更适合跨行比较固定字段；摘要长短不一时拆列会压缩内容并增加横向阅读。","correct":false},{"id":"visual-card-grid","label":"使用多列卡片网格，为每条通知增加封面图和大号图标","feedback":"通知的主体不是图片，多列卡片会打断时间顺序，还引入当前任务不需要的视觉信息。","correct":false}],"en":{"title":"A notification center shows dozens of messages by time. Each has a title, summary, timestamp, and View action, with no need for column comparison. How should it be organized?","options":[{"id":"scannable-list","label":"Use a vertical list with a consistent message structure ordered by time","feedback":"The records share a structure and are read in sequence, so a list supports scanning and opening individual details.","correct":true},{"id":"comparison-table","label":"Use four table columns for title, summary, time, and action","feedback":"Tables suit comparison across fixed fields. Variable summaries become compressed and force horizontal reading.","correct":false},{"id":"visual-card-grid","label":"Use a multi-column card grid and add a cover image and large icon to every message","feedback":"Images are not the main content here. A grid interrupts chronological reading and adds irrelevant visual information.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请把通知中心改成按时间排列的纵向列表，每条统一显示标题、两行内摘要、时间和查看入口。不要改成表格或图片卡片；用长短不同的摘要验证对齐、换行和点击区域。","en":{"title":"You can say this to an AI Agent","text":"Change the notification center to a time-ordered vertical list. Each item should consistently show a title, a summary capped at two lines, a timestamp, and a View action. Test alignment, wrapping, and click targets with varied summary lengths."}},"references":[{"title":"Lists 列表","source":"Material Design","url":"https://m3.material.io/components/lists/overview","title_en":"Lists"}],"scenes":["消息通知中心","文章资讯流","搜索结果","设置菜单页"],"en":{"use":[{"t":"Messages and notifications","m":"list-msg"},{"t":"Search results","m":"list-article"},{"t":"Contacts or members","m":"list-thumb"},{"t":"A compact stream of similar content","m":"list-menu"}],"dont":[{"t":"Use it when several fields must line up for comparison","m":"tag-table"},{"t":"Give every row a different structure","m":"list-grid","bad":true},{"t":"Hide the boundary between items","m":"list-one","bad":true},{"t":"Load an endless list without progress or a way back","m":"