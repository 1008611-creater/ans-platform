0\">Choose the direction you are interested in</div>\n          <div style=\"font-size:12px;color:var(--text-3);margin:2px 0 10px\">Multiple selections to help you recommend more suitable content</div>\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;font-size:12px\">\n            <label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>🎨 design</label>\n            <label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>💻 Front-end development</label>\n            <label class=\"demo-check\"><input type=\"checkbox\"><i></i>🤖 AI application</label>\n            <label class=\"demo-check\"><input type=\"checkbox\"><i></i>📊 Data Analysis</label>\n          </div>\n          <button class=\"btn btn-primary\" style=\"width:100%;margin-top:12px\">Complete, enter the home page</button>\n        </div>","<div style=\"max-width:320px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-card)\">\n          <input class=\"demo-input\" style=\"width:100%;margin-bottom:8px\" placeholder=\"Email\" value=\"lin@example.com\">\n          <input class=\"demo-input\" style=\"width:100%;margin-bottom:10px\" type=\"password\" placeholder=\"Set password\" value=\"••••••••\">\n          <label class=\"demo-check\" style=\"font-size:12px;align-items:flex-start\"><input type=\"checkbox\" checked><i style=\"margin-top:2px\"></i><span style=\"line-height:1.5\">I have read and agree to the <a style=\"color:var(--brand)\">User Agreement</a> and <a style=\"color:var(--brand)\">\"Privacy Policy\"</a></span></label>\n          <button class=\"btn btn-primary\" style=\"width:100%;margin-top:10px\">Register</button>\n        </div>","<div style=\"max-width:440px;margin:0 auto\">\n          <div style=\"border:1px solid var(--border-light);border-radius:10px;overflow:hidden\">\n            <div class=\"checkbox-sc-li\" style=\"background:var(--bg-soft)\"><label class=\"demo-check half\" style=\"font-size:12px;color:var(--text-3)\"><input type=\"checkbox\" checked><i></i>File name</label><span style=\"flex:1\"></span><span style=\"font-size:12px;color:var(--text-3)\">Modification time</span></div>\n            <div class=\"checkbox-sc-li\"><label class=\"demo-check\" style=\"font-size:12px;flex:1\"><input type=\"checkbox\" checked><i></i>📄 Home page revision.fig</label><span style=\"font-size:12px;color:var(--text-3)\">2 hours ago</span></div>\n            <div class=\"checkbox-sc-li\"><label class=\"demo-check\" style=\"font-size:12px;flex:1\"><input type=\"checkbox\" checked><i></i>📄 Design specification.md</label><span style=\"font-size:12px;color:var(--text-3)\">Yesterday</span></div>\n            <div class=\"checkbox-sc-li\"><label class=\"demo-check\" style=\"font-size:12px;flex:1\"><input type=\"checkbox\"><i></i>📄 Requirements Review Minutes.docx</label><span style=\"font-size:12px;color:var(--text-3)\">3 days ago</span></div>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:10px;margin-top:8px\"><span style=\"font-size:12px;color:var(--text-2)\">2 items selected</span><span style=\"flex:1\"></span><button class=\"btn btn-outline\">Move</button><button class=\"btn btn-danger\">Delete</button></div>\n        </div>"],"anatomy":{"demo":"<span class=\"ap\" data-ap=\"root\"><span class=\"demo-check\"><span class=\"ap\" data-ap=\"box\"><i class=\"c-box\"></i></span><span class=\"ap\" data-ap=\"label\">接收产品更新邮件</span></span></span>","demo_en":"<span class=\"ap\" data-ap=\"root\"><span class=\"demo-check\"><span class=\"ap\" data-ap=\"box\"><i class=\"c-box\"></i></span><span class=\"ap\" data-ap=\"label\">Receive product update emails</span></span></span>","parts":[{"key":"root","cn":"复选项","en":"Checkbox","desc":"整行都能点，互相独立","desc_en":"Each checkbox row is independently clickable."},{"key":"box","cn":"方框","en":"Box","desc":"勾选打对勾，部分选中显示横杠","desc_en":"Use an indeterminate mark when only some child items are selected"},{"key":"label","cn":"文案","en":"Label","desc":"说清勾选后会怎样","desc_en":"Explain what selecting the checkbox will do"}]},"variants":[{"cn":"默认","en":"Default","demo":"<label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>音乐</label><label class=\"demo-check\"><input type=\"checkbox\"><i></i>电影</label>","demo_en":"<label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>Music</label><label class=\"demo-check\"><input type=\"checkbox\"><i></i>Movies</label>","when":"多选或单独确认一件事时","when_en":"Use for multiple independent choices or a single confirmation"},{"cn":"半选（全选）","en":"Indeterminate","demo":"<div class=\"chk-col\"><label class=\"demo-check half\"><input type=\"checkbox\" checked><i></i>全选</label><label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>设计稿.sketch</label><label class=\"demo-check\"><input type=\"checkbox\"><i></i>需求文档.md</label></div>","demo_en":"<div class=\"chk-col\"><label class=\"demo-check half\"><input type=\"checkbox\" checked><i></i>Select all</label><label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>Design draft.sketch</label><label class=\"demo-check\"><input type=\"checkbox\"><i></i>Requirements document.md</label></div>","when":"批量选择时，表示只勾了一部分","when_en":"Use an indeterminate state when only some items in a batch are selected"},{"cn":"禁用","en":"Disabled","demo":"<label class=\"demo-check\"><input type=\"checkbox\" disabled><i></i>不可选</label><label class=\"demo-check\"><input type=\"checkbox\" checked disabled><i></i>已选禁用</label>","demo_en":"<label class=\"demo-check\"><input type=\"checkbox\" disabled><i></i>Unavailable</label><label class=\"demo-check\"><input type=\"checkbox\" checked disabled><i></i>Selected disabled</label>","when":"该选项当前不可勾选","when_en":"When an option is temporarily unavailable"}],"use":[{"t":"<b>多条件筛选</b>：几个条件自由组合","m":"check-filter"},{"t":"<b>兴趣、技能</b>等多选收集","m":"check-interest"},{"t":"<b>全选、批量操作</b>：一键选中整组","m":"check-all"},{"t":"<b>单独确认一件事</b>：我已阅读并同意","m":"sw-agree"}],"dont":[{"t":"选项<b>互斥且只能选一个</b>：使用 {c:radio}","m":"check-vs-radio","bad":true},{"t":"切换后<b>立即生效</b>的设置：使用 {c:switch}","m":"check-autosave","bad":true},{"t":"触发<b>提交、删除</b>等操作：使用 {c:button}","m":"check-action","bad":true},{"t":"大量选项不宜<b>全部平铺</b>：使用多选 {c:select}","m":"check-many","bad":true}],"lessonPractice":{"title":"订阅表单允许用户选择邮件、短信和应用通知，可以选多个，也可以一个不选，提交后才生效。怎样设计？","options":[{"id":"checkbox-list","label":"每个通知渠道放一个独立复选框","feedback":"三个渠道彼此独立，复选框能准确表达可选一个、多个或完全不选。","correct":true},{"id":"radio-list","label":"把三个渠道放进同一个单选组","feedback":"单选组只允许保留一个选项，会错误限制用户同时订阅多个渠道。","correct":false},{"id":"instant-switches","label":"放三个立即生效的开关，再保留提交按钮","feedback":"开关通常表示操作后立即改变状态，与题目中统一提交后生效的流程不一致。","correct":false}],"en":{"title":"A subscription form offers email, SMS, and app notifications. People may choose several or none, and changes apply on submit. What fits?","options":[{"id":"checkbox-list","label":"Give each notification channel its own checkbox","feedback":"The channels are independent, and checkboxes express choosing one, several, or none accurately.","correct":true},{"id":"radio-list","label":"Put all three channels in one radio group","feedback":"A radio group keeps only one choice, incorrectly preventing people from selecting several channels.","correct":false},{"id":"instant-switches","label":"Use three immediate switches and still keep a Submit button","feedback":"Switches normally signal immediate change, which conflicts with the form's apply-on-submit behavior.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"邮件、短信和应用通知请用三个独立复选框，允许多选或全不选，提交后统一生效。请验证每个标签可点击，并准确提交用户勾选的渠道。","en":{"title":"You can say this to an AI Agent","text":"Use three independent checkboxes for email, SMS, and app notifications, allowing several or none, and apply them on submit. Verify clickable labels and the submitted channel values."}},"references":[{"title":"复选类型输入框","source":"MDN","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/checkbox","title_en":"<input type=\"checkbox\">"},{"title":"复选框模式","source":"WAI-ARIA APG","url":"https://www.w3.org/WAI/ARIA/apg/patterns/checkbox/","title_en":"Checkbox Pattern"}],"scenes":["列表多条件筛选","兴趣标签选择","注册协议确认","表格批量选择"],"en":{"use":[{"t":"Select several interests","m":"check-filter"},{"t":"Apply multiple filters","m":"check-interest"},{"t":"Choose rows in a table","m":"check-all"},{"t":"Confirm one independent statement","m":"sw-agree"}],"dont":[{"t":"Use checkboxes for choices that exclude each other","m":"check-vs-radio","bad":true},{"t":"Preselect consent that the user should give knowingly","m":"check-autosave","bad":true},{"t":"Make the clickable label too small","m":"check-action","bad":true},{"t":"Leave the effect of selecting a parent item unclear","m":"check-many","bad":true}],"scenes":["Filter panel","Interest picker","Bulk selection","Terms confirmation"],"sceneUI":["<div style=\"max-width:420px;margin:0 auto\">\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:8px\">\n            <span style=\"font-size:12px;color:var(--text-3)\">Status</span>\n            <label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>In progress</label>\n            <label class=\"demo-check\"><input type=\"checkbox\" checked><i></i>Completed</label>\n            <label class=\"demo-check\"><input type=\"checkbox\"><i></i>Archived</label>\n            <span style=\"margin-left:auto;font-size:12px;color:var(--text-3)\">5 items in total</span>\n          </div>\n          <div style=\"border:1px solid var(--border-light);border-radius:10px;overflow:hidden\">\n            <div class=\"checkbox-sc-li\"><span style=\"flex:1;font-size:12px\">Website refresh v2</span><span class=\"demo-tag blue\">In progress</span></div>\n            <div class=\"checkbox-sc-li\"><span style=\"flex:1;font-size:12px\">Design specification arrangement</span><span class=\"demo-tag green\">Completed</span></div>\n            <div class=\"checkbox-sc-