{"__formatVersion":2,"__revision":"6c8604ddf7c10eb1","__entryId":"branch","entry":{"sceneUI":["<div style=\"max-width:420px;margin:0 auto\" class=\"terminal-win\">\n      <div class=\"terminal-bar\"><i></i><i></i><i></i><span>zsh — my-first-page</span></div>\n      <div class=\"terminal-body\">\n        <span><b class=\"terminal-p\">$</b> <b class=\"terminal-c\">git switch -c feature/new-nav</b></span>\n        <span class=\"terminal-g\">Switched to a new branch 'feature/new-nav'</span>\n        <span class=\"terminal-d\">从当前提交创建并切换到新分支</span>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;font-weight:600\">my-first-page</span><span class=\"demo-tag gray\">Public</span>\n      </div>\n      <div style=\"padding:12px 14px\">\n        <div style=\"display:inline-block;border:1px solid var(--border);border-radius:6px;padding:4px 10px;font-size:12px\">⑂ main ▾</div>\n        <div style=\"margin-top:6px;border:1px solid var(--border);border-radius:8px;overflow:hidden;box-shadow:0 4px 12px rgba(15,23,42,.06)\">\n          <div style=\"padding:6px 10px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3)\">切换分支</div>\n          <div style=\"padding:7px 10px;font-size:12px;border-bottom:1px solid var(--border-light)\"><b>✓ main</b> <span class=\"demo-tag gray\" style=\"margin-left:4px\">默认</span></div>\n          <div style=\"padding:7px 10px;font-size:12px;border-bottom:1px solid var(--border-light)\">　feature/new-nav</div>\n          <div style=\"padding:6px 10px;font-size:12px;color:var(--brand)\">查看所有分支（2）</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:12px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        <span style=\"color:var(--code-keyword)\">&lt;nav</span> <span style=\"color:var(--warning)\">class</span>=<span style=\"color:#16a34a\">\"top-nav\"</span><span style=\"color:var(--code-keyword)\">&gt;</span><br>\n        <span style=\"color:var(--code-keyword)\">&nbsp;&nbsp;&lt;a&gt;</span>首页<span style=\"color:var(--code-keyword)\">&lt;/a&gt;</span><br>\n        <span style=\"color:var(--code-keyword)\">&lt;/nav&gt;</span>\n      </div>\n      <div style=\"background:#eaf2ff;color:var(--info);font-size:12px;padding:4px 12px;display:flex;gap:14px\"><span>⑂ <b>feature/new-nav</b></span><span>⊘ 0　⚠ 0</span><span style=\"margin-left:auto\">Ln 3, Col 1</span></div>\n      <div style=\"font-size:12px;color:var(--text-3);padding:6px 12px 8px\">开始修改前确认左下角显示的当前分支</div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px;font-weight:600\">你的分支</div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:12px;font-weight:600;flex:1\">⑂ main</span><span class=\"demo-tag gray\">默认</span><span style=\"font-size:12px;color:var(--text-3)\">2 小时前更新</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px\">\n        <span style=\"font-size:12px;font-weight:600;flex:1\">⑂ feature/new-nav</span><span style=\"font-size:12px;color:var(--text-3)\">5 分钟前更新</span><span style=\"background:#1f883d;color:#fff;font-size:12px;border-radius:6px;padding:3px 8px\">New pull request</span>\n      </div>\n    </div>"],"sceneUI_en":["<div style=\"max-width:420px;margin:0 auto\" class=\"terminal-win\">\n      <div class=\"terminal-bar\"><i></i><i></i><i></i><span>zsh — my-first-page</span></div>\n      <div class=\"terminal-body\">\n        <span><b class=\"terminal-p\">$</b> <b class=\"terminal-c\">git switch -c feature/new-nav</b></span>\n        <span class=\"terminal-g\">Switched to a new branch 'feature/new-nav'</span>\n        <span class=\"terminal-d\">Create and switch to a new branch from the current commit</span>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;font-weight:600\">my-first-page</span><span class=\"demo-tag gray\">Public</span>\n      </div>\n      <div style=\"padding:12px 14px\">\n        <div style=\"display:inline-block;border:1px solid var(--border);border-radius:6px;padding:4px 10px;font-size:12px\">⑂ main ▾</div>\n        <div style=\"margin-top:6px;border:1px solid var(--border);border-radius:8px;overflow:hidden;box-shadow:0 4px 12px rgba(15,23,42,.06)\">\n          <div style=\"padding:6px 10px;border-bottom:1px solid var(--border-light);font-size:12px;color:var(--text-3)\">Switch branch</div>\n          <div style=\"padding:7px 10px;font-size:12px;border-bottom:1px solid var(--border-light)\"><b>✓ main</b> <span class=\"demo-tag gray\" style=\"margin-left:4px\">Default</span></div>\n          <div style=\"padding:7px 10px;font-size:12px;border-bottom:1px solid var(--border-light)\">feature/new-nav</div>\n          <div style=\"padding:6px 10px;font-size:12px;color:var(--brand)\">View all branches (2)</div>\n        </div>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:12px 14px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2);line-height:1.9\">\n        <span style=\"color:var(--code-keyword)\">&lt;nav</span> <span style=\"color:var(--warning)\">class</span>=<span style=\"color:#16a34a\">\"top-nav\"</span><span style=\"color:var(--code-keyword)\">&gt;</span><br>\n        <span style=\"color:var(--code-keyword)\"> &lt;a&gt;</span>Homepage<span style=\"color:var(--code-keyword)\">&lt;/a&gt;</span><br>\n        <span style=\"color:var(--code-keyword)\">&lt;/nav&gt;</span>\n      </div>\n      <div style=\"background:#eaf2ff;color:var(--info);font-size:12px;padding:4px 12px;display:flex;gap:14px\"><span>⑂ <b>feature/new-nav</b></span><span>⊘ 0　⚠ 0</span><span style=\"margin-left:auto\">Ln 3, Col 1</span></div>\n      <div style=\"font-size:12px;color:var(--text-3);padding:6px 12px 8px\">Confirm the current branch displayed in the lower left corner before starting modification</div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"padding:8px 14px;border-bottom:1px solid var(--border-light);font-size:12px;font-weight:600\">your branch</div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:12px;font-weight:600;flex:1\">⑂ main</span><span class=\"demo-tag gray\">Default</span><span style=\"font-size:12px;color:var(--text-3)\">Updated 2 hours ago</span>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:8px;padding:9px 14px\">\n        <span style=\"font-size:12px;font-weight:600;flex:1\">⑂ feature/new-nav</span><span style=\"font-size:12px;color:var(--text-3)\">Updated 5 minutes ago</span><span style=\"background:#1f883d;color:#fff;font-size:12px;border-radius:6px;padding:3px 8px\">New pull request</span>\n      </div>\n    </div>"],"anatomy":{"demo":"<div class=\"branch-graph\">\n      <div class=\"branch-row\"><span class=\"ap branch-tag\" data-ap=\"main\">main</span><span class=\"branch-dot\"></span><span class=\"branch-link\"></span><span class=\"ap branch-dot\" data-ap=\"base\"></span><span class=\"branch-link\"></span><span class=\"branch-dot\"></span></div>\n      <div class=\"branch-row\"><span class=\"branch-pad\" style=\"width:118px\"></span><span class=\"ap branch-tag green\" data-ap=\"feature\">feature/new-nav</span><span class=\"branch-dot green\"></span><span class=\"branch-link\"></span><span class=\"branch-dot green\"></span></div>\n      <span class=\"ap branch-head\" data-ap=\"head\">HEAD → 你现在在 feature/new-nav</span>\n    </div>","demo_en":"<div class=\"branch-graph\">\n      <div class=\"branch-row\"><span class=\"ap branch-tag\" data-ap=\"main\">main</span><span class=\"branch-dot\"></span><span class=\"branch-link\"></span><span class=\"ap branch-dot\" data-ap=\"base\"></span><span class=\"branch-link\"></span><span class=\"branch-dot\"></span></div>\n      <div class=\"branch-row\"><span class=\"branch-pad\" style=\"width:118px\"></span><span class=\"ap branch-tag green\" data-ap=\"feature\">feature/new-nav</span><span class=\"branch-dot green\"></span><span class=\"branch-link\"></span><span class=\"branch-dot green\"></span></div>\n      <span class=\"ap branch-head\" data-ap=\"head\">HEAD → You are now in feature/new-nav</span>\n    </div>","parts":[{"key":"main","cn":"主线","en":"main","desc":"常见的默认分支，通常保留已验证的改动；是否允许直接提交要看团队规则","desc_en":"Default branches usually contain verified changes; whether direct commits are allowed depends on team rules"},{"key":"base","cn":"分叉点","en":"Base","desc":"新分支从某个 commit 创建，起点对应当时的快照","desc_en":"A new branch is created from a certain commit, and the starting point corresponds to the snapshot at that time"},{"key":"feature","cn":"功能分支","en":"Feature Branch","desc":"可按 feature/功能名命名，用于独立开发和测试","desc_en":"Can be named according to feature/function name for independent development and testing"},{"key":"head","cn":"当前位置","en":"HEAD","desc":"HEAD 指向当前检出的分支或提交，git switch 会更新其指向","desc_en":"HEAD points to the currently checked-out branch or commit, and git switch will update its point."}]},"variants":[{"cn":"创建分支","en":"switch -c","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git switch -c feature/new-nav</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git switch -c feature/new-nav</span>","when":"从当前提交创建并切换到新分支","when_en":"Create and switch to a new branch from the current commit"},{"cn":"切回主分支","en":"switch","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git switch main</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git switch main</span>","when":"切换工作目录到 main 的文件版本","when_en":"Switch the working directory to the file version of main"},{"cn":"列出分支","en":"branch","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git branch</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git branch</span>","when":"查看本地分支列表","when_en":"View local branch list"},{"cn":"删除分支","en":"branch -d","demo":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git branch -d feature/new-nav</span>","demo_en":"<span style=\"font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text-2)\">git branch -d feature/new-nav</span>","when":"确认分支已合并或不再需要后","when_en":"After confirming that the branch has been merged or is no longer needed"}],"use":[{"t":"开发新功能或尝试较大的修改时，先从稳定版本创建分支","m":"branch-main"},{"t":"用 feature/new-nav 等能说明用途的名称","m":"branch-name"},{"t":"切换前先确认当前改动已经 Commit 或暂时收好","m":"branch-switch"},{"t":"完成并测试后及时合回主版本，不让两边相差太久","m":"branch-feature"}],"dont":[{"t":"直接在主版本上做不确定的大改动","m":"branch-main-bad","bad":true},{"t":"使用 test1、aaa 等无法说明用途的分支名称","m":"branch-name-bad","bad":true},{"t":"带着未保存的改动随意切换，导致内容出现在错误分支","m":"branch-lost-bad","bad":true},{"t":"功能完成很久仍不合回，增加之后的合并难度","m":"branch-stale-bad","bad":true}],"lessonPractice":{"title":"main 现在稳定，你要尝试一套可能推翻的导航方案。怎样开始更安全？","options":[{"id":"edit-main","label":"留在 main 直接修改，完成后再决定要不要保留","feedback":"不确定的大改会直接混入稳定路线，之后分辨和撤回实验内容都更困难。","correct":false},{"id":"branch-from-main","label":"先收好当前改动，再从最新 main 创建用途明确的分支","feedback":"新分支共享稳定起点，却把后续实验暂时隔开，验证后再决定是否合回。","correct":true},{"id":"new-repository","label":"为这次导航实验创建一个全新的 Git 仓库","feedback":"新仓库会割裂原有历史和协作关系；同一项目的独立修改路线应使用分支。","correct":false}],"en":{"title":"Main is stable, and you want to try a navigation approach that may be discarded. What is the safer start?","options":[{"id":"edit-main","label":"Stay on main, make the experiment, and decide whether to keep it later","feedback":"An uncertain large change enters the stable line directly, making experimental work harder to isolate and undo.","correct":false},{"id":"branch-from-main","label":"Store current work, then create a purpose-named branch from the latest main","feedback":"The branch shares the stable starting point while keeping the experiment separate until it is verified.","correct":true},{"id":"new-repository","label":"Create an entirely new Git repository for the navigation experiment","feedback":"A new repository disconnects the project's history and collaboration. A branch is the independent line within the same project.","correct":false}]}},"lessonAgentPrompt":{"title":"你可以这样告诉 AI Agent","text":"请先收好当前改动并同步最新 main，再创建一个名称说明用途的导航实验分支。只在该分支修改和验证导航，不要直接改 main。完成后告诉我分支名、与 main 的差异和验证结果，先不要合并。","en":{"title":"You can say this to an AI Agent","text":"Store current work and sync the latest main, then create a purpose-named branch for the navigation experiment. Change and verify navigation only on that branch, not main. Report the branch, its diff from main, and validation results without merging yet."}},"demoDetail":"<div class=\"git-story git-story--branch is-detail\">\n  <div class=\"git-story-main\"><div class=\"git-branch-visual\">\n      <div class=\"git-branch-caption\"><span>主版本</span><small>保持稳定</small></div>\n      <div class=\"git-branch-lane is-main\"><i></i><b></b><i></i><b></b><i></i></div>\n      <div class=\"git-branch-split\"><span>从这里分开</span></div>\n      <div class=\"git-branch-caption is-feature\"><span>新功能</span><small>单独修改</small></div>\n      <div class=\"git-branch-lane is-feature\"><i></i><b></b><i></i></div>\n    </div></div>\n  <div class=\"git-story-answer\"><span class=\"git-command\">git switch -c feature/new-nav</span><p>分支像一条独立的版本线。你可以在“新功能”这条线上修改和测试，主版本仍停在原来的稳定状态。\n</p></div>\n</div>","references":[{"title":"git-branch 官方文档","source":"git-scm","url":"https://git-scm.com/docs/git-branch","title_en":"Git - git-branch Documentation"},{"title":"分支简介（Pro Git）","source":"git-scm","url":"https://git-scm.com/book/en/v2/Git-Branching-Branches-in-a-Nutshell","title_en":"Pro Git - Branches in a Nutshell"}],"scenes":["终端开新分支","GitHub 分支下拉切换","VS Code 左下角分支名","GitHub 分支列表页"],"en":{"demoDetail":"<div class=\"git-story git-story--branch is-detail\">\n  <div class=\"git-story-main\"><div class=\"git-branch-visual\">\n      <div class=\"git-branch-caption\"><span>Main version</span><small>Stay stable</small></div>\n      <div class=\"git-branch-lane is-main\"><i></i><b></b><i></i><b></b><i></i></div>\n      <div class=\"git-branch-split\"><span>Split here</span></div>\n      <div class=\"git-branch-caption is-feature\"><span>New feature</span><small>Individual modification</small></div>\n      <div class=\"git-branch-lane is-feature\"><i></i><b></b><i></i></div>\n    </div></div>\n  <div class=\"git-story-answer\"><span class=\"git-command\">git switch -c feature/new-nav</span><p>The branch is like an independent version line. You can modify and test on the \"new features\" line, and the main version will still be in its original stable state.\n</p></div>\n</div>","use":[{"t":"Build a feature separately","m":"branch-main"},{"t":"Fix a bug without disturbing ongoing work","m":"branch-name"},{"t":"Try an experiment","m":"branch-switch"},{"t":"Prepare a release or urgent patch","m":"branch-feature"}],"dont":[{"t":"Use one long-lived branch for unrelated work","m":"branch-main-bad","bad":true},{"t":"Create it from an outdated or wrong starting point","m":"branch-name-bad","bad":true},{"t":"Keep finished branches forever without a reason","m":"branch-lost-bad","bad":true},{"t":"Assume switching branches saves uncommitted changes safely","m":"branch-stale-bad","bad":true}],"scenes":["Feature branch","Bug-fix branch","Experiment","Release branch"],"sceneUI":["<div style=\"max-width:420px;margin:0 auto\" class=\"terminal-win\">\n      <div class=\"terminal-bar\"><i></i><i></i><i></i><span>zsh — my-first-page</span></div>\n      <div class=\"terminal-body\">\n        <span><b class=\"terminal-p\">$</b> <b class=\"terminal-c\">git switch -c feature/new-nav</b></span>\n        <span class=\"terminal-g\">Switched to a new branch 'feature/new-nav'</span>\n        <span class=\"terminal-d\">Create and switch to a new branch from the current commit</span>\n      </div>\n    </div>","<div style=\"max-width:420px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden\">\n      <div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border-light)\">\n        <span style=\"font-size:13px;font-weight:600\">my-first-page</span><span class=\"demo-tag gray\">Public</span>\n      </div>\n      <div style=\"padding:12px 14px\">\n        <div style=\"display:inline-block;border:1px solid var(--border);border-radius:6px;padding:4px 10px;font-size:12px\">⑂ main ▾</div>\n        <div style=\"margin-top:6px;border:1px solid var(--border);border-radius:8px;overflow:hidden;box-shadow:0 4px 12px rgba(15,23,42,.06)\">\n          <div style=\"padding:6px 10px;border-bottom:1px solid var(--border-light);font-size:12p