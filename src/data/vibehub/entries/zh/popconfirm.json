x;flex-direction:column;align-items:center\"><div style=\"background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 14px rgba(29,33,41,.14);padding:6px 8px;display:flex;flex-direction:column;gap:5px;max-width:150px\"><span style=\"font-size:12px;color:var(--text)\">⚠ 确认删除全部 1,024 条数据？此操作不可恢复！</span><div style=\"display:flex;justify-content:flex-end;gap:4px\"><span class=\"mk-btn outline\">取消</span><span class=\"mk-btn danger\">确定删除</span></div></div><div style=\"width:0;height:0;border:5px solid transparent;border-top-color:var(--bg)\"></div><span class=\"mk-btn danger\" style=\"margin-top:1px\">删除全部</span></div></div></li><li class=\"has-usage-mock\"><div class=\"usage-text\">说明文字较长：使用 <a class=\"c-ref c-link\" href=\"/vibe-hub/modal?lang=zh\" data-ref=\"modal\" aria-label=\"弹窗 Modal\">弹窗 <b>Modal</b></a> 承载完整内容</div><div class=\"mk bad\"><div style=\"background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 14px rgba(29,33,41,.14);padding:6px 8px;width:150px;display:flex;flex-direction:column;gap:4px\"><span style=\"font-size:12px;color:var(--text)\">删除后，项目下的文件、成员和配置都会被清除，且无法通过任何方式恢复，请确认你已经备份好重要数据。</span><div style=\"display:flex;justify-content:flex-end;gap:4px\"><span class=\"mk-btn outline\">取消</span><span class=\"mk-btn danger\">删除</span></div></div></div></li><li class=\"has-usage-mock\"><div class=\"usage-text\">只需展示信息：使用 <a class=\"c-ref c-link\" href=\"/vibe-hub/popover?lang=zh\" data-ref=\"popover\" aria-label=\"气泡卡片 Popover\">气泡卡片 <b>Popover</b></a> 或 <a class=\"c-ref c-link\" href=\"/vibe-hub/tooltip?lang=zh\" data-ref=\"tooltip\" aria-label=\"文字提示 Tooltip\">文字提示 <b>Tooltip</b></a></div><div class=\"mk bad\"><div style=\"display:flex;flex-direction:column;align-items:center\"><div style=\"background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 14px rgba(29,33,41,.14);padding:6px 8px;display:flex;flex-direction:column;gap:5px;max-width:150px\"><span style=\"font-size:12px;color:var(--text)\">💡 支持拖拽调整排序</span><div style=\"display:flex;justify-content:flex-end;gap:4px\"><span class=\"mk-btn outline\">取消</span><span class=\"mk-btn primary\">知道了</span></div></div><div style=\"width:0;height:0;border:5px solid transparent;border-top-color:var(--bg)\"></div><span class=\"mk-btn danger\" style=\"margin-top:1px\">悬停我</span></div></div></li><li class=\"has-usage-mock\"><div class=\"usage-text\">连续要求多次确认：应改进触发条件或操作流程</div><div class=\"mk bad\"><div class=\"mk-row\"><div style=\"background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 14px rgba(29,33,41,.14);padding:6px 8px;display:flex;flex-direction:column;gap:4px\"><span style=\"font-size:12px;color:var(--text)\">确认删除？</span><div style=\"display:flex;justify-content:flex-end;gap:4px\"><span class=\"mk-btn primary\">确定</span></div></div><div style=\"background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 14px rgba(29,33,41,.14);padding:6px 8px;display:flex;flex-direction:column;gap:4px\"><span style=\"font-size:12px;color:var(--text)\">再确认一次？</span><div style=\"display:flex;justify-content:flex-end;gap:4px\"><span class=\"mk-btn danger\">确定</span></div></div></div></div></li></ul></div></div><section><div class=\"section-title\">组成结构 · Anatomy</div><div class=\"anat-wrap\"><div class=\"anat-stage\"><div class=\"popconfirm-anat\"><div class=\"ap\" data-ap=\"card\"><div class=\"popconfirm-card\"><div class=\"ap\" data-ap=\"text\"><div class=\"popconfirm-text\"><i>⚠</i><span>确认删除这条记录？</span></div></div><div class=\"ap\" data-ap=\"actions\"><div class=\"popconfirm-actions\"><span class=\"btn btn-outline\">取消</span><span class=\"btn btn-primary\">确定</span></div></div></div></div><div class=\"popconfirm-arrow\"></div><div class=\"ap\" data-ap=\"trigger\"><span class=\"btn btn-danger\">删除</span></div></div></div><div class=\"anat-parts\"><div class=\"anat-part\" data-ap=\"card\"><button class=\"anat-part-trigger\" type=\"button\" ari