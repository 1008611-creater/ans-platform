span class=\"custom-select-value\" data-custom-select-value>Last 7 days</span>\n      <i class=\"select-arrow\" aria-hidden=\"true\"></i>\n    </button>\n    <span class=\"custom-select-menu\" role=\"listbox\">\n      <button type=\"button\" class=\"custom-select-option on\" role=\"option\" aria-selected=\"true\" data-custom-select-option data-value=\"Last 7 days\">\n        <span>Last 7 days</span><i class=\"custom-select-check\" aria-hidden=\"true\">✓</i>\n      </button><button type=\"button\" class=\"custom-select-option\" role=\"option\" aria-selected=\"false\" data-custom-select-option data-value=\"Last 30 days\">\n        <span>Last 30 days</span><i class=\"custom-select-check\" aria-hidden=\"true\">✓</i>\n      </button><button type=\"button\" class=\"custom-select-option\" role=\"option\" aria-selected=\"false\" data-custom-select-option data-value=\"this year\">\n        <span>This year</span><i class=\"custom-select-check\" aria-hidden=\"true\">✓</i>\n      </button>\n    </span>\n  </span></div>\n        <div class=\"form-actions\"><button class=\"btn btn-primary\" style=\"padding:6px 12px;font-size:12px\">Query</button><button class=\"btn btn-text\" style=\"padding:6px 8px;font-size:12px\">Reset</button></div>\n      </div>\n      <div class=\"select-sc-row\" style=\"border-top:1px solid var(--border)\"><span style=\"flex:1;font-size:12px;color:var(--text)\">Order #20260721-018</span><span class=\"demo-tag green\">Completed</span><span style=\"font-size:12px;color:var(--text-3)\">¥ 329</span></div>\n      <div class=\"select-sc-row\"><span style=\"flex:1;font-size:12px;color:var(--text)\">Order #20260721-017</span><span class=\"demo-tag blue\">In progress</span><span style=\"font-size:12px;color:var(--text-3)\">¥ 89</span></div>\n    </div></div></div></div></div></div></section><section class=\"selector-recommendation\" aria-label=\"Recommended tool\"><div class=\"section-title\">Recommended tool</div><a class=\"selector-recommendation-card\" href=\"ht