">\n        <b style=\"font-size:14px\">Make team collaboration clearer</b>\n        <i class=\"mk-line\" style=\"width:72%\"></i>\n        <i class=\"mk-line\" style=\"width:52%\"></i>\n      </div>\n    </div></div></div></div></div><div class=\"scene-item\"><div class=\"scene-cap\">Workspace navigation</div><div class=\"scene-shot is-plain\"><div class=\"sc-body\"><div class=\"sc-body-inner\"><div style=\"display:flex;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg);box-shadow:var(--shadow-card)\">\n      <div style=\"width:136px;flex:none;border-right:1px solid var(--border-light);padding:10px 8px;display:flex;flex-direction:column;gap:2px\">\n        <div style=\"font-size:12px;color:var(--text-3);padding:2px 10px\">Development Guide</div>\n        <span class=\"menu-sc-item\">Quick Start</span>\n        <span class=\"menu-sc-item on\">Installation and configuration</span>\n        <div style=\"font-size:12px;color:var(--text-3);padding:6px 10px 2px\">Core concept</div>\n        <span class=\"menu-sc-item\">Component model</span>\n        <span class=\"menu-sc-item\">Status management</span>\n        <span class=\"menu-sc-item\">Style scheme</span>\n      </div>\n      <div style=\"flex:1;min-width:0;padding:12px 14px;display:flex;flex-direction:column;gap:7px\">\n        <b style=\"font-size:13px\">Installation and configuration</b>\n        <i class=\"mk-line\" style=\"width:92%\"></i><i class=\"mk-line\" style=\"width:66%\"></i>\n        <div style=\"background:var(--bg-soft);border-radius:6px;padding:7px 10px;font-size:12px;color:var(--text-2);font-family:monospace\">npm install museon-ui</div>\n        <i class=\"mk-line\" style=\"width:78%\"></i>\n      </div>\n    </div></div></div></div></div><div class=\"scene-item\"><div class=\"scene-cap\">Mobile menu</div><div class=\"scene-shot is-plain\"><div class=\"sc-body\"><div class=\"sc-body-inner\"><div style=\"position:relative;height:150px;border:1px solid var(--borde