:4px;background:var(--bg);white-space:nowrap\">Members</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">Calendar</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">Reports</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">Messages</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">Settings</span><span style=\"padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);white-space:nowrap\">Trash</span></div></div></li><li class=\"has-usage-mock\"><div class=\"usage-text\">Copy the desktop row unchanged onto a phone</div><div class=\"mk bad\"><div class=\"mk-win\" style=\"padding:0;overflow:hidden;gap:0\"><span style=\"display:block;background:var(--bg-hover);padding:5px 8px;font-size:12px;color:var(--text-3)\">Top bar and body share the same background color</span><span style=\"display:block;background:var(--bg-hover);padding:5px 8px;font-size:12px;color:var(--text-3)\">Lacks visual layering</span></div></div></li></ul></div></div><section><div class=\"section-title\">Anatomy</div><div class=\"anat-wrap\"><div class=\"anat-stage\"><span class=\"topnav-wire topnav-anat\"><span class=\"ap\" data-ap=\"header\"><span class=\"topnav-wire-bar\"><i class=\"topnav-wire-logo\"></i><span class=\"topnav-wire-links\"><i></i><i></i><i></i></span><b class=\"topnav-wire-btn\"></b></span></span><span class=\"ap\" data-ap=\"main\"><span class=\"topnav-wire-body\"><span class=\"topnav-wire-col\">Content area</span></span></span><span class=\"ap\" data-ap=\"footer\"><span class=\"topnav-wire-foot\">Footer · Copyright and secondary links</span></span></span></div><div class=\"anat-parts\"><div class=\"anat-part\" data-ap=\"header\"><button class=\"anat-part-trigger\" type=\"button\" aria-pressed=\"false\"><span class=\"idx\">1</span><span class=\"pn\">Header</span></button><span class=\"pd\">Holds the brand, navigation, and primary actions; make it sticky when needed</span></div><div class=\"anat-part\" data-ap=\"main\"><button class=\"anat-part-trigger\" type=\"button\" aria-pressed=\"false\"><span class=\"idx\">2</span><span class=\"pn\">Main</span></button><span class=\"pd\">The page’s main content, centered with a maximum width and side whitespace</span></div><div class=\"anat-part\" data-ap=\"footer\"><button class=\"anat-part-trigger\" type=\"button\" aria-pressed=\"false\"><span class=\"idx\">3</span><span class=\"pn\">Footer</span></button><span class=\"pd\">Holds copyright, regulatory information, and secondary links</span></div></div></div></section><section><div class=\"section-title\">Variants</div><div class=\"variant-grid\"><div class=\"variant-card\"><div class=\"variant-name\">Static</div><div class=\"variant-demo\"><span class=\"topnav-wire\" style=\"width:120px\"><span class=\"topnav-wire-bar\"><i class=\"topnav-wire-logo\"></i><span class=\"topnav-wire-links\"><i></i><i></i></span></span><span class=\"topnav-wire-body\" style=\"padding:6px 0\"><span class=\"topnav-wire-col\" style=\"min-height:22px\"></span></span></span></div><div class=\"variant-when\">For a short page that does not need persistent navigation</div></div><div class=\"variant-card\"><div class=\"variant-name\">Sticky</div><div class=\"variant-demo\"><span class=\"topnav-wire\" style=\"width:120px\"><span class=\"topnav-wire-bar\" style=\"box-shadow:inset 0 -2px 0 var(--brand)\"><i class=\"topnav-wire-logo\"></i><span class=\"topnav-wire-links\"><i></i><i></i></span></span><span class=\"topnav-wire-body\" style=\"padding:6px 0\"><span class=\"topnav-wire-col\" style=\"min-height:22px\"></span></span></span></div><div class=\"variant-when\">When navigation should remain available while users scroll through a long page</div></div><div cla