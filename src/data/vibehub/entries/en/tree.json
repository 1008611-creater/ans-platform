div></div></div></div></div><div class=\"scene-item\"><div class=\"scene-cap\">Department tree</div><div class=\"scene-shot is-plain\"><div class=\"sc-body\"><div class=\"sc-body-inner\"><div style=\"max-width:360px;margin:0 auto;border:1px solid var(--border-light);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow-card)\">\n      <div style=\"font-size:13px;font-weight:600;margin-bottom:8px\">Select approver</div>\n      <div class=\"tre-sc\">\n        <div class=\"tre-sc-row\"><span class=\"arr\">▾</span>🏢 XX Technology</div>\n        <div class=\"tre-sc-row\" style=\"padding-left:26px\"><span class=\"arr\">▾</span>Design Department</div>\n        <div class=\"tre-sc-row on\" style=\"padding-left:42px\"><img src=\"/vibe-hub/source/assets/avatar-fox.png\" style=\"width:16px;height:16px;border-radius:50%\" alt=\"\">Alex Chen</div>\n        <div class=\"tre-sc-row\" style=\"padding-left:26px\"><span class=\"arr\">▸</span>R&amp;D Department</div>\n      </div>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:10px\"><button class=\"btn btn-outline\" style=\"padding:4px 12px;font-size:12px\">Cancel</button><button class=\"btn btn-primary\" style=\"padding:4px 12px;font-size:12px\">OK</button></div>\n    </div></div></div></div></div><div class=\"scene-item\"><div class=\"scene-cap\">Category manager</div><div class=\"scene-shot is-plain\"><div class=\"sc-body\"><div class=\"sc-body-inner\"><div style=\"max-width:400px;margin:0 auto;border:1px solid var(--border-light);border-radius:10px;padding:14px 16px\">\n      <div style=\"display:flex;align-items:center;margin-bottom:8px\"><b style=\"font-size:13px;flex:1\">Role permissions · Operation</b><span class=\"demo-tag gray\">3 / 6 items selected</span></div>\n      <div class=\"tre-sc\">\n        <div class=\"tre-sc-row\"><span class=\"arr\">▾</span><i class=\"tre-sc-box on\"></i>Content management</div>\n        <div class=\"tre-sc-row\" style=\"padding-left:32px\"><i class=\"tre-sc