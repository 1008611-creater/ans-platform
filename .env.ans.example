# ANS Platform 部署环境变量示例
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会入库）

# ---- 数据库（共享 prompts-chat-db 的 prompts_chat 库）----
DB_PASSWORD=prompts123

# ---- 鉴权 ----
# 与旧站保持一致，共享用户库时 JWT 可互认
AUTH_SECRET=change-me-to-a-long-random-string

# ---- 邮件（注册验证 / 邀请通知，待接入）----
# SMTP_HOST=smtp.cau.edu.cn
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# ---- 人机验证 Cloudflare Turnstile（待接入）----
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
