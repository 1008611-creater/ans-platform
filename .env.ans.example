# ANS Platform 部署环境变量示例
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会入库）

# ---- 托管 PostgreSQL（生产必填，不要填 localhost / 127.0.0.1）----
# DATABASE_URL 用应用连接串；如果供应商提供连接池，放池化地址。
DATABASE_URL="postgresql://ans_app:change-me@your-managed-postgres.example.com:5432/ans?sslmode=require&schema=public"
# DIRECT_URL 用于 Prisma 迁移，填写直连地址；没有连接池时可与 DATABASE_URL 相同。
DIRECT_URL="postgresql://ans_app:change-me@your-managed-postgres.example.com:5432/ans?sslmode=require&schema=public"

# ---- 鉴权 ----
AUTH_SECRET=change-me-to-a-long-random-string

# ---- BYOK credential encryption (optional) ----
# Encrypts user-supplied model keys at rest. Falls back to AUTH_SECRET when unset.
# MODEL_CREDENTIAL_SECRET=change-me-to-a-separate-long-random-string

# ---- Platform model gateway (required for generation runs) ----
# OpenAI-compatible endpoint. Base URL must stop at /v1 with no trailing slash.
# RUN_BASE_URL="https://your-gateway.example.com/v1"
# RUN_API_KEY=change-me

# ---- 邮件（注册验证 / 邀请通知，待接入）----
# SMTP_HOST=smtp.cau.edu.cn
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# ---- 人机验证 Cloudflare Turnstile（待接入）----
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# AIGC contest workspace links (optional; defaults point to cauai.fun)
# ANS_SOLARA_URL="https://plan.cauai.fun"
# ANS_PLANE_URL="https://plane.cauai.fun"
# ANS_TOONFLOW_URL="https://toonflow.cauai.fun"
