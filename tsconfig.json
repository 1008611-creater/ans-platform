{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-agri-tasks/types/**/*.ts",
    ".next-agri-tasks/dev/types/**/*.ts",
    ".next-agri-submissions/types/**/*.ts",
    ".next-agri-submissions/dev/types/**/*.ts",
    ".next-agri-reviews/types/**/*.ts",
    ".next-agri-reviews/dev/types/**/*.ts",
    ".next-agri-references/types/**/*.ts",
    ".next-agri-references/dev/types/**/*.ts",
    ".next-agri-demo/types/**/*.ts",
    ".next-agri-demo/dev/types/**/*.ts",
    ".next-agri-summary/types/**/*.ts",
    ".next-agri-summary/dev/types/**/*.ts",
    ".next-agri-p2/types/**/*.ts",
    ".next-agri-p2/dev/types/**/*.ts",
    ".next-compute-history/types/**/*.ts",
    ".next-compute-history/dev/types/**/*.ts",
    ".next-compute-history-build/types/**/*.ts",
    ".next-compute-history-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ecosystem-sites-archive"
  ]
}
