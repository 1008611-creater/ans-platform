  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previous AgriRankingPublication? @relation("AgriRankingHistory", fields: [previousId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  next AgriRankingPublication[] @relation("AgriRankingHistory")
  id String @id
  competitionId String
  stage String
  action String
  previousId String?
  snapshot Json
  sourceHash String
  actorId String
  idempotencyKey String
  requestHash String
  createdAt DateTime @db.Timestamptz(3)
  @@unique([competitionId, actorId, idempotencyKey])
  @@index([competitionId, stage, createdAt(sort: Desc), id(sort: Desc)], map: "agri_ranking_latest")
  @@map("agri_ranking_publications")
}
enum CommunityPostKind {
  NOTE
  TEXT
  STALL
}

enum CommunityStallKind {
  SEEK
  OFFER
  SWAP
  TEAM
}

enum CommunityBoard {
  TEAM
  CAREER
  RESEARCH
  AIGC
  CAMPUS
}

enum CommunityPostStatus {
  OPEN
  RESOLVED
  CLOSED
  HIDDEN
}

enum CommunityApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// 社区帖子：图文笔记、一句话、集市摊位（求 / 出 / 换 / 组队）。摊位到期或解决后收起。
model CommunityPost {
  id            String              @id @default(cuid())
  authorId      String
  author        User                @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind          CommunityPostKind
  stall         CommunityStallKind?
  board         CommunityBoard
  title         String?             @db.VarChar(80)
  body          String              @db.VarChar(2000)
  images        String[]
  /// 组队摊位：[{ "name": "前端", "slots": 1 }]，已入队人数按通过的申请计算。
  roles         Json?
  competitionId String?
  competition   Competition?        @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status        CommunityPostStatus @default(OPEN)
  expiresAt     DateTime?
  helperId      String?
  helper        User?               @relation("CommunityPostHelper", fields: [helperId], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  /// 接力：这条帖子接的是哪条。接力的接力也挂到最早那条原帖下，串只有一层。
  relayOfId     String?
  relayOf       CommunityPost?      @relation("CommunityRelay", fields: [relayOfId], references: [id], onDelete: SetNull)
  relays        CommunityPost[]     @relation("CommunityRelay")
  /// 管理员置顶的时间。推荐频道最上面放最近置顶的两条，用来放每天的官方挑战帖。
  pinnedAt      DateTime?
  /// 做同款：帖子附的项目广场项目（catalog slug），看帖的人点「做同款」从这个项目开始做。
  catalogSlug   String?             @db.VarChar(80)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  replies       CommunityReply[]
  likes         CommunityPostLike[]
  helpOffers    CommunityHelpOffer[]
  applications  CommunityTeamApplication[]
  reports       CommunityPostReport[]

  @@index([status, createdAt])
  @@index([board, status, createdAt])
  @@index([authorId, createdAt])
  @@index([relayOfId, createdAt])
  @@index([pinnedAt])
  @@index([catalogSlug, createdAt])
  @@map("community_posts")
}

/// 关注：关注一个人后，他发帖会出现在「关注」频道并提醒你。
model CommunityFollow {
  followerId String
  follower   User     @relation("CommunityFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("CommunityFollowee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@map("community_follows")
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String        @db.VarChar(1000)
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@map("community_replies")
}

model CommunityPostLike {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@map("community_post_likes")
}

/// 「我能帮」/「我想要」：发帖人从这里选出帮到自己的人。
model CommunityHelpOffer {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?       @db.VarChar(200)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@map("community_help_offers")
}

/// 组队帖的入队申请；队长同意后直接成为队伍成员。
model CommunityTeamApplication {
  id          String                     @id @default(cuid())
  postId      String
  post        CommunityPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User                       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  role        String                     @db.VarChar(20)
  message     String?                    @db.VarChar(300)
  status      CommunityApplicationStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())

  @@unique([postId, applicantId])
  @@index([postId, status])
  @@map("community_team_applications")
}

model CommunityPostReport {
  id         String               @id @default(cuid())
  postId     String
  post       CommunityPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                 @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String               @db.VarChar(20)
  details    String?              @db.VarChar(500)
  status     ArtifactReportStatus @default(PENDING)
  createdAt  DateTime             @default(now())

  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@map("community_post_reports")
}

enum CommunityBottleStatus {
  OPEN
  HIDDEN
}

/// 漂流瓶：匿名的一段话，被随机捞到的人可以回一句，回复只有扔瓶子的人看得到。
model CommunityBottle {
  id        String                  @id @default(cuid())
  authorId  String
  author    User                    @relation("CommunityBottleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String                  @db.VarChar(280)
  status    CommunityBottleStatus   @default(OPEN)
  createdAt DateTime                @default(now())
  picks     CommunityBottlePick[]
  replies   CommunityBottleReply[]
  reports   CommunityBottleReport[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@map("community_bottles")
}

model CommunityBottlePick {
  id        String          @id @default(cuid())
  bottleId  String
  bottle    CommunityBottle @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([bottleId, userId])
  @@index([userId, createdAt])
  @@map("community_bottle_picks")
}

/// 每个捞到瓶子的人只能回一句。
model CommunityBottleReply {
  id        String          @id @default(cuid())
  bottleId  String
  bottle    CommunityBottle @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String          @db.VarChar(280)
  createdAt DateTime        @default(now())

  @@unique([bottleId, authorId])
  @@index([bottleId, createdAt])
  @@map("community_bottle_replies")
}

model CommunityBottleReport {
  id         String               @id @default(cuid())
  bottleId   String
  bottle     CommunityBottle      @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                 @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String               @db.VarChar(20)
  status     ArtifactReportStatus @default(PENDING)
  createdAt  DateTime             @default(now())

  @@unique([bottleId, reporterId])
  @@index([status, createdAt])
  @@map("community_bottle_reports")
}
