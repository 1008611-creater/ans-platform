generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  agriComputeGrants AgriTeamComputeGrant[]
  agriJudgeScores AgriJudgeScore[]
  agriRankingPublications AgriRankingPublication[]
  agriEvidenceRequests AgriEvidenceRequest[]
  agriEvidenceEvents AgriEvidenceEvent[]
  agriEvidenceManifests AgriEvidenceManifest[]
  agriEvidenceReceipts AgriEvidenceCommandReceipt[]
  agriPopularityVotes AgriPopularityVote[]
  agriPopularityConfigurations AgriPopularityRound[]
  visualInputUploads VisualInputUpload[]
  visualModelJobs VisualModelJob[]
  visualModelAssets VisualModelAsset[]
  visualWebsiteReleases VisualWebsiteRelease[]
  visualWebsiteDomains VisualWebsiteDomain[]
  communityPoints Int       @default(0)
  avatarFrameKey  String    @default("default") @db.VarChar(64)
  chatBubbleKey   String    @default("default") @db.VarChar(64)
  growthEvents             GrowthEvent[]
  apiComputeRequests ApiComputeRequest[]
  id                         String                 @id @default(cuid())
  email                      String                 @unique
  username                   String                 @unique
  name                       String?
  password                   String?
  avatar                     String?
  bio                        String?                @db.VarChar(250)
  customLinks                Json? // Array of {type: string, url: string, label?: string}
  role                       UserRole               @default(USER)
  locale                     String                 @default("en")
  emailVerified              DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  passwordChangedAt          DateTime?
  verified                   Boolean                @default(false)
  githubUsername             String?
  apiKey                     String?                @unique
  mcpPromptsPublicByDefault  Boolean                @default(false)
  flagged                    Boolean                @default(false)
  flaggedAt                  DateTime?
  deletedAt                  DateTime?
  flaggedReason              String?
  dailyGenerationLimit       Int                    @default(3)
  generationCreditsRemaining Int                    @default(3)
  generationCreditsRevision  Int                    @default(0)
  mediaGenerations           MediaGeneration[]
  computeTasks               ComputeTask[]
  agriCreatedIssues AgriIssue[] @relation("AgriIssueCreator")
  agriAssignedIssues AgriIssue[] @relation("AgriIssueAssignee")
  agriCompletedIssues AgriIssue[] @relation("AgriIssueCompleter")
  agriIssueEvents AgriIssueEvent[] @relation("AgriIssueEventActor")
  agriIssueReceipts AgriIssueReceipt[] @relation("AgriIssueReceiptActor")
  agriTechnicalChecks AgriTechnicalCheck[] @relation("AgriCheckActor")
  agriFeedbackEvents AgriCheckFeedbackEvent[] @relation("AgriFeedbackActor")
  agriReviewReceipts AgriReviewReceipt[] @relation("AgriReviewActor")
  agriDemoChecks AgriDemoCheck[] @relation("AgriDemoActor")
  agriDemoFeedbackEvents AgriDemoFeedbackEvent[] @relation("AgriDemoFeedbackActor")
  agriDemoReceipts AgriDemoReceipt[] @relation("AgriDemoReceiptActor")
  agriDemoEvents AgriDemoEvent[] @relation("AgriDemoEventActor")
  agriOnsiteItems AgriOnsiteItem[] @relation("AgriOnsiteCreator")
  agriOnsiteEvents AgriOnsiteEvent[] @relation("AgriOnsiteEventActor")
  agriOnsiteReceipts AgriOnsiteReceipt[] @relation("AgriOnsiteReceiptActor")
  agriRecordArchives AgriRecordArchive[] @relation("AgriArchiveCreator")
  agriRecordArchiveReceipts AgriRecordArchiveReceipt[] @relation("AgriArchiveReceiptActor")
  agriStageSubmissions AgriStageSubmission[] @relation("AgriStageSubmitter")
  agriConfirmedRosters AgriOfficialRoster[]
  agriOfficialMemberships AgriOfficialRosterMember[]
  agriSubmissionEvents AgriSubmissionEvent[] @relation("AgriSubmissionEventActor")
  agriSubmissionReceipts AgriSubmissionReceipt[] @relation("AgriSubmissionReceiptActor")
  agriWorkspaceUpdates AgriWorkspace[] @relation("AgriWorkspaceUpdater")
  agriConfirmedRules AgriRuleVersion[] @relation("AgriRuleConfirmer")
  agriAccessGrants AgriAccessGrant[] @relation("AgriGrantRecipient")
  agriGrantedScopes AgriAccessGrant[] @relation("AgriGrantActor")
  agriWorkspaceEvents AgriWorkspaceEvent[] @relation("AgriWorkspaceEventActor")
  agriFinalDecisions AgriFinalDecision[]
  agriCorrectionPermits AgriCorrectionPermit[]
  agriPermitEvents AgriCorrectionPermitEvent[]
  agriDecisionReceipts AgriDecisionReceipt[]
  agriPublicationEvents AgriPublicationEvent[]
  agriPublicationReceipts AgriPublicationReceipt[]
  agriCommandReceipts AgriCommandReceipt[] @relation("AgriCommandActor")
  agriPersonalTasks           AgriPersonalTask[] @relation("AgriTaskOwner")
  agriTaskEvents              AgriTaskEvent[] @relation("AgriTaskEventActor")
  agriTaskShares              AgriTaskShare[] @relation("AgriTaskShareRecipient")
  agriSharesGranted           AgriTaskShare[] @relation("AgriTaskShareActor")
  agriTaskReceipts             AgriTaskCommandReceipt[]
  generationCreditsResetAt   DateTime?
  accounts                   Account[]
  subscriptions              CategorySubscription[]
  changeRequests             ChangeRequest[]
  pinnedPrompts              PinnedPrompt[]
  reports                    PromptReport[]
  promptVersions             PromptVersion[]
  votes                      PromptVote[]
  prompts                    Prompt[]               @relation("PromptAuthor")
  sessions                   Session[]
  contributions              Prompt[]               @relation("PromptContributors")
  comments                   Comment[]              @relation("CommentAuthor")
  commentVotes               CommentVote[]
  notifications              Notification[]         @relation("NotificationRecipient")
  notificationsActed         Notification[]         @relation("NotificationActor")
  collections                Collection[]
  userPromptExamples         UserPromptExample[]
  auditLogs                  AuditLog[]             @relation("AuditActor")
  adminPermissions           Json?

  // ===== ANS 社区：等�?/ 经验 / 额度 =====
  xp             Int       @default(0) // 累计经验，只增不减（除管理员调整�?
  nickname       String? // 匿名展示名，独立�?username
  nicknameSetAt  DateTime? // 改昵称冷却起点（30 天一次）
  lastCheckInAt  DateTime?
  checkInStreak  Int       @default(0)
  quotaPoints    Decimal       @default(0) @db.Decimal(24, 6) // 个人可用算力点数
  quotaClaimedAt DateTime? // 免费额度池领取时间（每人一次）

  // ===== ANS 社区：关�?=====
  xpHistory                  XpLedger[]
  checkIns                   CheckIn[]
  createdInvites             InviteCode[]           @relation("InviteCreator")
  redeemedInvites            InviteRedemption[]
  sentInviteEmails           InviteEmailDelivery[]  @relation("InviteEmailActor")
  templates                  Template[]
  runs                       Run[]
  templateFavorites          TemplateFavorite[]
  ownedTeams                 Team[]                 @relation("TeamOwner")
  teamMemberships            TeamMember[]
  quotaLedgers               QuotaLedger[]
  ldxpRechargeOrders LdxpRechargeOrder[]
  workflows        Workflow[]
  workflowRuns     WorkflowRun[]
  workflowVersions WorkflowVersion[]  @relation("WorkflowVersionCreator")
  modelCredentials UserModelCredential[]
  aiConfigUpdates  AdminAiConfig[]        @relation("AdminAiConfigUpdater")
  favorites        ContentFavorite[]
  projects         Project[]
  projectFacts     ProjectFact[]      @relation("ProjectFactEditor")
  artifacts        Artifact[]         @relation("ArtifactCreator")
  artifactVersions ArtifactVersion[]  @relation("ArtifactVersionAuthor")
  publicationRequests ArtifactPublication[] @relation("ArtifactPublicationRequester")
  publicationReviews ArtifactPublication[] @relation("ArtifactPublicationReviewer")
  competitionReviews TeamCompetition[] @relation("CompetitionReviewer")
  competitionContributions TeamCompetitionContribution[]
  authoredXpRewardRules XpRewardRule[] @relation("XpRewardRuleAuthor")
  reviewedXpRewardAppeals XpRewardAppeal[] @relation("XpRewardAppealReviewer")
  xpRewardAppeals XpRewardAppeal[] @relation("XpRewardAppealAuthor")
  xpRewardGrants XpRewardGrant[]
  openedXpRewardReviews XpRewardReviewCase[] @relation("XpRewardReviewOpener")
  resolvedXpRewardReviews XpRewardReviewCase[] @relation("XpRewardReviewResolver")
  artifactReactions ArtifactReaction[]
  artifactComments ArtifactComment[]
  communityPosts CommunityPost[] @relation("CommunityPostAuthor")
  communityPostsHelped CommunityPost[] @relation("CommunityPostHelper")
  communityReplies CommunityReply[]
  communityPostLikes CommunityPostLike[]
  communityHelpOffers CommunityHelpOffer[]
  communityTeamApplications CommunityTeamApplication[]
  communityPostReports CommunityPostReport[]
  communityBottles CommunityBottle[] @relation("CommunityBottleAuthor")
  communityBottlePicks CommunityBottlePick[]
  communityBottleReplies CommunityBottleReply[]
  communityBottleReports CommunityBottleReport[]
  communityFollowing CommunityFollow[] @relation("CommunityFollower")
  communityFollowers CommunityFollow[] @relation("CommunityFollowee")
  artifactReports ArtifactReport[] @relation("ArtifactReportAuthor")
  marketListings MarketListing[] @relation("MarketSeller")
  marketCheckouts MarketExternalCheckout[]
  marketMedia MarketMedia[]
  marketStars MarketListingStar[]
  marketPurchases MarketOrder[] @relation("MarketBuyer")
  marketSales MarketOrder[] @relation("MarketOrderSeller")
  marketEvents MarketOrderEvent[] @relation("MarketEventActor")
  marketMessages MarketOrderMessage[]
  marketReviews MarketReview[]


  @@index([deletedAt])
  @@index([xp])
  @@index([quotaClaimedAt])
  @@map("users")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Prompt {
  id                  String              @id @default(cuid())
  title               String
  titleZh             String?
  titleEn             String?
  slug                String?
  description         String?
  descriptionZh       String?
  descriptionEn       String?
  content             String
  contentZh           String?
  contentEn           String?
  type                PromptType          @default(TEXT)
  isPrivate           Boolean             @default(false)
  mediaUrl            String?
  viewCount           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  authorId            String
  categoryId          String?
  embedding           Json?
  requiredMediaCount  Int?
  requiredMediaType   RequiredMediaType?
  requiresMediaUpload Boolean             @default(false)
  structuredFormat    StructuredFormat?
  featuredAt          DateTime?
  isFeatured          Boolean             @default(false)
  isUnlisted          Boolean             @default(false)
  unlistedAt          DateTime?
  delistReason        DelistReason?
  deletedAt           DateTime?
  changeRequests      ChangeRequest[]
  pinnedBy            PinnedPrompt[]
  reports             PromptReport[]
  tags                PromptTag[]
  versions            PromptVersion[]
  votes               PromptVote[]
  comments            Comment[]
  author              User                @relation("PromptAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category            Category?           @relation(fields: [categoryId], references: [id])
  contributors        User[]              @relation("PromptContributors")
  outgoingConnections PromptConnection[]  @relation("ConnectionSource")
  incomingConnections PromptConnection[]  @relation("ConnectionTarget")
  collectedBy         Collection[]
  userExamples        UserPromptExample[]
  bestWithModels      String[] // Model slugs this prompt works best with (max 3), e.g. ["gpt-4o", "claude-3-5-sonnet"]
  bestWithMCP         Json? // MCP configs array, e.g. [{command: "npx -y @mcp/server", tools: ["tool1"]}]
  workflowLink        String? // URL to test/demo the workflow when prompt has previous/next connections

  @@index([authorId])
  @@index([categoryId])
  @@index([type])
  @@index([isPrivate])
  @@index([isFeatured])
  @@index([isUnlisted])
  @@index([slug])
  @@index([isPrivate, isUnlisted, deletedAt, createdAt(sort: Desc)])
  @@map("prompts")
}

model PromptVersion {
  id         String   @id @default(cuid())
  version    Int
  content    String
  changeNote String?
  createdAt  DateTime @default(now())
  promptId   String
  createdBy  String
  author     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  prompt     Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_versions")
}

model ChangeRequest {
  id              String              @id @default(cuid())
  proposedContent String
  proposedTitle   String?
  reason          String?
  status          ChangeRequestStatus @default(PENDING)
  reviewNote      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  promptId        String
  authorId        String
  originalContent String
  originalTitle   String
  author          User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  prompt          Prompt              @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([authorId])
  @@index([status])
  @@map("change_requests")
}

model Category {
  id          String                 @id @default(cuid())
  name        String
  slug        String                 @unique
  description String?
  icon        String?
  order       Int                    @default(0)
  pinned      Boolean                @default(false)
  parentId    String?
  parent      Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]             @relation("CategoryHierarchy")
  subscribers CategorySubscription[]
  prompts     Prompt[]
  templates   Template[]

  @@index([parentId])
  @@index([pinned])
  @@map("categories")
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  slug    String      @unique
  color   String      @default("#6366f1")
  prompts PromptTag[]

  @@map("tags")
}

model PromptTag {
  promptId String
  tagId    String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@map("prompt_tags")
}

model CategorySubscription {
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("category_subscriptions")
}

model PromptVote {
  userId    String
  promptId  String
  createdAt DateTime @default(now())
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
  @@index([userId])
  @@index([promptId])
  @@map("prompt_votes")
}

model PinnedPrompt {
  userId    String
  promptId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
  @@index([userId])
  @@map("pinned_prompts")
}

model Collection {
  userId    String
  promptId  String
  createdAt DateTime @default(now())
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
  @@index([userId])
  @@index([promptId])
  @@map("collections")
}

model UserPromptExample {
  id        String   @id @default(cuid())
  mediaUrl  String
  comment   String?
  createdAt DateTime @default(now())
  promptId  String
  userId    String
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([userId])
  @@map("user_prompt_examples")
}

model PromptReport {
  id         String       @id @default(cuid())
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  promptId   String
  reporterId String
  prompt     Prompt       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([reporterId])
  @@index([status])
  @@map("prompt_reports")
}

model WebhookConfig {
  id        String         @id @default(cuid())
  name      String
  url       String
  method    String         @default("POST")
  headers   Json?
  payload   String
  events    WebhookEvent[]
  isEnabled Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("webhook_configs")
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  score     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  promptId  String
  authorId  String
  parentId  String?
  flagged   Boolean       @default(false)
  flaggedAt DateTime?
  flaggedBy String?
  deletedAt DateTime?
  prompt    Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author    User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  votes     CommentVote[]

  @@index([promptId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model CommentVote {
  userId    String
  commentId String
  value     Int // 1 for upvote, -1 for downvote
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([userId])
  @@index([commentId])
  @@map("comment_votes")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  actorId   String?
  promptId  String?
  commentId String?
  /// 社区通知指向的帖子或漂流瓶；excerpt 是帖子标题或回复的前几十个字。
  communityPostId String?
  bottleId        String?
  excerpt         String?          @db.VarChar(80)
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

model PromptConnection {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source    Prompt   @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Prompt   @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@map("prompt_connections")
}

enum NotificationType {
  COMMENT
  REPLY
  COMMUNITY_REPLY
  COMMUNITY_HELP_OFFER
  COMMUNITY_APPLICATION
  COMMUNITY_APPLICATION_ACCEPTED
  COMMUNITY_APPLICATION_DECLINED
  COMMUNITY_HELPED
  BOTTLE_REPLY
  COMMUNITY_RELAY
  COMMUNITY_FOLLOWED
  COMMUNITY_FOLLOWEE_POST
}

enum UserRole {
  ADMIN
  USER
}

enum PromptType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STRUCTURED
  SKILL
  TASTE
}

enum StructuredFormat {
  JSON
  YAML
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequiredMediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  COPYRIGHT
  MISLEADING
  RELIST_REQUEST
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum WebhookEvent {
  PROMPT_CREATED
  PROMPT_UPDATED
  PROMPT_DELETED
}

enum DelistReason {
  TOO_SHORT
  NOT_ENGLISH
  LOW_QUALITY
  NOT_LLM_INSTRUCTION
  MANUAL
  UNUSUAL_ACTIVITY
}

// ============================================================================
// ANS 社区平台（v3.2 框架�?
// 等级经验 / 邀请码 / 模板 / 运行 / 团队 / 比赛 / 算力额度
// ============================================================================

enum XpReason {
  SHARE
  CHECK_IN
  PUBLISH_PROMPT
  PUBLISH_TEMPLATE
  COMMENT
  RECEIVE_VOTE
  RECEIVE_FAVORITE
  FEATURED
  TEMPLATE_APPROVED
  RUN_COMPLETE
  MANUAL_ADJUST
  COMPETITION_AWARD
  COMMUNITY_REWARD
  REWARD_REVERSAL
}

model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XpReason
  refType   String? // "prompt" | "template" | "comment" | "run"
  refId     String?
  note      String?
  createdAt DateTime @default(now())
  appeal XpRewardAppeal?
  reviewCase XpRewardReviewCase?
  rewardGrant XpRewardGrant?

  @@index([userId, createdAt])
  @@index([userId, reason])
  @@map("xp_ledger")
}

enum XpRewardAppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum XpRewardReviewStatus {
  OPEN
  CLEARED
  REVERSED
}

model XpRewardRule {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?  @db.VarChar(1000)
  amount      Int
  dailyLimit  Int      @default(1)
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("XpRewardRuleAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  grants      XpRewardGrant[]

  @@index([active, createdAt])
  @@map("xp_reward_rules")
}

model XpRewardGrant {
  id        String       @id @default(cuid())
  ruleId    String
  rule      XpRewardRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId  String
  amount    Int
  ledgerId  String       @unique
  ledger    XpLedger     @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@unique([ruleId, userId, sourceType, sourceId])
  @@index([userId, createdAt])
  @@map("xp_reward_grants")
}

model XpRewardAppeal {
  id           String                @id @default(cuid())
  ledgerId     String                @unique
  ledger       XpLedger              @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation("XpRewardAppealAuthor", fields: [userId], references: [id], onDelete: Cascade)
  message      String                @db.VarChar(2000)
  status       XpRewardAppealStatus  @default(PENDING)
  reviewedById String?
  reviewer     User?                 @relation("XpRewardAppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolution   String?               @db.VarChar(2000)
  adjustment  Int                   @default(0)
  createdAt    DateTime              @default(now())
  reviewedAt   DateTime?

  @@index([status, createdAt])
